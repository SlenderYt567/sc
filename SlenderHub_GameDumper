local GameNameCache

local function GetGameName()
    if GameNameCache then return GameNameCache end
    local ok, info = pcall(function()
        return MarketplaceService:GetProductInfo(game.PlaceId).Name
    end)
    local name = ok and info or ("place_" .. tostring(game.PlaceId))
    name = (name or ""):gsub("[<>:\"/\\|?*]", "_")
    GameNameCache = name ~= "" and name or ("place_" .. tostring(game.PlaceId))
    return GameNameCache
end

--------------------------------------------------------------------------------
-- FILESYSTEM COM CACHE (Evita crash de I/O)
--------------------------------------------------------------------------------
local HasWrite = Fn("WriteFile") ~= nil
local CreatedFoldersCache = {}
local CreatedFilesCache = {}

local function SanitizeName(name)
    if not SlenderHub.Config.Sanitize then return name end
    name = name:gsub("[<>:\"/\\|?*%c]", "_")
    name = name:gsub("^_+", ""):gsub("_+$", "")
    return name ~= "" and name or "unnamed"
end

local function EnsureFolder(path)
    if CreatedFoldersCache[path] then return true end
    local mk = Fn("MakeFolder")
    local isf = Fn("IsFolder")
    if not mk then return false end
    
    local cur = ""
    for _, part in ipairs(string.split(path, "/")) do
        cur = cur .. part
        if not CreatedFoldersCache[cur] then
            local exists = false
            if isf then
                local ok, e = pcall(isf, cur)
                exists = ok and e == true
            end
            if not exists then
                pcall(mk, cur)
            end
            CreatedFoldersCache[cur] = true
        end
        cur = cur .. "/"
    end
    return true
end

local function WriteUniqueFile(path, content)
    local wf = Fn("WriteFile")
    if not wf then return nil end
    
    local final = path
    local n = 1
    
    while CreatedFilesCache[final] do
        n = n + 1
        final = path:gsub("(.+)%.(lua|txt|json|bin)$", "%1_" .. n .. ".%2")
        if final == path then final = path .. "_" .. n end
    end
    
    CreatedFilesCache[final] = true
    local ok = pcall(wf, final, content)
    return ok and final or nil
end

--------------------------------------------------------------------------------
-- COLETA DE REMOTES
--------------------------------------------------------------------------------
local REMOTE_CLASSES = { "RemoteEvent", "RemoteFunction", "UnreliableRemoteEvent" }
local SUSPICIOUS_WORDS = { "ban", "admin", "detect", "cheat", "exploit", "check", "verify", "kick", "anti", "honeypot", "log", "report", "ac", "detection", "flag", "punish", "moderation", "security", "backdoor" }
local SECURITY_FOLDERS = { "anticheat", "anti-cheat", "ac", "security", "moderation", "detection" }

local function IsSuspiciousName(name)
    local n = name:lower()
    for _, w in ipairs(SUSPICIOUS_WORDS) do
        if n:find(w, 1, true) then return true end
    end
    return false
end

local function IsInsideSecurityFolder(inst)
    local cur = inst.Parent
    while cur do
        local cname = cur.Name:lower()
        for _, f in ipairs(SECURITY_FOLDERS) do
            if cname == f then return true end
        end
        cur = cur.Parent
    end
    return false
end

local function GetRemotePath(inst)
    local parts = {}
    local cur = inst
    while cur and cur ~= game do
        table.insert(parts, 1, cur.Name)
        cur = cur.Parent
    end
    return table.concat(parts, "/")
end

local function CollectRemotes()
    local remotes = {}
    local seen = {}

    local function Add(inst)
        if seen[inst] then return end
        seen[inst] = true
        table.insert(remotes, inst)
    end

    local descs = game:GetDescendants()
    for i, desc in ipairs(descs) do
        for _, cls in ipairs(REMOTE_CLASSES) do
            if desc:IsA(cls) then Add(desc) end
        end
        if desc:IsA("BindableEvent") or desc:IsA("BindableFunction") then
            Add(desc)
        end
        if i % 200 == 0 then task.wait() end -- Yield para aliviar CPU
    end

    local gc = Fn("GetGC")
    if gc then
        pcall(function()
            local gctable = gc()
            for i, v in ipairs(gctable) do
                if type(v) == "userdata" and typeof(v) == "Instance" then
                    for _, cls in ipairs(REMOTE_CLASSES) do
                        if v:IsA(cls) then Add(v) end
                    end
                end
                if i % 500 == 0 then task.wait() end
            end
        end)
    end

    local nilInst = Fn("GetNilInstances")
    if nilInst then
        pcall(function()
            for _, v in ipairs(nilInst()) do
                if typeof(v) == "Instance" then
                    for _, cls in ipairs(REMOTE_CLASSES) do
                        if v:IsA(cls) then Add(v) end
                    end
                end
            end
        end)
    end

    return remotes
end

local function CountConnections(remote)
    local gc = Fn("GetConnections")
    if not gc then return nil end
    local ok, cons = pcall(gc, remote)
    if not ok or type(cons) ~= "table" then return nil end
    return #cons
end

--------------------------------------------------------------------------------
-- COLETA DE SCRIPTS
--------------------------------------------------------------------------------
local ScriptStore = {}
local ExtraStore = {}
local SeenSources = {}
local Stats = { scripts = 0, closures = 0, extras = 0, errors = 0 }

local function SourceToPath(source)
    local s = source:gsub("^@", ""):gsub(":%d+$", "")
    local parts = {}
    for part in s:gmatch("[^/]+") do
        table.insert(parts, part)
    end
    local folder, name
    if #parts == 0 then
        folder, name = "unknown", "unknown"
    elseif #parts == 1 then
        folder, name = "unknown", parts[1]
    else
        folder, name = parts[1], parts[#parts]
    end
    return SanitizeName(folder), SanitizeName(name)
end

local function DecompileOne(closure)
    local dc = Fn("Decompile")
    if dc then
        local ok, code = pcall(dc, closure)
        if ok and type(code) == "string" and #code > 0 then
            return code, "code"
        end
    end
    local sb = Fn("ScriptBytecode") or Fn("DumpString")
    if sb then
        local ok, bin = pcall(sb, closure)
        if ok and type(bin) == "string" and #bin > 0 then
            return bin, "bytecode"
        end
    end
    return nil, nil
end

local function AddClosure(closure, info)
    info = info or debug.getinfo(closure)
    if not info or type(info.source) ~= "string" then return end
    local src = info.source
    if src == "=[C]" or not src:find("^@") then return end

    Stats.closures = Stats.closures + 1
    if SeenSources[src] then
        if SlenderHub.Config.WriteExtra then
            table.insert(ExtraStore, { source = src, closure = closure, info = info })
        end
        return
    end
    SeenSources[src] = true

    local folder, name = SourceToPath(src)
    local content, kind = DecompileOne(closure)
    local note
    if not content then
        kind = "note"
        note = string.format("-- Closure sem decompilador disponível.\n-- Executor: %s\n-- source: %s\n", tostring(ExecutorName), tostring(src))
    end
    local filePath = string.format("scripts/%s/%s.lua", folder, name)
    table.insert(ScriptStore, {
        path = filePath,
        folder = folder,
        name = name,
        content = content,
        kind = kind,
        note = note,
        source = src,
    })
    Stats.scripts = Stats.scripts + 1
end

local function CollectScripts()
    local running = Fn("GetRunning")
    if running then
        pcall(function()
            local list = running()
            for i, inst in ipairs(list) do
                if typeof(inst) == "Instance" then
                    local okClass = pcall(function() return inst:IsA("LuaSourceContainer") end)
                    if okClass then
                        local content, kind
                        local okSrc, src = pcall(function() return inst.Source end)
                        if okSrc and type(src) == "string" and #src > 0 then
                            content, kind = src, "code"
                        else
                            local dc = Fn("Decompile")
                            if dc then
                                local ok2, code = pcall(dc, inst)
                                if ok2 and type(code) == "string" and #code > 0 then
                                    content, kind = code, "code"
                                end
                            end
                        end
                        local folder, name = "scripts_rodando", SanitizeName(inst.Name)
                        local filePath = string.format("scripts/%s/%s.lua", folder, name)
                        table.insert(ScriptStore, {
                            path = filePath, folder = folder, name = name,
                            content = content, kind = kind or "note",
                            note = kind and nil or ("-- Script sem código recuperável: " .. tostring(inst:GetFullName())),
                            source = inst:GetFullName(),
                        })
                        Stats.scripts = Stats.scripts + 1
                    end
                end
                if i % SlenderHub.Config.BatchSize == 0 then task.wait() end
            end
        end)
    end

    local gc = Fn("GetGC")
    if gc then
        pcall(function()
            local gctable = gc()
            for i, v in ipairs(gctable) do
                if type(v) == "function" then
                    local ok, info = pcall(debug.getinfo, v, "S")
                    if ok and info then AddClosure(v, info) end
                end
                if i % 300 == 0 then task.wait() end -- Evita congelar thread no GC
            end
        end)
    end
end

--------------------------------------------------------------------------------
-- LOG RUNTIME DE REMOTES
--------------------------------------------------------------------------------
SlenderHub.RemoteLog = { Enabled = false, Buffer = {}, Hooked = false, OldNamecall = nil }

local function FlushRemoteLog()
    local base = string.format("%s/%s/remotes/runtime_log.txt", SlenderHub.Config.OutputRoot, GetGameName())
    EnsureFolder(SlenderHub.Config.OutputRoot .. "/" .. GetGameName() .. "/remotes")
    local content = table.concat(SlenderHub.RemoteLog.Buffer, "\n")
    WriteUniqueFile(base, content)
end

local function EnableRemoteLog()
    local hook = Fn("HookMetaMethod")
    local nm   = Fn("GetNamecall")
    local cc   = Fn("CheckCaller")
    local ncc  = Fn("NewCClosure")
    if not hook or not nm then
        Notify("SlenderHub", "Executor sem hookmetamethod", 3, "Error")
        return false
    end
    local old = hook(game, "__namecall")
    SlenderHub.RemoteLog.OldNamecall = old
    local function callback(self, ...)
        local method = nm()
        if (method == "FireServer" or method == "InvokeServer") and typeof(self) == "Instance" then
            if not (cc and cc()) then
                local args = { ... }
                local argStr = {}
                for i = 1, math.min(6, #args) do
                    local v = args[i]
                    local str = typeof(v) == "Instance" and ("Inst:" .. v.ClassName .. ":" .. v.Name) or tostring(v)
                    table.insert(argStr, str)
                end
                local line = string.format("[%s] %s %s(%s)", tostring(os.clock()), self.ClassName, self.Name, table.concat(argStr, ", "))
                table.insert(SlenderHub.RemoteLog.Buffer, line)
            end
        end
        return old(self, ...)
    end
    local hookedFn = ncc and ncc(callback) or callback
    hook(game, "__namecall", hookedFn)
    SlenderHub.RemoteLog.Hooked = true
    return true
end

local function DisableRemoteLog()
    if SlenderHub.RemoteLog.Hooked then
        pcall(hookmetamethod, game, "__namecall", SlenderHub.RemoteLog.OldNamecall or function() end)
        SlenderHub.RemoteLog.Hooked = false
    end
    FlushRemoteLog()
end

--------------------------------------------------------------------------------
-- DUMP COMPLETO ASSÍNCRONO
--------------------------------------------------------------------------------
local function BuildMetadata(remotes, honeypots)
    local meta = {
        tool = "SlenderHub Game Dumper",
        version = "1.0.1",
        game = GetGameName(),
        placeId = tostring(game.PlaceId),
        executor = tostring(ExecutorName),
        timestamp = os.date("%Y-%m-%d %H:%M:%S"),
        stats = {
            scripts = Stats.scripts,
            closures_scanned = Stats.closures,
            extra_closures = Stats.extras,
            remotes = #remotes,
            honeypots = #honeypots,
        },
    }
    return HttpService:JSONEncode(meta)
end

local function RunDump()
    Stats = { scripts = 0, closures = 0, extras = 0, errors = 0 }
    ScriptStore = {}
    ExtraStore = {}
    SeenSources = {}
    CreatedFoldersCache = {}
    CreatedFilesCache = {}

    local gameName = GetGameName()
    local root = string.format("%s/%s", SlenderHub.Config.OutputRoot, gameName)

    if not HasWrite then
        Notify("SlenderHub", "Executor sem writefile", 4, "Warning")
    end

    Notify("SlenderHub", "Coletando remotes...", 2, nil)
    local remotes = CollectRemotes()
    task.wait(0.1)

    Notify("SlenderHub", "Coletando scripts...", 3, nil)
    CollectScripts()
    task.wait(0.1)

    local honeypots = {}
    local connectionInfo = {}
    for _, r in ipairs(remotes) do
        local cons = CountConnections(r)
        connectionInfo[r] = cons
        if IsSuspiciousName(r.Name) or IsInsideSecurityFolder(r) then
            table.insert(honeypots, r)
        end
    end

    local okWrite = HasWrite
    if okWrite then
        EnsureFolder(root .. "/scripts")
        EnsureFolder(root .. "/remotes")
    end

    local written = 0
    local failed = 0
    
    if okWrite then
        Notify("SlenderHub", "Salvando arquivos em disco...", 3, nil)
        for i, s in ipairs(ScriptStore) do
            local full = string.format("%s/%s", root, s.path)
            EnsureFolder(root .. "/scripts/" .. s.folder)
            local content = s.content
            if s.kind == "bytecode" then
                content = "-- BYTECODE\n" .. content
            elseif s.kind == "note" then
                content = s.note
            else
                content = "--// SlenderHub Dump | " .. gameName .. "\n\n" .. (content or "")
            end
            
            local ok = WriteUniqueFile(full, content)
            if ok then written = written + 1 else failed = failed + 1 end
            
            if i % SlenderHub.Config.BatchSize == 0 then
                task.wait() -- Pausa para não fechar o Delta ao criar arquivos
            end
        end

        -- Remotes
        local lines = { string.format("REMOTES — %s (%s)", gameName, tostring(game.PlaceId)) }
        for _, r in ipairs(remotes) do
            table.insert(lines, string.format("[%s] %s | caminho: %s | handlers: %s",
                r.ClassName, r.Name, GetRemotePath(r), tostring(connectionInfo[r] or "?")))
        end
        WriteUniqueFile(root .. "/remotes/remotes.txt", table.concat(lines, "\n"))

        -- Metadata
        WriteUniqueFile(root .. "/metadata.json", BuildMetadata(remotes, honeypots))
    end

    local summary = string.format(
        "DUMP CONCLUÍDO\nJogo: %s\nExecutor: %s\n\nPasta: %s\n  • Scripts: %d\n  • Closures: %d\n  • Remotes: %d",
        gameName, tostring(ExecutorName), root, written, Stats.closures, #remotes)

    if SlenderHub.UI and SlenderHub.UI.SetResult then
        SlenderHub.UI.SetResult(summary)
    end
    Notify("SlenderHub", "Dump salvo com sucesso!", 5, "Success")
end

