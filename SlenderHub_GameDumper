local Env = getgenv and getgenv() or _G

local FunctionMap = {
    CheckCaller     = function() return type(checkcaller) == "function" and checkcaller or nil end,
    NewCClosure     = function() return type(newcclosure) == "function" and newcclosure or nil end,
    HookMetaMethod  = function() return type(hookmetamethod) == "function" and hookmetamethod or nil end,
    GetNamecall     = function() return type(getnamecallmethod) == "function" and getnamecallmethod or nil end,
    GetGC           = function() return type(getgc) == "function" and getgc or nil end,
    GetReg          = function() return type(getreg) == "function" and getreg or nil end,
    GetNilInstances = function() return type(getnilinstances) == "function" and getnilinstances or nil end,
    GetRunning      = function() return type(getrunningscripts) == "function" and getrunningscripts or nil end,
    GetConnections  = function() return type(getconnections) == "function" and getconnections or nil end,
    Decompile       = function() return type(decompile) == "function" and decompile or nil end,
    ScriptBytecode  = function() return type(getscriptbytecode) == "function" and getscriptbytecode or nil end,
    DumpString      = function() return type(dumpstring) == "function" and dumpstring or nil end,
    WriteFile       = function() return type(writefile) == "function" and writefile or nil end,
    MakeFolder      = function() return type(makefolder) == "function" and makefolder or nil end,
    IsFolder        = function() return type(isfolder) == "function" and isfolder or nil end,
    IsFile          = function() return type(isfile) == "function" and isfile or nil end,
    ListFiles       = function() return type(listfiles) == "function" and listfiles or nil end,
    Identify        = function()
        local names = { "getexecutorname", "identifyexecutor", "get_identify" }
        for _, n in ipairs(names) do
            if type(Env[n]) == "function" then
                local ok, v = pcall(Env[n])
                if ok and v then return tostring(v) end
            end
        end
        return "unknown"
    end,
}

local function Fn(name)
    local ok, val = pcall(FunctionMap[name])
    return ok and val or nil
end

local ExecutorName = Fn("Identify")

