-- Diagnóstico SlenderHub | "TIXEOlmYIUCVBKywi: attempt to call nil"
local alvo = "TIXEOlmYIUCVBKywi"
local found, n = {}, 0

-- 1) Procura closures vivas com esse source no heap
local gc = getgc and getgc() or {}
for _, v in ipairs(gc) do
    if type(v) == "function" then
        n = n + 1
        if n > 200000 then break end
        local ok, info = pcall(debug.getinfo, v, "S")
        if ok and info and info.source == alvo then
            table.insert(found, v)
        end
    end
end
print(("Closures com source %q: %d (varridos: %d)"):format(alvo, #found, n))

-- 2) Se achou, mostra de onde veio
if #found > 0 then
    local ok, info = pcall(debug.getinfo, found[1], "S")
    print("short_src:", ok and info and info.short_src, "| line:", ok and info and info.linedefined)
    local ok2, name = pcall(getnamecallmethod)
    print("getnamecallmethod:", ok2 and name or "?")
end

-- 3) O dumper está de pé?
local dumper = game:GetService("CoreGui"):FindFirstChild("SlenderHubDumper")
print("Dumper UI ativa:", dumper ~= nil)

-- 4) Ambiente do Delta — o que existe/falta
print("Executor:", (identifyexecutor and identifyexecutor()) or "?")
for _, f in ipairs({
    "getgenv", "getgc", "getreg", "decompile", "getscriptbytecode",
    "hookmetamethod", "getnamecallmethod", "checkcaller", "newcclosure",
    "writefile", "makefolder", "getconnections", "getnilinstances",
    "getrunningscripts", "getrawmetatable", "iscclosure", "isclosure",
}) do
    print(("  %-20s %s"):format(f, type(_G[f]) == "function" and "OK" or "FALTA"))
end
