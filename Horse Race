-- Loop seguro para toggles
local function StartToggleLoop(flagRef, interval, func)
    task.spawn(function()
        while flagRef[1] do
            local ok, err = pcall(func)
            if not ok then
                warn("[SlenderHub] Erro no loop:", err)
            end
            task.wait(interval)
        end
    end)
end

-- Helper para criar toggle com loop
local function CreateToggleLoop(tab, id, title, flagKey, interval, callback, default)
    return tab:AddToggle(id, {
        Title = title,
        Default = default or false,
        Callback = function(v)
            Flags[flagKey] = v
            if v then
                StartToggleLoop(
                    { get = function() return Flags[flagKey] end },
                    interval,
                    callback
                )
            end
        end
    })
end

-- Acessa remote do Knit por nome do serviço
local function GetKnitService(serviceName)
    if not KnitLoaded then return nil end
    local service = Services:FindFirstChild(serviceName)
    return service
end

-- Acessa RemoteEvent/RemoteFunction por caminho
local function GetKnitRemote(serviceName, remoteType, remoteName)
    local service = GetKnitService(serviceName)
    if not service then return nil end
    local container = service:FindFirstChild(remoteType)  -- "RE" ou "RF"
    if not container then return nil end
    return container:FindFirstChild(remoteName)
end

