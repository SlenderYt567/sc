task.spawn(function()
    task.wait(1)

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "SlenderHub_FloatingButton"
    screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

    local imageButton = Instance.new("ImageButton")
    imageButton.Size = UDim2.new(0, 50, 0, 50)
    imageButton.Position = UDim2.new(1, -110, 0, 10)
    imageButton.BackgroundTransparency = 1
    imageButton.Image = "rbxassetid://2875276601"
    imageButton.Parent = screenGui

    local uiStroke = Instance.new("UIStroke")
    uiStroke.Parent = imageButton
    uiStroke.Thickness = 4
    uiStroke.Color = Color3.fromRGB(0, 0, 255)
    uiStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    uiStroke.Transparency = 0

    local corner = Instance.new("UICorner")
    corner.Parent = imageButton

    local windowHidden = false

    imageButton.MouseButton1Click:Connect(function()
        windowHidden = not windowHidden
        if windowHidden then
            Window:Minimize()
        else
            pcall(function()
                if Window.Show then
                    Window:Show()
                elseif Window.Maximize then
                    Window:Maximize()
                else
                    windowHidden = not windowHidden
                end
            end)
        end
    end)

    -- Dragging (corrigido)
    local dragging = false
    local dragStart = nil
    local buttonStartPos = nil

    imageButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            buttonStartPos = imageButton.Position

            local con
            con = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    con:Disconnect()
                end
            end)
        end
    end)

    imageButton.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement and dragging and dragStart and buttonStartPos then
            local delta = input.Position - dragStart
            imageButton.Position = UDim2.new(
                buttonStartPos.X.Scale,
                buttonStartPos.X.Offset + delta.X,
                buttonStartPos.Y.Scale,
                buttonStartPos.Y.Offset + delta.Y
            )
        end
    end)
end)

