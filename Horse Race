--//==============================================================================
--// 6. GETREMOTE (Abstração segura de remotes)
--//==============================================================================
local function GetRemote(serviceName: string, remoteName: string, isFunction: boolean?)
    if not KnitLoaded or not Services[serviceName] then
        return nil
    end
    local folderName = if isFunction then "RF" else "RE"
    local folder = Services[serviceName]:FindFirstChild(folderName)
    if not folder then
        return nil
    end
    return folder:FindFirstChild(remoteName)
end

--//==============================================================================
--// 7. REMOTE GUARD (Rate Limiting + Safe Call)
--//==============================================================================
local lastCallTimestamps = {}

local function SafeFire(remote: any, ...: any): boolean
    if not remote or not remote:IsA("RemoteEvent") then
        warn("[SlenderHub] Invalid RemoteEvent")
        return false
    end
    local ok, err = pcall(function()
        remote:FireServer(...)
    end)
    if not ok then
        warn("[SlenderHub] FireServer failed:", err)
    end
    return ok
end

local function SafeInvoke(remote: any, ...: any): (boolean, any)
    if not remote or not remote:IsA("RemoteFunction") then
        warn("[SlenderHub] Invalid RemoteFunction")
        return false, nil
    end
    local ok, result = pcall(function()
        return remote:InvokeServer(...)
    end)
    if not ok then
        warn("[SlenderHub] InvokeServer failed:", result)
    end
    return ok, result
end

-- Função de rate limiting integrada
local function SafeFireRateLimited(remote: any, cooldown: number, ...: any): boolean
    if not remote then
        remote = nil -- Será re-buscado pelo loop
        return false
    end

    local now = tick()
    local key = tostring(remote)
    local lastCall = lastCallTimestamps[key] or 0

    if now - lastCall < cooldown then
        return false -- Ainda em cooldown
    end

    lastCallTimestamps[key] = now
    return SafeFire(remote, ...)
end

--//==============================================================================
--// 8. LOOP GUARD (Previne loops concorrentes)
--//==============================================================================
local activeLoops = {}

local function StartGuardedLoop(loopId: string, callback: (() -> ())?): boolean
    if activeLoops[loopId] then
        return false -- Já está rodando
    end

    activeLoops[loopId] = true

    task.spawn(function()
        while activeLoops[loopId] do
            if callback then
                local ok, err = pcall(callback)
                if not ok then
                    warn("[SlenderHub] Loop error (" .. loopId .. "):", err)
                end
            end
            task.wait(0.1) -- Mínimo 100ms entre iterações
        end
    end)

    return true
end

local function StopGuardedLoop(loopId: string)
    activeLoops[loopId] = false
end

