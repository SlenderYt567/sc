local Window = nil

local function Notify(title, text, duration, nType)
    if nType == nil then nType = "Success" end
    if duration == nil then duration = 4 end

    if Window and Window.Notify then
        pcall(function()
            Window:Notify(title or "SlenderHub", text or "", duration, nType)
        end)
    else
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = title or "SlenderHub",
                Text = text or "",
                Duration = duration,
            })
        end)
    end
end

--//==============================================================================
--// 12. CREATE AUTO TOGGLE HELPER (Compatível Lua 5.1)
--//==============================================================================
local function CreateAutoToggle(tab, title, flagKey, remoteGetter, fireFn, cooldown, description)
    local cd = cooldown or 0.5
    if description == nil then description = "Toggle " .. title end

    tab:Toggle(title, false, flagKey, description, function(value)
        Flags[flagKey] = value
        local loopId = "AutoToggle_" .. flagKey

        if value then
            if not StartGuardedLoop(loopId, function()
                if KnitLoaded then
                    local remote = remoteGetter()
                    if remote then
                        fireFn(remote)
                    end
                end
                task.wait(cd)
            end) then
                Notify("Warning", "Loop '" .. title .. "' já está rodando.", 2, "Warning")
            end
        else
            StopGuardedLoop(loopId)
        end
    end)
end

