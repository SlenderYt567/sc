local function saveKey(key)
    if writefile then
        local ok = pcall(function() writefile(CONFIG.KeyFileName, key) end)
        if not ok then
            warn("[Slender Hub] Failed to save key to file")
        end
    end
end

local function checkSavedKey()
    local read = readfile or function() return "" end
    if isfile and isfile(CONFIG.KeyFileName) then
        local savedKey = read(CONFIG.KeyFileName)
        if savedKey and savedKey ~= "" then
            local success, msg = PB.redeemKey(savedKey)
            if success then
                Notify("Slender Hub", "Auto-Login Successful!", 3, "Success")
                task.wait(0.5)
                StartMainScript()
                return true
            end
        end
    end
    return false
end

