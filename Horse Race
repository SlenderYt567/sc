-- Safe request function (fixed: melhor deteccao de erros)
local function safeRequest(options)
    local req = request or http_request or syn_request or (http and http.request)
    if not req then
        warn("[Slender Hub] HTTP not supported - no request function found")
        return nil, "HTTP requests not supported"
    end
    local success, response = pcall(function() return req(options) end)
    if success and response then
        return response
    else
        local errMsg = tostring(response)
        warn("[Slender Hub] HTTP request failed:", errMsg)
        return nil, "Connection Error: " .. errMsg
    end
end

