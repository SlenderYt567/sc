-- Função genérica para criar um toggle de auto com loop
local function CreateAutoToggle(tab: any, title: string, flagKey: string, remoteGetter: () -> any,
                                fireFn: (remote: any) -> (), cooldown: number?, description: string?)
    local cd = cooldown or 0.5
    tab:Toggle(title, false, flagKey, description or "Toggle " .. title, function(value: boolean)
        Flags[flagKey] = value
        local loopId = "AutoToggle_" .. flagKey

        if value then
            if not StartGuardedLoop(loopId, function()
                if KnitLoaded then
                    local remote = remoteGetter()
                    if remote then
                        fireFn(remote)
                    end
                end
                task.wait(cd)
            end) then
                Notify("Warning", "Loop '" .. title .. "' já está rodando.", 2, "Warning")
            end
        else
            StopGuardedLoop(loopId)
        end
    end)
end

