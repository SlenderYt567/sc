-- Check connectivity
local function checkConnectivity()
    local response = safeRequest({Url = PB.host .. "/public/connectivity", Method = "GET"})
    if not response or (response.StatusCode ~= 200 and response.StatusCode ~= 429) then
        warn("[Slender Hub] Primary host unreachable (" .. tostring(PB.host) .. "), trying fallback...")
        PB.host = "https://api.platoboost.net"
        -- Test fallback
        local response2 = safeRequest({Url = PB.host .. "/public/connectivity", Method = "GET"})
        if response2 and (response2.StatusCode == 200 or response2.StatusCode == 429) then
            warn("[Slender Hub] Using fallback host:", PB.host)
        else
            warn("[Slender Hub] Both hosts unreachable - API calls may fail")
        end
    else
        warn("[Slender Hub] Connected to:", PB.host)
    end
end
checkConnectivity()

function PB.generateNonce()
    -- Usa HttpService para gerar GUID aleatorio (mais seguro que math.random)
    local success, guid = pcall(function()
        return game:GetService("HttpService"):GenerateGUID(false)
    end)
    if success and guid then
        -- GUID exemplo: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" -> remove tracos
        return guid:gsub("-", ""):sub(1, 16)
    end
    
    -- Fallback: seed com tempo + tick
    local seed = os.time() * 1000 + math.floor(tick() * 1000)
    math.randomseed(seed % 2^31)
    -- Garbage collection pra ajudar entropia
    collectgarbage()
    collectgarbage()
    seed = os.time() * 1000 + math.floor(tick() * 1000) + math.random(0, 999999)
    math.randomseed(seed % 2^31)
    local str = ""
    for _ = 1, 16 do
        str = str .. string.char(math.random(97, 122))
    end
    return str
end

function PB.cacheLink()
    if PB.cachedTime + 600 < os.time() then
        local response = safeRequest({
            Url = PB.host .. "/public/start",
            Method = "POST",
            Body = lEncode({service = PB.service, identifier = lDigest(PB.fGetHwid())}),
            Headers = {["Content-Type"] = "application/json"}
        })
        if response and response.StatusCode == 200 then
            local decoded = lDecode(response.Body)
            if decoded and decoded.success then
                PB.cachedLink = decoded.data.url
                PB.cachedTime = os.time()
                return true, PB.cachedLink
            end
        end
        return false, "Server Unreachable"
    end
    return true, PB.cachedLink
end

function PB.redeemKey(key)
    local nonce = PB.generateNonce()
    local body = {identifier = lDigest(PB.fGetHwid()), key = key}
    if PB.useNonce then body.nonce = nonce end
    
    local response = safeRequest({
        Url = PB.host .. "/public/redeem/" .. tostring(PB.service),
        Method = "POST",
        Body = lEncode(body),
        Headers = {["Content-Type"] = "application/json"}
    })
    
    if response and response.StatusCode == 200 then
        local decoded = lDecode(response.Body)
        if decoded and decoded.success and decoded.data.valid then
            if PB.useNonce then
                if decoded.data.hash == lDigest("true" .. "-" .. nonce .. "-" .. PB.secret) then
                    return true, "Success"
                end
                return false, "Integrity Check Failed"
            end
            return true, "Success"
        end
        return false, decoded and decoded.message or "Invalid Key"
    end
    return false, "Server Error"
end

