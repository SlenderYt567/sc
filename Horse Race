--//==============================================================================
--// 7. GETREMOTE (Abstração segura - compatível Lua 5.1)
--//==============================================================================
local function GetRemote(serviceName, remoteName, isFunction)
    if not KnitLoaded or not Services[serviceName] then
        return nil
    end
    local folderName
    if isFunction then
        folderName = "RF"
    else
        folderName = "RE"
    end
    local folder = Services[serviceName]:FindFirstChild(folderName)
    if not folder then
        return nil
    end
    return folder:FindFirstChild(remoteName)
end

--//==============================================================================
--// 8. REMOTE SAFE CALL FUNCTIONS
--//==============================================================================
local function SafeFire(remote, ...)
    if not remote or not remote:IsA("RemoteEvent") then
        return false
    end
    local ok, err = pcall(function()
        remote:FireServer(...)
    end)
    if not ok then
        warn("[SlenderHub] FireServer failed:", err)
    end
    return ok
end

local function SafeInvoke(remote, ...)
    if not remote or not remote:IsA("RemoteFunction") then
        return false, nil
    end
    local ok, result = pcall(function()
        return remote:InvokeServer(...)
    end)
    if not ok then
        warn("[SlenderHub] InvokeServer failed:", result)
    end
    return ok, result
end

--//==============================================================================
--// 9. LOOP GUARD (Previne loops concorrentes)
--//==============================================================================
local activeLoops = {}

local function StartGuardedLoop(loopId, callback)
    if activeLoops[loopId] then
        return false
    end
    activeLoops[loopId] = true
    task.spawn(function()
        while activeLoops[loopId] do
            local ok, err = pcall(callback)
            if not ok then
                warn("[SlenderHub] Loop error (" .. tostring(loopId) .. "):", err)
            end
            task.wait(0.1)
        end
    end)
    return true
end

local function StopGuardedLoop(loopId)
    activeLoops[loopId] = false
end

