-- AUTO WIN (versão com áreas dinâmicas)
Tabs.Main:AddToggle("AutoWin", {
    Title = "Auto Win Contest",
    Callback = function(v)
        Flags.AutoWin = v
        task.spawn(function()
            while Flags.AutoWin do
                local fightService = GetKnitService("FightService")
                if fightService then
                    local joinRemote = fightService:FindFirstChild("RE"):FindFirstChild("JoinContest")
                    local winRemote  = fightService:FindFirstChild("RE"):FindFirstChild("GetWinsEvent")
                    local quitRemote = fightService:FindFirstChild("RE"):FindFirstChild("QuitContestEvent")
                    
                    if joinRemote and winRemote and quitRemote then
                        local areas = Workspace:FindFirstChild("Areas")
                        if areas then
                            for _, area in pairs(areas:GetChildren()) do
                                pcall(function()
                                    joinRemote:FireServer(area.Name)
                                    task.wait(0.1)
                                    local winGates = area:FindFirstChild("WinGates")
                                    if winGates then
                                        for i, gate in pairs(winGates:GetChildren()) do
                                            local gatePos = gate:FindFirstChild("gate")
                                            if gatePos then
                                                winRemote:FireServer("WinGate_" .. i, gatePos.Position)
                                            end
                                        end
                                    end
                                    quitRemote:FireServer(area.Name)
                                end)
                            end
                        end
                    end
                end
                task.wait(1)
            end
        end)
    end
})

