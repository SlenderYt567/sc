-- Funcao auxiliar: aguarda PlayerGui com timeout
local function waitForPlayerGui(timeout)
    timeout = timeout or 10
    local start = os.time()
    while not LocalPlayer or not LocalPlayer:FindFirstChild("PlayerGui") do
        if os.time() - start > timeout then
            warn("[Slender Hub] Timeout waiting for PlayerGui")
            return nil
        end
        task.wait(0.5)
    end
    return LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
end

