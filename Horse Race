-- Enhanced notification with fallback support
local function Notify(title, text, duration, nType)
    local notifyType = nType or "Success"
    
    -- Sempre loga no console para debug
    print(string.format("[Slender Hub] [%s] %s: %s", notifyType, title, text))
    
    if Window and Window.Notify then
        local ok = pcall(function()
            Window:Notify(title, text, duration or 5, notifyType)
        end)
        if ok then return end
        warn("[Slender Hub] Window:Notify failed, using fallback")
    end
    
    -- Fallback: notificacao do Roblox
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = duration or 5,
        })
    end)
end

--//==============================[ SCRIPT EXECUTION ]==============================//--
local function StartMainScript()
    -- Aguarda PlayerGui com timeout
    local pGui = waitForPlayerGui()
    if not pGui then
        warn("[Slender Hub] Could not find PlayerGui, skipping GUI cleanup")
        Notify("Slender Hub", "Warning: Could not access PlayerGui", 5, "Warning")
    else
        -- Destroy old GUIs
        if pGui:FindFirstChild(CONFIG.OldGuiName) then 
            pcall(function() pGui[CONFIG.OldGuiName]:Destroy() end)
            task.wait(0.1)
        end
    end
    
    pcall(function()
        local coreSlender = CoreGui:FindFirstChild("SlenderWind")
        if coreSlender then coreSlender:Destroy() end
    end)
    
    -- Check if game is supported
    if not TARGET_SCRIPT_URL then
        Notify("Slender Hub", "Game Not Supported (ID: " .. CurrentPlaceId .. ")", 5, "Error")
        return
    end
    
    -- Execute main script
    local fetchSuccess, scriptContent = pcall(function()
        return game:HttpGet(TARGET_SCRIPT_URL)
    end)
    if not fetchSuccess or not scriptContent or scriptContent == "" then
        local errMsg = tostring(scriptContent)
        warn("[Slender Hub] Failed to fetch script:", errMsg)
        Notify("Error", "Failed to download script! Check Console (F9)", 5, "Error")
        return
    end
    
    local success, err = pcall(function()
        loadstring(scriptContent)()
    end)
    if not success then
        warn("[Slender Hub] Script Load Failed:", err)
        Notify("Error", "Failed to load script! Check Console (F9)", 5, "Error")
    end
end

