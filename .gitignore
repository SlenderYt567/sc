local dragging, dragOffset = false, Vector2.new()
DragBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragOffset = input.Position - Window.AbsolutePosition
    end
end)
DragBar.InputChanged:Connect(function(input)
    if dragging then
        local pos = UDim2.fromOffset(input.Position.X - dragOffset.X, input.Position.Y - dragOffset.Y)
        Window.Position = pos
    end
end)
DragBar.InputEnded:Connect(function()
    dragging = false
end)

