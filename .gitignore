local CurrentPlaceId = game.PlaceId
local TARGET_SCRIPT_URL = GAMES_MAP[CurrentPlaceId]

--//==============================[ PLATOBOOST LIBS ]==============================//--
--- Carrega as bibliotecas SHA-256 + JSON + PlatoBoost API
--- NOTA: Idealmente estas libs seriam carregadas de um único arquivo central
local PlatoboostLib = loadstring(game:HttpGet("https://api.platoboost.com/public/lib"))()

local lEncode    = PlatoboostLib.JSON.Encode
local lDecode    = PlatoboostLib.JSON.Decode
local lDigest    = PlatoboostLib.Crypto.SHA256
local fRequest   = PlatoboostLib.Request
local useNonce   = PlatoboostLib.UseNonce

--//==============================[ BACKEND LOGIC ]==============================//--
local Window = nil
local fGetHwid = gethwid or function() 
    return game:GetService("RbxAnalyticsService"):GetClientId() 
end

local cachedLink, cachedTime = "", 0
local host = "https://api.platoboost.com"

-- Verificação de conectividade com fallback fixo
local function checkConnectivity()
    local success, response = pcall(function()
        return fRequest({
            Url = host .. "/public/connectivity",
            Method = "GET"
        })
    end)
    if not success or not response or 
       (response.StatusCode ~= 200 and response.StatusCode ~= 429) then
        host = "https://api.platoboost.net"
    end
end
checkConnectivity()

local function generateNonce()
    -- Usa os.time + math.random + tick para melhor entropia
    local seed = os.time() * math.random(1, 10000) + tick()
    math.randomseed(seed)
    local str = ""
    for _ = 1, 16 do
        str = str .. string.char(math.random(97, 122))
    end
    return str
end

local function Notify(title: string, text: string, duration: number?, nType: string?)
    if Window and Window.Notify then
        Window:Notify(title, text, duration or 5, nType or "Success")
    else
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = title,
                Text = text,
                Duration = duration or 5,
            })
        end)
    end
end

local function cacheLink()
    if cachedTime + 600 < os.time() then
        local success, response = pcall(function()
            return fRequest({
                Url = host .. "/public/start",
                Method = "POST",
                Body = lEncode({
                    service = PB_CONFIG.ServiceId,
                    identifier = lDigest(fGetHwid())
                }),
                Headers = {["Content-Type"] = "application/json"}
            })
        end)
        if success and response and response.StatusCode == 200 then
            local decoded = lDecode(response.Body)
            if decoded and decoded.success then
                cachedLink = decoded.data.url
                cachedTime = os.time()
                return true, cachedLink
            end
        end
        return false, "Server Unreachable"
    end
    return true, cachedLink
end

local function redeemKey(key: string): (boolean, string)
    local nonce = generateNonce()
    local body = {
        identifier = lDigest(fGetHwid()),
        key = key
    }
    if useNonce then body.nonce = nonce end
    
    local success, response = pcall(function()
        return fRequest({
            Url = host .. "/public/redeem/" .. tostring(PB_CONFIG.ServiceId),
            Method = "POST",
            Body = lEncode(body),
            Headers = {["Content-Type"] = "application/json"}
        })
    end)
    
    if not success then return false, "Connection Error" end
    if not response then return false, "No Response" end
    
    if response.StatusCode == 200 then
        local decoded = lDecode(response.Body)
        if decoded and decoded.success and decoded.data.valid then
            if useNonce then
                local expected = "true" .. "-" .. nonce .. "-" .. PB_CONFIG.PlatoSecret
                if decoded.data.hash == lDigest(expected) then
                    if writefile then writefile(PB_CONFIG.KeyFileName, key) end
                    return true, "Success"
                end
                return false, "Integrity Check Failed"
            end
            if writefile then writefile(PB_CONFIG.KeyFileName, key) end
            return true, "Success"
        end
        return false, decoded.message or "Invalid Key"
    elseif response.StatusCode == 429 then
        return false, "Rate Limited. Wait 20s."
    end
    return false, "Server Error (HTTP " .. tostring(response.StatusCode) .. ")"
end

local function formatTime(seconds: number): string
    if seconds == math.huge then return "Lifetime" end
    local days = math.floor(seconds / 86400)
    local hours = math.floor((seconds % 86400) / 3600)
    local minutes = math.floor((seconds % 3600) / 60)
    return string.format("%dd %02dh %02dm", days, hours, minutes)
end

--//==============================[ SCRIPT EXECUTION ]==============================//--
local function StartMainScript()
    local pGui = LocalPlayer:WaitForChild("PlayerGui")
    
    -- Destroy old SlenderWind GUI
    if pGui:FindFirstChild(PB_CONFIG.OldGuiName) then 
        pGui[PB_CONFIG.OldGuiName]:Destroy() 
        task.wait(0.1)
    end
    
    -- Destroy CoreGui version if exists
    pcall(function()
        local coreSlender = CoreGui:FindFirstChild("SlenderWind")
        if coreSlender then coreSlender:Destroy() end
    end)
    
    -- Set anti-bypass global
    _G[PB_CONFIG.Secret] = true
    
    -- Check if game is supported
    if not TARGET_SCRIPT_URL then
        Notify("Slender Hub", "Game Not Supported (ID: " .. CurrentPlaceId .. ")", 5, "Error")
        return
    end
    
    -- Execute main script
    local success, err = pcall(function()
        loadstring(game:HttpGet(TARGET_SCRIPT_URL))()
    end)
    if not success then
        warn("[Slender Hub] Script Load Failed:", err)
        Notify("Error", "Failed to load script! Check Console (F9)", 5, "Error")
    end
end

--//==============================[ AUTO-LOGIN CHECK ]==============================//--
local function checkSavedKey(): boolean
    if isfile and isfile(PB_CONFIG.KeyFileName) then
        local savedKey = readfile(PB_CONFIG.KeyFileName)
        if savedKey and savedKey ~= "" then
            local success, msg = redeemKey(savedKey)
            if success then
                Notify("Slender Hub", "Auto-Login Successful!", 3, "Success")
                task.wait(0.5)
                StartMainScript()
                return true
            end
        end
    end
    return false
end

-- If main script GUI already exists, skip key system
local playerGui = LocalPlayer:WaitForChild("PlayerGui")
if playerGui:FindFirstChild(PB_CONFIG.MainGuiName) then
    StartMainScript()
    return
end

-- Try auto-login first
if checkSavedKey() then return end

