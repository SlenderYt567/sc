----------------------------------------------------------------------------
-- ESP (Highlight se disponível; senão Drawing; senão nada)
----------------------------------------------------------------------------
SlenderHub.ESP = { Enabled = false, Instances = {} }

local Highlight = function(inst, color)
    if inst:FindFirstChildOfClass("Highlight") then return end
    local hl = Instance.new("Highlight")
    hl.Name = "SlenderHubESP"
    hl.FillColor = color
    hl.FillTransparency = 0.6
    hl.OutlineColor = color
    hl.OutlineTransparency = 0
    hl.Parent = inst
end

local function ScanTargets()
    local patients, anomalies = {}, {}
    for _, desc in ipairs(SlenderHub.Config.PatientNames) do
        for _, model in ipairs(workspace:GetDescendants()) do
            if model:IsA("Model") and model.PrimaryPart then
                local okName = model.Name:lower()
                local isPatient = okName:find(desc:lower())
                local isAnom = false
                for _, a in ipairs(SlenderHub.Config.AnomalyNames) do
                    if okName:find(a:lower()) then isAnom = true break end
                end
                if isPatient then
                    if isAnom then table.insert(anomalies, model)
                    else table.insert(patients, model) end
                end
            end
        end
    end
    return patients, anomalies
end

function SlenderHub.SetESP(enabled)
    SlenderHub.ESP.Enabled = enabled
    if not enabled then
        for _, hl in ipairs(workspace:GetDescendants()) do
            if hl:IsA("Highlight") and hl.Name == "SlenderHubESP" then hl:Destroy() end
        end
        return
    end
    task.spawn(function()
        while SlenderHub.ESP.Enabled and task.wait(0.5) do
            pcall(function()
                for _, m in ipairs(workspace:GetDescendants()) do
                    if m:IsA("Model") and m.PrimaryPart then
                        local n = m.Name:lower()
                        for _, p in ipairs(SlenderHub.Config.PatientNames) do
                            if n:find(p:lower()) then
                                local isAnom = false
                                for _, a in ipairs(SlenderHub.Config.AnomalyNames) do
                                    if n:find(a:lower()) then isAnom = true break end
                                end
                                Highlight(m, isAnom and SlenderHub.Config.EspColor or SlenderHub.Config.EspColorGood)
                                break
                            end
                        end
                    end
                end
            end)
        end
    end)
end

----------------------------------------------------------------------------
-- MOVEMENT (walkspeed / noclip / fly / teleport p/ prompt)
----------------------------------------------------------------------------
SlenderHub.Movement = { Noclip = false, Fly = false }

local NoclipConn

function SlenderHub.SetWalkSpeed(v)
    local hum = GetHumanoid()
    if hum then hum.WalkSpeed = v end
end

function SlenderHub.SetNoclip(enabled)
    SlenderHub.Movement.Noclip = enabled
    if not enabled then
        if NoclipConn then NoclipConn:Disconnect() NoclipConn = nil end
        return
    end
    if NoclipConn then NoclipConn:Disconnect() end
    NoclipConn = RunService.Stepped:Connect(function(_, dt)
        local hum = GetHumanoid()
        if not hum then return end
        hum:ChangeState(Enum.HumanoidStateType.Physics)
        local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if root then root.Velocity = Vector3.new(0, 0, 0) end
    end)
end

function SlenderHub.SetFly(enabled)
    SlenderHub.Movement.Fly = enabled
    if not enabled then return end
    task.spawn(function()
        while SlenderHub.Movement.Fly and task.wait() do
            local hum = GetHumanoid()
            local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not hum or not root then break end
            local vel = root.AssemblyLinearVelocity or Vector3.new(0, 0, 0)
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vel = vel + Vector3.new(0, 60, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then vel = vel - Vector3.new(0, 60, 0) end
            root.AssemblyLinearVelocity = Vector3.new(vel.X, vel.Y, vel.Z)
        end
    end)
end

function SlenderHub.TeleportToPrompt()
    local prompt = nil
    local names = SlenderHub.Config.PromptNames
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("ProximityPrompt") or d:IsA("ClickDetector") then
            for _, n in ipairs(names) do
                if d.Name:lower():find(n:lower()) or (d.Parent and d.Parent.Name:lower():find(n:lower())) then
                    prompt = d
                    break
                end
            end
        end
        if prompt then break end
    end
    if not prompt then
        Notify("SlenderHub", "Nenhum prompt encontrado", 2, "Warning")
        return
    end
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if root and prompt.Parent then
        local target = prompt.Parent:IsA("BasePart") and prompt.Parent.Position or (prompt.Parent.PrimaryPart and prompt.Parent.PrimaryPart.Position)
        if target then
            root.CFrame = CFrame.new(target + Vector3.new(0, 4, 0))
            Notify("SlenderHub", "Teleportado para: " .. prompt.Parent.Name, 2, "Success")
        end
    end
end

function SlenderHub.InteractWithPrompt()
    local fp = Fn("FirePrompt")
    local fc = Fn("FireClick")
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("ProximityPrompt") and fp then
            pcall(fp, d)
            return
        elseif d:IsA("ClickDetector") and fc then
            pcall(fc, d)
            return
        end
    end
    Notify("SlenderHub", "Executor não expõe fire de prompts", 2, "Error")
end

----------------------------------------------------------------------------
-- AUTO CHECK-IN / REJECT (heurística + botão do shutter via prompt)
----------------------------------------------------------------------------
SlenderHub.AutoCheckIn = { Enabled = false }

function SlenderHub.SetAutoCheckIn(enabled)
    SlenderHub.AutoCheckIn.Enabled = enabled
    if not enabled then return end
    task.spawn(function()
        while SlenderHub.AutoCheckIn.Enabled and task.wait(0.6) do
            pcall(function()
                -- tenta interagir com o shutter/prompt mais próximo
                SlenderHub.InteractWithPrompt()
            end)
        end
    end)
end

----------------------------------------------------------------------------
-- ANTI JUMPSCARE (esconde telas de susto que o jogo cria no PlayerGui)
----------------------------------------------------------------------------
SlenderHub.AntiJumpscare = { Enabled = false, Done = {} }

function SlenderHub.SetAntiJumpscare(enabled)
    SlenderHub.AntiJumpscare.Enabled = enabled
    if not enabled then return end
    task.spawn(function()
        while SlenderHub.AntiJumpscare.Enabled and task.wait(0.3) do
            pcall(function()
                local pg = LocalPlayer:FindFirstChild("PlayerGui")
                if not pg then return end
                for _, gui in ipairs(pg:GetChildren()) do
                    if gui:IsA("ScreenGui") and gui:IsA("ScreenGui") then
                        local n = gui.Name:lower()
                        if n:find("jump") or n:find("scare") or n:find("horror") or n:find("effect") then
                            if not SlenderHub.AntiJumpscare.Done[gui] then
                                SlenderHub.AntiJumpscare.Done[gui] = true
                                gui.Enabled = false
                            end
                        end
                    end
                end
            end)
        end
    end)
end

----------------------------------------------------------------------------
-- UI SLENDERWIND (embutida, enxuta — padrão visual do hub)
----------------------------------------------------------------------------
SlenderHub.UI = {}

local function CreateUI()
    local theme = {
        MainBg   = Color3.fromRGB(18, 18, 22),
        Sidebar  = Color3.fromRGB(23, 23, 27),
        Element  = Color3.fromRGB(30, 30, 36),
        Text     = Color3.fromRGB(240, 240, 240),
        SubText  = Color3.fromRGB(160, 160, 160),
        Accent   = Color3.fromRGB(60, 130, 250),
        Stroke   = Color3.fromRGB(45, 45, 50),
        Success  = Color3.fromRGB(60, 250, 100),
        Warning  = Color3.fromRGB(250, 180, 60),
        Error    = Color3.fromRGB(255, 85, 85),
    }

    local parent = CoreGui
    if parent:FindFirstChild("SlenderHub") then parent.SlenderHub:Destroy() end

    local sg = Instance.new("ScreenGui")
    sg.Name = "SlenderHub"
    sg.ResetOnSpawn = false
    sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    sg.Parent = parent

    local main = Instance.new("Frame")
    main.BackgroundColor3 = theme.MainBg
    main.Size = UDim2.new(0, 420, 0, 520)
    main.Position = UDim2.new(0.5, -210, 0.5, -260)
    main.Parent = sg
    local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0, 10); corner.Parent = main
    local stroke = Instance.new("UIStroke"); stroke.Color = theme.Stroke; stroke.Parent = main

    -- topbar
    local topbar = Instance.new("Frame")
    topbar.BackgroundTransparency = 1
    topbar.Size = UDim2.new(1, 0, 0, 36)
    topbar.Parent = main

    local title = Instance.new("TextLabel")
    title.Text = "SlenderHub | Animal Hospital"
    title.TextColor3 = theme.Text
    title.Font = Enum.Font.GothamBold
    title.TextSize = 15
    title.BackgroundTransparency = 1
    title.Position = UDim2.new(0, 14, 0, 0)
    title.Size = UDim2.new(1, -60, 1, 0)
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = topbar

    -- drag
    local dragging, dragInput, startPos
    topbar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; startPos = input.Position; dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - startPos
            main.Position = UDim2.new(main.Position.X.Scale, main.Position.X.Offset + delta.X, main.Position.Y.Scale, main.Position.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input == dragInput then dragging = false end
    end)

    -- toggle
    local openBtn = Instance.new("TextButton")
    openBtn.Text = "SH"
    openBtn.TextColor3 = theme.Accent
    openBtn.BackgroundColor3 = theme.Sidebar
    openBtn.Size = UDim2.new(0, 44, 0, 44)
    openBtn.Position = UDim2.new(0, 20, 0.5, 0)
    openBtn.Font = Enum.Font.GothamBlack
    openBtn.TextSize = 16
    openBtn.Visible = false
    openBtn.Parent = sg
    local oc = Instance.new("UICorner"); oc.CornerRadius = UDim.new(0, 12); oc.Parent = openBtn
    local toggle = function()
        main.Visible = not main.Visible
        openBtn.Visible = not main.Visible
    end
    openBtn.MouseButton1Click:Connect(toggle)

    -- content
    local content = Instance.new("ScrollingFrame")
    content.BackgroundTransparency = 1
    content.Position = UDim2.new(0, 12, 0, 44)
    content.Size = UDim2.new(1, -24, 1, -56)
    content.ScrollBarThickness = 3
    content.ScrollBarImageColor3 = theme.Accent
    content.CanvasSize = UDim2.new(0, 0, 0, 0)
    content.AutomaticCanvasSize = Enum.AutomaticSize.Y
    content.Parent = main

    local list = Instance.new("UIListLayout")
    list.Padding = UDim.new(0, 8)
    list.SortOrder = Enum.SortOrder.LayoutOrder
    list.Parent = content

    local notifyContainer = Instance.new("Frame")
    notifyContainer.BackgroundTransparency = 1
    notifyContainer.Position = UDim2.new(1, -310, 1, -20)
    notifyContainer.Size = UDim2.new(0, 290, 1, 0)
    notifyContainer.AnchorPoint = Vector2.new(0, 1)
    notifyContainer.Parent = sg
    local nlist = Instance.new("UIListLayout")
    nlist.Padding = UDim.new(0, 6)
    nlist.VerticalAlignment = Enum.VerticalAlignment.Bottom
    nlist.Parent = notifyContainer

    SlenderHub.UI.Notify = function(titleText, body, dur, type)
        local typeColor = theme.Accent
        if type == "Success" then typeColor = theme.Success
        elseif type == "Warning" then typeColor = theme.Warning
        elseif type == "Error" then typeColor = theme.Error end

        local frame = Instance.new("Frame")
        frame.BackgroundColor3 = theme.Sidebar
        frame.Size = UDim2.new(1, 0, 0, 56)
        frame.Parent = notifyContainer
        local fcorner = Instance.new("UICorner"); fcorner.CornerRadius = UDim.new(0, 8); fcorner.Parent = frame
        local fstroke = Instance.new("UIStroke"); fstroke.Color = typeColor; fstroke.Parent = frame

        local t1 = Instance.new("TextLabel")
        t1.Text = titleText; t1.TextColor3 = typeColor; t1.Font = Enum.Font.GothamBold; t1.TextSize = 14
        t1.BackgroundTransparency = 1; t1.Position = UDim2.new(0, 10, 0, 6); t1.Size = UDim2.new(1, -20, 0, 20)
        t1.TextXAlignment = Enum.TextXAlignment.Left; t1.Parent = frame
        local t2 = Instance.new("TextLabel")
        t2.Text = body or ""; t2.TextColor3 = theme.Text; t2.Font = Enum.Font.Gotham; t2.TextSize = 12
        t2.BackgroundTransparency = 1; t2.Position = UDim2.new(0, 10, 0, 26); t2.Size = UDim2.new(1, -20, 0, 22)
        t2.TextXAlignment = Enum.TextXAlignment.Left; t2.TextWrapped = true; t2.Parent = frame

        task.delay(dur or 3, function()
            frame:Destroy()
        end)
    end

    local function Section(text)
        local s = Instance.new("TextLabel")
        s.Text = text; s.TextColor3 = theme.SubText; s.Font = Enum.Font.GothamBold; s.TextSize = 11
        s.BackgroundTransparency = 1; s.Size = UDim2.new(1, 0, 0, 22); s.TextXAlignment = Enum.TextXAlignment.Left
        s.Parent = content
    end

    local function Row(text, desc)
        local frame = Instance.new("Frame")
        frame.BackgroundColor3 = theme.Element
        frame.Size = UDim2.new(1, 0, 0, 40)
        frame.Parent = content
        local rcorner = Instance.new("UICorner"); rcorner.CornerRadius = UDim.new(0, 6); rcorner.Parent = frame
        local rstroke = Instance.new("UIStroke"); rstroke.Color = theme.Stroke; rstroke.Parent = frame
        local l = Instance.new("TextLabel")
        l.Text = text; l.TextColor3 = theme.Text; l.Font = Enum.Font.GothamMedium; l.TextSize = 13
        l.BackgroundTransparency = 1; l.Position = UDim2.new(0, 12, 0, 0); l.Size = UDim2.new(1, -50, 1, 0)
        l.TextXAlignment = Enum.TextXAlignment.Left; l.Parent = frame
        if desc then
            local d = Instance.new("TextLabel")
            d.Text = desc; d.TextColor3 = theme.SubText; d.Font = Enum.Font.Gotham; d.TextSize = 10
            d.BackgroundTransparency = 1; d.Position = UDim2.new(0, 12, 0, 18); d.Size = UDim2.new(1, -50, 0, 20)
            d.TextXAlignment = Enum.TextXAlignment.Left; d.Parent = frame
        end
        return frame, l
    end

    local function Button(text, callback)
        local btn = Instance.new("TextButton")
        btn.Text = text; btn.TextColor3 = theme.Text; btn.Font = Enum.Font.GothamBold; btn.TextSize = 13
        btn.BackgroundColor3 = theme.Accent; btn.Size = UDim2.new(1, 0, 0, 36)
        btn.Parent = content
        local bcorner = Instance.new("UICorner"); bcorner.CornerRadius = UDim.new(0, 6); bcorner.Parent = btn
        btn.MouseButton1Click:Connect(function()
            pcall(callback)
        end)
    end

    local function Toggle(text, default, callback)
        local frame, label = Row(text)
        local sw = Instance.new("Frame")
        sw.BackgroundColor3 = default and theme.Accent or Color3.fromRGB(50, 50, 55)
        sw.Size = UDim2.new(0, 36, 0, 20); sw.Position = UDim2.new(1, -46, 0.5, -10)
        sw.Parent = frame
        local sc = Instance.new("UICorner"); sc.CornerRadius = UDim.new(1, 0); sc.Parent = sw
        local knob = Instance.new("Frame")
        knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        knob.Size = UDim2.new(0, 16, 0, 16); knob.Position = UDim2.new(0, default and 18 or 2, 0.5, -8)
        knob.Parent = sw
        local kc = Instance.new("UICorner"); kc.CornerRadius = UDim.new(1, 0); kc.Parent = knob

        local enabled = default
        local function update(val)
            enabled = val
            Tween(sw, { BackgroundColor3 = enabled and theme.Accent or Color3.fromRGB(50, 50, 55) }, 0.15)
            Tween(knob, { Position = UDim2.new(0, enabled and 18 or 2, 0.5, -8) }, 0.15)
            pcall(callback, enabled)
        end
        frame.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                update(not enabled)
            end
        end)
        return {
            Set = update,
        }
    end

    return {
        Section = Section,
        Button = Button,
        Toggle = Toggle,
    }
end

----------------------------------------------------------------------------
-- BOOT
----------------------------------------------------------------------------
local function Boot()
    CreateUI()

    -- Key flow
    local tier = nil
    local function StartFeatures(freeTier)
        tier = freeTier
        Notify("SlenderHub", "Acesso liberado (tier: " .. (tier or "trial") .. ")", 3, "Success")

        local ui = SlenderHub.UI

        ui.Section("ESP")
        ui.Toggle("ESP de Pacientes/Anomalias", false, function(v)
            SlenderHub.SetESP(v)
        end)

        ui.Section("Sanidade")
        ui.Toggle("Sanidade Infinita", false, function(v)
            SlenderHub.SetInfSanity(v)
        end)
        ui.Toggle("Anti-Jumpscare", false, function(v)
            SlenderHub.SetAntiJumpscare(v)
        end)

        ui.Section("Automação")
        ui.Toggle("Auto Check-In", false, function(v)
            SlenderHub.SetAutoCheckIn(v)
        end)
        ui.Button("Interagir com prompt", function()
            SlenderHub.InteractWithPrompt()
        end)
        ui.Button("Teleportar p/ prompt", function()
            SlenderHub.TeleportToPrompt()
        end)

        ui.Section("Movimento")
        ui.Toggle("Noclip", false, function(v)
            SlenderHub.SetNoclip(v)
        end)
        ui.Toggle("Fly (Space/Shift)", false, function(v)
            SlenderHub.SetFly(v)
        end)

        ui.Section("Sistema")
        ui.Button("Fechar Hub", function()
            local pg = CoreGui:FindFirstChild("SlenderHub")
            if pg then pg:Destroy() end
        end)
    end

    -- Modo trial (sem key) ou com key
    if SlenderHub.Config.AllowTrial then
        StartFeatures("trial")
    else
        -- aqui entra a tela de key quando AllowedTrial = false
        StartFeatures("premium")
    end
end

local ok, err = pcall(Boot)
if not ok then
    warn("[SlenderHub] Erro no boot: " .. tostring(err))
end

return SlenderHub
