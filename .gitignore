Tabs.Train:AddToggle("AutoTrainToggle", {
    Title = "Auto Train",
    Default = false,
    Callback = function(state)
        Flags.AutoTrain = state
        if state and not AutoTrainRunning then
            AutoTrainRunning = true
            task.spawn(function()
                while Flags.AutoTrain do
                    local trainRE = Knit and Knit:FindFirstChild("Services"):FindFirstChild("TrainService"):FindFirstChild("RE"):FindFirstChild("RunTrain")
                    if trainRE then
                        pcall(function()
                            trainRE:FireServer("Treadmill_" .. Flags.TrainWorld .. "_" .. Flags.TrainMachine)
                        end)
                    end
                    task.wait(1)
                end
                AutoTrainRunning = false
            end)
        end
    end
})

-- AUTO STAR COLLECTOR (dump: TrainService/RE/HitStar + GetStar — é o que dá força de verdade)
Tabs.Train:AddToggle("AutoStar", {
    Title = "Auto Star Collector",
    Default = false,
    Callback = function(state)
        Flags.AutoStar = state
        task.spawn(function()
            while Flags.AutoStar do
                local hitStar = GetKnitRemote("TrainService", "RE", "HitStar")
                local getStar = GetKnitRemote("TrainService", "RE", "GetStar")
                if hitStar then
                    -- procura estrelas geradas no Workspace (nome típico "Star"/"StarPart")
                    local stars = Workspace:FindFirstChild("Stars") or Workspace:FindFirstChild("StarParts")
                    if stars then
                        for _, star in ipairs(stars:GetChildren()) do
                            pcall(function()
                                if star:IsA("BasePart") then
                                    hitStar:FireServer(star.Position)
                                    task.wait(0.05)
                                end
                            end)
                        end
                    end
                    -- fallback: tenta fire direto com posição da raiz
                    if not stars then
                        local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if root then
                            pcall(function() hitStar:FireServer(root.Position) end)
                        end
                    end
                end
                if getStar then
                    pcall(function() getStar:FireServer() end)
                end
                task.wait(0.4)
            end
        end)
    end
})

