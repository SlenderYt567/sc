            local ok = FireGiveGamePass(gp.id)
            Fluent:Notify({
                Title = "Gamepass",
                Content = ("%s: %s"):format(gp.name, ok and "fired" or "remote não encontrado"),
                Duration = 3
            })
        end
    })
end

