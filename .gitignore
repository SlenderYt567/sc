local function getGameId()
    local ok, id = pcall(function() return game.PlaceId end)
    if ok then return id end
    local ok2, id2 = pcall(function() return game.GameId end)
    if ok2 then return id2 end
    return 0
end

if getGameId() ~= CONFIG.GameId then
    warn("[SlenderHub] Jogo nÃ£o Ã© Pet Simulator 99! (esperado id " .. CONFIG.GameId .. ", atual " .. getGameId() .. ")")
    -- Continua mesmo assim: a detecÃ§Ã£o de remotes Ã© dinÃ¢mica, pode funcionar em jogos similares.
end

-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
-- 4. MÃ“DULO DE REMOTES (detecÃ§Ã£o dinÃ¢mica + wrappers seguros)
-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

local Remotes = {}

-- Busca um objeto por caminho relativo ao ReplicatedStorage
local function findRemote(path)
    local current = ReplicatedStorage
    for _, name in ipairs(path) do
        current = current:FindFirstChild(name)
        if not current then return nil end
    end
    return current
end

-- Busca recursiva limitada (fallback quando o caminho exato muda)
local function findByName(base, name, depth)
    depth = depth or 0
    if depth > 4 then return nil end
    local direct = base:FindFirstChild(name)
    if direct then return direct end
    for _, child in ipairs(base:GetChildren()) do
        local found = findByName(child, name, depth + 1)
        if found then return found end
    end
    return nil
end

-- Inicializa os remotes conhecidos do PS99
local function initRemotes()
    for _, path in ipairs(CONFIG.RemotePaths) do
        local remote = findRemote(path)
        if not remote then
            remote = findByName(ReplicatedStorage, path[#path])
        end
        if remote then
            Remotes[path[#path]] = remote
        end
    end
end

-- Wrappers seguros
local function fireMain(...)
    if not Remotes.MainEvent then return false end
    local ok, err = pcall(function() Remotes.MainEvent:FireServer(...) end)
    if not ok then
        warn("[SlenderHub] MainEvent falhou: " .. tostring(err))
        return false
    end
    return true
end

local function invokeMain(...)
    if not Remotes.MainEvent then return false end
    local ok, err = pcall(function() Remotes.MainEvent:InvokeServer(...) end)
    if not ok then
        warn("[SlenderHub] MainEvent invoke falhou: " .. tostring(err))
        return false
    end
    return true
end

local function invokeUpdate(...)
    if not Remotes.UpdateInventory then return false end
    local ok, err = pcall(function() Remotes.UpdateInventory:InvokeServer(...) end)
    if not ok then return false end
    return true
end

-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
-- 5. SCAN DO MUNDO (quebrÃ¡veis, moedas, zonas, ovos)
-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

local World = {}

local function getMap()
    return workspace:FindFirstChild("Map") or workspace
end

function World.getBreakables()
    local map = getMap()
    local folder = map:FindFirstChild("Breakables") or workspace:FindFirstChild("Breakables")
    if not folder then return {} end
    local list = {}
    for _, b in ipairs(folder:GetChildren()) do
        if b:IsA("BasePart") and b.Parent then
            list[#list + 1] = b
        end
    end
    return list
end

function World.getCoinFolders()
    local map = getMap()
    local folders = {}
    for _, name in ipairs({ "Coins", "Orbs", "Diamonds", "Gems", "Lootbags" }) do
        local folder = map:FindFirstChild(name) or workspace:FindFirstChild(name)
        if folder then folders[#folders + 1] = folder end
    end
    return folders
end

function World.getZones()
    local map = getMap()
    local zonesFolder = map:FindFirstChild("Zones") or map:FindFirstChild("Areas") or workspace:FindFirstChild("Zones")
    if not zonesFolder then return {} end
    local list = {}
    for _, z in ipairs(zonesFolder:GetChildren()) do
        if z:IsA("Folder") or z:IsA("Model") then
            list[#list + 1] = z
        end
    end
    return list
end

function World.getEggs()
    local map = getMap()
    local eggsFolder = map:FindFirstChild("Eggs") or workspace:FindFirstChild("Eggs")
    if not eggsFolder then return {} end
    local list = {}
    for _, e in ipairs(eggsFolder:GetChildren()) do
        if e:IsA("Model") and e.Parent then
            list[#list + 1] = e
        end
    end
    return list
end

-- Melhor zona = a que tem mais quebrÃ¡veis ativos (heurÃ­stica de progressÃ£o)
function World.getBestZone()
    local zones = World.getZones()
    local best, bestCount = nil, -1
    for _, zone in ipairs(zones) do
        local count = 0
        local breakables = zone:FindFirstChild("Breakables")
        if breakables then count = #breakables:GetChildren() end
        if count > bestCount then
            best, bestCount = zone, count
        end
    end
    return best
end

function World.teleportTo(zoneName)
    -- MÃ©todo 1: MainEvent "Teleport" (padrÃ£o PS99)
    if fireMain("Teleport", zoneName) then return true end
    -- MÃ©todo 2: TeleportEvent
    if Remotes.TeleportEvent then
        local ok = pcall(function() Remotes.TeleportEvent:FireServer(zoneName) end)
        if ok then return true end
    end
    -- MÃ©todo 3: MainEvent "CheckpointTeleport"
    if fireMain("CheckpointTeleport", zoneName) then return true end
    return false
end
-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
-- 6. SISTEMA DE FEATURES
-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

local Features = {
    AutoFarm = false,
    AutoTPBestArea = false,
    AutoTap = false,
    AutoCollect = false,
    AutoRebirth = false,
    AutoHatch = false,
    AutoBuyEgg = false,
    AutoQuest = false,
    AutoClaimRank = false,
    AutoClaimGifts = false,
    AutoUsePotions = false,
    AutoUseFruits = false,
    AutoOpenGifts = false,
    OptimizePets = false,
    OptimizeConfetti = false,
    OptimizeBreakFX = false,
    FiestaAutoBreak = false,
    FiestaAutoBoss = false,
    FiestaAutoChest = false,
}

local Stats = {
    Broken = 0,
    Coins = 0,
    Hatched = 0,
    LastZone = "â€”",
    FarmState = "off",
}

local SelectedEgg = "Auto (melhor ovo)"

-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• helpers â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

local function getCharacter()
    local char = LocalPlayer.Character
    if not char then
        local ok = pcall(function() return LocalPlayer.CharacterAdded:Wait(2) end)
        if ok then char = LocalPlayer.Character end
    end
    return char
end

local function getHRP()
    local char = getCharacter()
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildOfClass("Humanoid")
end

local function breakTarget(target)
    if not target or not target.Parent then return false end
    local cd = target:FindFirstChildOfClass("ClickDetector")
    if cd then
        pcall(function() fireclickdetector(cd, 1) end)
        Stats.Broken = Stats.Broken + 1
        return true
    end
    -- Fallback via CollectionUpdater/Breakables (mÃ©todo de remote do PS99)
    local cu = Remotes.CollectionUpdater or Remotes.Breakables
    if cu then
        local ok = pcall(function() cu:InvokeServer("Break", target.Position) end)
        if ok then
            Stats.Broken = Stats.Broken + 1
            return true
        end
    end
    return false
end

local function collectCoins()
    local folders = World.getCoinFolders()
    local collected = 0
    for _, folder in ipairs(folders) do
        for _, coin in ipairs(folder:GetChildren()) do
            if coin:IsA("BasePart") and coin.Parent then
                local cd = coin:FindFirstChildOfClass("ClickDetector")
                if cd then
                    pcall(function() fireclickdetector(cd, 1) end)
                    collected = collected + 1
                end
            end
        end
    end
    Stats.Coins = Stats.Coins + collected
    return collected > 0
end

-- QuebrÃ¡vel mais prÃ³ximo do player (dentro do raio)
local function nearestBreakable(radius)
    local hrp = getHRP()
    if not hrp then return nil end
    local root = hrp:IsA("BasePart") and hrp or hrp.Parent and hrp.Parent:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local best, bestDist = nil, radius
    for _, b in ipairs(World.getBreakables()) do
        local dist = (b.Position - root.Position).Magnitude
        if dist < bestDist then
            best, bestDist = b, dist
        end
    end
    return best
end

local function hatchEgg(eggName)
    if eggName == "Auto (melhor ovo)" then
        -- Escolhe o primeiro ovo hatchÃ¡vel (com ClickDetector)
        for _, egg in ipairs(World.getEggs()) do
            local cd = egg:FindFirstChildOfClass("ClickDetector")
            if cd then
                pcall(function() fireclickdetector(cd, 1) end)
                Stats.Hatched = Stats.Hatched + 1
                return true
            end
        end
    else
        for _, egg in ipairs(World.getEggs()) do
            if egg.Name == eggName then
                local cd = egg:FindFirstChildOfClass("ClickDetector")
                if cd then
                    pcall(function() fireclickdetector(cd, 1) end)
                    Stats.Hatched = Stats.Hatched + 1
                    return true
                end
            end
        end
    end
    -- Fallback via remote (best effort â€” nome muda com updates)
    return fireMain("Hatch", eggName)
end

local function rebirth()
    return fireMain("Rebirth")
end

local function claimRankRewards()
    -- Best effort: tenta mÃºltiplos formatos conhecidos (pcall protege de honeypot)
    fireMain("NewClaim", "RankRewards")
    fireMain("ClaimReward", "Rank")
    if Remotes.ClaimRewards then
        pcall(function() Remotes.ClaimRewards:InvokeServer("Rank") end)
    end
end

local function claimFreeGifts()
    fireMain("NewClaim", "FreeGift")
    fireMain("ClaimDailyRewards")
end

local function usePotions()
    -- Best effort: equipa poÃ§Ã£o de dano/luck via UpdateInventory
    invokeUpdate("EquipPotion", "Damage")
    invokeUpdate("EquipPotion", "Luck")
end

local function useFruits()
    invokeUpdate("UseFruit", "Strength")
end

local function openGifts()
    fireMain("OpenGift")
end

-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• loops de execuÃ§Ã£o â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

-- Loop principal de farm (rÃ¡pido)
taskSpawn(function()
    local lastTP = 0
    while true do
        if Features.AutoFarm then
            local target = nearestBreakable(FarmRadius)
            if target then
                breakTarget(target)
                Stats.FarmState = "quebrando"
            else
                Stats.FarmState = "sem alvo"
                if Features.AutoTPBestArea then
                    local now = os.clock()
                    if now - lastTP > CONFIG.TeleportCooldown then
                        lastTP = now
                        local best = World.getBestZone()
                        if best then
                            World.teleportTo(best.Name)
                            Stats.LastZone = best.Name
                        end
                    end
                end
            end
        end
        if Features.AutoTap then
            local target = nearestBreakable(15)
            if target then breakTarget(target) end
        end
        taskWait(CONFIG.FarmInterval)
    end
end)

-- Loop de coletas automÃ¡ticas (mÃ©dio)
taskSpawn(function()
    while true do
        if Features.AutoCollect then
            collectCoins()
        end
        if Features.AutoRebirth then
            rebirth()
        end
        if Features.AutoHatch then
            hatchEgg(SelectedEgg)
        end
        if Features.AutoBuyEgg then
            fireMain("BuyEgg", SelectedEgg)
        end
        taskWait(CONFIG.CollectInterval)
    end
end)

-- Loop de quests/claims (lento)
taskSpawn(function()
    while true do
        if Features.AutoQuest then
            -- Rank quest progress (best effort)
            fireMain("QuestProgress")
        end
        if Features.AutoClaimRank then
            claimRankRewards()
        end
        if Features.AutoClaimGifts then
            claimFreeGifts()
        end
        if Features.AutoUsePotions then
            usePotions()
        end
        if Features.AutoUseFruits then
            useFruits()
        end
        if Features.AutoOpenGifts then
            openGifts()
        end
        taskWait(CONFIG.QuestInterval)
    end
end)

-- Loop de otimizaÃ§Ã£o (manutenÃ§Ã£o)
taskSpawn(function()
    while true do
        -- Pets invisÃ­veis (client-side)
        if Features.OptimizePets then
            local pets = workspace:FindFirstChild("Pets")
            if pets then
                for _, pet in ipairs(pets:GetChildren()) do
                    for _, part in ipairs(pet:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.LocalTransparencyModifier = 1
                        end
                    end
                end
            end
        end
        -- Confetti invisÃ­vel
        if Features.OptimizeConfetti then
            local confetti = workspace:FindFirstChild("Confetti")
            if confetti then
                for _, part in ipairs(confetti:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.LocalTransparencyModifier = 1
                    end
                end
            end
        end
        -- Remove visual de quebrÃ¡veis (FX)
        if Features.OptimizeBreakFX then
            for _, b in ipairs(World.getBreakables()) do
                for _, part in ipairs(b:GetDescendants()) do
                    if part:IsA("BasePart") and (part.Name:find("FX") or part.Name:find("Effect") or part.Name:find("Glow")) then
                        part.LocalTransparencyModifier = 1
                    end
                end
            end
        end
        taskWait(5)
    end
end)

-- ============ MODULO FIESTA MAZE (evento Pinata Fiesta - Update 88, 08/2026) ============
-- Fontes: dump Dex - ReplicatedStorage.Library.Client.FiestaMazeCmds,
--         Library.Client.FiestaMazePortals, Library.Util.FiestaMaze(+Geometry),
--         Library.Client.Network (Invoke "GX_Redeem"), Network.AutoRaid_Disable

local Fiesta = {}

-- require seguro com cache (modulos do jogo sao tabelas)
local fiestaModuleCache = {}
local function fiestaRequire(path)
    if fiestaModuleCache[path] ~= nil then
        return fiestaModuleCache[path]
    end
    local ok, mod = pcall(require, path)
    if ok and type(mod) == "table" then
        fiestaModuleCache[path] = mod
        return mod
    end
    fiestaModuleCache[path] = false
    return nil
end

local function fiestaLib()
    local lib = ReplicatedStorage:FindFirstChild("Library")
    if lib then return lib end
    return nil
end

-- FiestaMazeCmds: estado + progresso do maze
function Fiesta.getCmds()
    local lib = fiestaLib()
    if not lib then return nil end
    local client = lib:FindFirstChild("Client")
    if not client then return nil end
    local mod = client:FindFirstChild("FiestaMazeCmds")
    if not mod then return nil end
    return fiestaRequire(mod)
end

-- Progresso: (cleared, total) celulas do caminho
function Fiesta.progress()
    local cmds = Fiesta.getCmds()
    if not cmds or type(cmds.Progress) ~= "function" then return 0, 0 end
    local ok, cleared, total = pcall(cmds.Progress, cmds)
    if ok and type(cleared) == "number" then
        return cleared, type(total) == "number" and total or 0
    end
    return 0, 0
end

-- Estado atual do maze (tabela interna: .rooms, .built, .cleared, .origin, .cursed)
function Fiesta.getState()
    local cmds = Fiesta.getCmds()
    if not cmds or type(cmds.Get) ~= "function" then return nil end
    local ok, state = pcall(cmds.Get, cmds)
    if ok and type(state) == "table" then return state end
    return nil
end

-- Curso? (flag do FFlags: PinataFiesta_Maze)
function Fiesta.isCursed()
    local cmds = Fiesta.getCmds()
    if not cmds then return false end
    if type(cmds.IsCursed) == "function" then
        local ok, v = pcall(cmds.IsCursed, cmds)
        if ok then return v == true end
    end
    return false
end

-- FiestaMazePortals: teleporte para a Prize Room
function Fiesta.getPortals()
    local lib = fiestaLib()
    if not lib then return nil end
    local client = lib:FindFirstChild("Client")
    if not client then return nil end
    local mod = client:FindFirstChild("FiestaMazePortals")
    if not mod then return nil end
    return fiestaRequire(mod)
end

function Fiesta.sendToPrizeRoom()
    local portals = Fiesta.getPortals()
    if not portals or type(portals.SendToPrizeRoom) ~= "function" then return false end
    local ok = pcall(portals.SendToPrizeRoom, portals)
    return ok == true
end

function Fiesta.prizeRoomArrival()
    local portals = Fiesta.getPortals()
    if not portals or type(portals.PrizeRoomArrival) ~= "function" then return nil end
    local ok, cf = pcall(portals.PrizeRoomArrival, portals)
    if ok and typeof(cf) == "CFrame" then return cf end
    return nil
end

-- Contagem de Fiesta Boss Key via Library.Items (padrao do jogo)
function Fiesta.bossKeys()
    local lib = fiestaLib()
    if not lib then return 0 end
    local dir = lib:FindFirstChild("Directory")
    local items = lib:FindFirstChild("Items")
    if not (dir and items) then return 0 end
    local dirMod = fiestaRequire(dir)
    local itemsMod = fiestaRequire(items)
    if not (dirMod and itemsMod) then return 0 end
    local miscItems = dirMod.MiscItems
    if not miscItems then return 0 end
    local def = miscItems["Fiesta Boss Key"]
    if not def then return 0 end
    local ok, count = pcall(function()
        return itemsMod.Misc(def):CountAny()
    end)
    if ok and type(count) == "number" then
        return math.floor(count)
    end
    return 0
end

-- Abre a boss room: Network.Invoke("GX_Redeem") (dump Dex: FiestaMazeCmds.raiseGate)
-- Fallback: invoca o RemoteFunction direto caso o Network module nao exista
function Fiesta.redeemBoss()
    local lib = fiestaLib()
    if lib then
        local client = lib:FindFirstChild("Client")
        if client then
            local netMod = client:FindFirstChild("Network")
            if netMod then
                local net = fiestaRequire(netMod)
                if net and type(net.Invoke) == "function" then
                    local ok = pcall(net.Invoke, net, "GX_Redeem")
                    if ok then return true end
                end
            end
        end
    end
    if Remotes.GX_Redeem then
        local ok = pcall(function() Remotes.GX_Redeem:InvokeServer() end)
        if ok then return true end
    end
    return false
end

-- Desativa o AutoRaid (remote descoberto no dump: Network.AutoRaid_Disable)
function Fiesta.disableAutoRaid()
    if Remotes.AutoRaid_Disable then
        local ok = pcall(function() Remotes.AutoRaid_Disable:FireServer() end)
        if ok then return true end
    end
    local remote = findByName(ReplicatedStorage, "AutoRaid_Disable")
    if remote then
        local ok = pcall(function() remote:FireServer() end)
        if ok then return true end
    end
    return false
end

-- Salas do maze replicadas no workspace (estrutura do Geometry: __THINGS.Instances.FiestaMaze.Models.Rooms)
function Fiesta.getRooms()
    local things = workspace:FindFirstChild("__THINGS")
    if not things then return nil end
    local inst = things:FindFirstChild("Instances")
    if not inst then return nil end
    local maze = inst:FindFirstChild("FiestaMaze")
    if not maze then return nil end
    local models = maze:FindFirstChild("Models")
    if not models then return nil end
    return models:FindFirstChild("Rooms")
end

-- Quebraveis do maze (pinatas) - qualquer BasePart com ClickDetector dentro das salas
function Fiesta.getMazeBreakables()
    local rooms = Fiesta.getRooms()
    if not rooms then return {} end
    local list = {}
    for _, room in ipairs(rooms:GetChildren()) do
        if room:IsA("Model") then
            for _, part in ipairs(room:GetDescendants()) do
                if part:IsA("BasePart") and part.Parent then
                    local cd = part:FindFirstChildOfClass("ClickDetector")
                    if cd then
                        list[#list + 1] = part
                    end
                end
            end
        end
    end
    return list
end

-- Caminho ideal: salas "RoomN" (onPath) em ordem - para ESP/navegacao
function Fiesta.getPathRooms()
    local rooms = Fiesta.getRooms()
    if not rooms then return {} end
    local list = {}
    for _, room in ipairs(rooms:GetChildren()) do
        if room:IsA("Model") and room:GetAttribute("OnPath") then
            list[#list + 1] = room
        end
    end
    table.sort(list, function(a, b)
        return (a:GetAttribute("RoomNumber") or 0) < (b:GetAttribute("RoomNumber") or 0)
    end)
    return list
end

-- ============ LOOPS FIESTA MAZE ============

-- Auto Pinata (quebra quebraveis do maze)
taskSpawn(function()
    while true do
        if Features.FiestaAutoBreak then
            local hrp = getHRP()
            if hrp then
                local root = hrp:IsA("BasePart") and hrp or (hrp.Parent and hrp.Parent:FindFirstChild("HumanoidRootPart"))
                if root then
                    for _, part in ipairs(Fiesta.getMazeBreakables()) do
                        local cd = part:FindFirstChildOfClass("ClickDetector")
                        if cd then
                            pcall(function() fireclickdetector(cd, 1) end)
                            Stats.Broken = Stats.Broken + 1
                        end
                    end
                end
            end
        end
        taskWait(CONFIG.FarmInterval)
    end
end)

-- Auto Boss (redeem GX_Redeem quando tiver chave suficiente)
taskSpawn(function()
    local lastRedeem = 0
    while true do
        if Features.FiestaAutoBoss then
            local keys = Fiesta.bossKeys()
            if keys >= 1 then
                local now = os.clock()
                if now - lastRedeem > 5 then -- cooldown anti-spam
                    lastRedeem = now
                    Fiesta.redeemBoss()
                end
            end
        end
        taskWait(CONFIG.QuestInterval)
    end
end)

-- Auto Chest (coleta baus do maze via ClickDetector)
taskSpawn(function()
    while true do
        if Features.FiestaAutoChest then
            local rooms = Fiesta.getRooms()
            if rooms then
                for _, room in ipairs(rooms:GetChildren()) do
                    if room:IsA("Model") then
                        for _, part in ipairs(room:GetDescendants()) do
                            if part:IsA("BasePart") and part.Parent and (part.Name:lower():find("chest") or part.Name:lower():find("ba")) then
                                local cd = part:FindFirstChildOfClass("ClickDetector")
                                if cd then
                                    pcall(function() fireclickdetector(cd, 1) end)
                                end
                            end
                        end
                    end
                end
            end
        end
        taskWait(CONFIG.CollectInterval)
    end
end)
