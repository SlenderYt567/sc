-- Abas
local TabsBar = Mk("Frame", { Parent = Window, BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 58), Size = UDim2.fromOffset(150, 390) })

local TabDefs = {
    { Name = "Main",     Icon = "👤" },
    { Name = "Sanidade", Icon = "❤️" },
    { Name = "Auto",     Icon = "⚡" },
    { Name = "Visual",   Icon = "👁" },
    { Name = "Movimento", Icon = "🎮" },
    { Name = "Settings", Icon = "⚙️" },
}

local TabsContent = Mk("Frame", { Parent = Window, BackgroundColor3 = ThemeUI.Panel, Position = UDim2.fromOffset(170, 58), Size = UDim2.new(1, -182, 1, -70) })
Corner(TabsContent, 10)
Stroke(TabsContent, ThemeUI.Line, 1)

local TabButtons = {}
local TabPages = {}
local CurrentTab = 1

local function ShowTab(idx)
    CurrentTab = idx
    for i, btn in ipairs(TabButtons) do
        local active = (i == idx)
        TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = active and ThemeUI.Accent2 or ThemeUI.Card }):Play()
        local lbl = btn:FindFirstChild("Label")
        if lbl then lbl.TextColor3 = active and Color3.fromRGB(255,255,255) or ThemeUI.Sub end
    end
    for i, page in ipairs(TabPages) do page.Visible = (i == idx) end
end

for i, def in ipairs(TabDefs) do
    local btn = Mk("TextButton", {
        Parent = TabsBar, BackgroundColor3 = ThemeUI.Card, Text = "",
        Position = UDim2.fromOffset(0, (i-1) * 62), Size = UDim2.fromOffset(150, 54),
        ZIndex = 2,
    })
    Corner(btn, 8)
    Stroke(btn, ThemeUI.Line, 1)
    Mk("TextLabel", {
        Parent = btn, Name = "Icon", BackgroundTransparency = 1, Font = Enum.Font.Gotham,
        Text = def.Icon, TextColor3 = ThemeUI.Text, TextSize = 18,
        Position = UDim2.fromOffset(10, 4), Size = UDim2.fromOffset(30, 30),
    })
    Mk("TextLabel", {
        Parent = btn, Name = "Label", BackgroundTransparency = 1, Font = Enum.Font.GothamBold,
        Text = def.Name, TextColor3 = ThemeUI.Sub, TextSize = 15,
        Position = UDim2.fromOffset(44, 0), Size = UDim2.fromOffset(100, 54),
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    btn.MouseButton1Click:Connect(function() ShowTab(i) end)
    TabButtons[i] = btn

    local page = Mk("ScrollingFrame", {
        Parent = TabsContent, BackgroundTransparency = 1, Visible = false,
        Position = UDim2.fromOffset(10, 10), Size = UDim2.new(1, -20, 1, -20),
        CanvasSize = UDim2.new(0, 0, 2, 0), ScrollBarThickness = 4,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
    })
    TabPages[i] = page
end

-- Layout Helpers
local PageCursor = {}
local function NextY(page, h)
    local y = PageCursor[page] or 0
    PageCursor[page] = y + h
    return y
end

local function Section(page, title)
    local y = NextY(page, 34)
    Mk("TextLabel", {
        Parent = page, BackgroundTransparency = 1, Font = Enum.Font.GothamBold,
        Text = title, TextColor3 = ThemeUI.Accent, TextSize = 14,
        Position = UDim2.fromOffset(6, y), Size = UDim2.fromOffset(320, 24),
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    local line = Mk("Frame", { Parent = page, BackgroundColor3 = ThemeUI.Line, Position = UDim2.fromOffset(6, y + 26), Size = UDim2.new(1, -12, 0, 1) })
    return line
end

local function Spacer(page, h)
    NextY(page, h or 8)
end

local function Toggle(page, title, desc, default, cb)
    local y = NextY(page, 58)
    local card = Mk("Frame", { Parent = page, BackgroundColor3 = ThemeUI.Card, Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, 52) })
    Corner(card, 8)
    Stroke(card, ThemeUI.Line, 1)
    Mk("TextLabel", {
        Parent = card, BackgroundTransparency = 1, Font = Enum.Font.Gotham,
        Text = title, TextColor3 = ThemeUI.Text, TextSize = 14,
        Position = UDim2.fromOffset(12, 5), Size = UDim2.fromOffset(300, 20), TextXAlignment = Enum.TextXAlignment.Left,
    })
    if desc and #desc > 0 then
        Mk("TextLabel", {
            Parent = card, BackgroundTransparency = 1, Font = Enum.Font.Gotham,
            Text = desc, TextColor3 = ThemeUI.Sub, TextSize = 11,
            Position = UDim2.fromOffset(12, 25), Size = UDim2.fromOffset(300, 18), TextXAlignment = Enum.TextXAlignment.Left,
        })
    end
    local knob = Mk("Frame", {
        Parent = card, Name = "Knob", BackgroundColor3 = default and ThemeUI.Accent or ThemeUI.Line,
        Position = UDim2.new(1, -42, 0, 11), Size = UDim2.fromOffset(30, 30),
    })
    Corner(knob, 15)
    local dot = Mk("Frame", { Parent = knob, Name = "Dot", BackgroundColor3 = Color3.fromRGB(255,255,255), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.fromOffset(12, 12) })
    Corner(dot, 6)
    local state = default or false
    local function refresh()
        TweenService:Create(knob, TweenInfo.new(0.15), { BackgroundColor3 = state and ThemeUI.Accent or ThemeUI.Line }):Play()
        dot.Visible = state
    end
    refresh()
    local btn = Mk("TextButton", { Parent = card, BackgroundTransparency = 1, Text = "", Size = UDim2.new(1, 0, 1, 0) })
    btn.MouseButton1Click:Connect(function()
        state = not state
        refresh()
        pcall(cb, state)
    end)
    return {
        Set = function(v) state = v; refresh(); pcall(cb, v) end,
        Get = function() return state end,
    }
end

local function Button(page, title, cb)
    local y = NextY(page, 46)
    local btn = Mk("TextButton", {
        Parent = page, BackgroundColor3 = ThemeUI.Accent2, Text = title,
        Font = Enum.Font.GothamBold, TextColor3 = Color3.fromRGB(255,255,255), TextSize = 14,
        Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, 40),
    })
    Corner(btn, 8)
    Stroke(btn, ThemeUI.Line, 1)
    btn.MouseButton1Click:Connect(function() pcall(cb) end)
    return btn
end

local function Slider(page, title, min, max, def, cb)
    local y = NextY(page, 70)
    local card = Mk("Frame", { Parent = page, BackgroundColor3 = ThemeUI.Card, Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, 64) })
    Corner(card, 8)
    Stroke(card, ThemeUI.Line, 1)
    Mk("TextLabel", {
        Parent = card, BackgroundTransparency = 1, Font = Enum.Font.Gotham,
        Text = title, TextColor3 = ThemeUI.Text, TextSize = 14,
        Position = UDim2.fromOffset(12, 5), Size = UDim2.fromOffset(240, 20), TextXAlignment = Enum.TextXAlignment.Left,
    })
    local valLbl = Mk("TextLabel", {
        Parent = card, BackgroundTransparency = 1, Font = Enum.Font.GothamBold,
        Text = tostring(def), TextColor3 = ThemeUI.Accent, TextSize = 14,
        Position = UDim2.new(1, -60, 0, 5), Size = UDim2.fromOffset(50, 20), TextXAlignment = Enum.TextXAlignment.Right,
    })
    local bar = Mk("Frame", { Parent = card, BackgroundColor3 = ThemeUI.Line, Position = UDim2.fromOffset(12, 34), Size = UDim2.new(1, -24, 0, 6) })
    Corner(bar, 3)
    local fill = Mk("Frame", { Parent = bar, Name = "Fill", BackgroundColor3 = ThemeUI.Accent, Size = UDim2.new((def-min)/(max-min), 0, 1, 0) })
    Corner(fill, 3)
    local value = def
    local function setFrom(input)
        local localX = math.clamp(input.Position.X - bar.AbsolutePosition.X, 0, bar.AbsoluteSize.X)
        value = min + (max - min) * (localX / math.max(bar.AbsoluteSize.X, 1))
        value = math.floor(value * 10 + 0.5) / 10
        fill.Size = UDim2.new((value-min)/(max-min), 0, 1, 0)
        valLbl.Text = tostring(value)
        pcall(cb, value)
    end
    local dragBtn = Mk("TextButton", { Parent = bar, BackgroundTransparency = 1, Text = "", Size = UDim2.new(1, 0, 1, 0) })
    dragBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            setFrom(input)
        end
    end)
    dragBtn.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            setFrom(input)
        end
    end)
    return {
        Set = function(v) value = v; fill.Size = UDim2.new((value-min)/(max-min), 0, 1, 0); valLbl.Text = tostring(v); pcall(cb, v) end,
        Get = function() return value end,
    }
end

