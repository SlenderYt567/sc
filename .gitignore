end

-- Layout helper: empilha componentes verticalmente
local function layout(container)
    local y = 0
    for _, child in ipairs(container:GetChildren()) do
        if child:IsA("Frame") and not child:GetAttribute("NoLayout") then
            child.Position = UDim2.new(0, 0, 0, y)
            y = y + child.Size.Y.Offset + 12
        end
    end
    container.CanvasSize = UDim2.new(0, 0, 0, y)
end
