-- CODES TAB (códigos públicos do jogo — CodesService/RF/RedeemItem)
-- =====================================

-- Auto Redeem todos os códigos
Tabs.Codes:AddToggle("AutoRedeemCodes", {
    Title = "Auto Redeem ALL Codes",
    Default = false,
    Callback = function(v)
        Flags.AutoRedeemCodes = v
        task.spawn(function()
            while Flags.AutoRedeemCodes do
                for _, code in ipairs(GameCodes) do
                    local res = RedeemCode(code)
                    task.wait(1)
                end
                task.wait(60) -- códigos têm cooldown/limite de uso
            end
        end)
    end
})

-- Botão: tentar todos os códigos uma vez
Tabs.Codes:AddButton({
    Title = "Try ALL Codes (uma vez)",
    Callback = function()
        local okCount = 0
        local results = {}
        for _, code in ipairs(GameCodes) do
            local res = RedeemCode(code)
            if res ~= "no-remote" and res ~= "falhou" then
                okCount = okCount + 1
                table.insert(results, ("%s: %s"):format(code, res))
            end
            task.wait(1)
        end
        Fluent:Notify({
            Title = "Codes",
            Content = ("%d códigos responderam"):format(okCount),
            Duration = 4
        })
        for _, r in ipairs(results) do
            Fluent:Notify({ Title = "Code OK", Content = r, Duration = 3 })
        end
    end
})

-- Botões individuais de código
for _, code in ipairs(GameCodes) do
    Tabs.Codes:AddButton({
        Title = "Redeem " .. code,
        Callback = function()
            local res = RedeemCode(code)
            Fluent:Notify({
                Title = "Code " .. code,
                Content = res,
                Duration = 3
            })
        end
    })
end

