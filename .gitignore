--[[
    SlenderHub | Diagnóstico de Ambiente
    Rode DENTRO do jogo (The Animal Hospital) antes do hub.
    Escreve o resultado em slenderhub_diag.txt (pasta do executor Wave)
    e também printa no console. Envie o conteúdo de volta.
]]

local log = {}

local function add(msg)
    table.insert(log, tostring(msg))
    print("[DIAG] " .. tostring(msg))
end

local function findFirst(container, name, className)
    if not container then return nil end
    local f = container:FindFirstChild(name)
    if f and (not className or f:IsA(className)) then return f end
    return nil
end

add("=== SlenderHub Diagnostico ===")
add("Data: " .. tostring(os.date("%Y-%m-%d %H:%M:%S")))
add("PlaceId: " .. tostring(game.PlaceId))
add("GameId: " .. tostring(game.GameId))
add("Place: " .. tostring(game.Name))

-- Executor
add("--- Executor ---")
local execName = "unknown"
pcall(function()
    if identifyexecutor then execName = identifyexecutor()
    elseif getexecutorname then execName = getexecutorname()
    elseif get_identify then execName = get_identify() end
end)
add("Executor: " .. tostring(execName))
add("getgenv: " .. tostring(getgenv ~= nil))
add("loadstring: " .. tostring(loadstring ~= nil))
add("writefile: " .. tostring(writefile ~= nil))
add("getrawmetatable: " .. tostring(getrawmetatable ~= nil))
add("fireproximityprompt: " .. tostring(fireproximityprompt ~= nil))
add("task: " .. tostring(task ~= nil))
add("task.time: " .. tostring(task ~= nil and task.time ~= nil))

-- Jogador
add("--- Jogador ---")
add("LocalPlayer: " .. tostring(game:GetService("Players").LocalPlayer))
add("Character: " .. tostring(game:GetService("Players").LocalPlayer and game:GetService("Players").LocalPlayer.Character))

-- Fluent (mesma URL do Horse Race)
add("--- Fluent ---")
local fluentOk, fluentRes = pcall(function()
    local src = game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua")
    return #src, src
end)
if fluentOk then
    add("HttpGet Fluent: OK (" .. tostring(fluentRes) .. " bytes)")
    local lsOk, lsRes = pcall(loadstring, fluentRes)
    if lsOk and lsRes then
        local runOk, runRes = pcall(lsRes)
        if runOk then
            add("loadstring+exec Fluent: OK (" .. type(runRes) .. ")")
        else
            add("loadstring+exec Fluent: FAIL ao executar: " .. tostring(runRes))
        end
    else
        add("loadstring Fluent: FAIL: " .. tostring(lsRes))
    end
else
    add("HttpGet Fluent: FAIL: " .. tostring(fluentRes))
end

-- Lib do jogo
add("--- Lib do jogo ---")
local libInst = game.ReplicatedStorage:FindFirstChild("Lib")
add("ReplicatedStorage/Lib existe: " .. tostring(libInst ~= nil))
if libInst then
    add("Lib class: " .. libInst.ClassName)
    local reqOk, lib = pcall(require, libInst)
    add("require Lib: " .. (reqOk and "OK (" .. type(lib) .. ")" or "FAIL: " .. tostring(lib)))
    if reqOk and lib then
        add("lib.Network: " .. tostring(lib.Network ~= nil))
        add("lib.Network.FireServer: " .. tostring(lib.Network and lib.Network.FireServer ~= nil))
        add("lib.PlayerLostSanity: " .. tostring(lib.PlayerLostSanity ~= nil))
        add("lib.Inject: " .. tostring(lib.Inject ~= nil))
        add("lib.HeartMinigameComplete: " .. tostring(lib.HeartMinigameComplete ~= nil))
        add("lib.DS: " .. tostring(lib.DS ~= nil))
        add("lib.dHandler: " .. tostring(lib.dHandler ~= nil))
        add("lib.data: " .. tostring(lib.data ~= nil))
        add("lib.data.Stats: " .. tostring(lib.data and lib.data.Stats ~= nil))
    end
end

-- Remotes do jogo
add("--- Remotes ---")
local util = game.ReplicatedStorage:FindFirstChild("Util")
local net = util and util:FindFirstChild("Net")
local re = net and net:FindFirstChild("RE")
local rf = net and net:FindFirstChild("RF")
add("Util/Net: " .. tostring(net ~= nil))
add("RE/RequestRemoteEvent: " .. tostring(re and re:FindFirstChild("RequestRemoteEvent") ~= nil))
add("RE/RequestRemoteFunction: " .. tostring(re and re:FindFirstChild("RequestRemoteFunction") ~= nil))
add("RF/RequestData: " .. tostring(rf and rf:FindFirstChild("RequestData") ~= nil))
add("RE/PlayerLostSanity: " .. tostring(re and re:FindFirstChild("PlayerLostSanity") ~= nil))
add("RE/Touch: " .. tostring(re and re:FindFirstChild("Touch") ~= nil))
add("RE/HeartbeatMinigameComplete: " .. tostring(re and re:FindFirstChild("HeartbeatMinigameComplete") ~= nil))
add("HONEYPOT RE/ScannerKillGhost: " .. tostring(re and re:FindFirstChild("ScannerKillGhost") ~= nil))
add("HONEYPOT RE/DialogDecision: " .. tostring(re and re:FindFirstChild("DialogDecision") ~= nil))

-- Teste rápido de sintaxe do próprio hub (se existir)
add("--- Hub file test ---")
pcall(function()
    if isfile and isfile("SlenderHub_AnimalHospital.lua") then
        local hubSrc = readfile("SlenderHub_AnimalHospital.lua")
        add("Hub file: OK (" .. #hubSrc .. " bytes) - file no executor")
        local hOk, hRes = pcall(loadstring, hubSrc)
        add("loadstring hub: " .. (hOk and hRes and "OK" or "FAIL: " .. tostring(hRes)))
    else
        add("Hub file: nao encontrado no executor (sem isfile/readfile)")
    end
end)

local content = table.concat(log, "\n")
pcall(function()
    if writefile then
        writefile("slenderhub_diag.txt", content)
        add("Log salvo em slenderhub_diag.txt")
    end
end)

warn("\n" .. content .. "\n")
