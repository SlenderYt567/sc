-- ============================================================
-- [4.5.1] 3RD PERSON: destrava a câmera (o jogo força 1ª pessoa)
-- Correção dump: Client.lua seta CameraMaxZoomDistance=20; o ZoomController
-- lê CameraMin/MaxZoomDistance do LocalPlayer → aumentar o max destrava o zoom
-- ============================================================
local ThirdPersonOn = false

local function SetThirdPerson(enabled)
    ThirdPersonOn = enabled
    if not enabled then
        pcall(function()
            LocalPlayer.CameraMaxZoomDistance = 20
            LocalPlayer.CameraMinZoomDistance = 0.5
            game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, true)
        end)
        SafeNotify("3ª Pessoa", "Desativado", 2)
        return
    end
    pcall(function()
        LocalPlayer.CameraMaxZoomDistance = 500
        LocalPlayer.CameraMinZoomDistance = 0.5
    end)
    task.spawn(function()
        while ThirdPersonOn and task.wait(0.3) do
            pcall(function()
                local cam = workspace.CurrentCamera
                local char = LocalPlayer.Character
                if cam and char then
                    cam.CameraType = Enum.CameraType.Custom
                    cam.CameraSubject = char:FindFirstChild("Humanoid")
                    cam.FieldOfView = 90
                end
                local UIS = game:GetService("UserInputService")
                if UIS.MouseBehavior == Enum.MouseBehavior.LockCenter then
                    UIS.MouseBehavior = Enum.MouseBehavior.Default
                end
            end)
        end
    end)
end

-- ============================================================
-- HOOK CENTRAL FirePrompt (upgrade 4.5.1)
-- Um único hook encadeia DetectAnomaly + AntiStuck sem conflito
-- ============================================================
do
    local BaseFirePrompt = FirePrompt
    FirePrompt = function(prompt, ...)
        -- Detect Anomaly Check-In (aborta check-in se for anomalia)
        if DetectAnomalyOn and prompt and IsCheckInPrompt(prompt) then
            local model = prompt.Parent
            local up = model
            while up and not up:IsA("Model") do up = up.Parent end
            local target = up or model
            local danger = IsAnomalyModel(target)
            if not danger and target then
                for _, child in ipairs(target:GetChildren()) do
                    if IsAnomalyModel(child) then danger = true break end
                end
            end
            if not danger then
                local pos = PromptPos(prompt)
                if pos then
                    for _, tag in ipairs({ "Anomaly", "GhostAnomaly", "Skinwalker", "StalkerMonster", "TallMonsterSpawn", "Shadow", "DontLookUp", "Fake" }) do
                        for _, inst in ipairs(CollectionService:GetTagged(tag)) do
                            local ipos = inst:IsA("BasePart") and inst.Position
                                or (inst.PrimaryPart and inst.PrimaryPart.Position) or nil
                            if ipos and (pos - ipos).Magnitude < 10 then danger = true break end
                        end
                        if danger then break end
                    end
                end
            end
            if danger then
                SafeNotify("Anti-Anomaly", "Check-in ABORTADO (paciente é anomalia!)", 5)
                task.wait(3)
                return
            end
        end
        -- Anti-Stuck (pula prompt preso após N tentativas)
        if AntiStuckOn and prompt then
            PromptTries[prompt] = (PromptTries[prompt] or 0) + 1
            if PromptTries[prompt] >= StuckLimit then
                SafeNotify("Anti-Stuck", "Pulo prompt preso: " .. tostring(prompt.Name), 3)
                PromptTries[prompt] = 0
                task.wait(2)
                return
            end
        end
        return BaseFirePrompt(prompt, ...)
    end
end

