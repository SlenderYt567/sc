-- 2. AMBIENTE / FALLBACKS DE EXECUTOR
-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer

-- Fallback de task (executores Lua 5.1 puros não têm task)
local taskWait = (task and task.wait) or function(t) wait(t or 0.1) end
local taskSpawn = (task and task.spawn) or function(fn, ...) coroutine.resume(coroutine.create(fn), ...) end

-- Fallback de math.clamp (não existe em Lua 5.1 puro)
local clamp = math.clamp or function(x, a, b)
    if x < a then return a end
    if x > b then return b end
    return x
end

-- Raio de farm padrão (ajustável no slider)
local FarmRadius = 80

-- IdentificaÃ§Ã£o do executor (best effort)
local function getExecutorName()
    for _, fn in ipairs({ identifyexecutor, getexecutorname, getexecutor }) do
        if type(fn) == "function" then
            local ok, res = pcall(fn)
            if ok and type(res) == "string" and #res > 0 then return res end
        end
    end
    return "Executor"
end

local EXECUTOR = getExecutorName()

-- ProteÃ§Ã£o de UI (esconde de anti-cheats de UI)
local function protectUI(gui)
    if get_hidden_gui and type(get_hidden_gui) == "function" then
        pcall(function() gui.Parent = get_hidden_gui() end)
    elseif gethui and type(gethui) == "function" then
        pcall(function() gui.Parent = gethui() end)
    elseif syn and syn.protect_gui then
        pcall(function() syn.protect_gui(gui) end)
        pcall(function() gui.Parent = CoreGui end)
    else
        pcall(function() gui.Parent = LocalPlayer:WaitForChild("PlayerGui") end)
    end
end

-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
-- 3. VERIFICAÃ‡ÃƒO DE JOGO
