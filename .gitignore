--!strict
--[[
    PS99 Dex Dump Webhook - Universal Remote + Hierarchy Scanner (Discord) v1.1
    Versao: 2.1 | Alvo: Pet Simulator 99 (qualquer jogo Roblox)
    Plataforma: Executor Mobile (Delta/Hydrogen/Arceus X/Fluxus Mobile)

    O que faz:
      [1] Varre o DataModel inteiro atras de remotes
      [2] Agrupa TODOS os remotes por NOME (com paths completos)
      [3] Monta dump estilo DEX por nome (arvore de classes)
      [4] ENVIA TUDO para o seu webhook do Discord (arquivo anexo)
      [5] Copia para o clipboard tambem (fallback manual)
      [6] UI touch-friendly para mobile (botoes grandes)

    CONFIGURACAO:
      AUTO_SEND = true  -> envia sozinho apos o scan (recomendado)
      WEBHOOK_URL       -> sua URL do Discord (abaixo)

    FIXES v2.1 (mesma correcao do Mobile v1.1):
      - GetDescendants() nativo (nao trava mais)
      - xpcall no scan + pcall por instancia (nao congela mais em
        "Scan em andamento..." - bug de instancia destruida)
      - progresso em tempo real + dump parcial mesmo em erro/timeout
]]

--//==============================[ CONFIG ]==============================//--
local WEBHOOK_URL = "https://discord.com/api/webhooks/1398723880369131631/7knZsAymoHblk9BcsXYuI7XT2-8PNHkZJfFbtyLHssHqjW_pXeBQVznZ0lDHz7G9ObRI"
local WEBHOOK_NAME = "PS99 DexDump"
local AUTO_SEND = true   -- mude para false se quiser enviar so pelo botao

--//==============================[ 1. API COMPAT (multi-executor) ]==============================//--
local getExecutorName = (function()
    local fn = identifyexecutor or identify_executor
    if fn then
        local ok, name = pcall(fn)
        if ok and type(name) == "string" then return name end
    end
    return "unknown"
end)()

local copy = (function()
    if setclipboard then return setclipboard end
    if toclipboard then return toclipboard end
    if set_clipboard then return set_clipboard end
    return function() end
end)()

local saveFile = (function()
    if not writefile then return nil end
    local ok = pcall(function() makefolder("PS99Dump") end)
    return function(name, content)
        pcall(writefile, "PS99Dump/" .. name, content)
    end
end)()

local reqFn = (function()
    if syn and syn.request then return syn.request end
    if request then return request end
    if http and http.request then return http.request end
    return nil
end)()

-- Log com buffer: guarda tudo para aparecer na UI mesmo se o console do
-- executor mobile suprimir print (caso Delta). print() sempre e tentado.
local logBuffer = {}
local function logMsg(msg)
    msg = tostring(msg)
    table.insert(logBuffer, msg)
    if #logBuffer > 200 then table.remove(logBuffer, 1) end
    local okPrint = pcall(print, "[PS99Dump] " .. msg)
    return okPrint
end

-- Leitura segura de ambiente: nunca deixa o script morrer em acesso ao game.
local function safeGame()
    local ok, g = pcall(function() return game end)
    return ok and g or nil
end

local function safeGetService(serviceName)
    local g = safeGame()
    if not g then return nil end
    local ok, svc = pcall(function() return g:GetService(serviceName) end)
    return ok and svc or nil
end

local function safeLocalPlayer()
    local players = safeGetService("Players")
    if not players then return nil end
    local ok, plr = pcall(function() return players.LocalPlayer end)
    return ok and plr or nil
end

--//==============================[ 2. WEBHOOK DISCORD ]==============================//--
local function jsonString(s)
    s = tostring(s)
    s = s:gsub("\\", "\\\\"):gsub("\"", "\\\""):gsub("\n", "\\n"):gsub("\r", "\\r"):gsub("\t", "\\t")
    s = s:gsub("[%z\1-\31]", function(c) return string.format("\\u%04x", c:byte()) end)
    return "\"" .. s .. "\""
end

local function sendSimple(content, username)
    if not reqFn then return -1 end
    local body = '{"content":' .. jsonString(content) .. ',"username":' .. jsonString(username or WEBHOOK_NAME) .. '}'
    local ok, res = pcall(function()
        return reqFn({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = body,
        })
    end)
    if ok and res then return tonumber(res.StatusCode) or 0 else return -1 end
end

local function sendChunked(text, label)
    local okCount = 0
    local remaining = tostring(text)
    local first = true
    while #remaining > 0 do
        local part = remaining:sub(1, 1800)
        local header = first and ("**" .. label .. "**\n") or ""
        local code = sendSimple(header .. "```\n" .. part .. "\n```")
        if code >= 200 and code < 300 then okCount = okCount + 1 end
        remaining = remaining:sub(1801)
        first = false
        task.wait(0.35)
    end
    return okCount
end

local function sendFile(filename, content, msg)
    if not reqFn then return -1 end
    local boundary = "----PS99Dump" .. tostring(os.clock()):gsub("%.", "") .. "7xK"
    local body = ""
    if msg and #tostring(msg) > 0 then
        body = body .. "--" .. boundary .. "\r\nContent-Disposition: form-data; name=\"content\"\r\n\r\n" .. tostring(msg) .. "\r\n"
    end
    body = body .. "--" .. boundary
        .. "\r\nContent-Disposition: form-data; name=\"file1\"; filename=\"" .. filename .. "\""
        .. "\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n"
        .. tostring(content)
        .. "\r\n--" .. boundary .. "--\r\n"
    local ok, res = pcall(function()
        return reqFn({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = { ["Content-Type"] = "multipart/form-data; boundary=" .. boundary },
            Body = body,
        })
    end)
    if ok and res then return tonumber(res.StatusCode) or 0 else return -1 end
end

local function sendAll(remotesText, dexText, susText, stamp)
    if not reqFn then return "request nao suportado neste executor" end

    local player = game:GetService("Players").LocalPlayer
    local msgHeader = "Dump PS99 - " .. stamp
        .. "\nGameId: " .. tostring(game.GameId)
        .. "\nPlaceId: " .. tostring(game.PlaceId)
        .. "\nPlayer: " .. tostring(player and player.Name or "?")
        .. "\nExecutor: " .. getExecutorName

    local c1 = sendFile("remotes_" .. stamp .. ".txt", remotesText, msgHeader .. "\n\n[remotes por nome]")
    if c1 >= 200 and c1 < 300 then
        local c2 = sendFile("dex_" .. stamp .. ".txt", dexText, msgHeader .. "\n\n[dex style por nome]")
        local c3 = sendSimple("**Suspeitos (possiveis honeypots):**\n```\n" .. susText .. "\n```")
        return "Enviado! (remotes=" .. tostring(c1) .. " dex=" .. tostring(c2 or -1) .. " sus=" .. tostring(c3 or -1) .. ")"
    end

    local ok1 = sendChunked(remotesText, "REMOTES POR NOME")
    local ok2 = sendChunked(dexText, "DEX STYLE")
    sendSimple("**Suspeitos:**\n```\n" .. susText .. "\n```")
    return "Enviado via chunks (remotes=" .. tostring(ok1) .. " dex=" .. tostring(ok2) .. ")"
end

-- Envia aviso de ERRO para o Discord (com stack trace e info do jogo)
local function notifyError(msg, trace)
    if not reqFn then
        logMsg("request nao suportado - erro apenas na tela: " .. tostring(msg))
        return "request nao suportado - erro apenas na tela: " .. tostring(msg)
    end
    local player = safeLocalPlayer()
    local g = safeGame()
    local gid = "?"
    local pid = "?"
    if g then
        local ok1, v1 = pcall(function() return g.GameId end)
        local ok2, v2 = pcall(function() return g.PlaceId end)
        if ok1 then gid = tostring(v1) end
        if ok2 then pid = tostring(v2) end
    end
    local info = "**ERRO no PS99 DexDump**\n```\n"
        .. tostring(msg):sub(1, 800)
        .. "\n```\n**Stack:**\n```\n"
        .. tostring(trace or "n/a"):sub(1, 900)
        .. "\n```\nGameId: " .. gid
        .. "\nPlaceId: " .. pid
        .. "\nPlayer: " .. tostring(player and player.Name or "?")
        .. "\nExecutor: " .. getExecutorName
    local code = sendSimple(info, WEBHOOK_NAME .. " [ERRO]")
    if code >= 200 and code < 300 then
        logMsg("Erro enviado pro Discord! (" .. tostring(code) .. ")")
        return "Erro enviado pro Discord! (" .. tostring(code) .. ")"
    end
    logMsg("Falha ao enviar erro (codigo " .. tostring(code) .. ") - erro na tela: " .. tostring(msg))
    return "Falha ao enviar erro (codigo " .. tostring(code) .. ") - erro na tela: " .. tostring(msg)
end

--//==============================[ 3. ESTADO DO SCAN ]==============================//--
local RemoteClasses = {
    ["RemoteEvent"] = true,
    ["RemoteFunction"] = true,
    ["UnreliableRemoteEvent"] = true,
}

local remotes = {}
local totalInstances = 0
local processed = 0
local scanAborted = false
local scanError = nil
local scanStart = os.clock()
local SCAN_TIMEOUT = 25
local scanWarnings = {}

local function addWarning(msg)
    table.insert(scanWarnings, msg)
    print("[PS99Dump] WARN: " .. msg)
end

local function remoteNameCount()
    local n = 0
    for _ in pairs(remotes) do n = n + 1 end
    return n
end

local function sanitize(name)
    return tostring(name):gsub("[\r\n]", " ")
end

local function getPath(inst)
    local parts = {}
    local cur = inst
    local guard = 0
    while cur and guard < 60 do
        table.insert(parts, 1, sanitize(cur.Name))
        cur = cur.Parent
        guard = guard + 1
    end
    return table.concat(parts, ".")
end

local function registerRemote(inst)
    local name = tostring(inst.Name or "?")
    local entry = remotes[name]
    if not entry then
        entry = { paths = {}, classes = {} }
        remotes[name] = entry
    end
    table.insert(entry.paths, getPath(inst))
    -- CAUSA RAIZ DO ERRO: alguns executores (Delta) devolvem ClassName nil
    -- para certas instancias. Antes isso gravava classes[nil] = ... e o pcall
    -- engolia o erro, deixando a entry com classes={} vazia -> crash no format.
    local cls = tostring(inst.ClassName or "Unknown")
    entry.classes[cls] = (entry.classes[cls] or 0) + 1
end

local function processList(list, onProgress)
    local total = #list
    for i = 1, total do
        local inst = list[i]
        local okProc, errProc = pcall(function()
            if RemoteClasses[inst.ClassName] then
                registerRemote(inst)
            end
        end)
        if not okProc then
            addWarning("Falha ao processar instancia " .. tostring(i)
                .. " (" .. tostring(inst and inst.ClassName or "?") .. "): " .. tostring(errProc))
        end
        processed = processed + 1
        if processed % 2000 == 0 then
            if os.clock() - scanStart > SCAN_TIMEOUT then
                scanAborted = true
                return
            end
            onProgress(string.format("Escaneando... %d/%d | %d remotes",
                i, total, remoteNameCount()))
            task.wait()
        end
    end
end

local function runScan(onProgress)
    scanStart = os.clock()
    scanWarnings = {}

    local rs = {}
    local okRS = pcall(function()
        rs = game:GetService("ReplicatedStorage"):GetDescendants()
    end)
    if not okRS then
        addWarning("Falha ao ler ReplicatedStorage (pode estar bloqueado pelo executor)")
    end
    totalInstances = totalInstances + #rs
    processList(rs, onProgress)

    if not scanAborted then
        local ws = {}
        local okWS = pcall(function()
            ws = workspace:GetDescendants()
        end)
        if not okWS then
            addWarning("Falha ao ler Workspace (pode estar bloqueado pelo executor)")
        end
        totalInstances = totalInstances + #ws
        processList(ws, onProgress)
    end

    if not scanAborted then
        local gm = {}
        local okGM = pcall(function()
            gm = game:GetDescendants()
        end)
        if not okGM then
            addWarning("Falha ao ler DataModel (pode estar bloqueado pelo executor)")
        end
        totalInstances = totalInstances + #gm
        processList(gm, onProgress)
    end
end

--//==============================[ 4. FORMATADORES ]==============================//--
local function buildHeader()
    local lines = {}
    table.insert(lines, "== PS99 DEX DUMP ==")
    table.insert(lines, "GameId:   " .. tostring(game.GameId))
    table.insert(lines, "PlaceId:  " .. tostring(game.PlaceId))
    table.insert(lines, "JobId:    " .. tostring(game.JobId))
    local player = game:GetService("Players").LocalPlayer
    table.insert(lines, "Player:   " .. tostring(player and player.Name or "?"))
    table.insert(lines, "Executor: " .. getExecutorName)
    table.insert(lines, "Data:     " .. os.date("%Y-%m-%d %H:%M:%S"))
    table.insert(lines, "Scan:     " .. tostring(totalInstances) .. " instancias"
        .. (scanAborted and " (PARCIAL - timeout)" or "")
        .. (scanError and (" (ERRO: " .. tostring(scanError) .. ")") or ""))
    table.insert(lines, "Remotes:  " .. tostring(remoteNameCount()) .. " nomes unicos")
    if #scanWarnings > 0 then
        table.insert(lines, "Avisos:   " .. table.concat(scanWarnings, " | "))
    end
    return table.concat(lines, "\n")
end

local function formatRemotesByName()
    local lines = { buildHeader() }
    table.insert(lines, "")
    table.insert(lines, "== REMOTES SEPARADOS POR NOME ==")
    local names = {}
    for name in pairs(remotes) do table.insert(names, name) end
    table.sort(names)
    for _, name in ipairs(names) do
        local entry = remotes[name]
        if not entry or not entry.classes or next(entry.classes) == nil then
            addWarning("Entry corrompida para " .. tostring(name) .. " - pulada")
            remotes[name] = nil
            continue
        end
        local classSummary = {}
        for cls, qtd in pairs(entry.classes) do
            table.insert(classSummary, tostring(cls) .. "x" .. tostring(qtd))
        end
        table.sort(classSummary)
        table.insert(lines, "")
        table.insert(lines, string.format("[%s] %s (%d instancia(s)) [%s]",
            tostring(next(entry.classes) or "Unknown"),
            tostring(name),
            #entry.paths,
            table.concat(classSummary, ", ")))
        table.sort(entry.paths)
        for _, p in ipairs(entry.paths) do
            table.insert(lines, "    - " .. tostring(p))
        end
    end
    return table.concat(lines, "\n")
end

local function formatDexByName()
    local lines = { buildHeader() }
    table.insert(lines, "")
    table.insert(lines, "== DEX STYLE - ARVORE POR NOME ==")
    local all = {}
    for name, entry in pairs(remotes) do
        if not entry or not entry.classes or not entry.paths then
            continue
        end
        for _, p in ipairs(entry.paths) do
            for cls in pairs(entry.classes) do
                table.insert(all, { cls = tostring(cls), name = tostring(name), path = tostring(p) })
            end
        end
    end
    table.sort(all, function(a, b)
        if a.cls == b.cls then
            if a.name == b.name then return a.path < b.path end
            return a.name < b.name
        end
        return a.cls < b.cls
    end)
    local lastCls = ""
    for _, item in ipairs(all) do
        if item.cls ~= lastCls then
            lastCls = item.cls
            table.insert(lines, "")
            table.insert(lines, "-- " .. lastCls .. " --")
        end
        table.insert(lines, string.format("    %-28s %s", item.name, item.path))
    end
    return table.concat(lines, "\n")
end

local function formatSuspicious()
    local patterns = { "kick", "ban", "log", "anticheat", "anti_cheat", "punish", "report", "exploit", "cheat", "detect", "admin" }
    local lines = { "-- Nomes suspeitos (possiveis honeypots, requer validacao no servidor) --" }
    for name, entry in pairs(remotes) do
        if not entry then continue end
        local lower = tostring(name):lower()
        for _, pat in ipairs(patterns) do
            if lower:find(pat, 1, true) then
                table.insert(lines, "  [!!] " .. tostring(name) .. "  (" .. #entry.paths .. "x)")
                break
            end
        end
    end
    return table.concat(lines, "\n")
end

--//==============================[ 5. UI MOBILE ]==============================//--
local Players = safeGetService("Players")
local TweenService = safeGetService("TweenService")

local function makeUI()
    local gui = Instance.new("ScreenGui")
    gui.Name = "PS99DexDump"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 999
    gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

    local bg = Instance.new("Frame")
    bg.Name = "BG"
    bg.AnchorPoint = Vector2.new(0.5, 0.5)
    bg.Position = UDim2.new(0.5, 0, 0.5, 0)
    bg.Size = UDim2.new(0, 400, 0, 600)
    bg.BackgroundColor3 = Color3.fromRGB(15, 17, 25)
    bg.BackgroundTransparency = 0.05
    bg.BorderSizePixel = 0
    bg.Parent = gui
    pcall(function()
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 16)
        corner.Parent = bg
    end)
    pcall(function()
        local stroke = Instance.new("UIStroke")
        stroke.Thickness = 2
        stroke.Color = Color3.fromRGB(88, 101, 242)
        stroke.Transparency = 0.3
        stroke.Parent = bg
    end)

    local title = Instance.new("TextLabel")
    title.Name = "Title"
    title.BackgroundTransparency = 1
    title.Position = UDim2.new(0, 0, 0, 10)
    title.Size = UDim2.new(1, 0, 0, 40)
    title.Font = Enum.Font.GothamBold
    title.Text = "PS99 DEX DUMP (Webhook)"
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.TextSize = 22
    title.Parent = bg

    local status = Instance.new("TextLabel")
    status.Name = "Status"
    status.BackgroundTransparency = 1
    status.Position = UDim2.new(0, 0, 0, 50)
    status.Size = UDim2.new(1, 0, 0, 40)
    status.Font = Enum.Font.Gotham
    status.Text = "Iniciando..."
    status.TextColor3 = Color3.fromRGB(255, 200, 80)
    status.TextSize = 14
    status.TextWrapped = true
    status.Parent = bg

    local scroll = Instance.new("ScrollingFrame")
    scroll.Name = "Preview"
    scroll.BackgroundColor3 = Color3.fromRGB(22, 25, 36)
    scroll.Position = UDim2.new(0, 12, 0, 96)
    scroll.Size = UDim2.new(1, -24, 0, 220)
    scroll.BorderSizePixel = 0
    scroll.ScrollBarThickness = 6
    scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    scroll.Parent = bg
    pcall(function()
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 10)
        corner.Parent = scroll
    end)

    local preview = Instance.new("TextLabel")
    preview.Name = "Text"
    preview.BackgroundTransparency = 1
    preview.Size = UDim2.new(1, 0, 0, 0)
    preview.AutomaticSize = Enum.AutomaticSize.Y
    preview.Font = Enum.Font.Code
    preview.Text = "Aguardando scan..."
    preview.TextColor3 = Color3.fromRGB(200, 210, 230)
    preview.TextSize = 12
    preview.TextXAlignment = Enum.TextXAlignment.Left
    preview.TextYAlignment = Enum.TextYAlignment.Top
    preview.Parent = scroll

    local function makeButton(y, text, color, onClick)
        local btn = Instance.new("TextButton")
        btn.BackgroundColor3 = color
        btn.Position = UDim2.new(0, 12, 0, y)
        btn.Size = UDim2.new(1, -24, 0, 44)
        btn.Font = Enum.Font.GothamBold
        btn.Text = text
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.TextSize = 16
        btn.AutoButtonColor = true
        btn.Parent = bg
        pcall(function()
            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, 12)
            corner.Parent = btn
        end)
        btn.Activated:Connect(function()
            local tween = TweenService:Create(btn, TweenInfo.new(0.1), { Size = UDim2.new(1, -28, 0, 42) })
            tween:Play()
            task.delay(0.1, function()
                TweenService:Create(btn, TweenInfo.new(0.1), { Size = UDim2.new(1, -24, 0, 44) }):Play()
            end)
            pcall(onClick)
        end)
        return btn
    end

    local remotesText = ""
    local dexText = ""
    local susText = ""

    makeButton(326, "ENVIAR WEBHOOK", Color3.fromRGB(88, 101, 242), function()
        if #remotesText == 0 then
            status.Text = "Scan ainda nao terminou ou nao encontrou nada"
            return
        end
        status.Text = "Enviando para o Discord..."
        status.TextColor3 = Color3.fromRGB(255, 200, 80)
        task.spawn(function()
            local stamp = os.date("%Y%m%d_%H%M%S")
            local res = sendAll(remotesText, dexText, susText, stamp)
            status.Text = res
            status.TextColor3 = Color3.fromRGB(80, 230, 120)
        end)
    end)
    makeButton(378, "COPIAR REMOTES", Color3.fromRGB(70, 110, 255), function()
        if #remotesText == 0 then
            status.Text = "Scan ainda nao terminou ou nao encontrou nada"
            return
        end
        copy(remotesText)
        status.Text = "Remotes copiados! (" .. #remotesText .. " chars)"
    end)
    makeButton(430, "COPIAR DEX", Color3.fromRGB(50, 160, 110), function()
        if #dexText == 0 then
            status.Text = "Scan ainda nao terminou ou nao encontrou nada"
            return
        end
        copy(dexText)
        status.Text = "Dex copiado! (" .. #dexText .. " chars)"
    end)
    makeButton(482, "SALVAR ARQUIVO", Color3.fromRGB(200, 130, 40), function()
        if #remotesText == 0 then
            status.Text = "Scan ainda nao terminou ou nao encontrou nada"
            return
        end
        if saveFile then
            local stamp = os.date("%Y%m%d_%H%M%S")
            saveFile("remotes_" .. stamp .. ".txt", remotesText)
            saveFile("dex_" .. stamp .. ".txt", dexText)
            saveFile("suspects_" .. stamp .. ".txt", susText)
            status.Text = "Salvo em PS99Dump/ !"
        else
            status.Text = "writefile nao suportado neste executor"
        end
    end)

    local close = Instance.new("TextButton")
    close.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
    close.Position = UDim2.new(1, -64, 0, 12)
    close.Size = UDim2.new(0, 48, 0, 40)
    close.Font = Enum.Font.GothamBold
    close.Text = "X"
    close.TextColor3 = Color3.fromRGB(255, 255, 255)
    close.TextSize = 20
    close.Parent = bg
    pcall(function()
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 10)
        corner.Parent = close
    end)
    close.Activated:Connect(function()
        gui:Destroy()
    end)

    return {
        gui = gui,
        status = status,
        preview = preview,
        setTexts = function(r, d, s)
            remotesText = r
            dexText = d
            susText = s
        end,
        setStatus = function(text, color)
            status.Text = text
            if color then status.TextColor3 = color end
        end,
    }
end

--//==============================[ 6. MAIN (blindado em camadas) ]==============================//--
-- UI stub: se makeUI falhar, o scan continua rodando (headless) e o erro
-- ainda e reportado para o Discord. NUNCA deixa o script morrer antes do xpcall.
local ui = (function()
    local ok, u = pcall(makeUI)
    if ok and u then return u end
    local err = tostring(u)
    logMsg("Falha ao criar UI (" .. err .. ") - rodando em modo headless")
    return {
        gui = nil,
        status = { Text = "headless" },
        preview = { Text = "" },
        setTexts = function() end,
        setStatus = function(text, color)
            logMsg("[status] " .. tostring(text))
        end,
    }
end)()

-- Envia um ping de TESTE logo ao iniciar. Serve para confirmar que o webhook
-- funciona ANTES do scan - se o ping nao chegar, o problema e a URL/executor.
local function sendTestPing()
    if not reqFn then
        logMsg("WEBHOOK: request nao suportado - ping de teste SKIPPED")
        return
    end
    local player = safeLocalPlayer()
    local g = safeGame()
    local code = sendSimple(
        "**PS99 DexDump - TESTE**\nScript iniciado com sucesso.\n"
        .. "GameId: " .. tostring(g and g.GameId or "?")
        .. "\nPlayer: " .. tostring(player and player.Name or "?")
        .. "\nExecutor: " .. getExecutorName
        .. "\nTask: " .. tostring(task ~= nil),
        WEBHOOK_NAME .. " [TESTE]"
    )
    logMsg("Ping de teste: codigo " .. tostring(code))
end

-- Handler de erro raiz: tenta TUDO em pcall para nunca morrer mudo.
local function rootErrorHandler(err)
    scanError = tostring(err)
    logMsg("ERRO RAIZ: " .. scanError)
    local okUI, trace = pcall(debug.traceback, tostring(err), 2)
    if not okUI then trace = "sem traceback" end
    -- 1) tenta UI
    pcall(function()
        ui.setStatus("ERRO: " .. scanError, Color3.fromRGB(255, 80, 80))
    end)
    -- 2) tenta Discord (blindado)
    pcall(notifyError, err, trace)
    -- 3) tenta montar dump parcial
    pcall(function()
        local rt = formatRemotesByName()
        local dt = formatDexByName()
        ui.setTexts(rt, dt, formatSuspicious())
        ui.preview.Text = rt
    end)
    return nil
end

local function mainFlow()
    sendTestPing()
    ui.setStatus("Escaneando...", Color3.fromRGB(255, 200, 80))

    runScan(function(msg)
        ui.setStatus(msg)
    end)

    if scanAborted then
        ui.setStatus("Scan PARCIAL (timeout " .. SCAN_TIMEOUT .. "s) - gerando dump...",
            Color3.fromRGB(255, 120, 80))
    else
        ui.setStatus("Scan completo!", Color3.fromRGB(80, 230, 120))
    end

    local remotesText = formatRemotesByName()
    local dexText = formatDexByName()
    local susText = formatSuspicious()

    ui.setTexts(remotesText, dexText, susText)
    ui.preview.Text = remotesText

    if remoteNameCount() == 0 then
        ui.setStatus("Nenhum remote encontrado (0 nomes) - verifique se o jogo carregou",
            Color3.fromRGB(255, 120, 80))
        task.spawn(function()
            local player = safeLocalPlayer()
            local g = safeGame()
            local msg = "**PS99 DexDump - AVISO**\nNenhum remote encontrado.\n"
                .. "Instancias escaneadas: " .. tostring(totalInstances)
                .. "\nWarnings: " .. (#scanWarnings > 0 and table.concat(scanWarnings, " | ") or "nenhum")
                .. "\nGameId: " .. tostring(g and g.GameId or "?")
                .. "\nPlayer: " .. tostring(player and player.Name or "?")
                .. "\nExecutor: " .. getExecutorName
            local code = sendSimple(msg, WEBHOOK_NAME .. " [AVISO]")
            ui.setStatus("0 remotes. Aviso enviado pro Discord (" .. tostring(code) .. ")",
                Color3.fromRGB(255, 120, 80))
        end)
        return
    end

    if AUTO_SEND then
        ui.setStatus("Enviando para o Discord...", Color3.fromRGB(255, 200, 80))
        task.spawn(function()
            local stamp = os.date("%Y%m%d_%H%M%S")
            local res = sendAll(remotesText, dexText, susText, stamp)
            ui.setStatus(res, Color3.fromRGB(80, 230, 120))
        end)
    end
end

-- spawn seguro: erros dentro de task.spawn nao escapam mais em silencio.
-- O handler reporta UMA vez e retorna nil (nao relanca) - evita o bug de
-- "handled" virar segundo erro (o xpcall propaga o retorno do handler).
local function safeSpawn(fn)
    local run = function()
        xpcall(fn, function(err)
            rootErrorHandler(err)
            return nil
        end)
        -- NADA mais aqui: o handler ja reportou. Se rootErrorHandler
        -- retornasse um valor, o xpcall o propagaria como falso erro.
    end
    if task and task.spawn then
        task.spawn(run)
    else
        run()
    end
end

safeSpawn(mainFlow)
