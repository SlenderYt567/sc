-- Notificação nativa (toast)
local NotifyHolder = Mk("Frame", { Parent = UiGui, BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 8), Size = UDim2.new(1, -20, 0, 0), ZIndex = 10 })

local function NativeNotify(title, content, duration)
    pcall(function()
        local toast = Mk("Frame", { Parent = NotifyHolder, BackgroundColor3 = ThemeUI.Panel, Size = UDim2.fromOffset(240, 46), Position = UDim2.new(0.5, 0, 0, 0) })
        Corner(toast, 8)
        Stroke(toast, ThemeUI.Line, 1)
        Mk("TextLabel", {
            Parent = toast, BackgroundTransparency = 1, Font = Enum.Font.GothamBold,
            Text = title, TextColor3 = ThemeUI.Accent, TextSize = 13,
            Position = UDim2.fromOffset(12, 4), Size = UDim2.fromOffset(400, 18), TextXAlignment = Enum.TextXAlignment.Left,
        })
        Mk("TextLabel", {
            Parent = toast, BackgroundTransparency = 1, Font = Enum.Font.Gotham,
            Text = content, TextColor3 = ThemeUI.Text, TextSize = 12,
            Position = UDim2.fromOffset(12, 22), Size = UDim2.fromOffset(400, 18), TextXAlignment = Enum.TextXAlignment.Left,
        })
        
        local textBounds = TextService:GetTextSize(content or "", 12, Enum.Font.Gotham, Vector2.new(1000, 46))
        toast.Size = UDim2.fromOffset(math.max(textBounds.X + 30, 220), 46)
        toast.Position = UDim2.new(0.5, 0, 0, 0)
        toast.AnchorPoint = Vector2.new(0.5, 0)
        
        TweenService:Create(toast, TweenInfo.new(0.2), { Position = UDim2.new(0.5, 0, 0, 8) }):Play()
        task.delay(duration or 4, function()
            TweenService:Create(toast, TweenInfo.new(0.25), { Position = UDim2.new(0.5, 0, 0, -60) }):Play()
            task.delay(0.3, function() toast:Destroy() end)
        end)
    end)
end

SafeNotify = NativeNotify

