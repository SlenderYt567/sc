-- ============================================================
-- 3. UTILITÁRIOS
-- ============================================================

-- Obtém um RemoteEvent de um serviço Knit (com fallback flexível)
local function getServiceRemote(serviceName, remoteName)
    -- Caminho padrão Knit
    local knit = (ReplicatedStorage:FindFirstChild("Packages") and ReplicatedStorage.Packages:FindFirstChild("Knit"))
        or ReplicatedStorage:FindFirstChild("Knit")
    if knit then
        local services = knit:FindFirstChild("Services")
        local svc = services and services:FindFirstChild(serviceName)
        if svc then
            local re = svc:FindFirstChild("RE")
            local target = (re and re:FindFirstChild(remoteName)) or svc:FindFirstChild(remoteName)
            if target then return target end
        end
    end

    -- Fallback: busca recursiva no ReplicatedStorage
    for _, desc in ipairs(ReplicatedStorage:GetDescendants()) do
        if desc.Name == remoteName and (desc:IsA("RemoteEvent") or desc:IsA("RemoteFunction") or desc:IsA("BindableEvent")) then
            return desc
        end
    end
    return nil
end

-- Dispara evento de forma segura
local function fireInstance(inst, ...)
    if not inst then
        return false
    end
    local ok, err = pcall(function(...)
        if inst:IsA("RemoteEvent") then
            inst:FireServer(...)
        elseif inst:IsA("BindableEvent") then
            inst:Fire(...)
        elseif inst:IsA("RemoteFunction") then
            inst:InvokeServer(...)
        end
    end, ...)
    if not ok then
        warn("[PetUniverseHub] fireInstance falhou:", err)
    end
    return ok
end

-- Posição central de uma zona
local function getZonePosition(zone)
    local spawners = Workspace:FindFirstChild("BreakablesSpawners")
    local zoneFolder = spawners and spawners:FindFirstChild(zone)
    if not zoneFolder then
        return nil
    end
    local spot = zoneFolder:FindFirstChild("Spawner") or zoneFolder:FindFirstChild("PetArea")
    if spot and spot:IsA("BasePart") then
        return spot.Position
    end
    local total = Vector3.zero
    local count = 0
    for _, v in ipairs(zoneFolder:GetDescendants()) do
        if v.Name == "PetArea" and v:IsA("BasePart") then
            total = total + v.Position
            count = count + 1
        end
    end
    if count > 0 then
        return total / count
    end
    return nil
end

-- Teleporta o personagem para o centro de uma zona
local function teleportToZone(zone)
    local pos = getZonePosition(zone)
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if pos and hrp then
        hrp.CFrame = CFrame.new(pos + Vector3.new(0, 6, 0))
        return true
    end
    return false
end

-- ============================================================
-- 4. CARREGAR FLUENT UI
-- ============================================================
local function loadSource(src)
    if type(loadstring) == "function" then
        return loadstring(src)
    elseif type(load) == "function" then
        return load(src)
    end
    return nil
end

local function tryLoadFluent(url)
    local ok, res = pcall(function()
        local src = game:HttpGet(url, true)
        local fn = loadSource(src)
        if not fn then
            return nil
        end
        return fn()
    end)
    if ok and type(res) == "table" and type(res.CreateWindow) == "function" then
        return res
    end
    return nil
end

local Fluent = tryLoadFluent("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua")
if not Fluent then
    Fluent = tryLoadFluent("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/main.lua")
end
if not Fluent then
    error("Falha ao carregar Fluent UI. Verifique se a sua conexão e o executor suportam HttpGet do GitHub.")
end

