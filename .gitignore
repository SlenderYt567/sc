--[[
	SlenderHub — Mining Legends! (place 138805779586842)
	======================================================
	Baseado no dump SlenderHub: remotes/ClientPackets-ServerPackets, sistema
	conch_networking (admin) e estrutura de mundo (Workspace/Worlds).

	Rede do jogo:
	  require(ReplicatedStorage.Packages.Network)         -> lib custom
	  require(ReplicatedStorage.Shared.Modules.ClientPackets) -> cliente -> servidor (.send)
	  require(ReplicatedStorage.Shared.Modules.ServerPackets) -> servidor -> cliente (.listen)

	Packets exploráveis (do dump):
	  DamageBlock{Mine,GUID}  HatchEgg{EggName,Multi}  AutoHatchEgg{egg}  StopAutoHatchEgg{}
	  Rebirth{uint8}  EquipPet{Equip,str}  UseBoost{name}  UseFlag{name}  BuyUpgrade{name}
	  ClaimRankReward{uint8}  OpenMysteryBox{uint8}  RollEnchant{str}  StartAutoEnchant{Pet,Target}
	  SpinWheel{}  ClaimSpinnyToken{}  ClaimPlaytimeGift{uint8}  RedeemCode{str}
	  EquipBest{}  UnequipAllPets{}  ThrowTNT{TNT,X,Y,Z}  HatchExclusiveEgg{EggName,amt}
	  ReplayHatch{EggName,PetName,Tier}  MerchantPurchase{MerchantName,index}

	HONEYPOTS (NÃO FIRE): IntegrityCheckProcessorKey2_*, SetDialogInUse,
	conch_networking/log, conch_networking/log_command.

	UI: FluentUI (dawid-scripts/Fluent) — carregada da release oficial.
--]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local VirtualUser = game:GetService("VirtualUser")
local StarterPlayer = game:GetService("StarterPlayer")

local LocalPlayer = Players.LocalPlayer

-- ============================================================
-- 1) ENV GLOBAL (permite re-executar sem duplicar UI)
-- ============================================================
local Env = getgenv and getgenv() or _G
local HUB_NAME = "SlenderHub_ML"
if Env[HUB_NAME] then
	local old = Env[HUB_NAME]
	if old.cleanup then pcall(old.cleanup) end
	if old.window then pcall(old.window.Destroy, old.window) end
	task.wait(0.3)
	Env[HUB_NAME] = nil
end
local Hub = { window = nil, __connections = {}, __threads = {} }
Env[HUB_NAME] = Hub

local function onConnection(cn)
	if cn then table.insert(Hub.__connections, cn) end
end

local function cleanupAll()
	for _, cn in ipairs(Hub.__connections) do
		pcall(function()
			cn:Disconnect()
		end)
	end
	Hub.__connections = {}
	for name, th in pairs(Hub.__threads) do
		pcall(task.cancel, th)
	end
	Hub.__threads = {}
end
Hub.cleanup = cleanupAll

-- ============================================================
-- 2) SETTINGS
-- ============================================================
local Settings = {
	farmEnabled = false,
	farmCps = 10,                -- packets/sec de DamageBlock (rateLimit do jogo: 60)
	targetMode = "LookForward",  -- "LookForward" | "Crosshair"
	oresOnly = false,
	autoRebirth = false,
	rebirthInterval = 15,        -- segundos
	autoHatch = false,
	hatchEgg = nil,
	hatchMulti = false,
	autoEquipBest = false,
	autoSpin = false,
	autoBoost = false,
	boostName = nil,
	autoClaimPlaytime = false,
	redeemCode = "",
	noclip = false,
	walkspeed = 16,
	jumppower = 50,
	espOres = false,
	espAllOres = false,
	teleportZone = nil,
	adminEnabled = false,
	adminPrefix = ";",
	adminCommand = "",
	autoTNT = false,
	tntInterval = 2,
	tntName = nil,
	autoMystery = false,
	craftSlot = 1,
	craftRecipe = "",
	craftAmount = 1,
	claimCraftSlot = 1,
	autoEnchant = false,
	enchantPet = nil,
	enchantTarget = nil,
	enchantInterval = 5,
}

-- ============================================================
-- 3) CARREGAMENTO DA UI (FluentUI)
-- ============================================================
local Fluent = nil
do
	local ok, res = pcall(function()
		return loadstring(game:HttpGet(
			"https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"
		))()
	end)
	if ok and res then
		Fluent = res
	else
		warn("[SlenderHub] Falha ao carregar FluentUI: " .. tostring(res))
		-- fallback: tenta fonte local (docs da pasta UI/FluentUI)
		local ok2, res2 = pcall(function()
			return loadstring(readfile("UI/FluentUI"))()
		end)
		if ok2 and res2 then
			Fluent = res2
		end
	end
	if not Fluent then
		error("SlenderHub_ML: FluentUI indisponível", 0)
	end
end

local Window = Fluent:CreateWindow({
	Title = "SlenderHub — Mining Legends",
	SubTitle = "dump v1 | network packets nativos",
	TabWidth = 140,
	Size = UDim2.fromOffset(590, 480),
	Acrylic = true,
	Theme = "Dark",
	MinimizeKey = Enum.KeyCode.LeftControl,
})
Hub.window = Window

local Tabs = {
	Farm = Window:AddTab({ Title = "Farm", Icon = "zap" }),
	Player = Window:AddTab({ Title = "Player", Icon = "user" }),
	Visual = Window:AddTab({ Title = "Visual", Icon = "eye" }),
	Itens = Window:AddTab({ Title = "Itens", Icon = "package" }),
	Admin = Window:AddTab({ Title = "Admin", Icon = "terminal" }),
	Info = Window:AddTab({ Title = "Info", Icon = "info" }),
	Config = Window:AddTab({ Title = "Config", Icon = "settings" }),
}

local function Notify(title, content, duration)
	pcall(function()
		Fluent:Notify({ Title = title, Content = content, Duration = duration or 4 })
	end)
end

-- ============================================================
-- 4) INTEGRAÇÃO COM A REDE DO JOGO (nativo, via require)
-- ============================================================
local Network = {
	ok = false,
	Client = nil,   -- ClientPackets
	Server = nil,   -- ServerPackets
	Data = {},      -- módulos de dados (BlockModule, EggModule, ...)
}
local MODULE_NAMES = {
	"BlockModule", "BoostModule", "FlagModule", "UpgradeModule",
	"EggModule", "ExclusiveEggs", "PetModule", "EnchantModule",
	"TNTModule", "MysteryBoxModule", "PetChance",
}

do
	local ok, err = pcall(function()
		local NetLib = require(ReplicatedStorage.Packages.Network)
		Network.Client = require(ReplicatedStorage.Shared.Modules.ClientPackets)
		Network.Server = require(ReplicatedStorage.Shared.Modules.ServerPackets)
		Network.ok = (NetLib ~= nil) and (Network.Client ~= nil) and (Network.Server ~= nil)
	end)
	if not ok or not Network.ok then
		Network.ok = false
		warn("[SlenderHub] Rede do jogo indisponível: " .. tostring(err))
	end

	for _, name in ipairs(MODULE_NAMES) do
		local mok, mod = pcall(require, ReplicatedStorage.Shared.Modules[name])
		if mok and type(mod) == "table" then
			Network.Data[name] = mod
		end
	end
end

-- Rarity colors fallback (se RarityColors não for acessível)
local RARITY_COLORS = {
	Common = Color3.fromRGB(160, 160, 160),
	Uncommon = Color3.fromRGB(90, 220, 120),
	Rare = Color3.fromRGB(80, 150, 255),
	Epic = Color3.fromRGB(170, 100, 255),
	Legendary = Color3.fromRGB(255, 200, 60),
	Mythic = Color3.fromRGB(255, 80, 80),
	Secret = Color3.fromRGB(255, 90, 200),
	Paradox = Color3.fromRGB(0, 240, 255),
}
do
	local mok, rc = pcall(require, StarterPlayer.StarterPlayerScripts.Client.Modules.RarityColors)
	if mok and type(rc) == "table" then
		for k, v in pairs(rc) do
			if type(v) == "userdata" then RARITY_COLORS[k] = v end
		end
	end
end

-- ============================================================
-- 5) ESTADO DO SERVIDOR (listeners ServerPackets)
-- ============================================================
local State = {
	currencies = {},       -- string -> number
	rebirths = 0,
	blocksMined = 0,
	rankXp = 0,
	boosts = {},           -- string -> count
	flags = {},
	upgrades = {},
	ores = {},
	tnt = {},
	pets = {},             -- quantidades
	petsSingulars = {},
	blockStates = {},      -- GUID -> {Mine, BlockType, Amount, MaxAmount, Destroyed}
	zones = {},
	loaded = false,
	playtimeCounter = 0,
	exclusiveEggs = {},
	craftSlots = {},
	petEnchants = {},      -- petName -> {Name=, Tier=}
	mysteryBoxes = 0,
	enchantCrystals = 0,
	enchantStatus = nil,
	spinny = nil,
}

local function listenServer(packetName, handler)
	if not (Network.ok and Network.Server and Network.Server[packetName]) then return nil end
	local ok, cn = pcall(Network.Server[packetName].listen, Network.Server[packetName], handler)
	if ok and cn then
		table.insert(Hub.__connections, cn)
		return cn
	end
	return nil
end

-- Hooks de UI: rodam DEPOIS que o State é atualizado.
-- Evita registrar múltiplos .listen() no mesmo packet (modelo desconhecido da lib).
local StateHooks = {}
local function hookState(packetName, fn)
	if not StateHooks[packetName] then StateHooks[packetName] = {} end
	table.insert(StateHooks[packetName], fn)
end
local function emitHooks(packetName, ...)
	local list = StateHooks[packetName]
	if not list then return end
	for _, fn in ipairs(list) do
		pcall(fn, ...)
	end
end

listenServer("ClientLoaded", function()
	State.loaded = true
end)

listenServer("UpdateBlock", function(data)
	if type(data) ~= "table" then return end
	State.blocksMined = State.blocksMined + 1
	if type(data.BlockData) == "table" then
		local bd = data.BlockData
		State.blockStates[bd.GUID] = {
			Mine = data.Mine,
			BlockType = bd.BlockType,
			Amount = bd.Amount,
			MaxAmount = bd.MaxAmount,
			Destroyed = bd.Destroyed == true,
		}
	end
end)

listenServer("MineReset", function(mineName)
	if type(mineName) ~= "string" then return end
	for guid, st in pairs(State.blockStates) do
		if st.Mine == mineName then State.blockStates[guid] = nil end
	end
end)

listenServer("UpdateCurrency", function(data)
	if type(data) == "table" and data.currency then
		State.currencies[data.currency] = data.NewAmount
	end
end)

listenServer("CurrencyGranted", function(data)
	if type(data) == "table" and data.currency then
		State.currencies[data.currency] = data.NewAmount
	end
end)

listenServer("UpdateRebirths", function(n)
	State.rebirths = tonumber(n) or 0
end)

listenServer("UpdateRankXP", function(data)
	if type(data) == "table" then State.rankXp = data.XP or 0 end
end)

local function mapSum(map)
	if type(map) ~= "table" then return 0 end
	local s = 0
	for _, v in pairs(map) do s = s + (tonumber(v) or 0) end
	return s
end

listenServer("UpdateBoosts", function(m)
	State.boosts = m or {}
end)
listenServer("UpdateFlags", function(m)
	State.flags = m or {}
end)
listenServer("UpdateUpgrades", function(m)
	State.upgrades = m or {}
end)
listenServer("UpdateOres", function(m)
	State.ores = m or {}
end)
listenServer("UpdateTNT", function(m)
	State.tnt = m or {}
	emitHooks("UpdateTNT", State.tnt)
end)
listenServer("InventoryUpdate", function(data)
	if type(data) ~= "table" then return end
	State.pets = data.Quantities or {}
	State.petsSingulars = data.Singulars or {}
	emitHooks("InventoryUpdate", data)
end)
listenServer("UpdateSpinnyTokens", function(data)
	if type(data) == "table" then
		State.spinny = data
	end
end)
listenServer("CounterStarted", function(n)
	State.playtimeCounter = tonumber(n) or 0
end)
listenServer("ErrorMessage", function(msg)
	if type(msg) == "string" then
		Notify("Erro do servidor", msg, 5)
	end
end)
listenServer("CodeRedeemed", function()
	Notify("Código resgatado", "O servidor aceitou o código!", 4)
end)
listenServer("GlobalAnnounce", function(msg)
	if type(msg) == "string" and msg ~= "" then
		Notify("Anúncio global", msg, 6)
	end
end)

listenServer("UpdateExclusiveEggs", function(m)
	State.exclusiveEggs = m or {}
end)
listenServer("UpdateMysteryBoxes", function(n)
	State.mysteryBoxes = tonumber(n) or 0
	emitHooks("UpdateMysteryBoxes", State.mysteryBoxes)
end)
listenServer("UpdateEnchantCrystals", function(n)
	State.enchantCrystals = tonumber(n) or 0
end)
listenServer("UpdateCraftSlots", function(m)
	State.craftSlots = m or {}
	emitHooks("UpdateCraftSlots", State.craftSlots)
end)
listenServer("UpdatePetEnchants", function(m)
	State.petEnchants = m or {}
	emitHooks("UpdatePetEnchants", State.petEnchants)
end)
listenServer("AutoEnchantUpdate", function(data)
	if type(data) == "table" then
		State.enchantStatus = data
		emitHooks("AutoEnchantUpdate", data)
	end
end)
listenServer("MysteryBoxOpened", function(items)
	if type(items) ~= "table" then return end
	local total = 0
	for _, it in ipairs(items) do
		if type(it) == "table" then total = total + (tonumber(it.Amount) or 1) end
	end
	Notify("Mystery Box", ("Recompensas: %d item(s)"):format(total), 4)
end)

-- ============================================================
-- 6) HELPERS DE BLOCOS (Mine + GUID)
-- ============================================================
-- Container ancestral com nome de mina (estrito)
local function hasMineAncestor(part)
	local p = part.Parent
	while p do
		if p:IsA("Model") or p:IsA("Folder") then
			local nm = string.lower(tostring(p.Name))
			if string.find(nm, "mine") or string.find(nm, "mundo") or string.find(nm, "world") then
				return true
			end
		end
		p = p.Parent
	end
	return false
end

-- Nome da mina para o packet DamageBlock (best-effort)
local function findMineName(part)
	local p = part.Parent
	local lastContainer = nil
	while p do
		if p:IsA("Model") or p:IsA("Folder") then
			lastContainer = p
			local nm = string.lower(tostring(p.Name))
			if string.find(nm, "mine") or string.find(nm, "mundo") or string.find(nm, "world") then
				return p.Name
			end
		end
		p = p.Parent
	end
	-- fallback: primeiro container encontrado (evita enviar nil)
	if lastContainer then return lastContainer.Name end
	return nil
end

local function blockGUID(part)
	local guid = part:GetAttribute("GUID")
		or part:GetAttribute("BlockGUID")
		or part:GetAttribute("BlockId")
	if guid == nil or guid == "" then guid = part.Name end
	return tostring(guid)
end

local function blockTypeOf(part)
	local bt = part:GetAttribute("BlockType") or part:GetAttribute("BlockName")
	if bt ~= nil then return tostring(bt) end
	-- fallback: nome do bloco deve bater com BlockModule
	if Network.Data.BlockModule and Network.Data.BlockModule[part.Name] then
		return part.Name
	end
	return nil
end

local function isMineBlock(part)
	if not part:IsA("BasePart") then return false end
	local name = part.Name
	if name == "ZonePart" or name == "Atlantis" or name == "Fall" then return false end
	if part:GetAttribute("GUID") or part:GetAttribute("BlockGUID") or part:GetAttribute("BlockId") then
		return true
	end
	return hasMineAncestor(part)
end

local function getCharacter()
	local c = LocalPlayer.Character
	if not c then return nil end
	local hrp = c:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end
	return c, hrp
end

local function raycastBlock(origin, dir, maxDist, filterExclude)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.RespectCanCollide = true
	params.FilterDescendantsInstances = filterExclude or (LocalPlayer.Character and { LocalPlayer.Character } or {})
	local res = Workspace:Raycast(origin, dir * (maxDist or 250), params)
	if res and res.Instance and isMineBlock(res.Instance) then
		return res.Instance
	end
	return nil
end

-- Mira: bloco sob o crosshair
local function targetByCrosshair()
	local cam = Workspace.CurrentCamera
	if not cam then return nil end
	local viewport = cam.ViewportSize
	local origin, dir = cam:ViewportPointToRay(viewport.X / 2, viewport.Y / 2)
	return raycastBlock(origin, dir, 250)
end

-- Mira: bloco à frente do personagem (AFK-friendly)
local function targetByLookForward()
	local _, hrp = getCharacter()
	if not hrp then return nil end
	local cam = Workspace.CurrentCamera
	local look = cam and cam.CFrame.LookVector or hrp.CFrame.LookVector
	local origin = hrp.Position + Vector3.new(0, 2, 0)
	local block = raycastBlock(origin, look, 200)
	if block then return block end
	-- tenta levemente abaixo (minerar chão/frente)
	local down = (Vector3.new(look.X, look.Y - 0.35, look.Z)).Unit
	return raycastBlock(origin, down, 200)
end

local function getTargetBlock()
	if Settings.targetMode == "Crosshair" then
		return targetByCrosshair() or targetByLookForward()
	end
	return targetByLookForward() or targetByCrosshair()
end

local function rarityOf(blockType)
	if not blockType then return nil end
	local bm = Network.Data.BlockModule
	if bm and bm[blockType] then
		return bm[blockType].Rarity or "Common"
	end
	return nil
end

-- ============================================================
-- 7) CONTROLES DE FEATURE
-- ============================================================
local Packets = Network.Client

local function send(name, payload)
	if not Packets or not Packets[name] then return false end
	local ok, err = pcall(Packets[name].send, Packets[name], payload)
	if not ok then
		warn(("[SlenderHub] falha ao enviar %s: %s"):format(name, tostring(err)))
		return false
	end
	return true
end

-- ---- loops genéricos ----
local function cleanupThread(name)
	if Hub.__threads[name] then
		pcall(task.cancel, Hub.__threads[name])
		Hub.__threads[name] = nil
	end
end

local function runNamedLoop(name, loopFn, flag)
	cleanupThread(name)
	Hub.__threads[name] = task.spawn(function()
		while flag() do
			loopFn()
		end
	end)
end

-- ---- Autofarm ----
local function farmLoop()
	while Settings.farmEnabled do
		if not Network.ok then
			task.wait(1)
		else
			local part = getTargetBlock()
			if part then
				local mine = findMineName(part)
				local guid = blockGUID(part)
				local st = State.blockStates[guid]
				if not (st and st.Destroyed) then
					local canMine = true
					if Settings.oresOnly then
						local bt = blockTypeOf(part)
						local rar = rarityOf(bt)
						canMine = rar ~= nil and rar ~= "Common"
					end
					if canMine then
						send("DamageBlock", { Mine = mine, GUID = guid })
					end
				end
			end
			local interval = Settings.farmCps > 0 and (1 / Settings.farmCps) or 0.1
			task.wait(math.clamp(interval, 0.016, 1))
		end
	end
end

local function startFarm()
	cleanupThread("farm")
	Settings.farmEnabled = true
	Hub.__threads.farm = task.spawn(farmLoop)
end

local function stopFarm()
	Settings.farmEnabled = false
	if Hub.__threads.farm then
		pcall(task.cancel, Hub.__threads.farm)
		Hub.__threads.farm = nil
	end
end

-- ---- Auto Rebirth ----
local function rebirthLoop()
	while Settings.autoRebirth do
		if Network.ok then
			send("Rebirth", 1)
		end
		task.wait(Settings.rebirthInterval)
	end
end

-- ---- Auto Hatch ----
local function hatchLoop()
	while Settings.autoHatch do
		if Network.ok and Settings.hatchEgg then
			send("AutoHatchEgg", Settings.hatchEgg)
		end
		task.wait(6)
	end
end

-- ---- Auto Equip Best ----
local function equipBestLoop()
	while Settings.autoEquipBest do
		if Network.ok then
			send("EquipBest", {})
		end
		task.wait(10)
	end
end

-- ---- Auto Spin ----
local function spinLoop()
	while Settings.autoSpin do
		if Network.ok then
			send("SpinWheel", {})
			send("ClaimSpinnyToken", {})
		end
		task.wait(8)
	end
end

-- ---- Auto Boost ----
local function boostLoop()
	while Settings.autoBoost do
		if Network.ok and Settings.boostName then
			local amount = State.boosts[Settings.boostName] or 0
			if amount > 0 then
				send("UseBoost", Settings.boostName)
			end
		end
		task.wait(30)
	end
end

-- ---- Auto Claim Playtime ----
local function claimPlaytimeLoop()
	while Settings.autoClaimPlaytime do
		if Network.ok then
			send("ClaimPlaytimeGift", 1)
		end
		task.wait(60)
	end
end

-- ---- TNT ----
local function tntLoop()
	while Settings.autoTNT do
		if Network.ok and Settings.tntName then
			local part = getTargetBlock()
			if part then
				local pos = part.Position
				send("ThrowTNT", { TNT = Settings.tntName, X = pos.X, Y = pos.Y, Z = pos.Z })
			end
		end
		task.wait(math.clamp(Settings.tntInterval, 0.5, 10))
	end
end

-- ---- Mystery Box ----
local function mysteryLoop()
	while Settings.autoMystery do
		if Network.ok and State.mysteryBoxes > 0 then
			send("OpenMysteryBox", 1)
		end
		task.wait(1)
	end
end

-- ---- Auto Enchant ----
local function enchantLoop()
	while Settings.autoEnchant do
		if Network.ok and Settings.enchantPet and Settings.enchantTarget then
			send("StartAutoEnchant", { Pet = Settings.enchantPet, Target = Settings.enchantTarget })
		end
		task.wait(math.clamp(Settings.enchantInterval, 2, 30))
	end
end

-- ---- Noclip / WalkSpeed / JumpPower ----
local function charLoop()
	while true do
		local _, hrp = getCharacter()
		local humanoid = hrp and hrp.Parent and hrp.Parent:FindFirstChildOfClass("Humanoid")
		if humanoid then
			if humanoid.WalkSpeed ~= Settings.walkspeed then
				humanoid.WalkSpeed = Settings.walkspeed
			end
			if humanoid.UseJumpPower then
				if humanoid.JumpPower ~= Settings.jumppower then
					humanoid.JumpPower = Settings.jumppower
				end
			elseif humanoid.JumpHeight ~= (Settings.jumppower / 5) then
				humanoid.JumpHeight = Settings.jumppower / 5
			end
			if Settings.noclip then
				for _, part in ipairs(hrp.Parent:GetDescendants()) do
					if part:IsA("BasePart") and part.CanCollide then
						part.CanCollide = false
					end
				end
			end
		end
		task.wait(0.15)
	end
end
Hub.__threads.char = task.spawn(charLoop)

-- ---- Teleport ----
local function refreshZones()
	State.zones = {}
	local worlds = Workspace:FindFirstChild("Worlds")
	if worlds then
		for _, desc in ipairs(worlds:GetDescendants()) do
			if desc:IsA("BasePart") and (desc.Name == "ZonePart" or desc.Name == "Atlantis" or desc.Name == "Fall") then
				table.insert(State.zones, { Name = "Zona: " .. desc.Name, Part = desc })
			end
		end
	end
	for _, folder in ipairs(Workspace:GetChildren()) do
		if (folder:IsA("Folder") or folder:IsA("Model"))
			and string.find(string.lower(folder.Name), "mine") then
			local part = folder:FindFirstChildWhichIsA("BasePart", true)
			if part then
				table.insert(State.zones, { Name = "Mina: " .. folder.Name, Part = part })
			end
		end
	end
	return State.zones
end

local function teleportToZone(name)
	for _, zone in ipairs(State.zones) do
		if zone.Name == name then
			local _, hrp = getCharacter()
			if hrp then
				hrp.CFrame = zone.Part.CFrame + Vector3.new(0, 4, 0)
				Notify("Teleporte", zone.Name, 3)
			end
			return
		end
	end
	Notify("Teleporte", "Zona não encontrada", 3)
end

-- ---- ESP de minérios ----
local espHighlights = {}
local function clearESP()
	for _, h in ipairs(espHighlights) do
		pcall(h.Destroy, h)
	end
	espHighlights = {}
end

local function espLoop()
	while Settings.espOres do
		clearESP()
		local count = 0
		for _, part in ipairs(Workspace:GetDescendants()) do
			if count > 250 then break end
			if part:IsA("BasePart") and part.Transparency < 1 and isMineBlock(part) then
				local bt = blockTypeOf(part)
				if bt then
					local rar = rarityOf(bt)
					local show = (Settings.espAllOres and rar ~= nil)
						or (rar ~= nil and rar ~= "Common")
					if show then
						local hl = Instance.new("Highlight")
						hl.Adornee = part
						hl.FillColor = RARITY_COLORS[rar] or RARITY_COLORS.Common
						hl.FillTransparency = 0.45
						hl.OutlineColor = hl.FillColor
						hl.OutlineTransparency = 0
						hl.Parent = part
						table.insert(espHighlights, hl)
						count = count + 1
					end
				end
			end
		end
		task.wait(5) -- re-scan: blocos renascem
	end
	clearESP()
end

-- ---- Anti-AFK extra ----
onConnection(LocalPlayer.Idled:Connect(function()
	pcall(function()
		VirtualUser:CaptureController()
		VirtualUser:ClickButton2(Vector2.new(0, 0))
	end)
end))

-- ---- Admin (Conch) ----
local function getConchRemote()
	local folder = ReplicatedStorage:FindFirstChild("conch_networking")
	if folder then
		return folder:FindFirstChild("invoke_server_command")
	end
	return nil
end

local function isAdmin()
	return LocalPlayer:GetAttribute("ConchAdmin") == true
end

local function runAdminCommand(cmd)
	if not isAdmin() then
		Notify("Admin", "Seu personagem não tem ConchAdmin.", 4)
		return
	end
	local remote = getConchRemote()
	if not remote then
		Notify("Admin", "conch_networking não encontrado.", 4)
		return
	end
	local full = cmd
	if not string.find(string.lower(cmd), string.lower(Settings.adminPrefix)) then
		full = Settings.adminPrefix .. cmd
	end
	local ok, err = pcall(function()
		remote:FireServer(full)
	end)
	if ok then
		Notify("Admin", "Comando enviado: " .. full, 3)
	else
		Notify("Admin", "Falha ao executar: " .. tostring(err), 5)
	end
end

-- ============================================================
-- 8) UI — ABAS
-- ============================================================
local function refreshDropdown(dd, values, keep)
	if not dd then return end
	pcall(function()
		if type(dd.Clear) == "function" then dd:Clear() end
		if type(dd.AddItem) == "function" then
			for _, v in ipairs(values) do
				dd:AddItem(v)
			end
		end
	end)
end

