end)

-- ============================================================
-- 8. HATCH
-- ============================================================
local function hatchEgg(egg, amount)
    local remote = getServiceRemote("EggHatchService", "Hatch")
    local finalAmount = amount
    if type(amount) == "string" and amount ~= "Max" then
        finalAmount = tonumber(amount) or amount
    end
    return fireInstance(remote, egg, finalAmount)
end

task.spawn(function()
    while true do
        task.wait(0.5)
        if hatchState.enabled then
            hatchEgg(hatchState.egg, hatchState.amount)
        end
    end
end)

local function deletePet(petName)
    local config = getServiceRemote("EggHatchService", "Config")
    return fireInstance(config, "Delete", petName)
end

local function getPlayerPets()
    local result = {}
    local mirror = ReplicatedFirst:FindFirstChild("PlayerDataMirror")
    local petsData = mirror and mirror:FindFirstChild("PetsData")
    if petsData then
        for _, folder in ipairs(petsData:GetChildren()) do
            if folder:IsA("Folder") then
                for _, pet in ipairs(folder:GetChildren()) do
                    if pet:IsA("Folder") then
                        table.insert(result, pet.Name)
                    end
                end
            end
        end
    end
    return result
end

local function deleteCommonPets()
    local commons = {
        "Cat", "Dog", "Mouse", "Bird", "Rabbit", "Pig", "Cow", "Chicken",
        "Duck", "Goat", "Sheep", "Horse", "Turtle", "Fish", "Frog", "Squirrel",
    }
    local deleted = 0
    for _, petName in ipairs(getPlayerPets()) do
        for _, common in ipairs(commons) do
            if string.find(petName, common, 1, true) then
                if deletePet(petName) then
                    deleted = deleted + 1
                end
                break
            end
        end
    end
    return deleted
end

-- ============================================================
-- 9. MOVIMENTO
-- ============================================================
RunService.Stepped:Connect(function()
    if playerState.noclip then
        local char = LP.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end
    end
end)

RunService.Heartbeat:Connect(function()
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        if hum.WalkSpeed ~= playerState.speed then
            hum.WalkSpeed = playerState.speed
        end
        hum.UseJumpPower = true
        if hum.JumpPower ~= playerState.jump then
            hum.JumpPower = playerState.jump
        end
    end
end)

-- ============================================================
-- 10. ESP (VISUAL)
-- ============================================================
local function getTierColor(tierName)
    local name = string.lower(tierName)
    if string.find(name, "rtier") or string.find(name, "ruby") then
        return Color3.fromRGB(255, 60, 60)
    elseif string.find(name, "chest") then
        return Color3.fromRGB(255, 170, 0)
    elseif string.find(name, "tier5") then
        return Color3.fromRGB(255, 215, 0)
    elseif string.find(name, "tier4") then
        return Color3.fromRGB(180, 80, 255)
    elseif string.find(name, "tier3") then
        return Color3.fromRGB(60, 140, 255)
    elseif string.find(name, "tier2") then
        return Color3.fromRGB(60, 220, 120)
    elseif string.find(name, "apple") or string.find(name, "banana")
        or string.find(name, "kiwi") or string.find(name, "mango")
        or string.find(name, "blueberry") or string.find(name, "taco") then
        return Color3.fromRGB(120, 255, 120)
    end
    return Color3.fromRGB(255, 255, 255)
end

local function makeHighlight(adornee, color)
    local h = Instance.new("Highlight")
    h.Adornee = adornee
    h.FillTransparency = 0.75
    h.OutlineTransparency = 0
    h.FillColor = color
    h.OutlineColor = color
    h.Parent = Workspace
    return h
end

local function clearESP()
    for _, h in ipairs(espHighlights) do
        pcall(function()
            h:Destroy()
        end)
    end
    espHighlights = {}
end

local function refreshESP()
    clearESP()
    if not espState.enabled then
        return
    end
    local breakables = Workspace:FindFirstChild("Breakables")
    if breakables then
        for _, folder in ipairs(breakables:GetChildren()) do
            if espState.zone == "All" or folder.Name == espState.zone then
                for _, brk in ipairs(folder:GetChildren()) do
                    if brk:IsA("Model") then
                        table.insert(espHighlights, makeHighlight(brk, getTierColor(brk.Name)))
                    end
                end
            end
        end
    end
    if espState.orbs then
        local orbs = Workspace:FindFirstChild("Orbs")
        if orbs then
            for _, folder in ipairs(orbs:GetChildren()) do
                for _, orb in ipairs(folder:GetChildren()) do
                    if orb:IsA("BasePart") then
                        table.insert(espHighlights, makeHighlight(orb, Color3.fromRGB(0, 220, 255)))
                    end
                end
            end
        end
    end
end

