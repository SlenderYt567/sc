}

local TabButtons = {}
local TabPages = {}
local ActiveTab = "Main"

local TabList = new("Frame", {
    BackgroundTransparency = 1,
    Size = UDim2.new(1, 0, 0, #Tabs * 44),
    Position = UDim2.new(0, 0, 0, 108),
}, Sidebar)

for i, tab in ipairs(Tabs) do
    local btn = new("TextButton", {
        Text = tab.Icon .. "  " .. tab.Name,
        Font = CONFIG.FontBody,
        TextSize = 14,
        TextColor3 = CONFIG.SubText,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -16, 0, 40),
        Position = UDim2.new(0, 8, 0, (i - 1) * 44),
        TextXAlignment = Enum.TextXAlignment.Left,
        AutoButtonColor = false,
    }, TabList)
    btn.PaddingLeft = UDim.new(0, 10)
    local indicator = new("Frame", {
        Name = "Indicator",
        BackgroundColor3 = CONFIG.Accent,
        Size = UDim2.new(0, 3, 0, 22),
        Position = UDim2.new(0, 0, 0, 9),
        Visible = false,
    }, btn)
    btn.MouseButton1Click:Connect(function()
        ActiveTab = tab.Name
        for _, b in ipairs(TabButtons) do
            local ind = b:FindFirstChild("Indicator")
            b.TextColor3 = CONFIG.SubText
            if ind then ind.Visible = false end
        end
        btn.TextColor3 = CONFIG.Text
        indicator.Visible = true
        for _, page in ipairs(TabPages) do
            page.Visible = false
        end
        TabPages[tab.Name].Visible = true
    end)
    TabButtons[#TabButtons + 1] = btn
end

