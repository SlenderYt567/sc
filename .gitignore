    "🔹 Free & Premium tiers available\n" ..
    "🔹 Saved keys auto-login on next launch"
)

-- Auto-check saved key on UI load with notification
task.spawn(function()
    task.wait(1)
    if isfile and isfile(PB_CONFIG.KeyFileName) then
