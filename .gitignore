-- ============================================================
-- 7. FARM
-- ============================================================

local function reportDestroyedInZone(zone)
    local remote = getServiceRemote("BreakableSpawnService", "ReportDestroyed")
    local folder = Workspace:FindFirstChild("Breakables") and Workspace.Breakables:FindFirstChild(zone)
    if not (remote and folder) then
        return 0
    end
    local count = 0
    for _, brk in ipairs(folder:GetChildren()) do
        if brk:IsA("Model") then
            local coinId = brk:GetAttribute("CoinId")
            if type(coinId) == "string" and coinId ~= "" then
                fireInstance(remote, zone, coinId)
                count = count + 1
            end
        end
    end
    return count
end

local function claimOrbsInZone(zone, multiplier)
    local remote = getServiceRemote("BreakableOrbService", "ClaimOrb")
    local orbs = Workspace:FindFirstChild("Orbs")
    local zoneFolder = orbs and orbs:FindFirstChild(zone)
    if not (remote and zoneFolder) then
        return 0
    end
    local count = 0
    for _, orb in ipairs(zoneFolder:GetChildren()) do
        if orb:IsA("BasePart") and orb:FindFirstChild("Damage") then
            local coinId = orb:GetAttribute("CoinId") or ""
            local baseDmg = tonumber(orb.Damage.Value) or 1
            local dmg = baseDmg * multiplier
            fireInstance(remote, zoneFolder.Name, orb.Name, dmg, coinId)
            pcall(function()
                orb:Destroy()
            end)
            count = count + 1
        end
    end
    return count
end

local function findClickBonus()
    local found = {}
    local breakables = Workspace:FindFirstChild("Breakables")
    if breakables then
        for _, folder in ipairs(breakables:GetChildren()) do
            for _, brk in ipairs(folder:GetChildren()) do
                if brk:IsA("Model") then
                    local name = string.lower(brk.Name)
                    local coinId = brk:GetAttribute("CoinId")
                    if (string.find(name, "bonus") or string.find(name, "click"))
                        and type(coinId) == "string" and coinId ~= "" then
                        table.insert(found, { zone = folder.Name, coinId = coinId })
                    end
                end
            end
        end
    end
    return found
end

local function claimClickBonus()
    local remote = getServiceRemote("BreakableOrbService", "ClaimClickBonus")
    if not remote then
        return 0
    end
    local list = findClickBonus()
    for _, item in ipairs(list) do
        fireInstance(remote, item.coinId)
    end
    return #list
end

local function farmLoop()
    while farmState.enabled do
        local zone = farmState.zone

        farmState.destroyed = reportDestroyedInZone(zone)
        task.wait(0.2)

        farmState.orbs = claimOrbsInZone(zone, farmState.multiplier)

        if farmState.teleport then
            teleportToZone(zone)
        end

        task.wait(farmState.interval)
    end
    farmThread = nil
end

local function setAutoFarm(on)
    farmState.enabled = on
    if on and not farmThread then
        farmThread = task.spawn(farmLoop)
    elseif not on then
        farmThread = nil
    end
end

-- Loops secundários
task.spawn(function()
    while true do
        task.wait(0.4)
        if orbState.enabled then
            for _, zone in ipairs(ZONES) do
                claimOrbsInZone(zone, farmState.multiplier)
            end
        end
    end
end)

