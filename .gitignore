-- Fire no GiveGamePass com o ID do gamepass
local function FireGiveGamePass(gamepassId)
    local re = GetKnitRemote("GamePassService", "RE", "GiveGamePass")
    if not re then return false end
    -- Tenta padrão 1: só o ID
    local ok1, err1 = pcall(function() re:FireServer(gamepassId) end)
    -- Tenta padrão 2: ID + true (Knit costuma validar com booleano)
    local ok2, err2 = pcall(function() re:FireServer(gamepassId, true) end)
    return ok1 or ok2
end

-- =====================================
-- CÓDIGOS DO JOGO (descrição oficial — resgate via CodesService/RF/RedeemItem)
-- =====================================
local GameCodes = {
    "RELEASE", "NEW", "Like3K", "Like28K", "Like60K",
    "Xmas", "Santa", "Love", "Squid", "Power", "UPD10",
    "Panda", "Batman", "Trade", "Fruit", "Upgrade",
    "Like170k", "Super", "Season2", "Brainrot", "Offline", "X20"
}

-- Resgata um código (invoca o RF com variações de payload)
local function RedeemCode(code)
    local rf = GetKnitRemote("CodesService", "RF", "RedeemItem")
    if not rf then return "no-remote" end
    local payloads = { { code }, { code, 1 }, { code, true } }
    for _, args in ipairs(payloads) do
        local ok, res = pcall(function() return rf:InvokeServer(unpack(args)) end)
        if ok then return tostring(res) end
    end
    return "falhou"
end

