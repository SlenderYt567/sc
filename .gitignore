--!strict
--[[
    Zaphub Reconstruido (PS99) - Edicao Reverse Engineering
    Arquitetura: Protocolo HTTP binario + Motor LPH_NO_UPVALUES + Path2D
    Fonte: Bytecode Luraph (dump via executor) - decompilacao 100% offline
    Protos: 362 | Pool global: 523 entradas | Main real: proto_135 (f134)
    
    AVISO: As acoes de jogo reais (nomes de remotes, endpoints, cmds)
    sao ENVIADAS PELO SERVIDOR em tempo de execucao via loadstring
    (macro LPH_NO_UPVALUES), portanto NAO existem hardcoded no cliente.
    Este script reconstroi o que era extraivel: protocolo, execucao,
    movimento Path2D e utilitarios de ambiente.
]]

--//==============================[ EXECUTOR DETECTION (f1: identifyexecutor) ]==============================//--
local Zaphub = {}

-- Detecta qual exploit esta rodando para adaptar a execucao (f1: _G['identifyexecutor'])
Zaphub.getExecutor = function()
    local identify = _G.identifyexecutor
    if identify then
        local ok, name = pcall(identify)
        if ok and type(name) == "string" then
            return name:lower()
        end
    end
    -- fallback por globals de executores conhecidos
    if _G.fluxus then return "fluxus" end
    if _G.syn then return "synapse" end
    if _G.krnl then return "krnl" end
    return "unknown"
end

-- iscclosure disponivel? (usado para validar ambiente)
Zaphub.hasCClosure = function()
    return type(_G.iscclosure) == "function"
end

--//==============================[ PROTOCOLO BINARIO (f145/f150/f179/f262/f301) ]==============================//--
-- Formato do pacote (reconstruido dos blocos reais):
--   header : tamanho (b[4], '>i8') + checksum (b[9], hash concatenado)
--   meta   : opcode (b[11]) + subtipo (b[16]) + handler (b[14])
--   body   : campos 1..4 (b4[1]..b4[4]); sub: b4[1][10]='true' (flag),
--            b4[1][25] (closure do handler), b4[1][3]
--
-- Validacoes de tamanho:
--   f179: <=27 / >=44 / >=65 / >=106      f150: 14/42/70/98/126
--   f262: 16/29/46/47/53/54/88/95/115     f294: 61/132/203/274/345/416/487
--   main f134 (proto_135): 116 / 167 / 218 / 269
-- Checksums:
--   f179: '7148', '41345'   f150: '7394', '63951'   f262: '56290'..'10713'
--   f294: '6210', '31417'
-- Opcodes (f179, dispatch b[11]): 26, 6, 103, 49, 40, 45
-- Subtipos (f179, dispatch b[16]): 85=pcall, 86=error, 46=debug, 12=format
-- Subtipos (f262, dispatch b[13]): 80, 111, 117

-- Le um campo binario (padrao f179: buffer.read('>i8'/'<i8', off))
Zaphub.readField = function(buf, off, mode)
    return buffer.read(mode or ">i8", buf, off or 0)
end

-- Escreve um pacote binario (padrao f150: buffer.write >i8/<i8)
-- header: tamanho(u32) + checksum(u8) + opcode(u8) + subtipo(u8) + body
Zaphub.writePacket = function(body, checksum, opcode, subtype)
    local buf = buffer.create(4096)
    local off = 1
    local s = tostring(body or "")
    buffer.writeu32(buf, off, #s); off = off + 4
    buffer.writeu8(buf, off, checksum or 0); off = off + 1
    buffer.writeu8(buf, off, opcode or 0); off = off + 1
    buffer.writeu8(buf, off, subtype or 0); off = off + 1
    for i = 1, #s do
        buffer.writeu8(buf, off, string.byte(s, i)); off = off + 1
    end
    return buffer.tostring(buf, 1, off - 1)
end

-- Le um pacote binario e extrai os campos usados pelo parser
Zaphub.readPacket = function(raw)
    local buf = buffer.fromstring(raw)
    local off = 1
    local size = buffer.readu32(buf, off); off = off + 4
    local checksum = buffer.readu8(buf, off); off = off + 1
    local opcode = buffer.readu8(buf, off); off = off + 1
    local subtype = buffer.readu8(buf, off); off = off + 1
    local body = {}
    for i = off, math.min(off + size - 1, #raw) do
        body[#body + 1] = buffer.readu8(buf, i)
    end
    return {
        size = size,        -- campo b[4]
        checksum = checksum, -- campo b[9]
        opcode = opcode,    -- campo b[11]
        subtype = subtype,  -- campo b[16]
        body = body,
        bodyStr = string.char(unpack(body)),
    }
end

-- Checksum de integridade (f179 L360: concat('22', campo) + concat(_, '6') -> hash)
-- Constantes reais por frame:
--   f179: '-92260772'+'-13910'  f1: '23443'+'-23788'  f298: '31579'+'-31392'
--   f262: '-469732106'+'-29938' f294: '-106987'+'-24071'  main f134: '15018'+'-15396'
Zaphub.checkHash = function(...)
    local s = ""
    for i = 1, select("#", ...) do
        s = s .. tostring(select(i, ...))
    end
    local acc = 0
    for i = 1, #s do
        acc = (acc * 31 + string.byte(s, i)) % 2 ^ 31
    end
    return acc
end

--//==============================[ PARSER DE RESPOSTA HTTP (f179) ]==============================//--
-- Sequencia real observada: validar tamanho -> validar checksum ->
-- dispatch de opcode -> dispatch de subtipo -> executar handler.

Zaphub.processResponse = function(raw)
    local pkt = Zaphub.readPacket(raw)
    local size = pkt.size        -- b[4]
    local checksum = pkt.checksum -- b[9]
    local opcode = pkt.opcode    -- b[11]

    -- 1) validacoes de tamanho (f179 L84/L189/L195/L205/L27/L386)
    if size <= 27 then return Zaphub.onSize27(pkt) end
    if size >= 44 and size < 65 then return Zaphub.onSize44(pkt) end
    if size >= 65 and size < 106 then return Zaphub.onSize65(pkt) end
    if size >= 106 then return Zaphub.onSize106(pkt) end

    -- 2) validacao de checksum (L35 '7148' / L411 '41345')
    if checksum ~= 7148 and checksum ~= 41345 then
        return Zaphub.onBadChecksum(pkt)
    end

    -- 3) dispatch de opcode (b[11]): 26, 6, 103, 49, 40, 45
    return Zaphub.dispatch(pkt, opcode)
end

Zaphub.dispatch = function(packet, opcode)
    local handlers = {
        [26] = Zaphub.onCommand26,
        [6]  = Zaphub.onCommand6,
        [103] = Zaphub.onCommand103,
        [49] = Zaphub.onCommand49,
        [40] = Zaphub.onCommand40,
        [45] = Zaphub.onCommand45,
    }
    -- subtipos (f179): 85=pcall, 86=error, 46=debug, 12=format
    local subtypes = {
        [85] = "pcall", [86] = "error", [46] = "debug", [12] = "format",
        [80] = "cmd_a", [111] = "cmd_b", [117] = "cmd_c", -- f262
    }
    local h = handlers[opcode]
    if h then
        return h(packet)
    end
    return false
end

-- Handlers observados nos blocos reais do f179:
--   L129 (opcode 103): retorna closure RunService:IsServer()
--   L198: HttpService:PostAsync() via defer
--   L172/L338: execucao dinamica b[4](...)
--   L415: coroutine.resume(handler, ...) com 5 args
--   L307/L313: GetChildren + Workspace (discovery)
function Zaphub.onSize27(p) end       -- f179 L84/L153: size <= 27
function Zaphub.onSize44(p) end       -- f179 L27/L386: size >= 44
function Zaphub.onSize65(p) end       -- f179 L205/L189: size >= 65
function Zaphub.onSize106(p) end      -- f179 L195: size >= 106
function Zaphub.onBadChecksum(p) end  -- f179 L35/L411: checksum invalido

function Zaphub.onCommand26(p) end    -- validacao tamanho: >=44
function Zaphub.onCommand6(p) end     -- validacao tamanho: >=44
function Zaphub.onCommand103(p)       -- RunService:IsServer() (f179 L129)
    return Zaphub.isServer()
end
function Zaphub.onCommand49(p) end    -- validacao tamanho: >=106
function Zaphub.onCommand40(p) end
function Zaphub.onCommand45(p) end

--//==============================[ MOTOR DE EXECUCAO (f262 L143: LPH_NO_UPVALUES) ]==============================//--
-- O servidor envia codigo; o Zaphub executa via loadstring com o macro.
-- Template exato extraido do bytecode (f262 L143):
--   ' --[[%s]] return setfenv(function(...) return %s(...) end,
--        setmetatable({ ["%s"] = ... }, { __index = getfenv((...)) })) '
Zaphub.lph_no_upvalues = function(name, upvalues)
    local tmpl = ' --[[%s]] return setfenv(function(...) return %s(...) end, setmetatable({ ["%s"] = ... }, { __index = getfenv((...)) })) '
    local chunk = string.format(tmpl, name or "zaphub", "loadstring", name or "zaphub")
    local f, err = loadstring(chunk)
    if not f then return nil, err end
    local env = setmetatable({}, { __index = getfenv() })
    for k, v in pairs(upvalues or {}) do
        env[k] = v
    end
    local fn = f()
    return fn, env
end

-- Executa codigo recebido do servidor (f262 L149: b[5](...))
-- injetando upvalues (funcoes do protocolo, services, etc.)
Zaphub.executeServerCode = function(code, upvalues, ...)
    local loadFn = loadstring or load
    if not loadFn then
        error("loadstring nao suportado neste executor (LPH_NO_UPVALUES requer)", 2)
    end
    local fn, err = loadFn(code)
    if not fn then return nil, err end
    local env = setmetatable({}, { __index = getfenv() })
    for k, v in pairs(upvalues or {}) do
        env[k] = v
    end
    setfenv(fn, env)
    return fn(...)
end

--//==============================[ SISTEMA DE MOVIMENTO PATH2D (f174/f283/f208/f94/f115) ]==============================//--
-- O Zaphub cria Path2D com Path2DControlPoint e move o personagem ao
-- longo de curvas (GetPositionOnCurve / GetLength / GetTangentOnCurve).
Zaphub.PathMover = {}

-- Cria um Path2D com pontos de controle (padrao f174)
Zaphub.PathMover.create = function(parent, points)
    local path = Instance.new("Path2D")
    path.Parent = parent or workspace
    local cps = {}
    for i, pos in ipairs(points) do
        local cp = Instance.new("Path2DControlPoint")
        cp.Position = pos
        cp.Parent = path
        cps[i] = cp
    end
    path:SetControlPoints(cps)
    return path
end

-- Move um personagem ao longo do caminho
-- (padrao: GetPositionOnCurve(t) com t de 0 a GetLength())
Zaphub.PathMover.follow = function(character, path, speed)
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local length = path:GetLength()
    local t = 0
    while t < length do
        local pos = path:GetPositionOnCurve(t)
        hrp.CFrame = CFrame.new(pos)
        t = t + (speed or Zaphub.PathMover.curveStep)
        task.wait()
    end
end

-- Curvas utilizadas no bytecode: 0.5, 0.375, 0.25, 0.125, 0.75,
-- 0.0625, 0.625, 0.875, 0.1875, 0.4375
Zaphub.PathMover.curveStep = 0.5

--//==============================[ HTTP BINARIO (f179: PostAsync/RequestAsync) ]==============================//--
-- O Zaphub fala com o servidor via RequestAsync/PostAsync com corpo
-- binario (f1: HttpService, PostAsync, GetAsync, RequestAsync, IsStudio).
Zaphub.Http = {
    baseUrl = "https://api.zaphub.gg/", -- endpoint nao presente no bytecode
}

Zaphub.Http.request = function(path, body, headers)
    local http = game:GetService("HttpService")
    local ok, res = pcall(function()
        return http:RequestAsync({
            Url = Zaphub.Http.baseUrl .. path,
            Method = "POST",
            Headers = headers or { ["Content-Type"] = "application/octet-stream" },
            Body = body,
        })
    end)
    if ok then
        return res.Body
    end
    return nil
end

--//==============================[ UTILIDADES (bootstrap f1 / f134) ]==============================//--
Zaphub.utils = {
    getService = function(name)
        return game:GetService(name)
    end,
    workspace = function()
        return game:GetService("Workspace")
    end,
    -- main real f134: dispatch de respostas por tamanho 116/167/218/269
    isResponse = function(size)
        return size == 116 or size == 167 or size == 218 or size == 269
    end,
}

-- Verifica ambiente (f179 L129: RunService:IsServer())
Zaphub.isServer = function()
    return game:GetService("RunService"):IsServer()
end

--//==============================[ EXPORT ]==============================//--
return Zaphub
