end)

TabUniversal:Label("--- Account ---")
TabUniversal:Button("Remover Key", "Deleta a chave salva localmente (Re-execute após clicar)", function()
    if isfile and isfile(KEY_FILE_PATH) then
        deleteSavedKey()
        Notify("Key Removida", "Sua chave foi removida. Por favor, re-execute o script.", "Success", 5)
    else
        Notify("Erro", "Nenhuma chave salva encontrada para deletar.", "Error", 5)
    end
end)

