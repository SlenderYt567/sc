--[[
    ZapHubFarm v2 — Config ZapHub + Target Pet Tracker
    ---------------------------------------------------
    O que foi feito:
      1. Config original do ZapHub mantida (e adicionado "TargetPetTracker").
      2. Load do ZapHub protegido com pcall (não quebra o tracker se a API cair).
      3. Guarda anti-duplicação (evita executar 2x e duplicar farms).
      4. script_key movido para _G.script_key (evita conflito de global solta).
      5. Tracker 100% independente do ZapHub: lista no console (e webhook) quando
         detectar "Titanic Pinata Cat" e "Gargantuan Sombrero Cat".
    Modo de usar:
      Ajuste a config abaixo e execute. O tracker roda sozinho mesmo que o
      loadstring do ZapHub falhe.
--]]

-- ============================================================
-- GUARDA ANTI-DUPLICAÇÃO
-- ============================================================
if _G.ZapHubFarmLoaded then
    warn("[ZapHubFarm] Script ja carregado. Ignorando execucao duplicada.")
    return
end
_G.ZapHubFarmLoaded = true

-- ============================================================
-- CONFIG DO ZAPHUB
-- ============================================================
_G.ZapHubSettings = {
    -- Tracker nativo do ZapHub (webhook de pets novos em geral)
    ["NewPetsTracker"] = {Enable = true, WebhookURL = "https://discord.com/api/webhooks/1317117794176729088/rCvIdXGcdAHoKwGCmIzd_6NowsXzn4qJXDVs8koPYRhXiaZ7kEPLicFCjLCeJIs9kRvk", PetTypes = {"Gargantuan", "Titanic", "Huge", "Exclusive"}},

    -- Tracker dos PETs ALVO (lista no console + webhook quando pegar)
    ["TargetPetTracker"] = {
        Enable = true,                                -- liga/desliga o tracker local
        Pets = {"Titanic Pinata Cat", "Gargantuan Sombrero Cat"},
        ConsoleList = true,                           -- lista no console do executor
        WebhookURL = "https://discord.com/api/webhooks/1317117794176729088/rCvIdXGcdAHoKwGCmIzd_6NowsXzn4qJXDVs8koPYRhXiaZ7kEPLicFCjLCeJIs9kRvk", -- deixe "" para usar o mesmo do NewPetsTracker
    },

    ["Optimization"] = {Enable = false},

    ["TeleportToFiestaLobbyArea"] = {Enable = false},
    ["FarmFiestaLobbyPinata"] = {Enable = false, CooldownSeconds = 5},
    ["FiestaPinataChallenge"] = {Enable = false},
    ["StartFiestaMaze"] = {Enable = true, Difficulty = 0, PartyMode = "Solo", CooldownMinutes = 1},
    ["CompleteFiestaMaze"] = {Enable = true},
    ["CollectFiestaPrizeRoom"] = {Enable = true, Eggs = {"LootChest", "HugeChest", "TitanicChest", "LeprechaunChest"}},
    ["CrafFiestaGifts"] = {Enable = false},
    ["CombineFiestaKeys"] = {Enable = true, CombineBossKeys = true},
    ["BuyFiestaUpgrades"] = {Enable = true, Upgrades = {"Damage", "Pets", "Smash Speed"}},
    ["UseFiestaBoosters"] = {Enable = false, Boosters = {"Fiesta Maze Damage Booster", "Fiesta Maze XP Booster", "Instant Fiesta Maze XP Booster"}, TierPriority = "Lowest"},

    ["InfinitePetSpeed"] = {Enable = true},
    ["Tap"] = {Enable = true, Mode = "Random"},
    ["EfficientFarm"] = {Enable = true},
    ["CollectOrbs"] = {Enable = true},
    ["UseUltimate"] = {Enable = true},

    ["MakePetsGold"] = {Enable = false},
    ["MakePetsRainbow"] = {Enable = false},

    ["ClaimMailbox"] = {Enable = true},
    ["ClaimFreeGifts"] = {Enable = true},
    ["ClaimRankRewards"] = {Enable = true},
    ["ClaimDefaultForeverPackFreeGift"] = {Enable = true},

    ["UseFruits"] = {Enable = false, Fruits = {}},
    ["UseBuffs"] = {Enable = false, Buffs = {}},
    ["UsePotions"] = {Enable = false, Potions = {}},
    ["EquipEnchants"] = {Enable = false, Enchants = {}},

    ["Rejoin"] = {Enable = false, Time = 60}, -- Time is in minutes
    ["WhiteScreen"] = {Enable = true},
    ["StatGUI"] = {Enable = true,
        Items = {
            {Class = "Currency", Pets = "Diamonds"},
            {Class = "Currency", Item = "FiestaCoins"},
            {Class = "Currency", Item = "FiestaOrbs"},
            {Class = "Misc", Item = "Fiesta Candy"},
            {Class = "Lootbox", Item = "Fiesta Gift"},
        }
    },
}

_G.script_key = "nNOnKsJaYhZJPHjsxiLHAyUxUVXqFGsw" -- Sua premium key aqui

-- ============================================================
-- 1) CARREGAR O ZAPHUB (protegido — falha não derruba o tracker)
-- ============================================================
task.spawn(function()
    local ok, err = pcall(function()
        loadstring(game:HttpGet('https://zaphub.xyz/ExecPinataMazeEvent'))()
    end)
    if not ok then
        warn("[ZapHubFarm] Falha ao carregar o ZapHub: " .. tostring(err))
    else
        print("[ZapHubFarm] ZapHub carregado com sucesso.")
    end
end)

-- ============================================================
-- 2) TARGET PET TRACKER (independe do ZapHub)
-- ============================================================
local TrackerCfg = _G.ZapHubSettings.TargetPetTracker
if TrackerCfg and TrackerCfg.Enable then

    local HttpService = game:GetService("HttpService")
    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer

    -- Webhook usado pelo tracker (fallback: mesmo do NewPetsTracker)
    local WebhookURL = (TrackerCfg.WebhookURL and TrackerCfg.WebhookURL ~= "")
        and TrackerCfg.WebhookURL
        or (_G.ZapHubSettings.NewPetsTracker and _G.ZapHubSettings.NewPetsTracker.WebhookURL)
        or ""

    -- Pets que já foram listados (evita repetir a cada scan)
    local alreadyLogged = {}

    -- Normaliza a string: minúsculas, remove acentos/ñ e espaços extras
    local function normalize(str)
        if typeof(str) ~= "string" then return "" end
        return (string.lower(str)
            :gsub("%s+", " ")
            :gsub("ñ", "n")
            :gsub("[áàâãä]", "a")
            :gsub("[éèêë]", "e")
            :gsub("[íìîï]", "i")
            :gsub("[óòôõö]", "o")
            :gsub("[úùûü]", "u")
            :gsub("ç", "c")
            :gsub("^%s+", "")
            :gsub("%s+$", ""))
    end

    -- Alvos configurados, normalizados
    local targets = {}
    for _, petName in ipairs(TrackerCfg.Pets or {}) do
        targets[normalize(petName)] = petName
    end

    -- Retorna o nome "bonito" do alvo se a string bater com algum pet configurado
    -- Também aceita nomes compostos (ex: "Pinata Cat (Titanic)") por palavra-chave.
    local function matchTarget(rawName)
        local name = normalize(rawName)
        if name == "" then return nil end
        -- match exato
        if targets[name] then return targets[name] end
        -- match por palavra-chave (cobre variações do jogo)
        if name:find("pinata") and name:find("titanic") then return targets["titanic pinata cat"] or rawName end
        if name:find("sombrero") and name:find("gargantuan") then return targets["gargantuan sombrero cat"] or rawName end
        return nil
    end

    -- Envia mensagem no webhook do Discord
    local function sendWebhook(petName)
        if WebhookURL == "" then return end
        local payload = {
            content = "**[ZapHubFarm]** Pet raro detectado: **" .. petName .. "**",
            username = "ZapHubFarm Tracker",
        }
        local ok, err = pcall(function()
            HttpService:PostAsync(WebhookURL, HttpService:JSONEncode(payload), Enum.HttpContentType.ApplicationJson)
        end)
        if not ok then
            warn("[ZapHubFarm] Falha ao enviar webhook: " .. tostring(err))
        end
    end

    -- Lista o pet no console (e envia webhook) uma única vez
    local function logPet(rawName)
        local petName = matchTarget(rawName)
        if not petName then return end

        local key = normalize(rawName)
        if alreadyLogged[key] then return end
        alreadyLogged[key] = true

        if TrackerCfg.ConsoleList ~= false then
            print("")
            print("===============================================")
            print("[ZapHubFarm] PET RARO DETECTADO!")
            print("[ZapHubFarm] Pet : " .. petName)
            print("[ZapHubFarm] Data: " .. os.date("%d/%m/%Y") .. "  Hora: " .. os.date("%H:%M:%S"))
            print("===============================================")
            print("")
        end
        sendWebhook(petName)
    end

    -- Checa uma instância: nome do pet pode estar em .Name ou em StringValue.Value
    local function scanInstance(inst)
        if not inst then return end
        local ok, name = pcall(function() return inst.Name end)
        if ok and typeof(name) == "string" then
            logPet(name)
        end
        -- alguns jogos guardam o nome do pet em StringValue filho
        local okIsA, isStringValue = pcall(function() return inst:IsA("StringValue") end)
        if okIsA and isStringValue then
            local ok2, val = pcall(function() return inst.Value end)
            if ok2 and typeof(val) == "string" then
                logPet(val)
            end
        end
    end

    -- Varre tudo de um container (scan inicial)
    local function scanContainer(container)
        if not container then return end
        local ok, descendants = pcall(function() return container:GetDescendants() end)
        if ok then
            for _, inst in ipairs(descendants) do
                scanInstance(inst)
            end
        end
    end

    -- Escopo de busca: workspace (pets ativos), PlayerGui (inventário), ReplicatedStorage
    local scanRoots = {
        workspace,
        LocalPlayer and LocalPlayer.PlayerGui,
        game:GetService("ReplicatedStorage"),
    }

    -- Scan inicial (pega pets que JÁ existem no inventário/slots)
    for _, root in ipairs(scanRoots) do
        scanContainer(root)
    end

    -- Scan contínuo: toda vez que uma instância nova é adicionada
    for _, root in ipairs(scanRoots) do
        if root then
            local ok = pcall(function()
                return root.DescendantAdded:Connect(scanInstance)
            end)
            if not ok then
                warn("[ZapHubFarm] Nao foi possivel conectar em " .. tostring(root))
            end
        end
    end

    -- Scan extra (fallback): verificação periódica caso o jogo não replique
    -- o pet pelo DescendantAdded (ex: inventário recriado a cada join)
    task.spawn(function()
        while task.wait(15) do
            for _, root in ipairs(scanRoots) do
                scanContainer(root)
            end
        end
    end)

    -- Hook de __namecall: captura nomes de pets em FireServer/InvokeServer
    -- (cobre eventos de compra/abertura de caixa onde o nome vai no argumento)
    if hookmetamethod and newcclosure and getnamecallmethod and checkcaller then
        local oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            if checkcaller() then
                return oldNamecall(self, ...)
            end
            local method = getnamecallmethod()
            if method == "FireServer" or method == "InvokeServer" then
                local args = {...}
                for i = 1, #args do
                    local v = args[i]
                    if typeof(v) == "string" then
                        logPet(v)
                    end
                end
            end
            return oldNamecall(self, ...)
        end))
    else
        warn("[ZapHubFarm] hookmetamethod indisponivel no executor — usando apenas scanner.")
    end

    print("[ZapHubFarm] Target Pet Tracker ATIVO. Alvos:")
    for _, petName in ipairs(TrackerCfg.Pets or {}) do
        print("  -> " .. petName)
    end
end
