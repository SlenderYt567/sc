local function SetAutoHeartbeat(enabled)
    AutoHeartbeatOn = enabled
    if not enabled then return end
    task.spawn(function()
        while AutoHeartbeatOn and task.wait(0.25) do
            pcall(function()
                if not (Lib and Lib.HeartMinigameComplete) then return end
                local ui = Lib.UI and Lib.UI.Get and Lib.UI.Get("HeartbeatMinigameUI")
                if ui then
                    local frame = ui:FindFirstChild("Frame")
                    if frame and frame.Visible then
                        Lib:HeartMinigameComplete(true)
                    end
                end
            end)
        end
    end)
end

-- =====================================
-- ANTI JUMPSCARE
-- =====================================
local AntiJumpscareOn = false

do
    local scareNames = {
        "Jumpscare", "JumpscareHollow", "JumpscareShadow",
        "JumpscareShadowWithEyesIMG", "JumpscareStalker",
    }
    local function IsScare(name)
        for _, n in ipairs(scareNames) do
            if name == n then return true end
        end
        return false
    end

    local function HookBindEventsForScares()
        local lib = Lib
        if not (lib and lib.Network and lib.Network.BindEvents) then return end
        local old = lib.Network.BindEvents
        lib.Network.BindEvents = function(self, events)
            if type(events) == "table" and AntiJumpscareOn then
                for name in pairs(events) do
                    if IsScare(name) then
                        events[name] = function() end
                    end
                end
            end
            OnServerEvents(events)
            return old(self, events)
        end
    end
    HookBindEventsForScares()
end

local function SetAntiJumpscare(enabled)
    AntiJumpscareOn = enabled
    if not enabled then return end
    task.spawn(function()
        while AntiJumpscareOn and task.wait(0.3) do
            pcall(function()
                local pg = LocalPlayer:FindFirstChild("PlayerGui")
                if pg then
                    for _, guiName in ipairs(Config.ScareGuis) do
                        local gui = pg:FindFirstChild(guiName)
                        if gui and gui:IsA("ScreenGui") and gui.Enabled then
                            gui.Enabled = false
                        end
                    end
                end
                for _, guiName in ipairs(Config.ScareGuis) do
                    local gui = CoreGui:FindFirstChild(guiName)
                    if gui and gui:IsA("ScreenGui") and gui.Enabled then
                        gui.Enabled = false
                    end
                end
            end)
        end
    end)
end

-- =====================================
-- ESP REAL
-- =====================================
local ESPOn = false

local function ColorFor(model)
    if model:HasTag("NPC") then return Config.EspGood end
    if model:HasTag("Anomaly") or model:HasTag("StalkerMonster") or model:HasTag("TallMonsterSpawn")
        or model:HasTag("Shadow") or model:HasTag("DontLookUp") then
        return Config.EspDanger
    end
    if model:HasTag("Grime") or model:HasTag("EmergencyEventCounter") then return Config.EspTask end
    if model:HasTag("Door") then return Config.EspDoor end
    return nil
end

local function AddHighlight(m)
    if m:FindFirstChildOfClass("Highlight") then return end
    local color = ColorFor(m)
    if not color then return end
    local hl = Instance.new("Highlight")
    hl.Name = "SlenderHubESP"
    hl.FillColor = color
    hl.FillTransparency = 0.6
    hl.OutlineColor = color
    hl.OutlineTransparency = 0
    hl.Parent = m
end

local function SetESP(enabled)
    ESPOn = enabled
    if not enabled then
        for _, hl in ipairs(workspace:GetDescendants()) do
            if hl:IsA("Highlight") and hl.Name == "SlenderHubESP" then hl:Destroy() end
        end
        return
    end
    task.spawn(function()
        while ESPOn and task.wait(0.5) do
            pcall(function()
                for _, m in ipairs(workspace:GetDescendants()) do
                    if m:IsA("Model") and m.PrimaryPart then
                        AddHighlight(m)
                    end
                end
            end)
        end
    end)
end

-- =====================================
-- AUTO INTERACT
-- =====================================
local AutoInteractOn = false

local function FindPrompts()
    local list = {}
    for _, tag in ipairs({ "Inspect", "ShopItemPP" }) do
        for _, inst in ipairs(CollectionService:GetTagged(tag)) do
            if inst:IsA("ProximityPrompt") then
                table.insert(list, inst)
            else
                for _, desc in ipairs(inst:GetDescendants()) do
                    if desc:IsA("ProximityPrompt") then
                        table.insert(list, desc)
                    end
                end
            end
        end
    end
    return list
end

local function SetAutoInteract(enabled)
    AutoInteractOn = enabled
    if not enabled then return end
    if not FirePromptFn then
        SafeNotify("Executor", "fireproximityprompt não disponível", 4)
        return
    end
    task.spawn(function()
        local last = {}
        while AutoInteractOn and task.wait(0.8) do
            pcall(function()
                local root = GetRoot()
                local now = os.clock()
                for _, prompt in ipairs(FindPrompts()) do
                    if not last[prompt] or now - last[prompt] > 6 then
                        local parent = prompt.Parent
                        local pos = parent and (parent:IsA("BasePart") and parent.Position
                            or (parent.PrimaryPart and parent.PrimaryPart.Position)) or nil
                        if root and pos and (root.Position - pos).Magnitude < 40 then
                            FirePromptFn(prompt)
                            last[prompt] = now
                        end
                    end
                end
            end)
        end
    end)
end

-- =====================================
-- FARM ENGINE (estilo hubs OP: Auto Interact ALL + Slime/Fogo + Revive + Café)
-- =====================================
-- Mecânica real do jogo (dump):
--   * Todo o fluxo de check-in/tratamento/diagnóstico é SERVER-SIDE via
--     ProximityPrompts e ClickDetectors (sem remote dedicado). O farm é:
--     varrer TODOS os prompts, teleportar perto e disparar (fireproximityprompt).
--   * Slime (Grime, tag "Grime") e fogo (tag "OnFire"): o servidor spawna bolhas
--     ("SprayingBubbles") quando o jogador USA o extintor; as bolhas ao tocar
--     disparam FireServer("ExtinguisherBubbleHitGrime"/"ExtinguisherBubbleHit*")
--     que paga cash. Teleportar ACIMA do hazard e ativar o extintor.
--   * Reviver: tag "DeadPlayer" + FireServer("ReviveOther", player).
--   * Sanidade: atributo do jogador "Sanity" (0-100); café recupera.
local FarmOn = false
local DiagnoseOn = false
local AttendOn = false
local ReviveOn = false
local CoffeeOn = false
local InstantPromptOn = false
local FarmTargetPos = nil -- ESP/indicador do alvo atual (opcional)

local function FindAllPrompts()
    local list = {}
    for _, desc in ipairs(workspace:GetDescendants()) do
        if desc:IsA("ProximityPrompt") then
            table.insert(list, desc)
        end
    end
    return list
end

local function PromptPos(prompt)
    local p = prompt.Parent
    if not p then return nil end
    if p:IsA("BasePart") then return p.Position end
    if p.PrimaryPart then return p.PrimaryPart.Position end
    return nil
end

local function FirePrompt(prompt)
    if FirePromptFn then
        pcall(FirePromptFn, prompt)
    else
        -- Fallback: simula o input (métodos públicos do ProximityPrompt)
        pcall(function() prompt:InputHoldBegin() end)
        task.wait(0.15)
        pcall(function() prompt:InputHoldEnd() end)
    end
end

local function TeleportNear(pos, dist)
    local root = GetRoot()
    if not root or not pos then return end
    local delta = pos - root.Position
    local mag = delta.Magnitude
    if mag < (dist or 6) then return end
    root.CFrame = CFrame.new(root.Position + delta.Unit * (mag - (dist or 6)))
end

-- INSTANT PROMPTS: HoldDuration=0 + distância máxima em TODOS os PPs do mapa.
-- Técnica universal dos hubs OP deste jogo (Patch Hub, 4479, etc.).
local function ApplyInstantPrompt(prompt)
    pcall(function()
        prompt.HoldDuration = 0
        prompt.MaxActivationDistance = math.max(prompt.MaxActivationDistance, 60)
        prompt.RequiresLineOfSight = false
        prompt.ClickablePrompt = true
    end)
end

local function SetInstantPrompts(enabled)
    InstantPromptOn = enabled
    if not enabled then
        SafeNotify("Instant Prompts", "Desativado", 2)
        return
    end
    task.spawn(function()
        while InstantPromptOn and task.wait(1) do
            pcall(function()
                for _, prompt in ipairs(FindAllPrompts()) do
                    ApplyInstantPrompt(prompt)
                end
                -- também pega novos PPs que nascerem
                for _, prompt in ipairs(workspace:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") then ApplyInstantPrompt(prompt) end
                end
            end)
        end
    end)
end

-- Extintor: procura Tool no inventário/equipado (nome/atributo genérico)
local function FindExtinguisher()
    local function check(tool)
        if not tool or not tool:IsA("Tool") then return false end
        local n = string.lower(tool.Name)
        if string.find(n, "extinguisher") or string.find(n, "extintor") then return true end
        if tool:GetAttribute("FireExtinguisher") or tool:GetAttribute("IsFireExtinguisher") then return true end
        return false
    end
    for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
        if check(tool) then return tool end
    end
    local char = LocalPlayer.Character
    if char then
        for _, tool in ipairs(char:GetChildren()) do
            if check(tool) then return tool end
        end
    end
    return nil
end

local function FindHazards(tag)
    local best, bestDist = nil, math.huge
    local root = GetRoot()
    for _, m in ipairs(CollectionService:GetTagged(tag)) do
        local pos
        if m:IsA("BasePart") then
            pos = m.Position
        elseif m:IsA("Model") and m.PrimaryPart then
            pos = m.PrimaryPart.Position
        end
        if pos then
            local d = root and (root.Position - pos).Magnitude or 0
            if d < bestDist then best, bestDist = m, d end
        end
    end
    return best
end

local function HazardPos(hazard)
    if hazard:IsA("BasePart") then return hazard.Position end
    if hazard:IsA("Model") and hazard.PrimaryPart then return hazard.PrimaryPart.Position end
    return nil
end

local function UseExtinguisher(tool)
    local hum = GetHumanoid()
    if not hum or not tool then return end
    pcall(function() hum:EquipTool(tool) end)
    task.wait(0.15)
    pcall(function() tool:Activate() end)
end

-- AUTO FARM: limpa slime (Grime) e apaga fogo (OnFire) teleportando ACIMA do hazard
local function SetAutoFarm(enabled)
    FarmOn = enabled
    if not enabled then
        SafeNotify("Auto Farm", "Desativado", 2)
        return
    end
    task.spawn(function()
        local warnedNoTool = false
        while FarmOn and task.wait(1.2) do
            pcall(function()
                local tool = FindExtinguisher()
                if not tool then
                    if not warnedNoTool then
                        SafeNotify("Auto Farm", "Extintor não encontrado no inventário", 4)
                        warnedNoTool = true
                    end
                    return
                end
                warnedNoTool = false
                local target = FindHazards("Grime") or FindHazards("OnFire")
                if not target then return end
                local pos = HazardPos(target)
                if not pos then return end
                FarmTargetPos = pos
                -- Teleporta ACIMA (os hubs OP fazem isso: bolhas caem no alvo)
                local root = GetRoot()
                if root then
                    local dest = CFrame.new(pos + Vector3.new(0, 6, 0))
                    root.CFrame = dest
                end
                UseExtinguisher(tool)
                task.wait(0.7)
                UseExtinguisher(tool)
            end)
        end
    end)
end

-- AUTO DIAGNOSE: dispara prompts de inspeção (tag Inspect)
local function SetAutoDiagnose(enabled)
    DiagnoseOn = enabled
    if not enabled then
        SafeNotify("Auto Diagnose", "Desativado", 2)
        return
    end
    task.spawn(function()
        local last = {}
        while DiagnoseOn and task.wait(1.2) do
            pcall(function()
                local now = os.clock()
                for _, prompt in ipairs(FindAllPrompts()) do
                    if prompt:HasTag("Inspect") then
                        local pos = PromptPos(prompt)
                        if pos and (not last[prompt] or now - last[prompt] > 5) then
                            TeleportNear(pos, 4)
                            FirePrompt(prompt)
                            last[prompt] = now
                            task.wait(0.5)
                        end
                    end
                end
            end)
        end
    end)
end

-- AUTO ATENDIMENTO: dispara QUALQUER PP/ClickDetector do mapa (check-in,
-- badges, máquinas, tratamento, pacientes). Técnica "Auto-Interact ALL"
-- dos hubs OP: prioriza os mais próximos, teleporta e dispara.
local function SetAutoAttend(enabled)
    AttendOn = enabled
    if not enabled then
        SafeNotify("Auto Atendimento", "Desativado", 2)
        return
    end
    task.spawn(function()
        local last = {}
        while AttendOn and task.wait(1.0) do
            pcall(function()
                local now = os.clock()
                local root = GetRoot()
                -- PPs ordenados por proximidade (mais próximo primeiro)
                local prompts = FindAllPrompts()
                local sorted = {}
                for _, prompt in ipairs(prompts) do
                    if prompt.Enabled and not prompt:HasTag("Inspect") then
                        local pos = PromptPos(prompt)
                        if pos then
                            table.insert(sorted, { prompt = prompt, pos = pos,
                                d = root and (root.Position - pos).Magnitude or math.huge })
                        end
                    end
                end
                table.sort(sorted, function(a, b) return a.d < b.d end)
                for _, item in ipairs(sorted) do
                    local prompt, pos = item.prompt, item.pos
                    if not last[prompt] or now - last[prompt] > 4 then
                        TeleportNear(pos, 3)
                        FirePrompt(prompt)
                        last[prompt] = now
                        task.wait(0.35)
                    end
                end
                -- ClickDetectors (algumas máquinas usam CD em vez de PP)
                for _, cd in ipairs(workspace:GetDescendants()) do
                    if cd:IsA("ClickDetector") and cd.Parent and cd.Parent:IsA("BasePart") then
                        local pos = cd.Parent.Position
                        if (not last[cd] or now - last[cd] > 4) then
                            TeleportNear(pos, 3)
                            pcall(function()
                                if fireclickdetector then
                                    fireclickdetector(cd)
                                else
                                    cd:Click()
                                end
                            end)
                            last[cd] = now
                            task.wait(0.35)
                        end
                    end
                end
            end)
        end
    end)
end

-- AUTO REVIVE: revive jogadores caídos (tag DeadPlayer)
local function SetAutoRevive(enabled)
    ReviveOn = enabled
    if not enabled then
        SafeNotify("Auto Revive", "Desativado", 2)
        return
    end
    task.spawn(function()
        local last = {}
        while ReviveOn and task.wait(1.5) do
            pcall(function()
                local now = os.clock()
                for _, p in ipairs(CollectionService:GetTagged("DeadPlayer")) do
                    if p:IsA("Player") and p ~= LocalPlayer and (not last[p] or now - last[p] > 12) then
                        last[p] = now
                        NetFire("ReviveOther", p)
                    end
                end
            end)
        end
    end)
end

-- AUTO CAFÉ: usa item de café quando a sanidade está baixa
-- AUTO CAFÉ com teleporte para a máquina: se não há café no inventário,
-- procura a máquina de café no mapa (nome contém coffee/café), teleporta e
-- interage com o prompt dela para pegar um café.
local function FindCoffeeMachine()
    local root = GetRoot()
    local best, bestD = nil, math.huge
    for _, part in ipairs(workspace:GetDescendants()) do
        if part:IsA("BasePart") then
            local n = string.lower(part.Name)
            if string.find(n, "coffee") or string.find(n, "café") then
                local d = root and (root.Position - part.Position).Magnitude or 0
                if d < bestD then best, bestD = part, d end
            end
        end
    end
    return best
end

local function SetAutoCoffee(enabled)
    CoffeeOn = enabled
    if not enabled then
        SafeNotify("Auto Café", "Desativado", 2)
        return
    end
    task.spawn(function()
        local warnedNoCoffee = false
        while CoffeeOn and task.wait(2) do
            pcall(function()
                local sanity = LocalPlayer:GetAttribute("Sanity") or 100
                if sanity > 60 then return end
                -- 1) tenta café no inventário
                for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
                    if tool:IsA("Tool") then
                        local n = string.lower(tool.Name)
                        if string.find(n, "coffee") or string.find(n, "café") or string.find(n, "drink") then
                            local hum = GetHumanoid()
                            if hum then pcall(function() hum:EquipTool(tool) end) end
                            task.wait(0.2)
                            pcall(function() tool:Activate() end)
                            warnedNoCoffee = false
                            task.wait(4)
                            return
                        end
                    end
                end
                -- 2) fallback: teleporta para a máquina e interage
                local machine = FindCoffeeMachine()
                if machine then
                    TeleportNear(machine.Position, 3)
                    task.wait(0.3)
                    for _, prompt in ipairs(FindAllPrompts()) do
                        if prompt.Parent == machine or (prompt.Parent and prompt.Parent:IsDescendantOf(machine)) then
                            FirePrompt(prompt)
                            break
                        end
                    end
                    warnedNoCoffee = false
                    task.wait(2)
                    return
                end
                if not warnedNoCoffee then
                    SafeNotify("Auto Café", "Nenhum café no inventário/máquina", 4)
                    warnedNoCoffee = true
                end
            end)
        end
    end)
end

-- AUTO SHIFT LOOP: detecta o fim do turno (UI RoundStatsDetailed visível,
-- evento DisplayRoundStats) e vota replay automaticamente = turnos infinitos.
local ShiftLoopOn = false

local function RoundStatsVisible()
    pcall(function()
        if not (Lib and Lib.UI and Lib.UI.Get) then return false end
        local ui = Lib.UI.Get("RoundStatsDetailed")
        return ui and ui.Visible == true
    end)
end

local function SetAutoShiftLoop(enabled)
    ShiftLoopOn = enabled
    if not enabled then
        SafeNotify("Auto Shift Loop", "Desativado", 2)
        return
    end
    task.spawn(function()
        local votedAt = 0
        while ShiftLoopOn and task.wait(1.0) do
            pcall(function()
                if RoundStatsVisible() then
                    local now = os.clock()
                    if now - votedAt > 8 then
                        votedAt = now
                        NetFire("PlayAgainVote")
                        SafeNotify("Auto Shift", "Voto em jogar novamente enviado", 3)
                    end
                end
            end)
        end
    end)
end

-- HUD DE OBJETIVO: mostra o objetivo atual (UI Objective) em toast e
-- (se ativo) teleporta até o alvo apontado pelo objetivo.
local ObjHudOn = false
local ObjTpOn = false

local function GetObjectiveText()
    pcall(function()
        if not (Lib and Lib.UI and Lib.UI.Get) then return nil end
        local ui = Lib.UI.Get("Objective")
        if not ui then return nil end
        local f = ui:FindFirstChild("Frame")
        local t = f and f:FindFirstChild("objective")
        return t and t.Text or nil
    end)
end

local function SetObjHud(enabled)
    ObjHudOn = enabled
    if not enabled then
        SafeNotify("HUD Objetivo", "Desativado", 2)
        return
    end
    task.spawn(function()
        local lastText = ""
        while ObjHudOn and task.wait(1.5) do
            pcall(function()
                local txt = GetObjectiveText()
                if txt and txt ~= lastText then
                    lastText = txt
                    SafeNotify("Objetivo", txt, 4)
                end
            end)
        end
    end)
end

local function SetObjTeleport(enabled)
    ObjTpOn = enabled
    if not enabled then
        SafeNotify("TP Objetivo", "Desativado", 2)
        return
    end
    task.spawn(function()
        local lastTarget = nil
        while ObjTpOn and task.wait(1.0) do
            pcall(function()
                -- alvo do ponteiro (SetPointerTarget) — procura o mais próximo
                -- de uma instância marcada como objetivo pelo servidor
                local root = GetRoot()
                if not root then return end
                local best, bestD = nil, 45
                for _, part in ipairs(workspace:GetDescendants()) do
                    if part:IsA("BasePart") and part:HasTag("ObjectiveTarget") then
                        local d = (root.Position - part.Position).Magnitude
                        if d < bestD then best, bestD = part, d end
                    end
                end
                if best then
                    TeleportNear(best.Position, 4)
                    lastTarget = best
                end
            end)
        end
    end)
end

-- AUTO PACIENTES CAÍDOS: acha NPCs desmaiados (Humanoid.Health <= 0 que não
-- são jogadores) e teleporta perto para o prompt de carregar aparecer/ser disparado.
local CarryOn = false

local function SetAutoCarry(enabled)
    CarryOn = enabled
    if not enabled then
        SafeNotify("Auto Carregar", "Desativado", 2)
        return
    end
    task.spawn(function()
        while CarryOn and task.wait(1.5) do
            pcall(function()
                local root = GetRoot()
                if not root then return end
                local best, bestD = nil, math.huge
                for _, model in ipairs(workspace:GetDescendants()) do
                    if model:IsA("Model") and model ~= LocalPlayer.Character then
                        local hum = model:FindFirstChildOfClass("Humanoid")
                        if hum and hum.Health <= 0 and hum.MaxHealth > 0 then
                            local prim = model.PrimaryPart
                            if prim then
                                local d = (root.Position - prim.Position).Magnitude
                                if d < bestD then best, bestD = model, d end
                            end
                        end
                    end
                end
                if best and best.PrimaryPart then
                    FarmTargetPos = best.PrimaryPart.Position
                    TeleportNear(best.PrimaryPart.Position, 4)
                end
            end)
        end
    end)
end

-- =====================================
-- FEATURES OP (tags/prompts reais confirmadas via strings do Foxname Hub):
--   * Auto Check-In: tags "VisitorAtCheckIn"/"VisitorAtCheckIn2", badges
--     "PrintedBadge"/"PatientBadgeBase"/"VisitorBadgeBase", "CompletedCheckIn"
--   * Auto Taser: tag "TaserStation", remote "RE/TaserFired", "FoxnameTasered"
--   * Auto Ask Leave / Put Out Fire: prompts com ActionText "ask to leave"/"put out fire"
--   * Auto Barney Coffee: "CoffeeMachine2" + NPC Barney ("AutoBarneyCoffee")
--   * Auto Help Patient: prompt "help" (tag "AlwaysFaints")
-- =====================================
local CheckInOn = false
local TaserOn = false
local AskLeaveOn = false
local PutOutFireOn = false
local BarneyCoffeeOn = false
local HelpPatientOn = false

local function FindPromptByText(texts)
    for _, prompt in ipairs(FindAllPrompts()) do
        if prompt.Enabled then
            local at = string.lower(prompt.ActionText or "")
            for _, t in ipairs(texts) do
                if string.find(at, t) then return prompt end
            end
        end
    end
    return nil
end

-- AUTO CHECK-IN: encontra o prompt de check-in do NPC na fila, dispara,
-- espera a badge sair da impressora e pega. Tags confirmadas do jogo.
local function SetAutoCheckIn(enabled)
    CheckInOn = enabled
    if not enabled then
        SafeNotify("Auto Check-In", "Desativado", 2)
        return
    end
    task.spawn(function()
        while CheckInOn and task.wait(1.0) do
            pcall(function()
                -- 1) dispara prompt de check-in do visitante
                local prompt = FindPromptByText({ "check", "check-in", "checkin", "register" })
                if not prompt then
                    -- fallback: tag VisitorAtCheckIn
                    for _, tag in ipairs({ "VisitorAtCheckIn", "VisitorAtCheckIn2" }) do
                        for _, inst in ipairs(CollectionService:GetTagged(tag)) do
                            local pp = inst:FindFirstChildWhichIsA("ProximityPrompt")
                                or inst:FindFirstChildOfClass("ProximityPrompt")
                            if pp then prompt = pp break end
                        end
                        if prompt then break end
                    end
                end
                if prompt then
                    TeleportNear(PromptPos(prompt) or Vector3.new(), 3)
                    FirePrompt(prompt)
                    task.wait(0.4)
                end
                -- 2) pega a badge impressa
                local badge = nil
                for _, tag in ipairs({ "PrintedBadge", "PatientBadgeBase", "VisitorBadgeBase" }) do
                    for _, inst in ipairs(CollectionService:GetTagged(tag)) do
                        local pos = inst:IsA("BasePart") and inst.Position
                            or (inst.PrimaryPart and inst.PrimaryPart.Position) or nil
                        if pos then badge = { inst = inst, pos = pos } break end
                    end
                    if badge then break end
                end
                if badge then
                    TeleportNear(badge.pos, 3)
                    local pp = badge.inst:FindFirstChildWhichIsA("ProximityPrompt")
                        or badge.inst:FindFirstChildOfClass("ProximityPrompt")
                    if pp then FirePrompt(pp) end
                    task.wait(0.3)
                end
            end)
        end
    end)
end

-- AUTO TASER: quando uma anomalia está ativa, procura a estação de taser,
-- pega e dispara. Tags confirmadas: "TaserStation", remote "RE/TaserFired".
local function SetAutoTaser(enabled)
    TaserOn = enabled
    if not enabled then
        SafeNotify("Auto Taser", "Desativado", 2)
        return
    end
    task.spawn(function()
        local lastFire = 0
        while TaserOn and task.wait(1.2) do
            pcall(function()
                local now = os.clock()
                if now - lastFire < 8 then return end
                -- procura a estação de taser
                local station = nil
                for _, inst in ipairs(CollectionService:GetTagged("TaserStation")) do
                    local pos = inst:IsA("BasePart") and inst.Position
                        or (inst.PrimaryPart and inst.PrimaryPart.Position) or nil
                    if pos then station = { inst = inst, pos = pos } break end
                end
                if not station then return end
                -- equipa o taser se estiver no inventário
                local taser = nil
                for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
                    if tool:IsA("Tool") and string.find(string.lower(tool.Name), "taser") then
                        taser = tool break
                    end
                end
                -- vai até a estação para pegar o taser
                TeleportNear(station.pos, 4)
                local pp = station.inst:FindFirstChildWhichIsA("ProximityPrompt")
                    or station.inst:FindFirstChildOfClass("ProximityPrompt")
                if pp then FirePrompt(pp) end
                task.wait(0.5)
                if taser then
                    local hum = GetHumanoid()
                    if hum then pcall(function() hum:EquipTool(taser) end) end
                    task.wait(0.2)
                    pcall(function() taser:Activate() end)
                    lastFire = now
                    NetFire("TaserFired")
                end
            end)
        end
    end)
end

-- AUTO ASK TO LEAVE: quando uma anomalia está com "ask to leave", dispara
-- o prompt para ela sair (evita que o turno acabe).
local function SetAutoAskLeave(enabled)
    AskLeaveOn = enabled
    if not enabled then
        SafeNotify("Auto Ask Leave", "Desativado", 2)
        return
    end
    task.spawn(function()
        while AskLeaveOn and task.wait(1.0) do
            pcall(function()
                local prompt = FindPromptByText({ "ask to leave", "leave" })
                if prompt then
                    TeleportNear(PromptPos(prompt) or Vector3.new(), 3)
                    FirePrompt(prompt)
                    task.wait(0.5)
                end
            end)
        end
    end)
end

-- AUTO PUT OUT FIRE: complementa o Auto Farm de fogo — dispara o prompt
-- "put out fire" quando existe (algumas salas usam prompt em vez de extintor).
local function SetAutoPutOutFire(enabled)
    PutOutFireOn = enabled
    if not enabled then
        SafeNotify("Auto Apagar Fogo", "Desativado", 2)
        return
    end
    task.spawn(function()
        while PutOutFireOn and task.wait(1.0) do
            pcall(function()
                local prompt = FindPromptByText({ "put out fire", "extinguish", "extinguisher" })
                if prompt then
                    TeleportNear(PromptPos(prompt) or Vector3.new(), 3)
                    FirePrompt(prompt)
                    task.wait(0.5)
                end
            end)
        end
    end)
end

-- AUTO BARNEY COFFEE: dá café para o Barney (NPC que sempre pede café).
-- Tags confirmadas: "CoffeeMachine2", NPC "Barney".
local function SetAutoBarneyCoffee(enabled)
    BarneyCoffeeOn = enabled
    if not enabled then
        SafeNotify("Auto Café Barney", "Desativado", 2)
        return
    end
    task.spawn(function()
        while BarneyCoffeeOn and task.wait(2) do
            pcall(function()
                -- procura o Barney
                local barney = nil
                for _, npc in ipairs(workspace:GetDescendants()) do
                    if npc:IsA("Model") and string.find(string.lower(npc.Name), "barney") then
                        local prim = npc.PrimaryPart
                        if prim then barney = { model = npc, pos = prim.Position } break end
                    end
                end
                if not barney then return end
                -- se o Barney precisa de café (café na mão dele)
                local needs = false
                for _, tag in ipairs({ "AutoBarneyCoffee", "NeedsCoffee", "Coffee" }) do
                    if barney.model:HasTag(tag) then needs = true break end
                end
                if not needs then return end
                -- pega café na máquina
                local machine = workspace.Misc and workspace.Misc:FindFirstChild("CoffeeMachine2")
                local pos = machine and (machine:IsA("BasePart") and machine.Position
                    or (machine.PrimaryPart and machine.PrimaryPart.Position)) or nil
                if pos then
                    TeleportNear(pos, 3)
                    local pp = machine:FindFirstChildWhichIsA("ProximityPrompt")
                        or machine:FindFirstChildOfClass("ProximityPrompt")
                    if pp then FirePrompt(pp) end
                    task.wait(0.5)
                end
                -- entrega para o Barney
                TeleportNear(barney.pos, 4)
                local pp = barney.model:FindFirstChildWhichIsA("ProximityPrompt")
                    or barney.model:FindFirstChildOfClass("ProximityPrompt")
                if pp then FirePrompt(pp) end
                task.wait(0.5)
            end)
        end
    end)
end

-- AUTO HELP PATIENT: dispara prompts de ajuda de pacientes (tag "AlwaysFaints"
-- ou ActionText "help").
local function SetAutoHelpPatient(enabled)
    HelpPatientOn = enabled
    if not enabled then
        SafeNotify("Auto Ajudar Paciente", "Desativado", 2)
        return
    end
    task.spawn(function()
        while HelpPatientOn and task.wait(1.2) do
            pcall(function()
                local prompt = FindPromptByText({ "help" })
                if not prompt then
                    for _, inst in ipairs(CollectionService:GetTagged("AlwaysFaints")) do
                        local pp = inst:FindFirstChildWhichIsA("ProximityPrompt")
                            or inst:FindFirstChildOfClass("ProximityPrompt")
                        if pp then prompt = pp break end
                    end
                end
                if prompt then
                    TeleportNear(PromptPos(prompt) or Vector3.new(), 3)
                    FirePrompt(prompt)
                    task.wait(0.5)
                end
            end)
        end
    end)
end

-- =====================================
-- MOVEMENT
-- =====================================
local NoclipOn = false
local FlyOn = false
local NoclipConn = nil

local function SetWalkSpeed(v)
    local hum = GetHumanoid()
    if hum then hum.WalkSpeed = v end
end

local function SetNoclip(enabled)
    NoclipOn = enabled
    if not enabled then
        if NoclipConn then NoclipConn:Disconnect() NoclipConn = nil end
        return
    end
    if NoclipConn then NoclipConn:Disconnect() end
    NoclipConn = RunService.Stepped:Connect(function()
        local hum = GetHumanoid()
        if not hum then return end
        hum:ChangeState(Enum.HumanoidStateType.Physics)
        local root = GetRoot()
        if root then root.Velocity = Vector3.new(0, 0, 0) end
    end)
end

local function SetFly(enabled)
    FlyOn = enabled
    if not enabled then return end
    task.spawn(function()
        while FlyOn and task.wait() do
            local hum = GetHumanoid()
            local root = GetRoot()
            if not hum or not root then break end
            local vel = root.AssemblyLinearVelocity or Vector3.new(0, 0, 0)
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vel = vel + Vector3.new(0, 60, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then vel = vel - Vector3.new(0, 60, 0) end
            root.AssemblyLinearVelocity = Vector3.new(vel.X, vel.Y, vel.Z)
        end
    end)
end

