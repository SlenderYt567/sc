-- ============================================================
-- AUTO BUY SHOP: compra itens médicos por prioridade
-- Tag REAL confirmada (PlayerUpgradeShopLocal): "ShopItemPP" (+ ItemInfo.UI)
-- ============================================================
local BuyShopOn = false
local ShopPriority = { "Medkit", "Bandages", "Medicine", "Antibiotics", "Eye Drops", "Thermo" }

local function GetLocalCash()
    local data = GetData()
    if data and data.Stats and data.Stats.LocalCash then return data.Stats.LocalCash end
    -- fallback: atributo
    return LocalPlayer:GetAttribute("LocalCash") or 0
end

local function SetAutoBuyShop(enabled)
    BuyShopOn = enabled
    if not enabled then
        SafeNotify("Auto Buy Shop", "Desativado", 2)
        return
    end
    task.spawn(function()
        local last = {}
        while BuyShopOn and task.wait(3) do
            pcall(function()
                local now = os.clock()
                local cash = GetLocalCash()
                for _, inst in ipairs(CollectionService:GetTagged("ShopItemPP")) do
                    if inst:IsA("ProximityPrompt") or inst:FindFirstChildWhichIsA("ProximityPrompt") then
                        local pp = inst:IsA("ProximityPrompt") and inst or inst:FindFirstChildWhichIsA("ProximityPrompt")
                        local parent = pp.Parent
                        local pos = parent and (parent:IsA("BasePart") and parent.Position
                            or (parent.PrimaryPart and parent.PrimaryPart.Position)) or nil
                        local name = string.lower(parent and parent.Name or "")
                        local prio = 999
                        for i, item in ipairs(ShopPriority) do
                            if string.find(name, string.lower(item)) then prio = i break end
                        end
                        if prio < 999 and pos and (not last[pp] or now - last[pp] > 15) then
                            TeleportNear(pos, 3)
                            FirePrompt(pp)
                            last[pp] = now
                            SafeNotify("Shop", "Comprando: " .. tostring(parent and parent.Name), 2)
                            task.wait(1)
                        end
                    end
                end
            end)
        end
    end)
end

