--// ==============================[ AGENTES & SKILLS ]============================== //--
-- Expertise: [Roblox_Lua_Expert, Roblox_UI_Expert, Roblox_Bypass_Expert]

local UISkill = {}
function UISkill.Animate(object, properties, info)
    if not object then return end
    local tween = TweenService:Create(object, info or TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), properties)
    tween:Play()
    return tween
end

function UISkill.CreateRipple(buttonInstance)
    if not buttonInstance:IsA("GuiObject") then return end
    buttonInstance.ClipsDescendants = true
    buttonInstance.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            local ripple = Instance.new("Frame")
            ripple.Name = "Ripple"
            ripple.Parent = buttonInstance
            ripple.BackgroundColor3 = Color3.new(1, 1, 1)
            ripple.BackgroundTransparency = 0.6
            ripple.Size = UDim2.new(0, 0, 0, 0)
            ripple.Position = UDim2.new(0, input.Position.X - buttonInstance.AbsolutePosition.X, 0, input.Position.Y - buttonInstance.AbsolutePosition.Y)
            ripple.AnchorPoint = Vector2.new(0.5, 0.5)
            
            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(1, 0)
            corner.Parent = ripple
            
            UISkill.Animate(ripple, {
                Size = UDim2.new(0, buttonInstance.AbsoluteSize.X * 2.5, 0, buttonInstance.AbsoluteSize.X * 2.5),
                BackgroundTransparency = 1
            }, TweenInfo.new(0.6))
            
            task.delay(0.6, function() ripple:Destroy() end)
        end
    end)
end

-- SecuritySkill — Throttle apenas (SafeRequest removido, usa Platoboost agora)
local SecuritySkill = { _throttleStates = {} }
function SecuritySkill.Throttle(interval, identifier, func, ...)
    -- 'identifier' é uma string única pra cada função (ex: "Launch")
    local state = SecuritySkill._throttleStates[identifier]
    if not state then
        state = { LastCall = 0 }
        SecuritySkill._throttleStates[identifier] = state
    end
    local now = tick()
    if now - state.LastCall >= interval then
        state.LastCall = now
        return true, func(...)
    end
    return false, "Throttled"
end

