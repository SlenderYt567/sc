-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• TAB: FIESTA MAZE â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

do
    local page = createPage("Fiesta Maze")

    local status = createStatus(page, "Fiesta Maze: aguardando estado...")

    taskSpawn(function()
        while ScreenGui and ScreenGui.Parent do
            local label = status:FindFirstChildOfClass("TextLabel")
            if label then
                local cleared, total = Fiesta.progress()
                local keys = Fiesta.bossKeys()
                local cursed = Fiesta.isCursed()
                local state = Fiesta.getState()
                if state then
                    label.Text = string.format(
                        "Maze: %d/%d salas limpas Â· Boss Keys: %d Â· %s",
                        cleared, total, keys, cursed and "CURSED" or "normal"
                    )
                else
                    label.Text = "Fiesta Maze: fora do maze (ou instancia nao replicada)"
                end
            end
            taskWait(1)
        end
    end)

    createToggle(page, "Auto PiÃ±ata (Maze)", "Quebra quebrÃ¡veis dentro das salas do maze", function() return Features.FiestaAutoBreak end, function(v)
        Features.FiestaAutoBreak = v
        toast(v and "Auto PiÃ±ata: ON" or "Auto PiÃ±ata: OFF", v and CONFIG.Success or CONFIG.Danger)
    end)

    createToggle(page, "Auto Boss (GX_Redeem)", "Usa Fiesta Boss Key automaticamente na boss room", function() return Features.FiestaAutoBoss end, function(v)
        Features.FiestaAutoBoss = v
        toast(v and "Auto Boss: ON" or "Auto Boss: OFF", v and CONFIG.Success or CONFIG.Danger)
    end)

    createToggle(page, "Auto Chest (Maze)", "Abre baÃºs das salas do maze", function() return Features.FiestaAutoChest end, function(v)
        Features.FiestaAutoChest = v
    end)

    createButton(page, "ðŸ”‘ Abrir Boss Room (GX_Redeem)", function()
        if Fiesta.redeemBoss() then
            toast("GX_Redeem enviado", CONFIG.Success)
        else
            toast("Falha no GX_Redeem â€” remote mudou? (dump Dex)", CONFIG.Danger)
        end
    end)

    createButton(page, "ðŸŽ† Ir para a Prize Room", function()
        if Fiesta.sendToPrizeRoom() then
            toast("Enviado para a Prize Room", CONFIG.Success)
        else
            local cf = Fiesta.prizeRoomArrival()
            if cf then
                local hrp = getHRP()
                if hrp and hrp:IsA("BasePart") then
                    pcall(function() hrp.CFrame = cf end)
                    toast("Teleportado para a Prize Room", CONFIG.Success)
                end
            else
                toast("Prize Room nÃ£o encontrada", CONFIG.Danger)
            end
        end
    end)

    createButton(page, "âš« Desativar AutoRaid", function()
        if Fiesta.disableAutoRaid() then
            toast("AutoRaid desativado", CONFIG.Success)
        else
            toast("Remote AutoRaid_Disable nÃ£o encontrado", CONFIG.Danger)
        end
    end)

    createButton(page, "ðŸ“Š Mostrar caminho (salas onPath)", function()
        local rooms = Fiesta.getPathRooms()
        if #rooms > 0 then
            toast("Caminho do maze: " .. #rooms .. " salas", CONFIG.Accent)
        else
            toast("Nenhuma sala onPath encontrada", CONFIG.Danger)
        end
    end)

    layout(page)
end

