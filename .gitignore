        end
        table.sort(found)
        local label = status:FindFirstChildOfClass("TextLabel")
        if label then
            label.Text = "Remotes detectados: " .. (#found > 0 and table.concat(found, ", ") or "NENHUM â€” use dump Dex para ajustar CONFIG.RemotePaths")
        end
    end)

    createButton(page, "ðŸ”‘ Keybind: RightShift (toggle UI)", function()
        toast("Keybind padrÃ£o: RightShift", CONFIG.Accent)
