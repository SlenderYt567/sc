--[[
    SlenderHub | Animal Hospital (Anomaly) — Script Premium
    Dev: SlenderHub Team
    Versão: 3.0.0 (UI Fluent + recalibração dump 07/08/2026)

    Feito para executors PC (Wave/Codex/Delta/etc.) com matriz de fallback.
    UI: Fluent (dawid-scripts) — mesmo padrão do Horse Race.
    Key system: verificação via API do SlenderHub (pluggável).

    CALIBRAÇÃO REAL (dump SlenderHub_GameDumper — 07/08/2026):
    - Todo o tráfego passa por ReplicatedStorage/Lib com wrapper
      Network:FireServer(nome, ...) → roteia para RE/RequestRemoteEvent.
      Este script usa o PRÓPRIO Lib do jogo (require direto).
    - Sanidade: toda perda é client-side via Lib.PlayerLostSanity(amount, reason).
      Bloquear no wrapper = sanidade infinita de verdade (servidor nunca recebe).
    - Morte: atributos DeathCount/MAX_DeathCount em game.Players (replicados);
      revive via minigame de coração HeartbeatMinigameComplete(state, true).
    - Tags CollectionService: NPC, Anomaly, Door, Inspect, Grime, ShopItemPP,
      EmergencyEventCounter, StalkerMonster, TallMonsterSpawn, Shadow.
    - HONEYPOTS confirmados (NÃO FIRE): RE/ScannerKillGhost, RE/DialogDecision.
]]

-- =====================================
-- CONFIG
-- =====================================
local Config = {
    VerifyUrl  = "https://www.slenderhub.shop/api/exec",
    AllowTrial = true,
    WalkSpeed  = 22,
    SanityFloor = 100,
    EspGood    = Color3.fromRGB(60, 255, 120),
    EspDanger  = Color3.fromRGB(255, 60, 60),
    EspTask    = Color3.fromRGB(250, 180, 60),
    EspDoor    = Color3.fromRGB(60, 130, 250),
    ScareGuis  = { "Jumpscare", "static", "DontLookUp", "EmergencyCounter" },
}

-- =====================================
-- LOAD FLUENT (fallback: aviso claro se falhar)
-- =====================================
local Fluent = nil
local LoadError = nil

local okL, errL = pcall(function()
    return loadstring(game:HttpGet(
        "https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"
    ))()
end)
if okL and type(errL) == "table" and errL.CreateWindow then
    Fluent = errL
else
    LoadError = "Fluent: " .. tostring(okL and "retorno inválido (nil/loadstring)" or errL)
end

local SaveManager, InterfaceManager
if Fluent then
    pcall(function()
        SaveManager = loadstring(game:HttpGet(
            "https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/SaveManager.lua"
        ))()
    end)
    pcall(function()
        InterfaceManager = loadstring(game:HttpGet(
            "https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/InterfaceManager.lua"
        ))()
    end)
end

-- Notificação segura (funciona mesmo antes da janela existir)
local function SafeNotify(title, content, duration)
    if Fluent and Fluent.Notify then
        pcall(function() Fluent:Notify({ Title = title, Content = content, Duration = duration or 4 }) end)
    else
        warn("[SlenderHub] " .. tostring(title) .. " — " .. tostring(content))
    end
end

-- =====================================
-- SERVICES
-- =====================================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")
local CollectionService = game:GetService("CollectionService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer

local function GetHumanoid()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChildOfClass("Humanoid")
end

local function GetRoot()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

-- =====================================
-- MATRIZ DE EXECUTORES
-- =====================================
local Env = getgenv and getgenv() or _G

local function ExecFn(name)
    if type(Env[name]) == "function" then return Env[name] end
    return nil
end

local function Fn2(tbl)
    local ok, v = pcall(function() return tbl() end)
    return ok and v or nil
end

local CheckCaller = Fn2(function()
    return type(checkcaller) == "function" and checkcaller or nil
end)
local FirePromptFn = Fn2(function()
    return type(fireproximityprompt) == "function" and fireproximityprompt or nil
end)
local FireClickFn = Fn2(function()
    return type(fireclickdetector) == "function" and fireclickdetector or nil
end)
local GetRawMeta = Fn2(function()
    return type(getrawmetatable) == "function" and getrawmetatable or nil
end)
local NewCClosure = Fn2(function()
    return type(newcclosure) == "function" and newcclosure or nil
end)
local HookMeta = Fn2(function()
    return type(hookmetamethod) == "function" and hookmetamethod or nil
end)

local function IdentifyExecutor()
    local names = { "getexecutorname", "identifyexecutor", "get_identify" }
    for _, n in ipairs(names) do
        if type(Env[n]) == "function" then
            local ok, name = pcall(Env[n])
            if ok then return tostring(name) end
        end
    end
    return "unknown"
end

-- =====================================
-- LIB INTEGRATION (ReplicatedStorage/Lib — coração do jogo)
-- =====================================
local Lib = nil
local LibReady = false
local Data = nil

do
    local ok, lib = pcall(function()
        return require(game.ReplicatedStorage:WaitForChild("Lib", 10))
    end)
    if ok and lib then
        Lib = lib
        LibReady = true
    end
end

if Lib then
    -- Hook BindEvents: captura handlers do servidor sem quebrar nada
    pcall(function()
        if Lib.Network and Lib.Network.BindEvents then
            local old = Lib.Network.BindEvents
            Lib.Network.BindEvents = function(self, events)
                if type(events) == "table" and OnServerEvents then
                    OnServerEvents(events)
                end
                return old(self, events)
            end
        end
    end)
    -- Hook Inject: captura handlers injetados (dot call!)
    pcall(function()
        if Lib.Inject then
            local old = Lib.Inject
            Lib.Inject = function(name, fn, ...)
                if OnInject then OnInject(name, fn) end
                return old(name, fn, ...)
            end
        end
    end)
    -- Sincronização de dados
    pcall(function()
        if Lib.dHandler and Lib.dHandler.UpdateData then
            Lib.dHandler.UpdateData.Event:Connect(function()
                Data = Lib.data
            end)
        end
    end)
    pcall(function()
        if Lib.DS and Lib.DS.RequestData then
            task.spawn(function()
                local ok2, d = pcall(Lib.DS.RequestData)
                if ok2 then Data = Lib.data or d end
            end)
        end
    end)
end

local ServerEventHooks = {}
local InjectHooks = {}

local function OnServerEvents(events)
    for name, handler in pairs(events or {}) do
        if ServerEventHooks[name] then
            for _, cb in ipairs(ServerEventHooks[name]) do
                pcall(cb, handler, name)
            end
        end
    end
end

local function OnInject(name, fn)
    if name and InjectHooks[name] then
        for _, cb in ipairs(InjectHooks[name]) do
            pcall(cb, fn)
        end
    end
end

-- Fire seguro por nome (wrapper do jogo; fallback direto no gateway)
local function NetFire(name, ...)
    if Lib and Lib.Network and Lib.Network.FireServer then
        local ok = pcall(Lib.Network.FireServer, Lib.Network, name, ...)
        if ok then return true end
    end
    pcall(function()
        local util = game.ReplicatedStorage:FindFirstChild("Util")
        local net = util and util:FindFirstChild("Net")
        local re = net and net:FindFirstChild("RE")
        local gw = re and re:FindFirstChild("RequestRemoteEvent")
        if gw and gw:IsA("RemoteEvent") then
            gw:FireServer(name, ...)
        end
    end)
    return true
end

local function GetData()
    if Lib and Lib.data then return Lib.data end
    return Data
end

-- =====================================
-- INF SANITY REAL (hook no PlayerLostSanity — causa raiz)
-- =====================================
local InfSanityOn = false
local OrigPlayerLostSanity = Lib and Lib.PlayerLostSanity or nil

local function SetInfSanity(enabled)
    InfSanityOn = enabled
    if not Lib then
        SafeNotify("Lib", "Lib não encontrado — Inf Sanity indisponível", 4)
        return
    end
    if enabled then
        if not Lib.PlayerLostSanity then
            SafeNotify("Lib", "PlayerLostSanity não existe no Lib", 4)
            return
        end
        if not OrigPlayerLostSanity then OrigPlayerLostSanity = Lib.PlayerLostSanity end
        Lib.PlayerLostSanity = function(amount, reason)
            if InfSanityOn and (not amount or amount > 0) then
                return
            end
            return OrigPlayerLostSanity(amount, reason)
        end
        task.spawn(function()
            while InfSanityOn and task.wait(0.3) do
                pcall(function()
                    LocalPlayer:SetAttribute("Sanity", Config.SanityFloor)
                    LocalPlayer:SetAttribute("SanityImpactMultiplier", 0)
                end)
            end
        end)
    else
        if OrigPlayerLostSanity and Lib.PlayerLostSanity then
            Lib.PlayerLostSanity = OrigPlayerLostSanity
        end
    end
end

-- =====================================
-- AUTO HEARTBEAT (auto-completa minigame de coração)
-- =====================================
local AutoHeartbeatOn = false

do
    ServerEventHooks["StartHeartbeatMinigame"] = {
        function()
            if AutoHeartbeatOn and Lib and Lib.HeartMinigameComplete then
                task.defer(function()
                    pcall(Lib.HeartMinigameComplete, true)
                end)
            end
        end
    }
end

local function SetAutoHeartbeat(enabled)
    AutoHeartbeatOn = enabled
    if not enabled then return end
    task.spawn(function()
        while AutoHeartbeatOn and task.wait(0.25) do
            pcall(function()
                if not (Lib and Lib.HeartMinigameComplete) then return end
                local ui = Lib.UI and Lib.UI.Get and Lib.UI.Get("HeartbeatMinigameUI")
                if ui then
                    local frame = ui:FindFirstChild("Frame")
                    if frame and frame.Visible then
                        Lib.HeartMinigameComplete(true)
                    end
                end
            end)
        end
    end)
end

-- =====================================
-- ANTI JUMPSCARE (handlers + GUIs reais)
-- =====================================
local AntiJumpscareOn = false

do
    local scareNames = {
        "Jumpscare", "JumpscareHollow", "JumpscareShadow",
        "JumpscareShadowWithEyesIMG", "JumpscareStalker",
    }
    local function IsScare(name)
        for _, n in ipairs(scareNames) do
            if name == n then return true end
        end
        return false
    end

    local function HookBindEventsForScares()
        local lib = Lib
        if not (lib and lib.Network and lib.Network.BindEvents) then return end
        local old = lib.Network.BindEvents
        lib.Network.BindEvents = function(self, events)
            if type(events) == "table" and AntiJumpscareOn then
                for name in pairs(events) do
                    if IsScare(name) then
                        events[name] = function() end
                    end
                end
            end
            if OnServerEvents then OnServerEvents(events) end
            return old(self, events)
        end
    end
    HookBindEventsForScares()
end

local function SetAntiJumpscare(enabled)
    AntiJumpscareOn = enabled
    if not enabled then return end
    task.spawn(function()
        while AntiJumpscareOn and task.wait(0.3) do
            pcall(function()
                local pg = LocalPlayer:FindFirstChild("PlayerGui")
                if pg then
                    for _, guiName in ipairs(Config.ScareGuis) do
                        local gui = pg:FindFirstChild(guiName)
                        if gui and gui:IsA("ScreenGui") and gui.Enabled then
                            gui.Enabled = false
                        end
                    end
                end
                local cg = game:GetService("CoreGui")
                for _, guiName in ipairs(Config.ScareGuis) do
                    local gui = cg:FindFirstChild(guiName)
                    if gui and gui:IsA("ScreenGui") and gui.Enabled then
                        gui.Enabled = false
                    end
                end
            end)
        end
    end)
end

-- =====================================
-- ESP REAL (tags CollectionService)
-- =====================================
local ESPOn = false

local function ColorFor(model)
    if model:HasTag("NPC") then return Config.EspGood end
    if model:HasTag("Anomaly") or model:HasTag("StalkerMonster") or model:HasTag("TallMonsterSpawn")
        or model:HasTag("Shadow") or model:HasTag("DontLookUp") then
        return Config.EspDanger
    end
    if model:HasTag("Grime") or model:HasTag("EmergencyEventCounter") then return Config.EspTask end
    if model:HasTag("Door") then return Config.EspDoor end
    return nil
end

local function AddHighlight(m)
    if m:FindFirstChildOfClass("Highlight") then return end
    local color = ColorFor(m)
    if not color then return end
    local hl = Instance.new("Highlight")
    hl.Name = "SlenderHubESP"
    hl.FillColor = color
    hl.FillTransparency = 0.6
    hl.OutlineColor = color
    hl.OutlineTransparency = 0
    hl.Parent = m
end

local function SetESP(enabled)
    ESPOn = enabled
    if not enabled then
        for _, hl in ipairs(workspace:GetDescendants()) do
            if hl:IsA("Highlight") and hl.Name == "SlenderHubESP" then hl:Destroy() end
        end
        return
    end
    task.spawn(function()
        while ESPOn and task.wait(0.5) do
            pcall(function()
                for _, m in ipairs(workspace:GetDescendants()) do
                    if m:IsA("Model") and m.PrimaryPart then
                        AddHighlight(m)
                    end
                end
            end)
        end
    end)
end

-- =====================================
-- AUTO INTERACT (prompts por tags reais)
-- =====================================
local AutoInteractOn = false

local function FindPrompts()
    local list = {}
    for _, tag in ipairs({ "Inspect", "ShopItemPP" }) do
        for _, inst in ipairs(CollectionService:GetTagged(tag)) do
            if inst:IsA("ProximityPrompt") then
                table.insert(list, inst)
            else
                for _, desc in ipairs(inst:GetDescendants()) do
                    if desc:IsA("ProximityPrompt") then
                        table.insert(list, desc)
                    end
                end
            end
        end
    end
    return list
end

local function SetAutoInteract(enabled)
    AutoInteractOn = enabled
    if not enabled then return end
    if not FirePromptFn then
        SafeNotify("Executor", "fireproximityprompt não disponível", 4)
        return
    end
    task.spawn(function()
        local last = {}
        while AutoInteractOn and task.wait(0.8) do
            pcall(function()
                local root = GetRoot()
                local now = os.clock()
                for _, prompt in ipairs(FindPrompts()) do
                    if not last[prompt] or now - last[prompt] > 6 then
                        local parent = prompt.Parent
                        local pos = parent and (parent:IsA("BasePart") and parent.Position
                            or (parent.PrimaryPart and parent.PrimaryPart.Position)) or nil
                        if root and pos and (root.Position - pos).Magnitude < 40 then
                            FirePromptFn(prompt)
                            last[prompt] = now
                        end
                    end
                end
            end)
        end
    end)
end

-- =====================================
-- MOVEMENT
-- =====================================
local NoclipOn = false
local FlyOn = false
local NoclipConn = nil

local function SetWalkSpeed(v)
    local hum = GetHumanoid()
    if hum then hum.WalkSpeed = v end
end

local function SetNoclip(enabled)
    NoclipOn = enabled
    if not enabled then
        if NoclipConn then NoclipConn:Disconnect() NoclipConn = nil end
        return
    end
    if NoclipConn then NoclipConn:Disconnect() end
    NoclipConn = RunService.Stepped:Connect(function()
        local hum = GetHumanoid()
        if not hum then return end
        hum:ChangeState(Enum.HumanoidStateType.Physics)
        local root = GetRoot()
        if root then root.Velocity = Vector3.new(0, 0, 0) end
    end)
end

local function SetFly(enabled)
    FlyOn = enabled
    if not enabled then return end
    task.spawn(function()
        while FlyOn and task.wait() do
            local hum = GetHumanoid()
            local root = GetRoot()
            if not hum or not root then break end
            local vel = root.AssemblyLinearVelocity or Vector3.new(0, 0, 0)
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vel = vel + Vector3.new(0, 60, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then vel = vel - Vector3.new(0, 60, 0) end
            root.AssemblyLinearVelocity = Vector3.new(vel.X, vel.Y, vel.Z)
        end
    end)
end

-- =====================================
-- MISC
-- =====================================
local function TeleportToLobby()
    NetFire("TeleportToLobby")
    SafeNotify("SlenderHub", "Teleportando para o lobby...", 2)
end

local function VotePlayAgain()
    NetFire("PlayAgainVote")
    SafeNotify("SlenderHub", "Voto em jogar novamente enviado", 2)
end

local function ShowStats()
    local data = GetData()
    if data and data.Stats then
        SafeNotify("Dados", "Cash: $" .. tostring(data.Stats.LocalCash or 0)
            .. " | Classe: " .. tostring(data.Stats.Class or "?"), 5)
    else
        SafeNotify("Dados", "Dados indisponíveis (jogo não sincronizou)", 4)
    end
end

