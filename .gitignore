--[[
    SlenderHub | Animal Hospital — UPGRADE v4.5.0 (Addon)
    ======================================================
    Features novas descobertas na análise do Foxname Hub (27K views) + Overflow:

    ✅ NOVAS:
      • Auto Shutter (persianas)          — fecha persiana quando anomalia chega no check-in
      • Auto Fix Cams                     — conserta câmeras quebradas (Cameras/Cameras2)
      • Auto Buy Shop                     — compra itens médicos automaticamente (prioridade)
      • Server Hop                        — troca de servidor no fim do turno / morte
      • Auto Treat v2 (completo)          — ciclo médico: cama → item → entrega → cirurgia → queimado
      • Detect Anomaly Check-In           — ABORTA check-in se o paciente for anomalia (anti-morte)
      • Tratar Queimado                   — usa item Treat Burns no paciente em chamas
      • Pega Badge Órfã                   — coleta badge impressa sem NPC no ciclo
      • Anti-Stuck Prompts                — pula prompt preso após N tentativas

    Como integrar:
      1) Copie este arquivo INTEIRO e cole NO FINAL do SlenderHub_AnimalHospital.lua,
         ANTES do bloco "Boot Final" (linha ~1678) e DEPOIS dos helpers de UI.
      2) Os trechos [UI - COLE NA ABA] adicionam os toggles/buttons nas abas existentes.
      3) Rode o script normalmente.

    Compatibilidade: usa apenas funções comuns a Synapse/Xeno/Solara/Delta/Fluxus.
--]]

-- ============================================================
-- UPGRADE 4.5.0 — NOVAS FEATURES (dados reais do Foxname Hub)
-- ============================================================

-- ============================================================
-- AUTO SHUTTER (persianas): fecha quando ameaça está no check-in
-- ============================================================
local ShutterOn = false
local ShutterClosed = false

local function FindShutterButton()
    -- tags/strings reais do jogo: "ShutterButton", "DesignatedRoom", "Room6"
    local best, bestD = nil, math.huge
    local root = GetRoot()
    for _, inst in ipairs(workspace:GetDescendants()) do
        if inst:IsA("BasePart") and inst:HasTag("ShutterButton") then
            local d = root and (root.Position - inst.Position).Magnitude or 0
            if d < bestD then best, bestD = inst, d end
        end
    end
    return best
end

local function ThreatNearCheckIn()
    -- anomalia (tags reais) perto do check-in = perigo
    local root = GetRoot()
    if not root then return false end
    for _, inst in ipairs(CollectionService:GetTagged("Anomaly")) do
        local pos = inst:IsA("BasePart") and inst.Position
            or (inst.PrimaryPart and inst.PrimaryPart.Position) or nil
        if pos and (root.Position - pos).Magnitude < 40 then return true end
    end
    for _, tag in ipairs({ "Skinwalker", "StalkerMonster", "Fake" }) do
        for _, inst in ipairs(CollectionService:GetTagged(tag)) do
            local pos = inst:IsA("BasePart") and inst.Position
                or (inst.PrimaryPart and inst.PrimaryPart.Position) or nil
            if pos and (root.Position - pos).Magnitude < 40 then return true end
        end
    end
    return false
end

local function PressShutter(button)
    local pp = button:FindFirstChildWhichIsA("ProximityPrompt")
        or button:FindFirstChildOfClass("ProximityPrompt")
    if pp then
        TeleportNear(button.Position, 3)
        FirePrompt(pp)
        return true
    end
    -- fallback: ClickDetector
    local cd = button:FindFirstChildOfClass("ClickDetector")
    if cd then
        TeleportNear(button.Position, 3)
        pcall(function()
            if fireclickdetector then fireclickdetector(cd) else cd:Click() end
        end)
        return true
    end
    return false
end

local function SetAutoShutter(enabled)
    ShutterOn = enabled
    if not enabled then
        ShutterClosed = false
        SafeNotify("Auto Shutter", "Desativado", 2)
        return
    end
    task.spawn(function()
        while ShutterOn and task.wait(1.0) do
            pcall(function()
                local button = FindShutterButton()
                if not button then return end
                local threat = ThreatNearCheckIn()
                if threat and not ShutterClosed then
                    PressShutter(button)
                    ShutterClosed = true
                    SafeNotify("Shutter", "Fechando persiana (ameaça no check-in)", 3)
                elseif not threat and ShutterClosed then
                    PressShutter(button)
                    ShutterClosed = false
                end
            end)
        end
    end)
end

-- ============================================================
-- AUTO FIX CAMS: conserta câmeras quebradas ("Cameras"/"Cameras2")
-- ============================================================
local FixCamOn = false

local function FindBrokenCamera()
    for _, tag in ipairs({ "Cameras", "Cameras2" }) do
        for _, inst in ipairs(CollectionService:GetTagged(tag)) do
            if inst:IsA("Model") or inst:IsA("BasePart") then return inst end
        end
    end
    -- fallback: nome contém camera + prompt de conserto
    for _, desc in ipairs(workspace:GetDescendants()) do
        if desc:IsA("BasePart") and string.find(string.lower(desc.Name), "camera") then
            local pp = desc:FindFirstChildWhichIsA("ProximityPrompt")
            if pp and pp.Enabled then return desc end
        end
    end
    return nil
end

local function SetAutoFixCam(enabled)
    FixCamOn = enabled
    if not enabled then
        SafeNotify("Auto Fix Cam", "Desativado", 2)
        return
    end
    task.spawn(function()
        while FixCamOn and task.wait(2) do
            pcall(function()
                local cam = FindBrokenCamera()
                if not cam then return end
                local pos = cam:IsA("BasePart") and cam.Position
                    or (cam.PrimaryPart and cam.PrimaryPart.Position) or nil
                if not pos then return end
                local pp = cam:FindFirstChildWhichIsA("ProximityPrompt")
                    or cam:FindFirstChildOfClass("ProximityPrompt")
                if pp then
                    TeleportNear(pos, 3)
                    FirePrompt(pp)
                    SafeNotify("Fix Cam", "Consertando câmera", 2)
                end
            end)
        end
    end)
end

-- ============================================================
-- AUTO BUY SHOP: compra itens médicos por prioridade
-- ============================================================
local BuyShopOn = false
local ShopPriority = { "Medkit", "Bandages", "Medicine", "Antibiotics", "Eye Drops", "Thermo" }

local function GetLocalCash()
    local data = GetData()
    if data and data.Stats and data.Stats.LocalCash then return data.Stats.LocalCash end
    -- fallback: atributo
    return LocalPlayer:GetAttribute("LocalCash") or 0
end

local function SetAutoBuyShop(enabled)
    BuyShopOn = enabled
    if not enabled then
        SafeNotify("Auto Buy Shop", "Desativado", 2)
        return
    end
    task.spawn(function()
        local last = {}
        while BuyShopOn and task.wait(3) do
            pcall(function()
                local now = os.clock()
                local cash = GetLocalCash()
                -- varre itens da loja (tag ShopItemPP — real do jogo)
                for _, inst in ipairs(CollectionService:GetTagged("ShopItemPP")) do
                    if inst:IsA("ProximityPrompt") or inst:FindFirstChildWhichIsA("ProximityPrompt") then
                        local pp = inst:IsA("ProximityPrompt") and inst or inst:FindFirstChildWhichIsA("ProximityPrompt")
                        local parent = pp.Parent
                        local pos = parent and (parent:IsA("BasePart") and parent.Position
                            or (parent.PrimaryPart and parent.PrimaryPart.Position)) or nil
                        -- prioridade por nome
                        local name = string.lower(parent and parent.Name or "")
                        local prio = 999
                        for i, item in ipairs(ShopPriority) do
                            if string.find(name, string.lower(item)) then prio = i break end
                        end
                        if prio < 999 and pos and (not last[pp] or now - last[pp] > 15) then
                            TeleportNear(pos, 3)
                            FirePrompt(pp)
                            last[pp] = now
                            SafeNotify("Shop", "Comprando: " .. tostring(parent and parent.Name), 2)
                            task.wait(1)
                        end
                    end
                end
            end)
        end
    end)
end

-- ============================================================
-- SERVER HOP: troca de servidor (fim de turno / morte / sem cash)
-- ============================================================
local function HopServer()
    pcall(function()
        local TeleportService = game:GetService("TeleportService")
        local placeId = game.PlaceId
        local jobId = game.JobId
        -- teleporta para o MESMO lugar (novo servidor)
        TeleportService:TeleportToPlaceInstance(placeId, jobId)
    end)
end

local function ServerHopButton()
    SafeNotify("Server Hop", "Procurando outro servidor...", 2)
    task.spawn(HopServer)
end

-- ============================================================
-- DETECT ANOMALY CHECK-IN: aborta check-in se paciente for anomalia
-- (strings reais do Foxname: "Aborting check-in because patient is an anomaly",
--  "Skipping anomaly talk", tags: Skinwalker/StalkerMonster/Fake/Anomaly)
-- ============================================================
local DetectAnomalyOn = false

local function IsAnomalyModel(model)
    if not model then return false end
    for _, tag in ipairs({ "Anomaly", "Skinwalker", "StalkerMonster", "Fake" }) do
        if model:HasTag(tag) then return true end
    end
    -- fallback: nome contém anomalia/skin/strange
    local n = string.lower(model.Name)
    if string.find(n, "anomal") or string.find(n, "skinwalk") or string.find(n, "strange") then
        return true
    end
    return false
end

local function IsCheckInPrompt(prompt)
    local at = string.lower(prompt.ActionText or "")
    return string.find(at, "check") ~= nil
end

local function SetDetectAnomaly(enabled)
    DetectAnomalyOn = enabled
    if not enabled then return end
    -- hook: intercepta FirePrompt de check-in e aborta se for anomalia
    local origFire = FirePrompt
    if not origFire then return end
    local hooked = false
    FirePrompt = function(prompt, ...)
        if DetectAnomalyOn and prompt and IsCheckInPrompt(prompt) then
            local model = prompt.Parent
            -- sobe a hierarquia até o Model do NPC
            local up = model
            while up and not up:IsA("Model") do up = up.Parent end
            -- verifica o modelo e filhos imediatos
            local target = up or model
            local danger = IsAnomalyModel(target)
            if not danger and target then
                for _, child in ipairs(target:GetChildren()) do
                    if IsAnomalyModel(child) then danger = true break end
                end
            end
            -- verifica também qualquer anomalia DENTRO de 10 studs do prompt
            if not danger then
                local pos = PromptPos(prompt)
                if pos then
                    for _, tag in ipairs({ "Anomaly", "Skinwalker", "StalkerMonster", "Fake" }) do
                        for _, inst in ipairs(CollectionService:GetTagged(tag)) do
                            local ipos = inst:IsA("BasePart") and inst.Position
                                or (inst.PrimaryPart and inst.PrimaryPart.Position) or nil
                            if ipos and (pos - ipos).Magnitude < 10 then danger = true break end
                        end
                        if danger then break end
                    end
                end
            end
            if danger then
                SafeNotify("Anti-Anomaly", "Check-in ABORTADO (paciente é anomalia!)", 5)
                task.wait(3) -- espera o ciclo do Foxname "skip anomaly talk"
                return
            end
        end
        return origFire(prompt, ...)
    end
    hooked = true
    task.spawn(function()
        while DetectAnomalyOn and task.wait(0.5) do
            if not hooked then break end
        end
        -- quando desligar, restaura
        if not DetectAnomalyOn and hooked then
            FirePrompt = origFire
        end
    end)
    SafeNotify("Anti-Anomaly", "Detecção de anomalia no check-in ativada", 2)
end

-- ============================================================
-- AUTO TREAT v2 (COMPLETO): ciclo médico profissional
-- ============================================================
local TreatV2On = false
local TreatItems = { "Medicine", "Medkit", "Bandages", "Antibiotics", "Ointment", "Cough Syrup", "Eye Drops", "Herbs", "Maple Syrup", "IV Drops" }

local function FindPatientBed()
    -- camas com paciente (InBed) ou prompts de cama ("Pressing bed prompt")
    local root = GetRoot()
    local best, bestD = nil, math.huge
    for _, tag in ipairs({ "InBed", "Patient" }) do
        for _, inst in ipairs(CollectionService:GetTagged(tag)) do
            if inst:IsA("Model") and inst.PrimaryPart then
                local d = root and (root.Position - inst.PrimaryPart.Position).Magnitude or 0
                if d < bestD then best, bestD = inst, d end
            end
        end
    end
    -- fallback: prompt com ActionText treatment/medicine
    local pp = FindPromptByText({ "treatment", "medicine", "treat", "bed" })
    if pp and PromptPos(pp) then return pp end
    return best
end

local function FindMedItem()
    for _, item in ipairs(TreatItems) do
        for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
            if tool:IsA("Tool") and string.find(string.lower(tool.Name), string.lower(item)) then
                return tool
            end
        end
        local char = LocalPlayer.Character
        if char then
            for _, tool in ipairs(char:GetChildren()) do
                if tool:IsA("Tool") and string.find(string.lower(tool.Name), string.lower(item)) then
                    return tool
                end
            end
        end
    end
    return nil
end

local function SetAutoTreatV2(enabled)
    TreatV2On = enabled
    if not enabled then
        SafeNotify("Auto Treat v2", "Desativado", 2)
        return
    end
    task.spawn(function()
        local last = {}
        while TreatV2On and task.wait(1.5) do
            pcall(function()
                local now = os.clock()
                -- 1) acha cama/paciente
                local bed = FindPatientBed()
                if not bed then return end
                local pos = PromptPos(bed) or (bed.PrimaryPart and bed.PrimaryPart.Position) or nil
                if not pos then return end
                -- 2) teleporta e dispara prompt da cama
                if not last[bed] or now - last[bed] > 8 then
                    TeleportNear(pos, 3)
                    local pp = bed:IsA("ProximityPrompt") and bed or bed:FindFirstChildWhichIsA("ProximityPrompt")
                    if pp then FirePrompt(pp) end
                    last[bed] = now
                    task.wait(0.5)
                end
                -- 3) equipa/usa item médico no paciente
                local tool = FindMedItem()
                if tool then
                    local hum = GetHumanoid()
                    if hum then pcall(function() hum:EquipTool(tool) end) end
                    task.wait(0.3)
                    pcall(function() tool:Activate() end)
                end
            end)
        end
    end)
end

-- ============================================================
-- TRATAR QUEIMADO: usa item Treat Burns em paciente em chamas
-- ============================================================
local TreatBurnOn = false

local function FindBurningPatient()
    for _, tag in ipairs({ "Burning", "OnFire", "Burnt" }) do
        for _, inst in ipairs(CollectionService:GetTagged(tag)) do
            if inst:IsA("Model") and inst.PrimaryPart then return inst end
        end
    end
    -- fallback: paciente com fire parts
    for _, model in ipairs(workspace:GetDescendants()) do
        if model:IsA("Model") and model.PrimaryPart and model:HasTag("Patient") then
            for _, child in ipairs(model:GetDescendants()) do
                if child:IsA("Fire") then return model end
            end
        end
    end
    return nil
end

local function SetAutoTreatBurns(enabled)
    TreatBurnOn = enabled
    if not enabled then
        SafeNotify("Tratar Queimado", "Desativado", 2)
        return
    end
    task.spawn(function()
        local last = {}
        while TreatBurnOn and task.wait(2) do
            pcall(function()
                local patient = FindBurningPatient()
                if not patient or not patient.PrimaryPart then return end
                local now = os.clock()
                if last[patient] and now - last[patient] < 8 then return end
                -- procura item Treat Burns / Ointment / Bandages
                local tool = nil
                for _, name in ipairs({ "Treat Burns", "Ointment", "Bandages" }) do
                    for _, t in ipairs(LocalPlayer.Backpack:GetChildren()) do
                        if t:IsA("Tool") and string.find(string.lower(t.Name), string.lower(name)) then
                            tool = t break
                        end
                    end
                    if tool then break end
                end
                if not tool then return end
                -- teleporta e aplica
                TeleportNear(patient.PrimaryPart.Position, 3)
                local hum = GetHumanoid()
                if hum then pcall(function() hum:EquipTool(tool) end) end
                task.wait(0.3)
                pcall(function() tool:Activate() end)
                last[patient] = now
                SafeNotify("Queimado", "Aplicando " .. tostring(tool.Name) .. " no paciente", 3)
            end)
        end
    end)
end

-- ============================================================
-- PEGA BADGE ÓRFÃ: coleta badge impressa sem NPC no ciclo
-- ============================================================
local OrphanBadgeOn = false

local function SetAutoOrphanBadge(enabled)
    OrphanBadgeOn = enabled
    if not enabled then
        SafeNotify("Badge Órfã", "Desativado", 2)
        return
    end
    task.spawn(function()
        while OrphanBadgeOn and task.wait(1.5) do
            pcall(function()
                for _, tag in ipairs({ "PrintedBadge", "PatientBadgeBase", "VisitorBadgeBase" }) do
                    for _, inst in ipairs(CollectionService:GetTagged(tag)) do
                        local pos = inst:IsA("BasePart") and inst.Position
                            or (inst.PrimaryPart and inst.PrimaryPart.Position) or nil
                        if pos then
                            TeleportNear(pos, 3)
                            local pp = inst:FindFirstChildWhichIsA("ProximityPrompt")
                                or inst:FindFirstChildOfClass("ProximityPrompt")
                            if pp then FirePrompt(pp) end
                            break
                        end
                    end
                end
            end)
        end
    end)
end

-- ============================================================
-- ANTI-STUCK PROMPTS: pula prompt preso após N tentativas
-- ============================================================
local AntiStuckOn = false
local PromptTries = {}
local StuckLimit = 6

local function SetAntiStuck(enabled)
    AntiStuckOn = enabled
    if not enabled then
        PromptTries = {}
        SafeNotify("Anti-Stuck", "Desativado", 2)
        return
    end
    -- hook: envolve FirePrompt para contar tentativas
    local oldFirePrompt = FirePrompt
    FirePrompt = function(prompt, ...)
        if AntiStuckOn and prompt then
            PromptTries[prompt] = (PromptTries[prompt] or 0) + 1
            if PromptTries[prompt] >= StuckLimit then
                SafeNotify("Anti-Stuck", "Pulo prompt preso: " .. tostring(prompt.Name), 3)
                PromptTries[prompt] = 0
                task.wait(2)
                return
            end
        end
        return oldFirePrompt(prompt, ...)
    end
end

