-- Botão: ver quantos pets limitados restam (PurchaseService/RF)
Tabs.Pet:AddButton({
    Title = "Check Limited Pet Remaining",
    Callback = function()
        local rf = GetKnitRemote("PurchaseService", "RF", "GetLimitedPetRemaining")
        if rf then
            local ok, res = pcall(function() return rf:InvokeServer() end)
            Fluent:Notify({
                Title = "Limited Pets",
                Content = ok and ("resposta: " .. tostring(res)) or ("erro: " .. tostring(res)),
                Duration = 5
            })
        else
            Fluent:Notify({ Title = "Limited Pets", Content = "Remote não encontrado", Duration = 3 })
        end
    end
})

