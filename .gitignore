--[[
    SlenderHub | Animal Hospital (Anomaly) — Script Premium
    Dev: SlenderHub Team
    Versão: 1.0.0 (build inicial)

    Feito para executors PC (Wave/Codex/Delta/etc.) com matriz de fallback.
    UI padrão SlenderWind (embutida, enxuta).
    Key system: verificação via API do SlenderHub (pluggável).

    IMPORTANTE (calibração):
    O jogo não expõe nomes oficiais de remotes/valores de forma documentada.
    As constantes na seção CONFIG usam heurística — ajuste os nomes conforme
    a versão atual do jogo. O loop usa pcall em tudo: nada quebra se algo mudar.
]]

local SlenderHub = {}

----------------------------------------------------------------------------
-- CONFIG (calibre aqui)
----------------------------------------------------------------------------
SlenderHub.Config = {
    -- API de verificação de key (mesmo endpoint do loader do site)
    VerifyUrl  = "https://www.slenderhub.shop/api/exec",
    -- Se true, sem key o script roda em modo TRIAL limitado; se false, trava
    AllowTrial = true,

    -- Heurística de sanidade: nomes de Value/Attribute procurados no DataModel
    SanityNames = { "Sanity", "Sanidade", "sanity", "Brain", "Mentality" },

    -- Heurística de pacientes/anomalias: substrings de nome de modelos no Workspace
    PatientNames = { "Patient", "Paciente", "Client", "Visitor", "Anomaly" },
    AnomalyNames = { "Anomaly", "Skinwalker", "Stalker", "Hider", "Mimic", "Tentacle" },

    -- Heurística de itens/salas
    CoffeeNames   = { "Coffee", "Cafe", "Machine", "Pot" },
    ItemNames     = { "Med", "Medicine", "Item", "Tool", "Supply" },
    RoomNames     = { "Surgery", "XRay", "X-Ray", "Heart", "Medical", "Room" },

    -- ProximityPrompts / ClickDetectors procurados
    PromptNames   = { "ProximityPrompt", "Prompt", "Button", "Shutter" },

    -- Jogabilidade
    WalkSpeed     = 22,
    JumpPower     = 50,
    SanityFloor   = 100,   -- valor alvo do inf sanity
    EspColor      = Color3.fromRGB(255, 60, 60),
    EspColorGood  = Color3.fromRGB(60, 255, 120),
}

----------------------------------------------------------------------------
-- SERVICES + UTILS
----------------------------------------------------------------------------
local RunService   = game:GetService("RunService")
local Players      = game:GetService("Players")
local Lighting     = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local HttpService  = game:GetService("HttpService")
local CoreGui      = game:GetService("CoreGui")

local LocalPlayer  = Players.LocalPlayer
local Camera       = workspace.CurrentCamera

local function GetHumanoid()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChildOfClass("Humanoid")
end

local function Tween(obj, props, dur)
    dur = dur or 0.25
    local tween = TweenService:Create(obj, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
    tween:Play()
    return tween
end

local function Notify(title, text, dur, type)
    if SlenderHub.UI and SlenderHub.UI.Notify then
        SlenderHub.UI:Notify(title, text, dur, type)
    end
end

----------------------------------------------------------------------------
-- MATRIZ DE EXECUTORES (fallbacks — nunca assuma que a função existe)
----------------------------------------------------------------------------
local Env = getgenv and getgenv() or _G

local FunctionMap = {
    CheckCaller       = function() return type(checkcaller) == "function" and checkcaller or nil end,
    NewCClosure       = function() return type(newcclosure) == "function" and newcclosure or nil end,
    HookMetaMethod    = function() return type(hookmetamethod) == "function" and hookmetamethod or nil end,
    HookFunction      = function() return type(hookfunction) == "function" and hookfunction or nil end,
    GetRawMetaTable   = function() return type(getrawmetatable) == "function" and getrawmetatable or nil end,
    SetReadOnly       = function() return type(setreadonly) == "function" and setreadonly or nil end,
    FirePrompt        = function() return type(fireproximityprompt) == "function" and fireproximityprompt or nil end,
    FireClick         = function() return type(fireclickdetector) == "function" and fireclickdetector or nil end,
    GetGC             = function() return type(getgc) == "function" and getgc or nil end,
    GetReg            = function() return type(getreg) == "function" and getreg or nil end,
    IdentifyExecutor  = function()
        local names = { "getexecutorname", "identifyexecutor", "get_identify" }
        for _, n in ipairs(names) do
            if type(Env[n]) == "function" then return Env[n]() end
        end
        return "unknown"
    end,
}

local function Fn(name)
    local ok, val = pcall(FunctionMap[name])
    return ok and val or nil
end

--// HWID (pluggável: cada executor expõe de um jeito)
local HWID
do
    local ok, h = pcall(function()
        local exec = Fn("IdentifyExecutor") or "unknown"
        if type(Env["get_hwid"]) == "function" then return tostring(Env.get_hwid()) end
        -- fallback: hash estável do ambiente (não é HWID real; troque pelo nativo do seu executor)
        local base = tostring(LocalPlayer.UserId) .. ":" .. exec
        return HttpService:GenerateGUID(false) -- substitua por hash real se quiser persistência
    end)
    HWID = ok and h or "unknown"
end

----------------------------------------------------------------------------
-- KEY SYSTEM (pluggável — mesma resposta JSON do loader: {success, tier, message})
----------------------------------------------------------------------------
function SlenderHub.VerifyKey(key)
    local ok, res = pcall(function()
        local url = SlenderHub.Config.VerifyUrl
            .. "?key=" .. HttpService:UrlEncode(key)
            .. "&hwid=" .. HttpService:UrlEncode(HWID)
        return HttpService:JSONDecode(game:HttpGet(url))
    end)
    if not ok or not res then
        return false, "Falha na conexão com o servidor"
    end
    if not res.success then
        return false, res.message or "Key inválida"
    end
    return true, res
end

function SlenderHub.Authenticate(key)
    local ok, data = SlenderHub.VerifyKey(key)
    if not ok then return false, data end
    local tier = data.tier or data.type or "basic"
    return true, tier
end

----------------------------------------------------------------------------
-- INF SANITY (heurística: bloqueia perda no lado do cliente)
----------------------------------------------------------------------------
SlenderHub.InfSanity = { Enabled = false }

local function FindSanityValues()
    local found = {}
    local names = SlenderHub.Config.SanityNames
    local function scan(inst)
        if inst:IsA("NumberValue") or inst:IsA("IntValue") then
            for _, n in ipairs(names) do
                if inst.Name:lower():find(n:lower()) then
                    table.insert(found, inst)
                    break
                end
            end
        end
        if inst:IsA("Folder") or inst:IsA("Model") or inst:IsA("Workspace") or inst:IsA("PlayerGui") then
            for _, child in ipairs(inst:GetChildren()) do
                scan(child)
            end
        end
    end
    scan(workspace)
    if LocalPlayer:FindFirstChild("PlayerGui") then scan(LocalPlayer.PlayerGui) end
    return found
end

function SlenderHub.SetInfSanity(enabled)
    SlenderHub.InfSanity.Enabled = enabled
    if not enabled then return end
    task.spawn(function()
        while SlenderHub.InfSanity.Enabled and task.wait(0.2) do
            pcall(function()
                for _, v in ipairs(FindSanityValues()) do
                    if v.Value < SlenderHub.Config.SanityFloor then
                        v.Value = SlenderHub.Config.SanityFloor
                    end
                end
            end)
        end
    end)
end

