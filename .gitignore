    "https://raw.githubusercontent.com/SlenderYt567/sc/refs/heads/main/SlenderWind.lua"
))()

Window = SlenderWind.Window({
    Name = "Slender Hub | PlatoBoost",
    KeySystem = false,  -- We build our own PlatoBoost key system
    Theme = {
        Accent = Color3.fromRGB(0, 170, 255),  -- PlatoBoost Blue
        Success = Color3.fromRGB(0, 255, 100),
        Error = Color3.fromRGB(255, 50, 50)
    }
})

local Tab = Window:Tab("Key System")

-- Game status
local gameName = "Unknown Game"
pcall(function() gameName = MarketService:GetProductInfo(CurrentPlaceId).Name end)
local statusText = TARGET_SCRIPT_URL and "✅ Supported: " .. gameName or "⚠ Unsupported Game"

Tab:Paragraph("Status", statusText .. "\n(ID: " .. CurrentPlaceId .. ")")

-- Key Input
Tab:Input("PlatoBoost Key", "Enter your key...", "PBKey", "Paste your PlatoBoost key here", function(text)
    -- Auto-trim spaces
    -- The actual validation happens on button click
end)

-- Verify Button
Tab:Button("🔑 Verify Key", "Check key validity with PlatoBoost servers", function()
    Notify("Checking...", "Verifying with PlatoBoost...", 2)
    
    -- Try to get the key from input field
    pcall(function()
        for _, v in pairs(CoreGui:GetDescendants()) do
            if v:IsA("TextBox") and v.PlaceholderText:find("Enter your key") then
                local key = v.Text:gsub("%s+", "")
                if key == "" then
                    Notify("Input Required", "Please enter a key first.", 3, "Warning")
                    return
                end
                
                local success, msg = redeemKey(key)
                if success then
                    Notify("Success!", "Key Validated! Loading...", 3, "Success")
                    task.wait(0.5)
                    -- Close UI
                    pcall(function()
                        for _, ui in pairs(CoreGui:GetChildren()) do
                            if ui.Name == "SlenderWind" then
                                ui:Destroy()
                            end
                        end
                    end)
                    StartMainScript()
                else
                    Notify("Invalid Key", msg, 4, "Error")
                end
                return
            end
        end
        Notify("Error", "Could not find input field.", 3, "Error")
    end)
end)

-- Get Key Button
Tab:Button("📋 Get Key Link", "Copy PlatoBoost key link to clipboard", function()
    Notify("Getting Link...", "Contacting PlatoBoost...", 2)
    local success, link = cacheLink()
