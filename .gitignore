    Name      = "Slender Hub | Universal",
    KeySystem = false,
    Theme     = { Accent = Color3.fromRGB(0, 255, 128) }
})

--// ==============================[ PLATOBOOST onMessage ]============================== //--
-- Agora que a Window existe, podemos usar notificações visuais
pbOnMessage = function(message)
    pcall(function()
        Window:Notify("Platoboost", message, 5, "Info")
    end)
    warn("[Platoboost] " .. tostring(message))
end

--// ==============================[ HELPERS ]============================== //--
local function Notify(title: string, text: string, nType: string?, duration: number?)
    pcall(function()
        Window:Notify(title, text, duration or 5, nType or "Success")
    end)
end

local function formatTime(seconds: number): string
    if seconds == math.huge then return "Lifetime" end
    local d = math.floor(seconds / 86400)
    local h = math.floor((seconds % 86400) / 3600)
    local m = math.floor((seconds % 3600) / 60)
    return string.format("%dd %02dh %02dm", d, h, m)
end

--// ==============================[ HWID ]============================== //--
-- Usa a função do Platoboost (pbGetHwid) que já faz gethwid() ou fallback para UserId
-- Também expomos uma versão local para compatibilidade
local function getHWID(): string
    return pbGetHwid()
end

--// ==============================[ KEY STORAGE ]============================== //--
local function saveGlobalKey(key: string)
    pcall(function()
        if not isfolder(Config.FOLDER) then makefolder(Config.FOLDER) end
        writefile(KEY_FILE_PATH, HttpService:JSONEncode({ key = key }))
    end)
end

local function loadSavedKey(): string?
    if not isfile or not isfile(KEY_FILE_PATH) then return nil end
    local ok, parsed = pcall(function()
        return HttpService:JSONDecode(readfile(KEY_FILE_PATH))
    end)
    if ok and parsed and parsed.key then
        return parsed.key
    end
    return nil
end

local function deleteSavedKey()
    pcall(function()
        if isfile and isfile(KEY_FILE_PATH) then
            delfile(KEY_FILE_PATH)
        end
    end)
end

--// ==============================[ PLATOBOOST AUTHENTICATION ]============================== //--

-- authenticateWithKey: usa pbVerifyKey do Platoboost para validar a key
local function authenticateWithKey(licenseKey: string): boolean
    local ok, valid = pcall(function()
        return pbVerifyKey(licenseKey)
    end)

    if not ok then
        warn("[SlenderHub] Platoboost authentication error: " .. tostring(valid))
        Notify("Auth Error", "Erro ao conectar com Platoboost. Verifique o console.", "Error", 5)
        return false
    end

    if not valid then
        warn("[SlenderHub] Invalid key via Platoboost")
        return false
    end

    -- Key válida! Salva localmente
    saveGlobalKey(licenseKey)

    -- Tenta obter o tier/configuração via flag do Platoboost
    local tier = "premium"  -- padrão: key válida = premium
    local flagOk, flagValue = pcall(function()
        return pbGetFlag("access_tier")
    end)
    if flagOk and flagValue then
        tier = tostring(flagValue)
    end

    authorizedTier     = tier
    isAccessAuthorized = true

    print("[SlenderHub] Authenticated via Platoboost. Tier:", tier)
    return true
end

--// ==============================[ GAME SCRIPT LOADER ]============================== //--
local LoaderConfig = {
    ModulesPath  = "https://raw.githubusercontent.com/SlenderYt567/sc/refs/heads/main/",
    ScriptFolder = "script/"
}

local function loadGameScript(accessLevel: string)
    local targetFile = GameModules[CurrentPlaceId]
    if not targetFile then
        Notify("SlenderHub", "Game not supported (PlaceId: " .. CurrentPlaceId .. ")", "Error")
        return
    end

    -- Set global access level for game scripts to read
    if getgenv then
        getgenv().SlenderHubAccessLevel = accessLevel
    else
        _G.SlenderHubAccessLevel = accessLevel
    end

    local moduleContent = nil
    local loadSource    = ""

    -- Local search first
    if readfile then
        for _, path in ipairs({LoaderConfig.ScriptFolder .. targetFile, targetFile}) do
            local lok, res = pcall(function() return readfile(path) end)
            if lok and res and #res > 0 then
                moduleContent = res
                loadSource    = "Local"
                break
            end
        end
    end

    -- GitHub fallback (URL-encode spaces)
    if not moduleContent then
        local encoded = targetFile:gsub(" ", "%%20")
        for _, url in ipairs({
            LoaderConfig.ModulesPath .. encoded,
            LoaderConfig.ModulesPath .. LoaderConfig.ScriptFolder .. encoded,
        }) do
            local gok, res = pcall(function() return game:HttpGet(url) end)
            if gok and res and #res > 100 and not res:find("404") and not res:find("<html") then
                moduleContent = res
                loadSource    = "GitHub"
                break
            end
        end
    end

    if not moduleContent then
        Notify("Error", "Failed to find game script!", "Error")
        return
    end

    -- Execute
    local func, err = loadstring(moduleContent)
    if not func then
        Notify("Error", "Script compile error: " .. tostring(err), "Error")
        return
    end

    local execOk, result = pcall(func)
    if execOk and type(result) == "table" and type(result.Init) == "function" then
        pcall(function() result.Init(Window) end)
    end

    Notify("Loaded", "Game script launched from " .. loadSource, "Success")
    print("[SlenderHub] Launched: " .. targetFile .. " via " .. loadSource)
end

--// ==============================[ AUTO-LOGIN CHECK ]============================== //--
local rememberedKey = loadSavedKey()

if rememberedKey then
    print("[SlenderHub] Found saved key, verifying via Platoboost...")
    Notify("Auto-Login", "Verifying saved key...", "Success", 2)
    task.wait(0.5)

    if authenticateWithKey(rememberedKey) then
        local tierLabel = authorizedTier:sub(1,1):upper() .. authorizedTier:sub(2)
        Notify("Auto-Login", "Welcome back! Tier: " .. tierLabel, "Success", 3)
        task.wait(0.5)
        loadGameScript(authorizedTier)
        return
    else
        -- Saved key is invalid/expired, remove it
        deleteSavedKey()
        Notify("Session Expired", "Saved key is no longer valid. Please enter a new key.", "Error", 4)
    end
end

--// ==============================[ AUTHENTICATION TAB ]============================== //--
local TabAuth = Window:Tab("Authentication")

-- Game Status Info
local gameName = "Unknown Game"
pcall(function()
    gameName = game:GetService("MarketplaceService"):GetProductInfo(CurrentPlaceId).Name
end)
local statusText = GameModules[CurrentPlaceId]
    and ("✅ Supported: " .. gameName)
    or  ("⚠️ Not Supported (PlaceId: " .. CurrentPlaceId .. ")")
TabAuth:Paragraph("Game Status", statusText)

TabAuth:Label("── Platoboost Key System ──")

--// ======= KEY INPUT =======
TabAuth:Section("🔑 Global Key (Free / Premium)")
TabAuth:Input("License Key", "XXXX-XXXX-XXXX", "KeyInput", "Paste your Platoboost key here", function(text)
    local key = text:gsub("%s+", "")
    if #key < 5 then return end

    Notify("Verifying...", "Checking your key with Platoboost...", "Success", 2)
    task.wait(0.5)

    local success = authenticateWithKey(key)
    if success then
        local tierLabel = authorizedTier:sub(1,1):upper() .. authorizedTier:sub(2)
        Notify("✅ Key Valid!", "Tier: " .. tierLabel .. " — Key saved locally.", "Success", 5)
    else
        isAccessAuthorized = false
        Notify("❌ Invalid Key", "Key not found or already in use. Try again.", "Error", 4)
    end
end)

--// ======= FREE KEY (Platoboost Link) =======
TabAuth:Section("🎁 Free Key — Via Gateway (Platoboost)")
TabAuth:Paragraph("Como pegar sua Free Key", "Clique no botão abaixo para copiar um link. Abra no navegador, complete o captcha/gateway e receba sua key. Cole a key no campo acima.")
local btnFree = TabAuth:Button("🔗 Pegar Link de Ativação (Free)", "Gera um link do Platoboost e copia para o clipboard", function()
    local ok, link = pbCopyLink()
    if ok and link then
        Notify("Link Copiado!", "Cole no navegador e complete o gateway para receber sua key gratuita.", "Success", 5)
    else
        Notify("Erro", "Não foi possível gerar o link. Tente novamente.", "Error", 5)
    end
end)

--// ======= PREMIUM KEYS =======
TabAuth:Section("💎 Premium Plan — Shop")
TabAuth:Paragraph("Como obter Premium", "Keys premium são vendidas na nossa loja oficial ou diretamente com o dono. Após a compra, basta colar sua key no campo acima.")
local btnShop = TabAuth:Button("🛒 Loja SlenderHub (Comprar Premium)", "Abre a loja para comprar planos premium", function()
    setclipboard(Config.SHOP_URL)
    Notify("Link Copiado!", "Cole no navegador para acessar a loja e adquirir seu plano.", "Success", 5)
end)

--// ======= LAUNCH BUTTON =======
TabAuth:Label("── Launch ──")
local btnLaunch = TabAuth:Button("🚀 Launch Hub", "Verify and load the game script", function()
    local canCall, err = SecuritySkill.Throttle(2, "Launch", function()
        if not isAccessAuthorized then
            Notify("Access Denied", "Enter a valid key first.", "Error", 4)
            return
        end
        if not GameModules[CurrentPlaceId] then
            Notify("Error", "Game not supported yet.", "Error", 3)
            return
        end

        local tierLabel = authorizedTier:sub(1,1):upper() .. authorizedTier:sub(2)
        Notify("Loading...", "Tier: " .. tierLabel, "Success", 2)
        task.wait(0.5)
        loadGameScript(authorizedTier)
    end)
    
    if not canCall then
        Notify("Throttled", "Please wait before launching again.", "Error", 2)
    end
end)

-- Apply Ripples to buttons (Expert Touch)
pcall(function()
    UISkill.CreateRipple(btnFree.Instance or btnFree)
    UISkill.CreateRipple(btnShop.Instance or btnShop)
    UISkill.CreateRipple(btnLaunch.Instance or btnLaunch)
end)

