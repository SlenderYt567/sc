-- AUTO BUY FRUIT
local function BuyFruit(fruitID)
    local re = GetKnitRemote("FruitService", "RE", "BuyFruit")
    if re then
        pcall(function() re:FireServer(fruitID) end)
    end
end

for i = 1, 4 do
    local fruitID = string.format("Fruit_00%d", i)
    Flags.FruitToggles[fruitID] = false
    
    Tabs.Event:AddToggle(fruitID, {
        Title = "Auto " .. fruitID,
        Callback = function(v)
            Flags.FruitToggles[fruitID] = v
            task.spawn(function()
                while Flags.FruitToggles[fruitID] do
                    BuyFruit(fruitID)
                    task.wait(1)
                end
            end)
        end
    })
end

