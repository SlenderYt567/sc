-- 8. INICIALIZAÃ‡ÃƒO
-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

initRemotes()

-- Mostra a tab Main por padrÃ£o
TabPages["Main"].Visible = true
TabButtons[1].TextColor3 = CONFIG.Text
local firstIndicator = TabButtons[1]:FindFirstChild("Indicator")
if firstIndicator then firstIndicator.Visible = true end

-- Keybind de toggle da UI
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == CONFIG.Keybind then
        Window.Visible = not Window.Visible
    end
end)

-- Atualiza o status do header
local function getFPS()
    local ok, fps = pcall(function() return RunService:GetRealFPS() end)
    if ok and type(fps) == "number" then return math.floor(fps) end
    return 60
end
taskSpawn(function()
    while ScreenGui and ScreenGui.Parent do
        StatusLabel.Text = string.format(
            "Farm: %s · Hatch: %s · Coins: %d · FPS: %d",
            Features.AutoFarm and "ON" or "OFF",
            Features.AutoHatch and "ON" or "OFF",
            Stats.Coins,
            getFPS()
        )
        taskWait(1)
    end
end)

toast("âš¡ SlenderHub PS99 carregado!", CONFIG.Success)

print("[SlenderHub] PS99 Zap Style carregado. Executor: " .. EXECUTOR)
print("[SlenderHub] Aviso: remotes do PS99 mudam com updates â€” se alguma feature falhar, revise CONFIG.RemotePaths com um dump Dex.")
