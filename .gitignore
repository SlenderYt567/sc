-- =====================================
-- KNIT (CARREGAMENTO SEGURO COM TIMEOUT)
-- =====================================
local KnitLoaded = false
local Services = {}
local Knit = nil  -- Referência direta ao Knit

task.spawn(function()
    -- Timeout de 15 segundos
    local timeout = 15
    local start = tick()
    
    repeat
        task.wait(0.5)
        if tick() - start > timeout then
            warn("[SlenderHub] Knit timeout - Packages não encontrado")
            return
        end
    until ReplicatedStorage:FindFirstChild("Packages")
    
    local ok, result = pcall(function()
        local packages = ReplicatedStorage.Packages
        -- Procura qualquer versão do Knit (não hardcoded)
        local index = packages:FindFirstChild("_Index")
        if not index then return nil end
        
        for _, folder in pairs(index:GetChildren()) do
            if folder.Name:find("sleitnick_knit") then
                local knit = folder:FindFirstChild("knit")
                if knit then
                    Knit = knit
                    return knit:FindFirstChild("Services")
                end
            end
        end
        return nil
    end)
    
    if not ok or not result then
        warn("[SlenderHub] Knit não encontrado")
        return
    end
    
    Services = result
    KnitLoaded = true
    
    Fluent:Notify({
        Title = "Knit",
        Content = "Knit carregado com sucesso!",
        Duration = 4
    })
end)

-- =====================================
-- FUNÇÕES AUXILIARES
-- =====================================

-- Acessa serviço do Knit por nome
local function GetKnitService(serviceName)
    if not KnitLoaded then return nil end
    return Services:FindFirstChild(serviceName)
end

-- Acessa RemoteEvent/RemoteFunction por caminho (com fallback direto pelo Knit)
local function GetKnitRemote(serviceName, remoteType, remoteName)
    local service = GetKnitService(serviceName)
    if service then
        local container = service:FindFirstChild(remoteType)
        if container then
            local r = container:FindFirstChild(remoteName)
            if r then return r end
        end
    end
    -- Fallback: caminho direto ReplicatedStorage/Packages/_Index/sleitnick_knit@x/knit/Services/<svc>/<RE|RF>/<name>
    -- (não depende do Knit carregar; caminho confirmado pelo dump SlenderHub)
    local packages = ReplicatedStorage:FindFirstChild("Packages")
    if packages then
        local index = packages:FindFirstChild("_Index")
        if index then
            for _, folder in ipairs(index:GetChildren()) do
                if folder.Name:find("sleitnick_knit") then
                    local knit = folder:FindFirstChild("knit")
                    if knit then
                        local services = knit:FindFirstChild("Services")
                        if services then
                            local svc = services:FindFirstChild(serviceName)
                            if svc then
                                local cont = svc:FindFirstChild(remoteType)
                                if cont then
                                    local r = cont:FindFirstChild(remoteName)
                                    if r then return r end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return nil
end

