local lEncode, lDecode, lDigest = a3, aw, Z;

--! platoboost library
--! configuração do serviço
local PB_SERVICE = 28805;   -- seu service ID (identifica seu serviço no Platoboost)
local PB_SECRET = "9c548b2c-467f-4a25-a642-b3c6e9ddc407";  -- seu secret (obfuscate se quiser mais segurança)
local PB_USE_NONCE = true;  -- usa nonce para prevenir replay attacks

--! callbacks (será sobrescrito depois que a Window for criada)
local pbOnMessage = function(message)
    warn("[Platoboost] " .. tostring(message))
end

--! aguarda o jogo carregar
repeat task.wait(1) until game:IsLoaded()

--! funções auxiliares
local pbRequestSending = false
local pbSetClipboard = setclipboard or toclipboard or function() end
local pbRequest = request or http_request or syn_request
local pbStringChar = string.char
local pbToString = tostring
local pbStringSub = string.sub
local pbOsTime = os.time
local pbMathRandom = math.random
local pbMathFloor = math.floor
local pbGetHwid = gethwid or function()
    return "USER_" .. tostring(game:GetService("Players").LocalPlayer.UserId)
end

local pbCachedLink = ""
local pbCachedTime = 0
local pbCacheTTL = 10 * 60  -- 10 minutos

--! escolha do host (com fallback)
local pbHost = "https://api.platoboost.com"
local pbHostResponse = pbRequest({
    Url = pbHost .. "/public/connectivity",
    Method = "GET"
})

-- CORREÇÃO: usar AND em vez de OR (bug do código original)
if pbHostResponse.StatusCode ~= 200 and pbHostResponse.StatusCode ~= 429 then
    pbHost = "https://api.platoboost.net"
end

--! função para cachear o link
local function pbCacheLink()
    if pbCachedTime + pbCacheTTL < pbOsTime() then
        local response = pbRequest({
            Url = pbHost .. "/public/start",
            Method = "POST",
            Body = lEncode({
                service = PB_SERVICE,
                identifier = lDigest(pbGetHwid())
            }),
            Headers = {
                ["Content-Type"] = "application/json"
            }
        })

        if response.StatusCode == 200 then
            local decoded = lDecode(response.Body)
            if decoded.success == true then
                pbCachedLink = decoded.data.url
                pbCachedTime = pbOsTime()
                return true, pbCachedLink
            else
                pbOnMessage(decoded.message)
                return false, decoded.message
            end
        elseif response.StatusCode == 429 then
            local msg = "Você está sendo limitado. Aguarde 20 segundos e tente novamente."
            pbOnMessage(msg)
            return false, msg
        end

        local msg = "Falha ao obter link do Platoboost."
        pbOnMessage(msg)
        return false, msg
    else
        return true, pbCachedLink
    end
end

--! pré-carrega o link na inicialização
pbCacheLink()

--! geração de nonce (16 caracteres aleatórios)
local function pbGenerateNonce()
    local str = ""
    for _ = 1, 16 do
        str = str .. pbStringChar(pbMathFloor(pbMathRandom() * (122 - 97 + 1)) + 97)
    end
    return str
end

--! teste básico de aleatoriedade do nonce
for _ = 1, 5 do
    local oNonce = pbGenerateNonce()
    task.wait(0.2)
    if pbGenerateNonce() == oNonce then
        local msg = "Platoboost: erro de nonce (gerador não aleatório)."
        pbOnMessage(msg)
        error(msg)
    end
end

--! copia o link para a área de transferência
local function pbCopyLink()
    local success, link = pbCacheLink()
    if success then
        pbSetClipboard(link)
        return true, link
    end
    return false, nil
end

--! resgata uma key (para keys que começam com KEY_)
local function pbRedeemKey(key)
    local nonce = pbGenerateNonce()
    local endpoint = pbHost .. "/public/redeem/" .. pbToString(PB_SERVICE)

    local body = {
        identifier = lDigest(pbGetHwid()),
        key = key
    }

    if PB_USE_NONCE then
        body.nonce = nonce
    end

    local response = pbRequest({
        Url = endpoint,
        Method = "POST",
        Body = lEncode(body),
        Headers = {
            ["Content-Type"] = "application/json"
        }
    })

    if response.StatusCode == 200 then
        local decoded = lDecode(response.Body)
        if decoded.success == true then
            if decoded.data.valid == true then
                if PB_USE_NONCE then
                    if decoded.data.hash == lDigest("true" .. "-" .. nonce .. "-" .. PB_SECRET) then
                        return true
                    else
                        pbOnMessage("Falha ao verificar integridade do redeem.")
                        return false
                    end
                else
                    return true
                end
            else
                pbOnMessage("Key inválida.")
                return false
            end
        else
            if pbStringSub(decoded.message, 1, 27) == "unique constraint violation" then
                pbOnMessage("Você já possui uma key ativa. Aguarde expirar para resgatar outra.")
                return false
            else
                pbOnMessage(decoded.message)
                return false
            end
        end
    elseif response.StatusCode == 429 then
        pbOnMessage("Você está sendo limitado. Aguarde 20 segundos.")
        return false
    else
        pbOnMessage("Servidor retornou código inválido. Tente novamente.")
        return false
    end
end

--! verifica uma key no Platoboost (função principal)
local function pbVerifyKey(key)
    if pbRequestSending == true then
        pbOnMessage("Uma requisição já está em andamento. Aguarde.")
        return false
    else
        pbRequestSending = true
    end

    local nonce = pbGenerateNonce()
    local endpoint = pbHost .. "/public/whitelist/" .. pbToString(PB_SERVICE) .. "?identifier=" .. lDigest(pbGetHwid()) .. "&key=" .. key

    if PB_USE_NONCE then
        endpoint = endpoint .. "&nonce=" .. nonce
    end

    local response = pbRequest({
        Url = endpoint,
        Method = "GET",
    })

    pbRequestSending = false

    if response.StatusCode == 200 then
        local decoded = lDecode(response.Body)

        if decoded.success == true then
            if decoded.data.valid == true then
                if PB_USE_NONCE then
                    if decoded.data.hash == lDigest("true" .. "-" .. nonce .. "-" .. PB_SECRET) then
                        return true
                    else
                        pbOnMessage("Falha ao verificar integridade da resposta.")
                        return false
                    end
                else
                    return true
                end
            else
                if pbStringSub(key, 1, 4) == "KEY_" then
                    return pbRedeemKey(key)
                else
                    pbOnMessage("Key inválida.")
                    return false
                end
            end
        else
            pbOnMessage(decoded.message)
            return false
        end
    elseif response.StatusCode == 429 then
        pbOnMessage("Você está sendo limitado. Aguarde 20 segundos.")
        return false
    else
        pbOnMessage("Servidor retornou código inválido. Tente novamente.")
        return false
    end
end

--! obtém uma flag do servidor
local function pbGetFlag(name)
    local nonce = pbGenerateNonce()
    local endpoint = pbHost .. "/public/flag/" .. pbToString(PB_SERVICE) .. "?name=" .. name

    if PB_USE_NONCE then
        endpoint = endpoint .. "&nonce=" .. nonce
    end

    local response = pbRequest({
        Url = endpoint,
        Method = "GET",
    })

    if response.StatusCode == 200 then
        local decoded = lDecode(response.Body)
        if decoded.success == true then
            if PB_USE_NONCE then
                if decoded.data.hash == lDigest(pbToString(decoded.data.value) .. "-" .. nonce .. "-" .. PB_SECRET) then
                    return decoded.data.value
                else
                    pbOnMessage("Falha ao verificar integridade da flag.")
                    return nil
                end
            else
                return decoded.data.value
            end
        else
            pbOnMessage(decoded.message)
            return nil
        end
    else
        return nil
    end
end

