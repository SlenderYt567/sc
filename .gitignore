Tabs.Pet:AddToggle("AutoClaimUgc", {
    Title = "Auto Claim UGC Pets",
    Default = false,
    Callback = function(v)
        Flags.AutoClaimUgc = v
        task.spawn(function()
            while Flags.AutoClaimUgc do
                local re = GetKnitRemote("UgcService", "RE", "ClaimUgc")
                if re then
                    -- Tenta os nomes UGC conhecidos do dump + payloads variados
                    for _, ugcName in ipairs({ "UGC_PumpkinHead", "UGC_WizardHat" }) do
                        pcall(function() re:FireServer(ugcName) end)
                        pcall(function() re:FireServer(ugcName, true) end)
                        pcall(function() re:FireServer(ugcName, 1) end)
                    end
                end
                task.wait(2)
            end
        end)
    end
})

