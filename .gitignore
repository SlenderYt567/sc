-- UtilitÃ¡rios de instÃ¢ncia
local function new(class, props, parent)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do
        inst[k] = v
    end
    if parent then inst.Parent = parent end
    return inst
end

local function corner(radius, parent)
    return new("UICorner", { CornerRadius = UDim.new(0, radius) }, parent)
end

local function stroke(color, transparency, parent)
    return new("UIStroke", { Color = color, Transparency = transparency or 0 }, parent)
end

-- Toast (notificaÃ§Ã£o)
local toastHolder
local function toast(text, color)
    if not toastHolder then return end
    local t = new("Frame", {
        BackgroundColor3 = CONFIG.Card,
        Size = UDim2.new(0, 240, 0, 40),
        Position = UDim2.new(1, -260, 1, -60),
        ZIndex = 20,
    }, toastHolder)
    corner(8, t)
    stroke(CONFIG.CardBorder, 0, t)
    new("TextLabel", {
        Text = text,
        Font = CONFIG.FontBody,
        TextSize = 14,
        TextColor3 = CONFIG.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -12, 1, 0),
        Position = UDim2.new(0, 6, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
    }, t)
    t.Rotation = 90
    t.Position = UDim2.new(1, 40, 1, -60)
    local ti = TweenService:Create(t, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Rotation = 0, Position = UDim2.new(1, -260, 1, -60) })
    ti:Play()
    taskSpawn(function()
        taskWait(3)
        local out = TweenService:Create(t, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = UDim2.new(1, 60, 1, -60), Rotation = 90 })
        out:Play()
        out.Completed:Connect(function()
            t:Destroy()
        end)
    end)
end

-- Componente: Toggle
local function createToggle(parent, title, subtitle, getter, onChanged)
    local card = new("Frame", {
        BackgroundColor3 = CONFIG.Card,
        Size = UDim2.new(1, -24, 0, 64),
        Position = UDim2.new(0, 12, 0, 0),
    }, parent)
    corner(10, card)
    stroke(CONFIG.CardBorder, 0, card)
    new("TextLabel", {
        Text = title,
        Font = CONFIG.FontTitle,
        TextSize = 16,
        TextColor3 = CONFIG.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(0.8, -20, 0, 22),
        Position = UDim2.new(0, 12, 0, 8),
        TextXAlignment = Enum.TextXAlignment.Left,
    }, card)
    if subtitle then
        new("TextLabel", {
            Text = subtitle,
            Font = CONFIG.FontBody,
            TextSize = 12,
            TextColor3 = CONFIG.SubText,
            BackgroundTransparency = 1,
            Size = UDim2.new(0.8, -20, 0, 18),
            Position = UDim2.new(0, 12, 0, 32),
            TextXAlignment = Enum.TextXAlignment.Left,
        }, card)
    end
    local track = new("Frame", {
        BackgroundColor3 = Color3.fromRGB(60, 60, 80),
        Size = UDim2.new(0, 46, 0, 24),
        Position = UDim2.new(1, -62, 0, 20),
        AnchorPoint = Vector2.new(1, 0),
    }, card)
    corner(12, track)
    local knob = new("Frame", {
        BackgroundColor3 = Color3.fromRGB(235, 235, 245),
        Size = UDim2.new(0, 18, 0, 18),
        Position = UDim2.new(0, 3, 0, 3),
    }, track)
    corner(9, knob)
    local button = new("TextButton", {
        Text = "",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
    }, card)
    button.ZIndex = 10
    local function updateVisual()
        local on = getter()
        local targetColor = on and CONFIG.Accent or Color3.fromRGB(60, 60, 80)
        local targetPos = on and UDim2.new(1, -21, 0, 3) or UDim2.new(0, 3, 0, 3)
        TweenService:Create(track, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundColor3 = targetColor }):Play()
        TweenService:Create(knob, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = targetPos }):Play()
    end
    button.MouseButton1Click:Connect(function()
        onChanged(not getter())
        updateVisual()
    end)
    updateVisual()
    return card, updateVisual
end

-- Componente: BotÃ£o
local function createButton(parent, title, callback, color)
    local card = new("Frame", {
        BackgroundColor3 = CONFIG.Card,
        Size = UDim2.new(1, -24, 0, 48),
        Position = UDim2.new(0, 12, 0, 0),
    }, parent)
    corner(10, card)
    stroke(CONFIG.CardBorder, 0, card)
    new("TextLabel", {
        Text = title,
        Font = CONFIG.FontTitle,
        TextSize = 15,
        TextColor3 = color or CONFIG.Accent,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
    }, card)
    local button = new("TextButton", {
        Text = "",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
    }, card)
    button.MouseEnter:Connect(function()
        TweenService:Create(card, TweenInfo.new(0.15), { BackgroundColor3 = CONFIG.CardBorder }):Play()
    end)
    button.MouseLeave:Connect(function()
        TweenService:Create(card, TweenInfo.new(0.15), { BackgroundColor3 = CONFIG.Card }):Play()
    end)
    button.MouseButton1Click:Connect(function()
        local ok, err = pcall(callback)
        if not ok and err then
            toast("Erro: " .. tostring(err), CONFIG.Danger)
        end
    end)
    return card
end

-- Componente: Dropdown
local function createDropdown(parent, title, options, current, onSelected)
    local card = new("Frame", {
        BackgroundColor3 = CONFIG.Card,
        Size = UDim2.new(1, -24, 0, 56),
        Position = UDim2.new(0, 12, 0, 0),
    }, parent)
    corner(10, card)
    stroke(CONFIG.CardBorder, 0, card)
    new("TextLabel", {
        Text = title,
        Font = CONFIG.FontTitle,
        TextSize = 14,
        TextColor3 = CONFIG.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(0.45, -12, 0, 20),
        Position = UDim2.new(0, 12, 0, 8),
        TextXAlignment = Enum.TextXAlignment.Left,
    }, card)
    local display = new("TextButton", {
        Text = current,
        Font = CONFIG.FontBody,
        TextSize = 13,
        TextColor3 = CONFIG.Text,
        BackgroundColor3 = Color3.fromRGB(35, 35, 52),
        Size = UDim2.new(0.55, -12, 0, 32),
        Position = UDim2.new(0.45, 0, 0, 12),
    }, card)
    corner(8, display)
    stroke(CONFIG.CardBorder, 0, display)
    local list = new("ScrollingFrame", {
        BackgroundColor3 = CONFIG.Sidebar,
        Size = UDim2.new(0.55, -12, 0, 0),
        Position = UDim2.new(0.45, 0, 1, 4),
        Visible = false,
        ZIndex = 15,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ScrollBarThickness = 0,
    }, card)
    corner(8, list)
    stroke(CONFIG.CardBorder, 0, list)
    display.MouseButton1Click:Connect(function()
        list.Visible = not list.Visible
        if list.Visible then
            for _, child in ipairs(list:GetChildren()) do
                child:Destroy()
            end
            for _, opt in ipairs(options) do
                local optBtn = new("TextButton", {
                    Text = opt,
                    Font = CONFIG.FontBody,
                    TextSize = 13,
                    TextColor3 = CONFIG.Text,
                    BackgroundColor3 = Color3.fromRGB(30, 30, 46),
                    Size = UDim2.new(1, 0, 0, 34),
                    ZIndex = 16,
                }, list)
                optBtn.TextXAlignment = Enum.TextXAlignment.Left
                optBtn.PaddingLeft = UDim.new(0, 10)
                optBtn.MouseButton1Click:Connect(function()
                    display.Text = opt
                    list.Visible = false
                    onSelected(opt)
                end)
            end
            local h = math.min(#options * 34, 170)
            TweenService:Create(list, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.new(0.55, -12, 0, h) }):Play()
        else
            TweenService:Create(list, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Size = UDim2.new(0.55, -12, 0, 0) }):Play()
        end
    end)
    return card
end

-- Componente: Slider
local function createSlider(parent, title, min, max, current, onChanged)
    local card = new("Frame", {
        BackgroundColor3 = CONFIG.Card,
        Size = UDim2.new(1, -24, 0, 56),
        Position = UDim2.new(0, 12, 0, 0),
    }, parent)
    corner(10, card)
    stroke(CONFIG.CardBorder, 0, card)
    local label = new("TextLabel", {
        Text = title .. ": " .. tostring(current),
        Font = CONFIG.FontBody,
        TextSize = 13,
        TextColor3 = CONFIG.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(0.6, -12, 0, 20),
        Position = UDim2.new(0, 12, 0, 8),
        TextXAlignment = Enum.TextXAlignment.Left,
    }, card)
    local bg = new("Frame", {
        BackgroundColor3 = Color3.fromRGB(40, 40, 60),
        Size = UDim2.new(1, -24, 0, 6),
        Position = UDim2.new(0, 12, 0, 38),
    }, card)
    corner(3, bg)
    local fill = new("Frame", {
        BackgroundColor3 = CONFIG.Accent,
        Size = UDim2.new((current - min) / (max - min), 0, 1, 0),
    }, bg)
    corner(3, fill)
    local knobBtn = new("TextButton", {
        Text = "",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
    }, bg)
    local dragging = false
    knobBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)
    knobBtn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    knobBtn.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local rel = clamp((input.Position.X - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
            local value = math.floor(min + rel * (max - min) + 0.5)
            fill.Size = UDim2.new(rel, 0, 1, 0)
            label.Text = title .. ": " .. tostring(value)
            onChanged(value)
        end
    end)
    return card
end

