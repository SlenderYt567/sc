-- =====================================
-- EGG TAB
-- =====================================

local function CreateEggToggle(world, egg)
    local eggName = "Egg_" .. world .. "_" .. egg
    Flags.EggToggles[eggName] = false
    
    Tabs.Egg:AddToggle(eggName, {
        Title = "World " .. world .. " - Egg " .. egg,
        Default = false,
        Callback = function(v)
            Flags.EggToggles[eggName] = v
            task.spawn(function()
                while Flags.EggToggles[eggName] do
                    local re = GetKnitRemote("EggHatchService", "RE", "Hatch")
                    if re then
                        pcall(function() re:FireServer(eggName, 1) end)
                    end
                    task.wait(1)
                end
            end)
        end
    })
end

for world = 1, 4 do
    for egg = 1, 4 do
        CreateEggToggle(world, egg)
    end
end

