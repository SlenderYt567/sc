-- MISC
-- =====================================
local function TeleportToLobby()
    NetFire("TeleportToLobby")
    SafeNotify("SlenderHub", "Teleportando para o lobby...", 2)
end

local function VotePlayAgain()
    NetFire("PlayAgainVote")
    SafeNotify("SlenderHub", "Voto em jogar novamente enviado", 2)
end

local function ShowStats()
    local data = GetData()
    if data and data.Stats then
        SafeNotify("Dados", "Cash: $" .. tostring(data.Stats.LocalCash or 0)
            .. " | Classe: " .. tostring(data.Stats.Class or "?"), 5)
    else
        SafeNotify("Dados", "Dados indisponíveis (jogo não sincronizou)", 4)
    end
end

-- =====================================
-- UI NATIVA (ScreenGui)
-- =====================================
local UiGui = Instance.new("ScreenGui")
UiGui.Name = "SlenderHubAnimalHospital"
UiGui.ResetOnSpawn = false
UiGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

-- Suporte a executores mobile e restrições de permissão no CoreGui:
-- tenta parent no CoreGui; se o executor rejeitar (identity), usa gethui() e por fim PlayerGui
local ParentContainer = nil
if not pcall(function() UiGui.Parent = CoreGui end) then
    local okH, hui = pcall(function()
        if gethui then return gethui() end
        return nil
    end)
    if okH and hui then
        ParentContainer = hui
    else
        ParentContainer = LocalPlayer:WaitForChild("PlayerGui")
    end
    pcall(function() UiGui.Parent = ParentContainer end)
end

local ThemeUI = {
    Bg      = Color3.fromRGB(18, 22, 32),
    Panel   = Color3.fromRGB(24, 30, 44),
    Card    = Color3.fromRGB(31, 38, 56),
    Line    = Color3.fromRGB(45, 54, 80),
    Text    = Color3.fromRGB(235, 240, 250),
    Sub     = Color3.fromRGB(150, 160, 185),
    Accent  = Color3.fromRGB(64, 190, 255),
    Accent2 = Color3.fromRGB(38, 110, 190),
    Good    = Color3.fromRGB(60, 255, 120),
    Danger  = Color3.fromRGB(255, 70, 70),
}

local function Mk(className, props)
    local inst = Instance.new(className)
    for k, v in pairs(props) do inst[k] = v end
    return inst
end

local function Corner(parent, r)
    return Mk("UICorner", { Parent = parent, CornerRadius = UDim.new(0, r or 8) })
end

local function Stroke(parent, color, th)
    return Mk("UIStroke", { Parent = parent, Color = color or ThemeUI.Line, Thickness = th or 1 })
end

-- Janela principal
local Window = Mk("Frame", {
    Name = "Window",
    Parent = UiGui,
    BackgroundColor3 = ThemeUI.Bg,
    BorderSizePixel = 0,
    Position = UDim2.fromOffset(40, 60),
    Size = UDim2.fromOffset(560, 460),
})
Corner(Window, 12)
Stroke(Window, ThemeUI.Line, 1.5)

-- Dragging
do
    local dragging, dragStart, winStart
    local function update(input)
        local delta = input.Position - dragStart
        Window.Position = UDim2.fromOffset(winStart.X + delta.X, winStart.Y + delta.Y)
    end
    Window.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            winStart = Window.AbsolutePosition
        end
    end)
    Window.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end)
    Window.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

-- Atalho de teclado para abrir/fechar a UI (RCTRL)
UserInputService.InputBegan:Connect(function(input, gpe)
    if not gpe and input.KeyCode == Config.ToggleKey then
        UiGui.Enabled = not UiGui.Enabled
    end
end)

-- Header
local Header = Mk("Frame", { Name = "Header", Parent = Window, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 46) })
Mk("TextLabel", {
    Parent = Header, BackgroundTransparency = 1, Font = Enum.Font.GothamBold,
    Text = "SlenderHub | Animal Hospital", TextColor3 = ThemeUI.Text, TextSize = 18,
    Position = UDim2.fromOffset(16, 6), Size = UDim2.fromOffset(380, 26), TextXAlignment = Enum.TextXAlignment.Left,
})
Mk("TextLabel", {
    Parent = Header, BackgroundTransparency = 1, Font = Enum.Font.Gotham,
    Text = "By Slender (LIB " .. (LibReady and "OK" or "FAIL") .. ")", TextColor3 = ThemeUI.Sub, TextSize = 13,
    Position = UDim2.fromOffset(16, 26), Size = UDim2.fromOffset(380, 18), TextXAlignment = Enum.TextXAlignment.Left,
})

-- Botão fechar
local CloseBtn = Mk("TextButton", {
    Parent = Header, BackgroundColor3 = Color3.fromRGB(40, 48, 70), Text = "X",
    Font = Enum.Font.GothamBold, TextColor3 = ThemeUI.Text, TextSize = 16,
    Position = UDim2.new(1, -40, 0, 8), Size = UDim2.fromOffset(30, 30),
})
Corner(CloseBtn, 8)
CloseBtn.MouseButton1Click:Connect(function() UiGui.Enabled = false end)

-- Abas
local TabsBar = Mk("Frame", { Parent = Window, BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 58), Size = UDim2.fromOffset(150, 390) })

local TabDefs = {
    { Name = "Main",     Icon = "👤" },
    { Name = "Sanidade", Icon = "❤️" },
    { Name = "Auto",     Icon = "⚡" },
    { Name = "Farm",     Icon = "🧹" },
    { Name = "Visual",   Icon = "👁" },
    { Name = "Movimento", Icon = "🎮" },
    { Name = "Settings", Icon = "⚙️" },
}

local TabsContent = Mk("Frame", { Parent = Window, BackgroundColor3 = ThemeUI.Panel, Position = UDim2.fromOffset(170, 58), Size = UDim2.new(1, -182, 1, -70) })
Corner(TabsContent, 10)
Stroke(TabsContent, ThemeUI.Line, 1)

local TabButtons = {}
local TabPages = {}
local CurrentTab = 1

local function ShowTab(idx)
    CurrentTab = idx
    for i, btn in ipairs(TabButtons) do
        local active = (i == idx)
        TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = active and ThemeUI.Accent2 or ThemeUI.Card }):Play()
        local lbl = btn:FindFirstChild("Label")
        if lbl then lbl.TextColor3 = active and Color3.fromRGB(255,255,255) or ThemeUI.Sub end
    end
    for i, page in ipairs(TabPages) do page.Visible = (i == idx) end
end

for i, def in ipairs(TabDefs) do
    local btn = Mk("TextButton", {
        Parent = TabsBar, BackgroundColor3 = ThemeUI.Card, Text = "",
        Position = UDim2.fromOffset(0, (i-1) * 50), Size = UDim2.fromOffset(150, 44),
        ZIndex = 2,
    })
    Corner(btn, 8)
    Stroke(btn, ThemeUI.Line, 1)
    Mk("TextLabel", {
        Parent = btn, Name = "Icon", BackgroundTransparency = 1, Font = Enum.Font.Gotham,
        Text = def.Icon, TextColor3 = ThemeUI.Text, TextSize = 16,
        Position = UDim2.fromOffset(8, 3), Size = UDim2.fromOffset(28, 28),
    })
    Mk("TextLabel", {
        Parent = btn, Name = "Label", BackgroundTransparency = 1, Font = Enum.Font.GothamBold,
        Text = def.Name, TextColor3 = ThemeUI.Sub, TextSize = 14,
        Position = UDim2.fromOffset(40, 0), Size = UDim2.fromOffset(104, 44),
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    btn.MouseButton1Click:Connect(function() ShowTab(i) end)
    TabButtons[i] = btn

    local page = Mk("ScrollingFrame", {
        Parent = TabsContent, BackgroundTransparency = 1, Visible = false,
        Position = UDim2.fromOffset(10, 10), Size = UDim2.new(1, -20, 1, -20),
        CanvasSize = UDim2.new(0, 0, 2, 0), ScrollBarThickness = 4,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
    })
    TabPages[i] = page
end

-- Layout Helpers
local PageCursor = {}
local function NextY(page, h)
    local y = PageCursor[page] or 0
    PageCursor[page] = y + h
    return y
end

local function Section(page, title)
    local y = NextY(page, 34)
    Mk("TextLabel", {
        Parent = page, BackgroundTransparency = 1, Font = Enum.Font.GothamBold,
        Text = title, TextColor3 = ThemeUI.Accent, TextSize = 14,
        Position = UDim2.fromOffset(6, y), Size = UDim2.fromOffset(320, 24),
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    local line = Mk("Frame", { Parent = page, BackgroundColor3 = ThemeUI.Line, Position = UDim2.fromOffset(6, y + 26), Size = UDim2.new(1, -12, 0, 1) })
    return line
end

local function Spacer(page, h)
    NextY(page, h or 8)
end

local function Toggle(page, title, desc, default, cb)
    local y = NextY(page, 58)
    local card = Mk("Frame", { Parent = page, BackgroundColor3 = ThemeUI.Card, Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, 52) })
    Corner(card, 8)
    Stroke(card, ThemeUI.Line, 1)
    Mk("TextLabel", {
        Parent = card, BackgroundTransparency = 1, Font = Enum.Font.Gotham,
        Text = title, TextColor3 = ThemeUI.Text, TextSize = 14,
        Position = UDim2.fromOffset(12, 5), Size = UDim2.fromOffset(300, 20), TextXAlignment = Enum.TextXAlignment.Left,
    })
    if desc and #desc > 0 then
        Mk("TextLabel", {
            Parent = card, BackgroundTransparency = 1, Font = Enum.Font.Gotham,
            Text = desc, TextColor3 = ThemeUI.Sub, TextSize = 11,
            Position = UDim2.fromOffset(12, 25), Size = UDim2.fromOffset(300, 18), TextXAlignment = Enum.TextXAlignment.Left,
        })
    end
    local knob = Mk("Frame", {
        Parent = card, Name = "Knob", BackgroundColor3 = default and ThemeUI.Accent or ThemeUI.Line,
        Position = UDim2.new(1, -42, 0, 11), Size = UDim2.fromOffset(30, 30),
    })
    Corner(knob, 15)
    local dot = Mk("Frame", { Parent = knob, Name = "Dot", BackgroundColor3 = Color3.fromRGB(255,255,255), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.fromOffset(12, 12) })
    Corner(dot, 6)
    local state = default or false
    local function refresh()
        TweenService:Create(knob, TweenInfo.new(0.15), { BackgroundColor3 = state and ThemeUI.Accent or ThemeUI.Line }):Play()
        dot.Visible = state
    end
    refresh()
    local btn = Mk("TextButton", { Parent = card, BackgroundTransparency = 1, Text = "", Size = UDim2.new(1, 0, 1, 0) })
    btn.MouseButton1Click:Connect(function()
        state = not state
        refresh()
        pcall(cb, state)
    end)
    return {
        Set = function(v) state = v; refresh(); pcall(cb, v) end,
        Get = function() return state end,
    }
end

local function Button(page, title, cb)
    local y = NextY(page, 46)
    local btn = Mk("TextButton", {
        Parent = page, BackgroundColor3 = ThemeUI.Accent2, Text = title,
        Font = Enum.Font.GothamBold, TextColor3 = Color3.fromRGB(255,255,255), TextSize = 14,
        Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, 40),
    })
    Corner(btn, 8)
    Stroke(btn, ThemeUI.Line, 1)
    btn.MouseButton1Click:Connect(function() pcall(cb) end)
    return btn
end

local function Slider(page, title, min, max, def, cb)
    local y = NextY(page, 70)
    local card = Mk("Frame", { Parent = page, BackgroundColor3 = ThemeUI.Card, Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, 64) })
    Corner(card, 8)
    Stroke(card, ThemeUI.Line, 1)
    Mk("TextLabel", {
        Parent = card, BackgroundTransparency = 1, Font = Enum.Font.Gotham,
        Text = title, TextColor3 = ThemeUI.Text, TextSize = 14,
        Position = UDim2.fromOffset(12, 5), Size = UDim2.fromOffset(240, 20), TextXAlignment = Enum.TextXAlignment.Left,
    })
    local valLbl = Mk("TextLabel", {
        Parent = card, BackgroundTransparency = 1, Font = Enum.Font.GothamBold,
        Text = tostring(def), TextColor3 = ThemeUI.Accent, TextSize = 14,
        Position = UDim2.new(1, -60, 0, 5), Size = UDim2.fromOffset(50, 20), TextXAlignment = Enum.TextXAlignment.Right,
    })
    local bar = Mk("Frame", { Parent = card, BackgroundColor3 = ThemeUI.Line, Position = UDim2.fromOffset(12, 34), Size = UDim2.new(1, -24, 0, 6) })
    Corner(bar, 3)
    local fill = Mk("Frame", { Parent = bar, Name = "Fill", BackgroundColor3 = ThemeUI.Accent, Size = UDim2.new((def-min)/(max-min), 0, 1, 0) })
    Corner(fill, 3)
    local value = def
    local function setFrom(input)
        local localX = math.clamp(input.Position.X - bar.AbsolutePosition.X, 0, bar.AbsoluteSize.X)
        value = min + (max - min) * (localX / math.max(bar.AbsoluteSize.X, 1))
        value = math.floor(value * 10 + 0.5) / 10
        fill.Size = UDim2.new((value-min)/(max-min), 0, 1, 0)
        valLbl.Text = tostring(value)
        pcall(cb, value)
    end
    local dragBtn = Mk("TextButton", { Parent = bar, BackgroundTransparency = 1, Text = "", Size = UDim2.new(1, 0, 1, 0) })
    dragBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            setFrom(input)
        end
    end)
    dragBtn.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            setFrom(input)
        end
    end)
    return {
        Set = function(v) value = v; fill.Size = UDim2.new((value-min)/(max-min), 0, 1, 0); valLbl.Text = tostring(v); pcall(cb, v) end,
        Get = function() return value end,
    }
end

-- ============================================================
-- UPGRADE v4.5.1 — FEATURES (7 hubs: Foxname/Vexus/Cyraa/HexHubX/MiniHub/Overflow/OP Gui)
-- Validado contra dump do jogo (remotes.txt + scripts_rodando)
-- ============================================================

-- ============================================================
-- AUTO SHUTTER (persianas): fecha quando ameaça está no check-in
-- ============================================================
local ShutterOn = false
local ShutterClosed = false

local function FindShutterButton()
    -- tag real (Foxname): "ShutterButton"
    local best, bestD = nil, math.huge
    local root = GetRoot()
    for _, inst in ipairs(workspace:GetDescendants()) do
        if inst:IsA("BasePart") and inst:HasTag("ShutterButton") then
            local d = root and (root.Position - inst.Position).Magnitude or 0
            if d < bestD then best, bestD = inst, d end
        end
    end
    return best
end

local function ThreatNearCheckIn()
    -- tags REAIS de anomalia/monstros confirmadas no dump:
    -- GhostAnomaly (CameraSystem), StalkerMonster (StalkerStare), TallMonsterSpawn,
    -- Shadow (Jumpscares), DontLookUp, Anomaly (ESP)
    local root = GetRoot()
    if not root then return false end
    for _, tag in ipairs({ "Anomaly", "GhostAnomaly", "Skinwalker", "StalkerMonster", "TallMonsterSpawn", "Shadow", "DontLookUp", "Fake" }) do
        for _, inst in ipairs(CollectionService:GetTagged(tag)) do
            local pos = inst:IsA("BasePart") and inst.Position
                or (inst.PrimaryPart and inst.PrimaryPart.Position) or nil
            if pos and (root.Position - pos).Magnitude < 40 then return true end
        end
    end
    return false
end

local function PressShutter(button)
    local pp = button:FindFirstChildWhichIsA("ProximityPrompt")
        or button:FindFirstChildOfClass("ProximityPrompt")
    if pp then
        TeleportNear(button.Position, 3)
        FirePrompt(pp)
        return true
    end
    -- fallback: ClickDetector
    local cd = button:FindFirstChildOfClass("ClickDetector")
    if cd then
        TeleportNear(button.Position, 3)
        pcall(function()
            if fireclickdetector then fireclickdetector(cd) else cd:Click() end
        end)
        return true
    end
    return false
end

local function SetAutoShutter(enabled)
    ShutterOn = enabled
    if not enabled then
        ShutterClosed = false
        SafeNotify("Auto Shutter", "Desativado", 2)
        return
    end
    task.spawn(function()
        while ShutterOn and task.wait(1.0) do
            pcall(function()
                local button = FindShutterButton()
                if not button then return end
                local threat = ThreatNearCheckIn()
                if threat and not ShutterClosed then
                    PressShutter(button)
                    ShutterClosed = true
                    SafeNotify("Shutter", "Fechando persiana (ameaça no check-in)", 3)
                elseif not threat and ShutterClosed then
                    PressShutter(button)
                    ShutterClosed = false
                end
            end)
        end
    end)
end

-- ============================================================
-- AUTO FIX CAMS: conserta câmeras quebradas
-- Tags REAIS do dump (CameraSystem.lua): "SecurityCamera" + "BrokenCam"
-- ============================================================
local FixCamOn = false

local function FindBrokenCamera()
    for _, tag in ipairs({ "BrokenCam", "SecurityCamera" }) do
        for _, inst in ipairs(CollectionService:GetTagged(tag)) do
            if inst:IsA("Model") or inst:IsA("BasePart") then return inst end
        end
    end
    -- fallback: parte com nome camera + prompt de conserto
    for _, desc in ipairs(workspace:GetDescendants()) do
        if desc:IsA("BasePart") and string.find(string.lower(desc.Name), "camera") then
            local pp = desc:FindFirstChildWhichIsA("ProximityPrompt")
            if pp and pp.Enabled then return desc end
        end
    end
    return nil
end

local function SetAutoFixCam(enabled)
    FixCamOn = enabled
    if not enabled then
        SafeNotify("Auto Fix Cam", "Desativado", 2)
        return
    end
    task.spawn(function()
        while FixCamOn and task.wait(2) do
            pcall(function()
                local cam = FindBrokenCamera()
                if not cam then return end
                local pos = cam:IsA("BasePart") and cam.Position
                    or (cam.PrimaryPart and cam.PrimaryPart.Position) or nil
                if not pos then return end
                local pp = cam:FindFirstChildWhichIsA("ProximityPrompt")
                    or cam:FindFirstChildOfClass("ProximityPrompt")
                if pp then
                    TeleportNear(pos, 3)
