-- ============================================================
-- 3. UTILITÁRIOS
-- ============================================================

--- Obtém um RemoteEvent de um serviço Knit.
--- @param serviceName string
--- @param remoteName string
--- @return RemoteEvent?
local function getServiceRemote(serviceName: string, remoteName: string)
    local knit = ReplicatedStorage:FindFirstChild("Packages")
        and ReplicatedStorage.Packages:FindFirstChild("Knit")
    local services = knit and knit:FindFirstChild("Services")
    local svc = services and services:FindFirstChild(serviceName)
    local re = svc and svc:FindFirstChild("RE")
    return re and re:FindFirstChild(remoteName)
end

--- Dispara um instância de evento de forma segura (RemoteEvent/BindableEvent/RemoteFunction).
local function fireInstance(inst: Instance?, ...: any): boolean
    if not inst then
        return false
    end
    local ok, err = pcall(function()
        if inst:IsA("RemoteEvent") then
            inst:FireServer(...)
        elseif inst:IsA("BindableEvent") then
            inst:Fire(...)
        elseif inst:IsA("RemoteFunction") then
            inst:InvokeServer(...)
        end
    end)
    if not ok then
        warn("[PetUniverseHub] fireInstance falhou:", err)
    end
    return ok
end

--- Retorna a posição central de uma zona (Spawner ou média dos PetArea).
local function getZonePosition(zone: string): Vector3?
    local spawners = Workspace:FindFirstChild("BreakablesSpawners")
    local zoneFolder = spawners and spawners:FindFirstChild(zone)
    if not zoneFolder then
        return nil
    end
    local spot = zoneFolder:FindFirstChild("Spawner") or zoneFolder:FindFirstChild("PetArea")
    if spot and spot:IsA("BasePart") then
        return spot.Position
    end
    local total = Vector3.zero
    local count = 0
    for _, v in ipairs(zoneFolder:GetDescendants()) do
        if v.Name == "PetArea" and v:IsA("BasePart") then
            total += v.Position
            count += 1
        end
    end
    if count > 0 then
        return total / count
    end
    return nil
end

--- Teleporta o personagem para o centro de uma zona.
local function teleportToZone(zone: string): boolean
    local pos = getZonePosition(zone)
    local char = LP.Character
    local hrp = char and char:FindFirstChild(HRP)
    if pos and hrp then
        hrp.CFrame = CFrame.new(pos + Vector3.new(0, 6, 0))
        return true
    end
    return false
end

--- Lê o valor de moedas do mirror de dados do jogador.
local function getCoins(): number?
    local mirror = ReplicatedFirst:FindFirstChild("PlayerDataMirror")
    local stats = mirror and mirror:FindFirstChild("Stats")
    local coins = stats and stats:FindFirstChild("Coins")
    if coins and coins:IsA("ValueBase") then
        return coins.Value
    end
    return nil
end

