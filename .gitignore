		Title = "Alvo (enchant)",
		Values = { "Greed", "Mining", "Luck" },
		MultiSelect = false,
		Default = "Greed",
		Callback = function(v)
			Settings.enchantTarget = v
		end,
	})
	Settings.enchantTarget = "Greed"

	sec4:AddToggle("AutoEnchant", {
		Title = "Auto Enchant",
		Default = false,
		Callback = function(v)
			Settings.autoEnchant = v
			if v then
				runNamedLoop("enchant", function()
					if Network.ok and Settings.enchantPet and Settings.enchantTarget then
						send("StartAutoEnchant", { Pet = Settings.enchantPet, Target = Settings.enchantTarget })
					end
				end, function()
					return Settings.autoEnchant
				end)
			else
				cleanupThread("enchant")
				send("StopAutoEnchant", false)
			end
		end,
	})

	sec4:AddSlider("EnchantInterval", {
		Title = "Intervalo (s)",
		Min = 2,
		Max = 30,
		Default = Settings.enchantInterval,
		Rounding = 1,
		Callback = function(v)
			Settings.enchantInterval = v
		end,
	})

	sec4:AddButton({
		Title = "Roll enchant manual",
		Callback = function()
			if Settings.enchantPet then
				send("RollEnchant", Settings.enchantPet)
			else
				Notify("Enchant", "Selecione um pet primeiro.", 3)
			end
		end,
	})

	sec4:AddButton({
		Title = "Parar auto enchant",
		Callback = function()
			Settings.autoEnchant = false
			cleanupThread("enchant")
			send("StopAutoEnchant", false)
		end,
	})

	sec4:AddParagraph({
		Title = "Info",
		Content = "StartAutoEnchant{Pet, Target} (rateLimit 4/s). Pet = nome do pet do inventário "
			.. "(dropdown atualiza via InventoryUpdate). Alvo = enchant desejado (Greed, Mining, Luck...). "
			.. "Dropdown de alvo também atualiza via UpdatePetEnchants.",
	})

	-- ---- Hooks de UI (rodam após o State ser atualizado) ----
	hookState("UpdateTNT", function(m)
		local lines, vals = {}, {}
		for name, amt in pairs(m) do
			table.insert(lines, ("%s: x%s"):format(name, tostring(amt)))
			table.insert(vals, name)
		end
		table.sort(vals)
		if #lines == 0 then table.insert(lines, "Nenhum TNT no inventário") end
		pcall(function() tntInfo:SetContent(table.concat(lines, "\n")) end)
		if #vals > 0 then
			refreshDropdown(tntDD, vals)
			if not Settings.tntName or not m[Settings.tntName] then
				Settings.tntName = vals[1]
			end
		end
	end)

	hookState("UpdateMysteryBoxes", function(n)
		pcall(function()
			mysteryInfo:SetContent("Mystery Boxes: " .. tostring(n))
		end)
	end)

	hookState("UpdateCraftSlots", function(m)
		local lines = {}
		for k, v in pairs(m) do
			if type(v) == "table" then
				table.insert(lines, ("Slot %s: %s x%s"):format(
					tostring(k), tostring(v.Recipe or "?"), tostring(v.Amount or 0)
				))
			end
		end
		if #lines == 0 then table.insert(lines, "Nenhum craft em andamento") end
		pcall(function() craftInfo:SetContent(table.concat(lines, "\n")) end)
	end)

	hookState("UpdatePetEnchants", function(m)
		local seen = {}
		for _, info in pairs(m) do
			if type(info) == "table" and info.Name and info.Name ~= "" then
				seen[info.Name] = true
			end
		end
		local vals = {}
		for name in pairs(seen) do table.insert(vals, name) end
		table.sort(vals)
		if #vals > 0 then
			refreshDropdown(enchantTargetDD, vals)
			if not Settings.enchantTarget or not seen[Settings.enchantTarget] then
				Settings.enchantTarget = vals[1]
			end
		end
	end)

	hookState("AutoEnchantUpdate", function(data)
		local active = (data.Active == true) and "ATIVO" or "inativo"
		pcall(function()
			enchantInfo:SetContent(
				("AutoEnchant: %s\nPet: %s\nAlvo: %s\nRolls: %s"):format(
					active,
					tostring(data.Pet or "-"),
					tostring(data.Target or "-"),
					tostring(data.Rolls or 0)
				)
			)
		end)
	end)

	hookState("InventoryUpdate", function(data)
		local pets = data.Quantities or {}
		local vals = {}
		for name in pairs(pets) do table.insert(vals, name) end
		table.sort(vals)
		if #vals > 0 then
			refreshDropdown(enchantPetDD, vals)
			if not Settings.enchantPet or not pets[Settings.enchantPet] then
				Settings.enchantPet = vals[1]
			end
		end
	end)
end

-- ============ ADMIN ============
do
	local sec = Tabs.Admin:AddSection("Conch Admin System")

	local adminStatus = sec:AddParagraph({
		Title = "Status",
		Content = "ConchAdmin: " .. tostring(isAdmin()),
	})

	sec:AddParagraph({
		Title = "Aviso",
		Content = "Este painel só funciona se o atributo ConchAdmin do seu personagem estiver "
			.. "ativo (F2 abre o console oficial do jogo). Comandos são enviados via "
			.. "conch_networking.invoke_server_command. Teste com um comando simples "
			.. "(ex: help) em conta descartável antes de usar em conta principal.",
	})

	local prefixInput = sec:AddInput("AdminPrefix", {
		Title = "Prefixo",
		Default = ";",
		Placeholder = ";",
		Callback = function(v)
			Settings.adminPrefix = v
		end,
	})

	local cmdInput = sec:AddInput("AdminCommand", {
		Title = "Comando",
		Default = "",
		Placeholder = "ex: kill me / give coins 1000",
		Finished = true,
		Callback = function(v)
			Settings.adminCommand = v
			if v and v ~= "" then runAdminCommand(v) end
		end,
	})

	sec:AddButton({
		Title = "Executar comando",
		Callback = function()
			runAdminCommand(Settings.adminCommand)
		end,
	})

	onConnection(LocalPlayer:GetAttributeChangedSignal("ConchAdmin"):Connect(function()
		pcall(function()
			adminStatus:SetContent("ConchAdmin: " .. tostring(isAdmin()))
		end)
		Notify("Admin", "ConchAdmin mudou para: " .. tostring(isAdmin()), 4)
	end))
end

-- ============ INFO ============
do
	local sec = Tabs.Info:AddSection("Estatísticas")

	local statsParagraph = sec:AddParagraph({
		Title = "Live Stats",
		Content = "Aguardando dados do servidor...",
	})

	local function formatNumber(n)
		local s = tostring(math.floor(n))
		local r = ""
		while #s > 3 do
			r = "," .. string.sub(s, -3) .. r
			s = string.sub(s, 1, -4)
		end
		return s .. r
	end

	Hub.__threads.stats = task.spawn(function()
		while true do
			local lines = {
				("Coins:  %s"):format(formatNumber(State.currencies.Coins or 0)),
				("Gems:   %s"):format(formatNumber(State.currencies.Gems or 0)),
				("Rebirths: %s"):format(formatNumber(State.rebirths)),
				("Blocos minerados (sessão): %s"):format(formatNumber(State.blocksMined)),
				("Rank XP: %s"):format(formatNumber(State.rankXp)),
				("Pets:   %s | Boosts: %s | Flags: %s"):format(
					formatNumber(mapSum(State.pets)),
					formatNumber(mapSum(State.boosts)),
					formatNumber(mapSum(State.flags))
				),
				("Minérios: %s | TNT: %s"):format(
					formatNumber(mapSum(State.ores)),
					formatNumber(mapSum(State.tnt))
				),
				("Rede nativa: %s"):format(Network.ok and "OK" or "FALHOU (features desabilitadas)"),
			}
			pcall(function()
				statsParagraph:SetContent(table.concat(lines, "\n"))
			end)
			task.wait(1)
		end
	end)

	local sec2 = Tabs.Info:AddSection("Sobre")

	sec2:AddParagraph({
		Title = "SlenderHub",
		Content = "Dump: Mining Legends! (138805779586842)\n"
			.. "Rede: ReplicatedStorage.Packages.Network (packets nativos)\n"
			.. "Honeypots ignorados: IntegrityCheck*, SetDialogInUse, conch log*.",
	})

	sec2:AddButton({
		Title = "Limpar e fechar hub",
		Callback = function()
			Fluent:Dialog({
				Title = "Fechar hub",
				Content = "Tem certeza? Todas as features serão desativadas.",
				Buttons = {
					{ Title = "Sim", Callback = function()
						Settings.farmEnabled = false
						Settings.autoRebirth = false
						Settings.autoHatch = false
						Settings.autoEquipBest = false
						Settings.autoSpin = false
						Settings.autoBoost = false
						Settings.autoClaimPlaytime = false
						Settings.autoTNT = false
						Settings.autoMystery = false
						Settings.autoEnchant = false
						Settings.noclip = false
						Settings.espOres = false
						cleanupAll()
						clearESP()
						pcall(Window.Destroy, Window)
						Env[HUB_NAME] = nil
					end },
					{ Title = "Não", Callback = function() end },
				},
			})
		end,
	})
end

-- ============ CONFIG (SaveManager / InterfaceManager) ============
local SaveManager = nil
local InterfaceManager = nil
do
	local sok, sres = pcall(function()
		return loadstring(game:HttpGet(
			"https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/SaveManager.lua"
		))()
	end)
	if sok and sres then SaveManager = sres end

	local iok, ires = pcall(function()
		return loadstring(game:HttpGet(
			"https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/InterfaceManager.lua"
		))()
	end)
	if iok and ires then InterfaceManager = ires end

	if SaveManager then
		pcall(function()
			SaveManager:SetLibrary(Fluent)
			SaveManager:IgnoreThemeSettings()
			SaveManager:SetIgnoreIndexes({})
			SaveManager:BuildConfigSection(Tabs.Config)
		end)
	end

	if InterfaceManager then
		pcall(function()
			InterfaceManager:SetLibrary(Fluent)
			InterfaceManager:SetFolder("SlenderHub_MiningLegends")
			InterfaceManager:BuildInterfaceSection(Tabs.Config)
			InterfaceManager:SetTheme("Dark")
		end)
	end

	if not (SaveManager and InterfaceManager) then
		Notify("Config", "Addons de config não carregados (verifique a internet).", 5)
	end
end

-- ============================================================
-- 9) INICIALIZAÇÃO FINAL
-- ============================================================
refreshZones()

Window:SelectTab(1)

if SaveManager then pcall(SaveManager.LoadAutoloadConfig, SaveManager) end
if InterfaceManager then pcall(InterfaceManager.LoadInterfaceConfig, InterfaceManager) end

if not Network.ok then
	Notify(
		"SlenderHub ML",
		"Falha ao integrar a rede do jogo (require). "
			.. "Verifique se ReplicatedStorage.Packages.Network existe. Features de farm desabilitadas.",
		8
	)
else
	Notify("SlenderHub ML", "Hub carregado! Rede nativa OK.", 5)
end

if isAdmin() then
	Notify("Admin", "ConchAdmin detectado — painel admin disponível.", 5)
end

-- Garantia de parada ao sair do jogo
onConnection(Players.PlayerRemoving:Connect(function(plr)
	if plr == LocalPlayer then
		cleanupAll()
		clearESP()
	end
end))
