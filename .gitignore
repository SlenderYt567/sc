espSection:AddToggle("EspEnabled", {
    Title = "ESP de Breakables",
    Default = false,
    Callback = function(value: boolean)
        espState.enabled = value
        onEspChanged()
    end,
})

local espZones = { "All" }
for _, zone in ipairs(ZONES) do
    table.insert(espZones, zone)
end

espSection:AddDropdown("EspZone", {
    Title = "Zona do ESP",
    Values = espZones,
    Default = "All",
    Callback = function(value: string)
        espState.zone = value
        onEspChanged()
    end,
})

espSection:AddToggle("EspOrbs", {
    Title = "ESP de Orbs",
    Default = false,
    Callback = function(value: boolean)
        espState.orbs = value
        onEspChanged()
    end,
})

espSection:AddButton({
    Title = "Atualizar ESP agora",
    Callback = function()
        refreshESP()
    end,
})

-- ============================================================
-- 15. ABA SETTINGS (SAVE/LOAD)
-- ============================================================
local settingsSection = Tabs.Settings:AddSection("Configurações")

local SaveManager = loadstring(game:HttpGet(
    "https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/SaveManager.lua"
))()
SaveManager:SetLibrary(Fluent)
SaveManager:IgnoreThemeSettings()
SaveManager:SetIgnoreIndexes({})
SaveManager:BuildConfigSection(Tabs.Settings)

local InterfaceManager = loadstring(game:HttpGet(
    "https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/InterfaceManager.lua"
))()
InterfaceManager:SetLibrary(Fluent)
InterfaceManager:SetFolder("SlenderHub/PetUniverse")
InterfaceManager:BuildInterfaceSection(Tabs.Settings)
InterfaceManager:SetTheme("Dark")

-- ============================================================
-- 16. FINALIZAÇÃO
-- ============================================================
Window:SelectTab(1)
SaveManager:LoadAutoloadConfig()
InterfaceManager:LoadInterfaceConfig()

Fluent:Notify({
    Title = "Pet Universe Hub",
    Content = "Carregado! Aba Farm > Auto Farm para iniciar o exploit.",
    Duration = 4,
})
