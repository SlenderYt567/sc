-- EGG CHRISTMAS (CORRIGIDO: dump mostra o egg real como "Christmas_Egg"
-- em Worlds.Area_Christmas.Eggs."Egg Stand".Christmas_Egg — o nome
-- "Egg_Christmas" NÃO existe no jogo, por isso não funcionava)
Tabs.Event:AddToggle("EggChristmas", {
    Title = "Egg Christmas (corrigido)",
    Callback = function(v)
        Flags.EggChristmas = v
        task.spawn(function()
            while Flags.EggChristmas do
                local re = GetKnitRemote("EggHatchService", "RE", "Hatch")
                if re then
                    -- Descobre o nome real do egg de natal dinamicamente
                    local worlds = ReplicatedStorage:FindFirstChild("Worlds")
                    local area = worlds and worlds:FindFirstChild("Area_Christmas")
                    local eggs = area and area:FindFirstChild("Eggs")
                    local eggStand = eggs and eggs:FindFirstChild("Egg Stand")

                    -- Nomes candidatos: o que encontrar na árvore + fallbacks conhecidos
                    local candidates = {}
                    if eggStand then
                        for _, child in ipairs(eggStand:GetChildren()) do
                            table.insert(candidates, child.Name)
                        end
                    end
                    -- Fallbacks (dump + variações comuns)
                    table.insert(candidates, "Christmas_Egg")
                    table.insert(candidates, "Egg_Christmas")
                    table.insert(candidates, "Egg_R_1")
                    table.insert(candidates, "Egg_R_2")

                    for _, eggName in ipairs(candidates) do
                        pcall(function()
                            re:FireServer(eggName, 1)
                        end)
                    end
                end
                task.wait(1)
            end
        end)
    end
})

-- =====================================
-- INF EVENTOS (payload negativo — mesmo padrão do InfGems que funciona)
-- =====================================

-- Helper: fira um remote com payload negativo em variantes
local function FireNegative(serviceName, remoteName, payloads)
    local re = GetKnitRemote(serviceName, "RE", remoteName)
    if not re then return end
    for _, args in ipairs(payloads) do
        pcall(function() re:FireServer(unpack(args)) end)
    end
end

-- INF GIFTS (Natal) — dump: GiftBoxService + ChristmasService + FightService
Tabs.Event:AddToggle("InfGifts", {
    Title = "Inf Gifts (Natal)",
    Default = false,
    Callback = function(v)
        Flags.InfGifts = v
        task.spawn(function()
            while Flags.InfGifts do
                -- GiftBoxService: drop/abrir gifts em massa
                FireNegative("GiftBoxService", "DropGifts", {
                    { -70e+70 }, { -70e+70, {} }, { 999 }, { 9999 }, {}
                })
                FireNegative("GiftBoxService", "PickGift", {
                    { -70e+70 }, { -70e+70, {} }, { 9999 }, {}
                })
                FireNegative("GiftBoxService", "OpenGiftBox", {
                    { -70e+70 }, { -70e+70, {} }, { 9999 }, {}
                })
                -- ChristmasService: tokens de natal
                FireNegative("ChristmasService", "DropTokens", {
                    { -70e+70 }, { -70e+70, {} }, { 9999 }, {}
                })
                -- FightService: claim de token de natal (mesmo formato dos fruit tokens)
                FireNegative("FightService", "GetChristmasTokenEvent", {
                    { -70e+70 }, { -70e+70, {} }, { 9999 }, {}
                })
                task.wait(0.2)
            end
        end)
    end
})

-- INF FRUIT TOKENS (área de frutas) — dump: a moeda da área é "tokens":
-- FightService/RE/GetFruitTokenEvent + FruitService/RE/GetTowerToken
-- (PlayerDataService/RE/FruitTokensChanged é server→client, não fire)
Tabs.Event:AddToggle("InfFruit", {
    Title = "Inf Fruit Tokens",
    Default = false,
    Callback = function(v)
        Flags.InfFruit = v
        task.spawn(function()
            while Flags.InfFruit do
                -- FightService: evento que concede tokens de fruta
                FireNegative("FightService", "GetFruitTokenEvent", {
                    { -70e+70 }, { -70e+70, {} }, { 9999 }, {}
                })
                -- FruitService: token de torre (área fruit)
                FireNegative("FruitService", "GetTowerToken", {
                    { -70e+70 }, { -70e+70, {} }, { 9999 }, {}
                })
                -- Compras com saldo negativo (mantido como fallback)
                FireNegative("FruitService", "BuyFruit", {
                    { "Fruit_001", -70e+70 }, { "Fruit_001", -70e+70, {} },
                    { "Fruit_002", -70e+70 }, { "Fruit_002", -70e+70, {} },
                    { "Fruit_003", -70e+70 }, { "Fruit_003", -70e+70, {} },
                    { "Fruit_004", -70e+70 }, { "Fruit_004", -70e+70, {} }
                })
                FireNegative("FruitService", "BuyPet", {
                    { -70e+70 }, { -70e+70, {} }
                })
                FireNegative("FruitService", "UpdateTowerLevel", {
                    { -70e+70 }, { -70e+70, {} }
                })
                task.wait(0.2)
            end
        end)
    end
})

