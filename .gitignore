-- SlenderHub Client Exporter v1.0
-- SlenderHub Client Exporter v1.2
-- Execute no cliente. Saida relativa ao workspace do executor.
-- Exporta um retrato do que esta acessivel, nao um jogo completo/restauravel.
-- Cancelar: getgenv().SlenderHubExport.Cancel = true
local CONFIG = {
    OutputRoot = "slenderhub_exports",
    BatchSize = 250,
    ChunkSize = 1000,
    Decompile = true,
    DecompileDelay = 0.1,
    MaxInstances = 0, -- 0 = sem limite; interrupcoes ficam no manifesto
    MaxDecompile = 0, -- 0 = sem limite
    IncludeDetached = true,
}

local VERSION = "1.2"
warn("[SlenderHub v" .. VERSION .. "] Iniciado | JSON local | build SH-CE-12")
local env = (type(getgenv) == "function" and getgenv()) or _G
if env.SlenderHubExport and env.SlenderHubExport.Running then
    warn("[SlenderHub] Uma exportacao ja esta em andamento.")
    return
end
local state = { Running = true, Cancel = false, Phase = "starting" }
local state = { Running = true, Cancel = false, Phase = "starting", Version = VERSION }
env.SlenderHubExport = state
local Http = game:GetService("HttpService")
local function capability(name, fallback)
    local value = env[name] or fallback
    return type(value) == "function" and value or nil
end
local write = capability("writefile", writefile)
local mkdir = capability("makefolder", makefolder)
local isdir = capability("isfolder", isfolder)
local decode = capability("decompile", decompile)
local providers = {
    { "getnilinstances", capability("getnilinstances", getnilinstances) },
    { "getloadedmodules", capability("getloadedmodules", getloadedmodules) },
    { "getrunningscripts", capability("getrunningscripts", getrunningscripts) },
}
local function safeName(value)
    local name = tostring(value):gsub('[<>:"/\\|?*%c]', "_"):gsub("[ .]+$", "")
    name = name:sub(1, 70)
    if name == "" then name = "unnamed" end
    -- Prefixo evita nomes reservados do Windows, como CON e NUL.
    return "n_" .. name
end
local function read(object, property)
    local ok, value = pcall(function() return object[property] end)
    if ok then return value end
end
local function pathOf(object)
    local ok, value = pcall(function() return object:GetFullName() end)
    return ok and value or tostring(object)
end
local ids, nextId = {}, 0
local function idOf(object)
    if not object then return nil end
    if not ids[object] then
        nextId = nextId + 1
        ids[object] = nextId
    end
    return ids[object]
end
local function serialize(value)
    local kind = typeof(value)
    if kind == "nil" or kind == "boolean" or kind == "string" then return value end
    if kind == "number" then
        if value ~= value or value == math.huge or value == -math.huge then
            return { type = "number", value = tostring(value) }
        end
        return value
    end
    if kind == "Instance" then
        return { type = kind, id = idOf(value), path = pathOf(value) }
    elseif kind == "Vector3" then
        return { type = kind, value = { value.X, value.Y, value.Z } }
    elseif kind == "Vector2" then
        return { type = kind, value = { value.X, value.Y } }
    elseif kind == "Color3" then
        return { type = kind, value = { value.R, value.G, value.B } }
    elseif kind == "CFrame" then
        return { type = kind, value = { value:GetComponents() } }
    elseif kind == "UDim2" then
        return { type = kind, value = { value.X.Scale, value.X.Offset, value.Y.Scale, value.Y.Offset } }
    elseif kind == "UDim" then
        return { type = kind, value = { value.Scale, value.Offset } }
    elseif kind == "EnumItem" then
        return { type = kind, name = tostring(value), value = value.Value }
    end
    return { type = kind, value = tostring(value), representation = "text_only" }
end

-- Lista explicita: nao existe enumeracao universal de propriedades no cliente.
local groups = {
    { "BasePart", { "CFrame", "Size", "Color", "Material", "Transparency", "Anchored", "CanCollide", "CanTouch", "CanQuery", "CollisionGroup" } },
    { "Model", { "PrimaryPart", "WorldPivot" } },
    { "MeshPart", { "MeshId", "TextureID" } },
    { "SpecialMesh", { "MeshId", "TextureId", "MeshType", "Scale", "Offset" } },
    { "Decal", { "Texture", "Color3", "Transparency", "Face" } },
    { "Sound", { "SoundId", "Volume", "PlaybackSpeed", "Looped" } },
    { "Animation", { "AnimationId" } },
    { "GuiObject", { "Position", "Size", "AnchorPoint", "Visible", "BackgroundColor3", "BackgroundTransparency", "LayoutOrder", "ZIndex", "Rotation" } },
    { "TextLabel", { "Text", "TextColor3", "TextSize", "Font", "TextScaled", "RichText" } },
    { "TextButton", { "Text", "TextColor3", "TextSize", "Font", "TextScaled", "RichText" } },
    { "TextBox", { "Text", "PlaceholderText", "TextColor3", "TextSize" } },
    { "ImageLabel", { "Image", "ImageColor3", "ImageTransparency" } },
    { "ImageButton", { "Image", "ImageColor3", "ImageTransparency" } },
    { "ScreenGui", { "Enabled", "ResetOnSpawn", "DisplayOrder", "IgnoreGuiInset" } },
    { "ValueBase", { "Value" } },
    { "ProximityPrompt", { "ActionText", "ObjectText", "HoldDuration", "MaxActivationDistance", "Enabled" } },
    { "ClickDetector", { "MaxActivationDistance" } },
    { "Attachment", { "CFrame" } },
    { "JointInstance", { "Part0", "Part1", "C0", "C1" } },
    { "WeldConstraint", { "Part0", "Part1", "Enabled" } },
    { "ParticleEmitter", { "Texture", "Enabled", "Rate", "Lifetime", "Speed", "Color", "Size" } },
    { "Lighting", { "Ambient", "OutdoorAmbient", "Brightness", "ClockTime", "FogColor", "FogStart", "FogEnd" } },
    { "Workspace", { "Gravity", "StreamingEnabled" } },
    { "BaseScript", { "Disabled", "RunContext" } },
}
local remoteClasses = { RemoteEvent = true, RemoteFunction = true, UnreliableRemoteEvent = true }
local bindableClasses = { BindableEvent = true, BindableFunction = true }
local scriptClasses = { LocalScript = true, ModuleScript = true, Script = true }
local manifest = {
    version = 1,
    status = "running",
    placeId = tostring(game.PlaceId),
    universeId = tostring(game.GameId),
    startedAt = os.date("!%Y-%m-%dT%H:%M:%SZ"),
    config = CONFIG,
    counts = { instances = 0, scripts = 0, source = 0, decompiled = 0, unavailable = 0, remotes = 0, bindables = 0, errors = 0 },
    treeChunks = {},
    limitations = {
        "Somente dados acessiveis ao cliente durante a varredura; nao e snapshot atomico.",
        "Nao inclui codigo privado do servidor, DataStores ou handlers de remotes no servidor.",
        "Streaming pode ocultar partes do mapa. Terreno voxel e conteudo binario de assets nao sao exportados.",
        "Propriedades usam uma lista selecionada; tipos marcados text_only nao sao reconstruiveis automaticamente.",
        "Decompilacao e resultado nao validado do executor, nao o fonte original garantido.",
        "IDs referenciados podem apontar para instancias inacessiveis ou fora da varredura.",
        "Este pacote nao e um arquivo rbxl/rbxlx nem uma copia funcional do jogo.",
    },
}
local root
local errors, remotes, bindables, scripts, pendingScripts = {}, {}, {}, {}, {}
local function recordError(stage, target, reason)
    manifest.counts.errors = manifest.counts.errors + 1
    errors[#errors + 1] = { stage = stage, target = target, error = tostring(reason) }
end
local function save(relative, content)
    state.Operation = "writefile: " .. relative
    local ok, reason = pcall(write, root .. "/" .. relative, content)
    if not ok then error("Falha gravando " .. relative .. ": " .. tostring(reason), 0) end
end
-- Nomes/textos podem conter bytes que nao formam UTF-8. Numeros nao finitos
-- tambem podem aparecer DENTRO de Vector3/CFrame, nao apenas como escalares.
-- Encoder local evita que JSONEncode aborte todo o lote nesses casos.
local function quoteJSON(value)
    local out, i = { '"' }, 1
    while i <= #value do
        local b = value:byte(i)
        if b == 34 then out[#out + 1] = '\\"'
        elseif b == 92 then out[#out + 1] = '\\\\'
        elseif b < 32 then out[#out + 1] = string.format("\\u%04x", b)
        elseif b < 128 then out[#out + 1] = string.char(b)
        else
            local length = b >= 194 and b <= 223 and 2
                or b >= 224 and b <= 239 and 3
                or b >= 240 and b <= 244 and 4 or 0
            local valid = length > 0 and i + length - 1 <= #value
            for offset = 1, length - 1 do
                local c = value:byte(i + offset)
                if not c or c < 128 or c > 191 then valid = false end
            end
            local second = value:byte(i + 1) or 0
            if (b == 224 and second < 160) or (b == 237 and second > 159)
                or (b == 240 and second < 144) or (b == 244 and second > 143) then valid = false end
            if valid then
                out[#out + 1] = value:sub(i, i + length - 1)
                i = i + length - 1
            else
                -- Byte invalido vira U+00XX. Fontes .luau sao salvas sem alteracao.
                out[#out + 1] = string.format("\\u%04x", b)
            end
        end
        i = i + 1
    end
    out[#out + 1] = '"'
    return table.concat(out)
end
local function encodeJSON(value, active, location)
    local kind = type(value)
    if kind == "nil" then return "null" end
    if kind == "boolean" then return value and "true" or "false" end
    if kind == "string" then return quoteJSON(value) end
    if kind == "number" then
        if value ~= value or value == math.huge or value == -math.huge then
            return '{"type":"number","value":' .. quoteJSON(tostring(value)) .. '}'
        end
        return string.format("%.17g", value)
    end
    if kind ~= "table" then error("Tipo JSON inesperado em " .. location .. ": " .. kind, 0) end
    if active[value] then error("Ciclo JSON em " .. location, 0) end
    active[value] = true
    local count, maximum, array = 0, 0, true
    for key in pairs(value) do
        count = count + 1
        if type(key) ~= "number" or key < 1 or key % 1 ~= 0 then array = false
        else maximum = math.max(maximum, key) end
    end
    array = array and count > 0 and maximum == count
    local parts = {}
    if array then
        for index = 1, count do
            parts[index] = encodeJSON(value[index], active, location .. "[" .. index .. "]")
        end
    else
        for key, item in pairs(value) do
            if type(key) ~= "string" then error("Chave JSON nao textual em " .. location, 0) end
            parts[#parts + 1] = quoteJSON(key) .. ":" .. encodeJSON(item, active, location .. "." .. key)
        end
    end
    active[value] = nil
    return (array and "[" or "{") .. table.concat(parts, ",") .. (array and "]" or "}")
end
local function json(relative, data)
    save(relative, Http:JSONEncode(data))
    state.Operation = "encode: " .. relative
    local ok, content = pcall(encodeJSON, data, {}, relative)
    if not ok then error("Falha serializando " .. relative .. ": " .. tostring(content), 0) end
    save(relative, content)
end
local function checkpoint()
    json("manifest.json", manifest)
end
local function ensureDirectory(path)
    state.Operation = "makefolder: " .. path
    if isdir then
        local ok, exists = pcall(isdir, path)
        if ok and exists then return end
    end
    local ok, reason = pcall(mkdir, path)
    if not ok then error("Nao foi possivel criar " .. path .. ": " .. tostring(reason), 0) end
end
local function run()
    assert(write and mkdir, "O executor precisa disponibilizar writefile e makefolder.")
    ensureDirectory(CONFIG.OutputRoot)
    root = CONFIG.OutputRoot .. "/place_" .. tostring(game.PlaceId) .. "_" .. os.date("!%Y%m%d_%H%M%S") .. "_" .. Http:GenerateGUID(false):sub(1, 8)
    ensureDirectory(root)
    ensureDirectory(root .. "/tree")
    ensureDirectory(root .. "/scripts")
    ensureDirectory(root .. "/remotes")
    state.Output = root
    manifest.exporterVersion = VERSION
    manifest.jsonEncoding = "local_utf8_safe; invalid bytes escaped as U+00XX; nonfinite numbers tagged"
    manifest.capabilities = { decompile = decode ~= nil }
    for _, provider in ipairs(providers) do manifest.capabilities[provider[1]] = provider[2] ~= nil end
    checkpoint()
    save("README.txt", table.concat(manifest.limitations, "\n") .. "\n\nConsulte manifest.json para estado e contagens; scripts/index.json para fontes e falhas.\nA arvore usa IDs de parent/instancia, inclusive para nomes duplicados.\nOs remotes sao um catalogo, nao uma descricao de argumentos ou comportamento.\n")
    warn("[SlenderHub] Exportando para " .. root)
    warn("[SlenderHub v" .. VERSION .. "] Exportando para " .. root)

    local chunk, seen = {}, {}
    local function flush()
        if #chunk == 0 then return end
        local file = string.format("tree/part_%05d.json", #manifest.treeChunks + 1)
        json(file, chunk)
        manifest.treeChunks[#manifest.treeChunks + 1] = file
        chunk = {}
        checkpoint()
    end
    local function inspect(object, origin)
        local node = {
            id = idOf(object), parentId = idOf(read(object, "Parent")),
            name = object.Name, class = object.ClassName, path = pathOf(object),
            origin = origin, properties = {}, attributes = {},
        }
        for _, group in ipairs(groups) do
            if object:IsA(group[1]) then
                for _, property in ipairs(group[2]) do
                    local value = read(object, property)
                    if value ~= nil then node.properties[property] = serialize(value) end
                end
            end
        end
        local okAttributes, attributes = pcall(function() return object:GetAttributes() end)
        if okAttributes then
            for key, value in pairs(attributes) do node.attributes[key] = serialize(value) end
        else recordError("attributes", node.path, attributes) end
        local okTags, tags = pcall(function() return game:GetService("CollectionService"):GetTags(object) end)
        if okTags then node.tags = tags else recordError("tags", node.path, tags) end
        chunk[#chunk + 1] = node
        manifest.counts.instances = manifest.counts.instances + 1
        local entry = { id = node.id, path = node.path, class = node.class, name = node.name }
        if remoteClasses[node.class] then
            remotes[#remotes + 1] = entry
            manifest.counts.remotes = #remotes
        elseif bindableClasses[node.class] then
            bindables[#bindables + 1] = entry
            manifest.counts.bindables = #bindables
        elseif scriptClasses[node.class] then
            entry.status = "pending"
            scripts[#scripts + 1] = entry
            pendingScripts[#pendingScripts + 1] = { object = object, entry = entry }
            manifest.counts.scripts = #scripts
        end
    end
    local function walk(start, origin)
        local stack = { start }
        local processed = 0
        while #stack > 0 and not state.Cancel do
            if CONFIG.MaxInstances > 0 and manifest.counts.instances >= CONFIG.MaxInstances then
                manifest.instanceLimitReached = true
                break
            end
            local object = table.remove(stack)
            if not seen[object] then
                seen[object] = true
                state.Operation = "inspect: " .. pathOf(object)
                local ok, reason = pcall(inspect, object, origin)
                if not ok then recordError("instance", pathOf(object), reason) end
                local okChildren, children = pcall(function() return object:GetChildren() end)
                if okChildren then
                    for _, child in ipairs(children) do stack[#stack + 1] = child end
                else recordError("children", pathOf(object), children) end
                if #chunk >= CONFIG.ChunkSize then flush() end
                processed = processed + 1
                if processed % CONFIG.BatchSize == 0 then task.wait() end
            end
        end
    end
    state.Phase = "tree"
    walk(game, "datamodel")
    if CONFIG.IncludeDetached and not state.Cancel and not manifest.instanceLimitReached then
        for _, provider in ipairs(providers) do
            if state.Cancel or manifest.instanceLimitReached then break end
            if provider[2] then
                state.Operation = "discovery: " .. provider[1]
                local ok, objects = pcall(provider[2])
                if ok and type(objects) == "table" then
                    for _, object in pairs(objects) do
                        if state.Cancel or manifest.instanceLimitReached then break end
                        if typeof(object) == "Instance" then walk(object, provider[1]) end
                    end
                else recordError(provider[1], "discovery", objects) end
            end
        end
    end
    flush()
    json("remotes/index.json", remotes)
    json("remotes/bindables.json", bindables)
    local lines = { "TIPO\tCAMINHO\tID (argumentos/handlers de servidor nao disponiveis)" }
    for _, entry in ipairs(remotes) do
        lines[#lines + 1] = entry.class .. "\t" .. entry.path .. "\t" .. tostring(entry.id)
    end
    save("remotes/remotes.txt", table.concat(lines, "\n"))
    json("scripts/index.json", scripts)
    state.Phase = "scripts"
    local attempts = 0
    for i, pending in ipairs(pendingScripts) do
        if state.Cancel then break end
        local object, entry = pending.object, pending.entry
        local source = read(object, "Source")
        local method = "source"
        local context = read(object, "RunContext")
        local clientCode = entry.class ~= "Script" or tostring(context) == "Enum.RunContext.Client"
        if type(source) ~= "string" or source == "" then
            source = nil
            if not clientCode then
                entry.reason = "Fonte do Script nao acessivel; nao e codigo de cliente identificado."
            elseif not CONFIG.Decompile or not decode then
                entry.reason = "Fonte inacessivel e decompilador indisponivel/desativado."
            elseif CONFIG.MaxDecompile > 0 and attempts >= CONFIG.MaxDecompile then
                entry.reason = "Limite de decompilacao atingido."
                manifest.decompileLimitReached = true
            else
                attempts = attempts + 1
                -- pcall captura erros Lua, nao impede crash/trava de funcao nativa.
                state.Operation = "decompile: " .. entry.path
                local ok, result = pcall(decode, object)
                if ok and type(result) == "string" and result:find("%S") then
                    source, method = result, "decompiled"
                else
                    entry.reason = tostring(result or "Decompilador retornou resultado vazio.")
                end
                task.wait(CONFIG.DecompileDelay)
            end
        end
        if source then
            entry.file = "scripts/" .. tostring(entry.id) .. "_" .. safeName(entry.name) .. ".luau"
            save(entry.file, source)
            entry.status = method
            if method == "decompiled" then entry.validation = "unverified_executor_output" end
            manifest.counts[method] = manifest.counts[method] + 1
        else
            entry.status = "unavailable"
            manifest.counts.unavailable = manifest.counts.unavailable + 1
        end
        if i % 10 == 0 then
            json("scripts/index.json", scripts)
            checkpoint()
            warn(string.format("[SlenderHub] Scripts %d/%d", i, #pendingScripts))
            task.wait()
        end
    end
    manifest.decompileAttempts = attempts
    for _, entry in ipairs(scripts) do
        if entry.status == "pending" then
            entry.status, entry.reason = "cancelled", "Exportacao cancelada antes da leitura."
        end
    end
    json("scripts/index.json", scripts)
    json("errors.json", errors)
    manifest.status = state.Cancel and "cancelled" or "completed"
    if manifest.status == "completed" and (manifest.instanceLimitReached or manifest.decompileLimitReached or manifest.counts.errors > 0 or manifest.counts.unavailable > 0) then
        manifest.status = "partial"
    end
    manifest.finishedAt = os.date("!%Y-%m-%dT%H:%M:%SZ")
    checkpoint()
    warn(string.format("[SlenderHub] %s: %d instancias, %d remotes, %d fontes, %d decompilados, %d indisponiveis. Pasta: %s", manifest.status, manifest.counts.instances, #remotes, manifest.counts.source, manifest.counts.decompiled, manifest.counts.unavailable, root))
end
local ok, reason = pcall(run)
local function captureFailure(reason)
    local message = tostring(reason)
    if debug and type(debug.traceback) == "function" then
        local okTrace, trace = pcall(debug.traceback, message, 2)
        if okTrace then return trace end
    end
    return message
end
local ok, reason = xpcall(run, captureFailure)
state.Running = false
local failedPhase, failedOperation = state.Phase, state.Operation
state.Phase = ok and manifest.status or "failed"
if not ok then
    state.Error = tostring(reason)
    manifest.status, manifest.error = "failed", tostring(reason)
    if root and write then pcall(checkpoint) end
    warn("[SlenderHub] Exportacao falhou: " .. tostring(reason))
    manifest.failedPhase, manifest.failedOperation = failedPhase, failedOperation
    local diagnostic = "SlenderHub v" .. VERSION .. " | SH-CE-12\nEtapa: " .. tostring(failedPhase)
        .. "\nOperacao: " .. tostring(failedOperation) .. "\n" .. tostring(reason)
    if root and write then
        -- Texto simples: diagnostico disponivel mesmo quando o JSON falhar.
        pcall(write, root .. "/failure.txt", diagnostic)
        pcall(checkpoint)
    end
    state.Operation = failedOperation
    warn("[SlenderHub v" .. VERSION .. "] Exportacao falhou:\n" .. diagnostic)
end
