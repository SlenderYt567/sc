-- ============================================================
-- 7. FARM (EXPLOIT)
-- ============================================================

--- Reporta destruição de todos os breakables de uma zona.
local function reportDestroyedInZone(zone: string): number
    local remote = getServiceRemote("BreakableSpawnService", "ReportDestroyed")
    local folder = Workspace:FindFirstChild("Breakables")
        and Workspace.Breakables:FindFirstChild(zone)
    if not (remote and folder) then
        return 0
    end
    local count = 0
    for _, brk in ipairs(folder:GetChildren()) do
        if brk:IsA("Model") then
            local coinId = brk:GetAttribute("CoinId")
            if type(coinId) == "string" and coinId ~= "" then
                fireInstance(remote, zone, coinId)
                count += 1
            end
        end
    end
    return count
end

--- Reivindica todos os orbs de uma zona (mesmo fluxo do OrbsCollect do jogo).
local function claimOrbsInZone(zone: string, multiplier: number): number
    local remote = getServiceRemote("BreakableOrbService", "ClaimOrb")
    local orbs = Workspace:FindFirstChild("Orbs")
    local zoneFolder = orbs and orbs:FindFirstChild(zone)
    if not (remote and zoneFolder) then
        return 0
    end
    local count = 0
    for _, orb in ipairs(zoneFolder:GetChildren()) do
        if orb:IsA("BasePart") and orb:FindFirstChild("Damage") then
            local coinId = orb:GetAttribute("CoinId") or ""
            local dmg = orb.Damage.Value * multiplier
            fireInstance(remote, zoneFolder.Name, orb.Name, dmg, coinId)
            pcall(function()
                orb:Destroy()
            end)
            count += 1
        end
    end
    return count
end

--- Localiza breakables de click bonus (nome contém "bonus"/"click").
local function findClickBonus(): { { zone: string, coinId: string } }
    local found = {}
    local breakables = Workspace:FindFirstChild("Breakables")
    if breakables then
        for _, folder in ipairs(breakables:GetChildren()) do
            for _, brk in ipairs(folder:GetChildren()) do
                if brk:IsA("Model") then
                    local name = string.lower(brk.Name)
                    local coinId = brk:GetAttribute("CoinId")
                    if (string.find(name, "bonus") or string.find(name, "click"))
                        and type(coinId) == "string" and coinId ~= "" then
                        table.insert(found, { zone = folder.Name, coinId = coinId })
                    end
                end
            end
        end
    end
    return found
end

--- Reivindica o click bonus da zona atual.
local function claimClickBonus(): number
    local remote = getServiceRemote("BreakableOrbService", "ClaimClickBonus")
    if not remote then
        return 0
    end
    local list = findClickBonus()
    for _, item in ipairs(list) do
        fireInstance(remote, item.coinId)
    end
    return #list
end

-- Loop principal do autofarm (exploit)
local function farmLoop()
    while farmState.enabled do
        local zone = farmState.zone

        -- Passo 1: reportar destruição em massa
        farmState.destroyed = reportDestroyedInZone(zone)
        task.wait(0.2)

        -- Passo 2: reivindicar orbs gerados
        farmState.orbs = claimOrbsInZone(zone, farmState.multiplier)

        -- Passo 3 (opcional): teleportar para a zona
        if farmState.teleport then
            teleportToZone(zone)
        end

        task.wait(farmState.interval)
    end
end

local function setAutoFarm(on: boolean)
    farmState.enabled = on
    if on and not farmThread then
        farmThread = task.spawn(farmLoop)
    elseif not on then
        farmThread = nil
    end
end

-- Loop de coleta de orbs (standalone)
task.spawn(function()
    while true do
        task.wait(0.4)
        if orbState.enabled then
            for _, zone in ipairs(ZONES) do
                claimOrbsInZone(zone, farmState.multiplier)
            end
        end
    end
end)

-- Loop de auto break (remoto nativo do jogo)
task.spawn(function()
    while true do
        task.wait(1)
        if breakState.enabled then
            local remote = getServiceRemote("BreakableAreaService", "SetAutoBreaking")
            fireInstance(remote, true)
        end
    end
end)

-- Loop de click bonus automático
task.spawn(function()
    while true do
        task.wait(2)
        if clickBonusState.enabled then
            claimClickBonus()
        end
    end
end)

-- ============================================================
-- 8. HATCH (OVOS)
-- ============================================================
local function hatchEgg(egg: string, amount: string | number)
    local remote = getServiceRemote("EggHatchService", "Hatch")
    -- O remoto aceita "Max" ou um número; converte strings numéricas.
    local finalAmount: string | number = amount
    if type(amount) == "string" and amount ~= "Max" then
        local n = tonumber(amount)
        if n then
            finalAmount = n
        end
    end
    return fireInstance(remote, egg, finalAmount)
end

task.spawn(function()
    while true do
        task.wait(0.5)
        if hatchState.enabled then
            hatchEgg(hatchState.egg, hatchState.amount)
        end
    end
end)

--- Apaga um pet via remoto de configuração (Delete).
local function deletePet(petName: string)
    local knit = ReplicatedStorage:FindFirstChild("Packages")
        and ReplicatedStorage.Packages:FindFirstChild("Knit")
    local svc = knit and knit:FindFirstChild("Services")
        and knit.Services:FindFirstChild("EggHatchService")
    local config = svc and svc:FindFirstChild("Config")
    return fireInstance(config, "Delete", petName)
end

--- Lista pets do jogador a partir do mirror de dados.
local function getPlayerPets(): { string }
    local result = {}
    local mirror = ReplicatedFirst:FindFirstChild("PlayerDataMirror")
    local petsData = mirror and mirror:FindFirstChild("PetsData")
    if petsData then
        for _, folder in ipairs(petsData:GetChildren()) do
            if folder:IsA("Folder") then
                for _, pet in ipairs(folder:GetChildren()) do
                    if pet:IsA("Folder") then
                        table.insert(result, pet.Name)
                    end
                end
            end
        end
    end
    return result
end

--- Apaga todos os pets comuns (Tier1-Tier3 do jogo: "Common", etc.).
local function deleteCommonPets()
    local commons = {
        "Cat", "Dog", "Mouse", "Bird", "Rabbit", "Pig", "Cow", "Chicken",
        "Duck", "Goat", "Sheep", "Horse", "Turtle", "Fish", "Frog", "Squirrel",
    }
    local deleted = 0
    for _, petName in ipairs(getPlayerPets()) do
        for _, common in ipairs(commons) do
            if string.find(petName, common, 1, true) then
                if deletePet(petName) then
                    deleted += 1
                end
                break
            end
        end
    end
    return deleted
end

-- ============================================================
-- 9. MOVIMENTO (PLAYER)
-- ============================================================
RunService.Heartbeat:Connect(function(dt: number)
    local char = LP.Character
    if not char then
        return
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.WalkSpeed = playerState.speed
        hum.JumpPower = playerState.jump
    end
    if playerState.noclip then
        local hrp = char:FindFirstChild(HRP)
        if hrp then
            hrp.CFrame = hrp.CFrame + hrp.Velocity * dt
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end
end)

-- ============================================================
-- 10. ESP (VISUAL)
-- ============================================================
local function getTierColor(tierName: string): Color3
    local name = string.lower(tierName)
    if string.find(name, "rtier") or string.find(name, "ruby") then
        return Color3.fromRGB(255, 60, 60)
    elseif string.find(name, "chest") then
        return Color3.fromRGB(255, 170, 0)
    elseif string.find(name, "tier5") then
        return Color3.fromRGB(255, 215, 0)
    elseif string.find(name, "tier4") then
        return Color3.fromRGB(180, 80, 255)
    elseif string.find(name, "tier3") then
        return Color3.fromRGB(60, 140, 255)
    elseif string.find(name, "tier2") then
        return Color3.fromRGB(60, 220, 120)
    elseif string.find(name, "apple") or string.find(name, "banana")
        or string.find(name, "kiwi") or string.find(name, "mango")
        or string.find(name, "blueberry") or string.find(name, "taco") then
        return Color3.fromRGB(120, 255, 120)
    end
    return Color3.fromRGB(255, 255, 255)
end

local function makeHighlight(adornee: Instance, color: Color3): Highlight
    local h = Instance.new("Highlight")
    h.Adornee = adornee
    h.FillTransparency = 0.75
    h.OutlineTransparency = 0
    h.FillColor = color
    h.OutlineColor = color
    h.Parent = adornee.Parent or Workspace
    return h
end

local function clearESP()
    for _, h in ipairs(espHighlights) do
        pcall(function()
            h:Destroy()
        end)
    end
    table.clear(espHighlights)
end

local function refreshESP()
    clearESP()
    if not espState.enabled then
        return
    end
    local breakables = Workspace:FindFirstChild("Breakables")
    if breakables then
        for _, folder in ipairs(breakables:GetChildren()) do
            if espState.zone == "All" or folder.Name == espState.zone then
                for _, brk in ipairs(folder:GetChildren()) do
                    if brk:IsA("Model") then
                        table.insert(espHighlights, makeHighlight(brk, getTierColor(brk.Name)))
                    end
                end
            end
        end
    end
    if espState.orbs then
        local orbs = Workspace:FindFirstChild("Orbs")
        if orbs then
            for _, folder in ipairs(orbs:GetChildren()) do
                for _, orb in ipairs(folder:GetChildren()) do
                    if orb:IsA("BasePart") then
                        table.insert(espHighlights, makeHighlight(orb, Color3.fromRGB(0, 220, 255)))
                    end
                end
            end
        end
    end
end

-- Atualiza ESP ao mudar estado
local function onEspChanged()
    refreshESP()
end

