-- ============================================================
-- DETECT ANOMALY CHECK-IN: aborta check-in se paciente for anomalia
-- Tags REAIS do dump: GhostAnomaly/StalkerMonster/TallMonsterSpawn/Shadow/DontLookUp
-- ============================================================
local DetectAnomalyOn = false

local function IsAnomalyModel(model)
    if not model then return false end
    for _, tag in ipairs({ "Anomaly", "GhostAnomaly", "Skinwalker", "StalkerMonster", "TallMonsterSpawn", "Shadow", "DontLookUp", "Fake" }) do
        if model:HasTag(tag) then return true end
    end
    -- fallback: nome contém anomalia/skin/strange
    local n = string.lower(model.Name)
    if string.find(n, "anomal") or string.find(n, "skinwalk") or string.find(n, "strange") then
        return true
    end
    return false
end

local function IsCheckInPrompt(prompt)
    local at = string.lower(prompt.ActionText or "")
    return string.find(at, "check") ~= nil
end

local function SetDetectAnomaly(enabled)
    DetectAnomalyOn = enabled
    if not enabled then return end
    SafeNotify("Anti-Anomaly", "Detecção de anomalia no check-in ativada", 2)
end

-- ============================================================
-- AUTO TREAT v2 (COMPLETO): ciclo médico profissional
-- ============================================================
local TreatV2On = false
local TreatItems = { "Medicine", "Medkit", "Bandages", "Antibiotics", "Ointment", "Cough Syrup", "Eye Drops", "Herbs", "Maple Syrup", "IV Drops" }

local function FindPatientBed()
    local root = GetRoot()
    local best, bestD = nil, math.huge
    for _, tag in ipairs({ "InBed", "Patient" }) do
        for _, inst in ipairs(CollectionService:GetTagged(tag)) do
            if inst:IsA("Model") and inst.PrimaryPart then
                local d = root and (root.Position - inst.PrimaryPart.Position).Magnitude or 0
                if d < bestD then best, bestD = inst, d end
            end
        end
    end
    -- fallback: prompt com ActionText treatment/medicine
    local pp = FindPromptByText({ "treatment", "medicine", "treat", "bed" })
    if pp and PromptPos(pp) then return pp end
    return best
end

local function FindMedItem()
    for _, item in ipairs(TreatItems) do
        for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
            if tool:IsA("Tool") and string.find(string.lower(tool.Name), string.lower(item)) then
                return tool
            end
        end
        local char = LocalPlayer.Character
        if char then
            for _, tool in ipairs(char:GetChildren()) do
                if tool:IsA("Tool") and string.find(string.lower(tool.Name), string.lower(item)) then
                    return tool
                end
            end
        end
    end
    return nil
end

local function SetAutoTreatV2(enabled)
    TreatV2On = enabled
    if not enabled then
        SafeNotify("Auto Treat v2", "Desativado", 2)
        return
    end
    task.spawn(function()
        local last = {}
        while TreatV2On and task.wait(1.5) do
            pcall(function()
                local now = os.clock()
                local bed = FindPatientBed()
                if not bed then return end
                local pos = PromptPos(bed) or (bed.PrimaryPart and bed.PrimaryPart.Position) or nil
                if not pos then return end
                if not last[bed] or now - last[bed] > 8 then
                    TeleportNear(pos, 3)
                    local pp = bed:IsA("ProximityPrompt") and bed or bed:FindFirstChildWhichIsA("ProximityPrompt")
                    if pp then FirePrompt(pp) end
                    last[bed] = now
                    task.wait(0.5)
                end
                local tool = FindMedItem()
                if tool then
                    local hum = GetHumanoid()
                    if hum then pcall(function() hum:EquipTool(tool) end) end
                    task.wait(0.3)
                    pcall(function() tool:Activate() end)
                end
            end)
        end
    end)
end

-- ============================================================
-- TRATAR QUEIMADO: usa item em paciente em chamas
-- Tag REAL confirmada (VisualEffects): "OnFire" (parte) / "NPC"+"OnFire"
-- ============================================================
local TreatBurnOn = false

local function FindBurningPatient()
    for _, tag in ipairs({ "OnFire", "Burning", "Burnt" }) do
        for _, inst in ipairs(CollectionService:GetTagged(tag)) do
            if inst:IsA("Model") and inst.PrimaryPart then return inst end
            -- partes em chamas dentro de NPC: sobe para o Model
            if inst:IsA("BasePart") then
                local up = inst.Parent
                while up and not up:IsA("Model") do up = up.Parent end
                if up and up.PrimaryPart then return up end
            end
        end
    end
    -- fallback: paciente com fire parts
    for _, model in ipairs(workspace:GetDescendants()) do
        if model:IsA("Model") and model.PrimaryPart and model:HasTag("Patient") then
            for _, child in ipairs(model:GetDescendants()) do
                if child:IsA("Fire") then return model end
            end
        end
    end
    return nil
end

local function SetAutoTreatBurns(enabled)
    TreatBurnOn = enabled
    if not enabled then
        SafeNotify("Tratar Queimado", "Desativado", 2)
        return
    end
    task.spawn(function()
        local last = {}
        while TreatBurnOn and task.wait(2) do
            pcall(function()
                local patient = FindBurningPatient()
                if not patient or not patient.PrimaryPart then return end
                local now = os.clock()
                if last[patient] and now - last[patient] < 8 then return end
                local tool = nil
                for _, name in ipairs({ "Treat Burns", "Ointment", "Bandages" }) do
                    for _, t in ipairs(LocalPlayer.Backpack:GetChildren()) do
                        if t:IsA("Tool") and string.find(string.lower(t.Name), string.lower(name)) then
                            tool = t break
                        end
                    end
                    if tool then break end
                end
                if not tool then return end
                TeleportNear(patient.PrimaryPart.Position, 3)
                local hum = GetHumanoid()
                if hum then pcall(function() hum:EquipTool(tool) end) end
                task.wait(0.3)
                pcall(function() tool:Activate() end)
                last[patient] = now
                SafeNotify("Queimado", "Aplicando " .. tostring(tool.Name) .. " no paciente", 3)
            end)
        end
    end)
end

