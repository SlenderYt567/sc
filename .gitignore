end)

if saveOK and type(SaveManager) == "table" then
    pcall(function()
        SaveManager:SetLibrary(Fluent)
        SaveManager:IgnoreThemeSettings()
        SaveManager:SetIgnoreIndexes({})
        SaveManager:SetFolder("SlenderHub/PetUniverse")
        SaveManager:BuildConfigSection(Tabs.Settings)
    end)
end

if ifaceOK and type(InterfaceManager) == "table" then
    pcall(function()
        InterfaceManager:SetLibrary(Fluent)
        InterfaceManager:SetFolder("SlenderHub/PetUniverse")
        InterfaceManager:BuildInterfaceSection(Tabs.Settings)
        InterfaceManager:SetTheme("Dark")
    end)
end

-- ============================================================
-- 16. FINALIZAÇÃO
-- ============================================================
Window:SelectTab(1)

if saveOK and type(SaveManager) == "table" then
    pcall(function()
        SaveManager:LoadAutoloadConfig()
    end)
end

if ifaceOK and type(InterfaceManager) == "table" then
    pcall(function()
        InterfaceManager:LoadInterfaceConfig()
    end)
end

Fluent:Notify({
    Title = "Pet Universe Hub",
    Content = "Script carregado com sucesso!",
    Duration = 4,
})

end) -- fim do pcall principal

-- Notificação em caso de erro na inicialização
if not mainOK then
    local msg = tostring(mainErr)
    warn("[PetUniverseHub] ERRO:", msg)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Pet Universe Hub — Erro",
            Text = msg,
            Duration = 8,
        })
    end)
end
